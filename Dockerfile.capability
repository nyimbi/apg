# APG Capability Dockerfile
# Each capability installs as a standalone PyPI package and is served by
# capability_runner.py, which refuses to report healthy unless the named
# capability imports and its create_app() succeeds.
#
# Build: docker build -f Dockerfile.capability -t apg-capability .
# Run:   docker run -e APG_CAPABILITY=capabilities.agriculture.mkt.app \
#          -e APG_DATABASE_URL=... -p 8080:8080 apg-capability

FROM python:3.12-slim

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Install build toolchain
RUN pip install --no-cache-dir build wheel setuptools>=68

# Copy the full capabilities tree (used for local installs during platform mode)
COPY capabilities/ ./capabilities/
COPY capabilities/MANIFEST.json ./capabilities/MANIFEST.json
COPY capability_runner.py ./capability_runner.py

# Install base dependencies shared across all capabilities
RUN pip install --no-cache-dir \
    "pydantic>=2.0" \
    "uuid6>=0.4" \
    "sqlalchemy[asyncio]>=2.0" \
    "asyncpg>=0.29" \
    "flask>=3.0" \
    "alembic>=1.13" \
    "nats-py>=2.7" \
    "temporalio>=1.7" \
    "httpx>=0.27"

# Install all capability packages from local source.
# Failures are fatal: a broken capability must not yield a "healthy" image.
# In production, replace with: pip install apg-intel-alerts apg-fin-arc etc.
RUN set -eux; \
    find capabilities -name "pyproject.toml" -not -path "*/build/*" -not -path "*/__pycache__/*" \
        | xargs -I{} dirname {} \
        | xargs -I{} pip install --no-cache-dir -e {}

# Expose default port (override via CMD)
EXPOSE 8080

# Health reflects the real capability boot, not a stub process
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/health || exit 1

# Serve the capability named by $APG_CAPABILITY
CMD ["python", "capability_runner.py"]
