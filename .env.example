# APG Platform — Environment Configuration Template
# Copy to .env and fill in your values before deploying.
# Never commit .env to version control.

# ── Core Platform ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (asyncpg driver)
APG_DATABASE_URL=postgresql+asyncpg://apg:changeme@localhost:5432/apg

# Default tenant ID used when no tenant header is present
APG_DEFAULT_TENANT=platform

# Secret key for session signing (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
APG_SECRET_KEY=change-me-to-a-random-hex-string

# ── Messaging & Workflow ───────────────────────────────────────────────────────

# NATS JetStream connection (leave blank to disable event bus)
NATS_URL=nats://localhost:4222

# Temporal.io server address (leave blank to use in-process workflow engine)
TEMPORAL_HOST=localhost:7233

# ── Policy Engine ─────────────────────────────────────────────────────────────

# Open Policy Agent REST endpoint (leave blank to use built-in RBAC)
OPA_URL=http://localhost:8181

# ── AI / LLM ─────────────────────────────────────────────────────────────────

# Ollama base URL for locally-hosted models
OLLAMA_BASE_URL=http://localhost:11434

# Provider command for APG agent runtime (receives JSON on stdin, writes JSON to stdout)
# Example: APG_AGENT_PROVIDER_COMMAND=apg-agent-ollama
APG_AGENT_PROVIDER_COMMAND=
APG_AGENT_CODEX_PROVIDER_COMMAND=
APG_AGENT_CLAUDE_CODE_PROVIDER_COMMAND=

# ── Africa Mobile Money ───────────────────────────────────────────────────────

# Safaricom M-PESA Daraja API
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=
MPESA_TIMEOUT_URL=https://your-domain.com/mpesa/timeout
MPESA_RESULT_URL=https://your-domain.com/mpesa/result
# sandbox | production
MPESA_ENV=sandbox

# MTN Mobile Money
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
# sandbox | production
MTN_ENV=sandbox

# Airtel Money
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# sandbox | production
AIRTEL_ENV=sandbox

# Orange Money
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=

# Wave
WAVE_API_KEY=

# ── Card Bureau ───────────────────────────────────────────────────────────────

# Generic card bureau REST API (Sanlam, DPO, NIC, etc.)
CARD_BUREAU_URL=
CARD_BUREAU_API_KEY=

# ── Global Payments ───────────────────────────────────────────────────────────

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Equity Bank ───────────────────────────────────────────────────────────────

EQUITY_BASE_URL=https://api.equitybankgroup.com
EQUITY_API_KEY=
EQUITY_CONSUMER_KEY=
EQUITY_CONSUMER_SECRET=

# ── Messaging / Notifications ─────────────────────────────────────────────────

# Twilio (SMS / voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ── GIS / Maps ────────────────────────────────────────────────────────────────

GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────────

# S3-compatible object storage (MinIO, AWS S3, Cloudflare R2)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=apg-uploads
S3_REGION=us-east-1
