"""Configuration defaults for Environmental Monitoring."""

from __future__ import annotations

import os


class Config:
	PROJECT_NAME = os.environ.get("PROJECT_NAME", "{{project_name}}")
	PROJECT_DESCRIPTION = os.environ.get("PROJECT_DESCRIPTION", "{{project_description}}")
	AUTHOR = os.environ.get("PROJECT_AUTHOR", "{{author}}")
	DATABASE_URL = os.environ.get("DATABASE_URL", "{{database_url}}")
	SECRET_KEY = os.environ.get("SECRET_KEY", "{{secret_key}}")
	TEMPLATE_ID = "iot/environmental_sensor"
	TEMPLATE_NAME = "Environmental Monitoring"
	DOMAIN = "Environmental Monitoring"
	COMPLEXITY = "Intermediate"
	FEATURES = [
    "Multi-sensor Integration",
    "Environmental Analytics",
    "Trend Prediction"
]
	DATABASES = [
    "sensor_readings",
    "environmental_data",
    "predictions"
]
	AGENTS = [
    "SensorAgent",
    "AnalyticsAgent",
    "PredictionAgent"
]


def as_dict() -> dict[str, object]:
	return {
		"project_name": Config.PROJECT_NAME,
		"project_description": Config.PROJECT_DESCRIPTION,
		"author": Config.AUTHOR,
		"database_url": Config.DATABASE_URL,
		"template_id": Config.TEMPLATE_ID,
		"template_name": Config.TEMPLATE_NAME,
		"domain": Config.DOMAIN,
		"complexity": Config.COMPLEXITY,
		"features": list(Config.FEATURES),
		"databases": list(Config.DATABASES),
		"agents": list(Config.AGENTS),
	}
