"""Domain models for AI Intelligence Platform."""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime, timezone
from typing import Any


DATABASES = [
    "models",
    "inference_logs",
    "training_data"
]
SEED_ITEMS = [
    [
        "model_management",
        "Model Management"
    ],
    [
        "multi_agent_ai",
        "Multi-Agent AI"
    ],
    [
        "inference_pipeline",
        "Inference Pipeline"
    ],
    [
        "ai_analytics",
        "AI Analytics"
    ]
]


@dataclass(slots=True)
class TemplateRecord:
	key: str
	label: str
	status: str = "ready"
	metadata: dict[str, Any] = field(default_factory=dict)
	created_at: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())

	def activate(self) -> None:
		self.status = "active"


def seed_records() -> list[TemplateRecord]:
	return [
		TemplateRecord(key=key, label=label, metadata={"database": DATABASES[index % len(DATABASES)] if DATABASES else "default"})
		for index, (key, label) in enumerate(SEED_ITEMS)
	]
