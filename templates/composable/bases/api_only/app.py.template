CAPABILITIES: List[str] = {{capabilities|tojson}}


def create_app(config: Dict[str, Any] | None = None) -> Dict[str, Any]:
    """Create a dependency-free API service descriptor."""
    settings = dict(config or {})
    return {
        "project": "{{project_name}}",
        "base_template": "{{base_template}}",
        "service_type": "api_only",
        "version": "{{version}}",
        "capabilities": CAPABILITIES,
        "routes": [
            {"method": "GET", "path": "/health", "handler": "health_check"},
            {"method": "GET", "path": "/capabilities", "handler": "list_capabilities"},
