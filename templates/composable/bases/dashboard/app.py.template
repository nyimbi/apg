"""
{{project_name}} - Analytics Dashboard
=======================================

Generated by APG using Analytics Dashboard base template.
"""

from datetime import datetime
from typing import Any, Dict, List


CAPABILITIES: List[str] = {{capabilities|tojson}}


def create_app(config: Dict[str, Any] | None = None) -> Dict[str, Any]:
    """Create a dependency-free dashboard descriptor."""
    settings = dict(config or {})
    return {
        "project": "{{project_name}}",
        "base_template": "{{base_template}}",
        "service_type": "analytics_dashboard",
        "version": "{{version}}",
        "capabilities": CAPABILITIES,
        "dashboards": [
            {
                "name": "overview",
                "title": "{{project_name}} Overview",
                "widgets": ["capability_status", "event_volume", "contract_health"],
            },
            {
                "name": "operations",
                "title": "Operations",
                "widgets": ["active_workflows", "alerts", "recent_activity"],
            },
        ],
        "config": settings,
    }


def dashboard_manifest() -> Dict[str, Any]:
    """Return dashboard navigation and widget metadata."""
    app = create_app()
    return {
        "application": app["project"],
        "dashboards": app["dashboards"],
        "capabilities": app["capabilities"],
    }


def health_check() -> Dict[str, Any]:
    """Return an executable health payload for dashboard deployments."""
    return {
        "status": "healthy",
        "timestamp": datetime.now().isoformat(),
        "application": "{{project_name}}",
        "service_type": "analytics_dashboard",
        "dashboard_count": len(dashboard_manifest()["dashboards"]),
    }


if __name__ == "__main__":
    print(health_check())
