"""
{{project_name}} - Real-Time Application
=========================================

Generated by APG using Real-Time Application base template.
"""

from datetime import datetime
from typing import Any, Dict, List


CAPABILITIES: List[str] = {{capabilities|tojson}}
STREAMS: Dict[str, List[Dict[str, Any]]] = {}


def create_app(config: Dict[str, Any] | None = None) -> Dict[str, Any]:
    """Create a dependency-free real-time application descriptor."""
    settings = dict(config or {})
    flow_id = settings.get("bytewax_flow_id", "apg-real-time")
    return {
        "project": "{{project_name}}",
        "base_template": "{{base_template}}",
        "service_type": "real_time",
        "version": "{{version}}",
        "flow_id": flow_id,
        "capabilities": CAPABILITIES,
        "streams": sorted(STREAMS),
        "config": settings,
    }


def publish_event(stream: str, event: Dict[str, Any]) -> Dict[str, Any]:
    """Append one event to the in-process real-time stream ledger."""
    assert stream, "stream is required"
    record = {
        "stream": stream,
        "sequence": len(STREAMS.setdefault(stream, [])),
        "event": dict(event),
        "timestamp": datetime.now().isoformat(),
    }
    STREAMS[stream].append(record)
    return record


def read_stream(stream: str, cursor: int = 0) -> List[Dict[str, Any]]:
    """Read stream records from the supplied cursor."""
    return list(STREAMS.get(stream, [])[cursor:])


def health_check() -> Dict[str, Any]:
    """Return an executable health payload for real-time deployments."""
    app = create_app()
    return {
        "status": "healthy",
        "timestamp": datetime.now().isoformat(),
        "application": app["project"],
        "service_type": "real_time",
        "flow_id": app["flow_id"],
        "stream_count": len(STREAMS),
    }


if __name__ == "__main__":
    print(health_check())
