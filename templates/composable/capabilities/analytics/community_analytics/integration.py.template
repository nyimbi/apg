class CommunityAnalyticsView(BaseView):
    """
    Main view for Community Analytics capability.
    """

    route_base = "/community_analytics"

    @expose("/")
    def index(self):
        """Main community dashboard view"""
        return self.render_template("community_analytics_dashboard.html")

    @expose("/contribute")
    def contribute(self):
        """Community contribution view"""
        return self.render_template("community_analytics_contribute.html")
