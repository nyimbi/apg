"""
Edge Computing Integration
==========================

Integration logic for the Edge Computing capability.
Handles IoT-specific setup and configuration.
"""

import logging
from importlib import import_module
from flask import Blueprint
from flask_appbuilder import BaseView

# Configure logging
log = logging.getLogger(__name__)

# Create capability blueprint
edge_computing_bp = Blueprint(
    'edge_computing',
    __name__,
    url_prefix='/iot/edge_computing',
    template_folder='templates',
    static_folder='static'
)


def integrate_edge_computing(app, appbuilder, db):
    """
    Integrate Edge Computing capability into the application.

    Args:
        app: Flask application instance
        appbuilder: Flask-AppBuilder instance
        db: SQLAlchemy database instance
    """
    try:
        # Register blueprint
        app.register_blueprint(edge_computing_bp)

        # Import optional capability modules without invalid function-local star imports
        package_prefix = f"{__package__}." if __package__ else ""
        for module_name in ("models", "views"):
            try:
                import_module(f"{package_prefix}{module_name}")
            except ImportError as import_error:
                log.debug(f"Optional module {module_name} not loaded: {import_error}")

        # Apply IoT-specific configuration
        config_additions = {'EDGE_REGISTRY_URL': 'localhost:5000', 'KUBERNETES_CONFIG': '/etc/k8s/config'}
        for key, value in config_additions.items():
            app.config[key] = value

        # Initialize IoT services
        iot_service = EdgeComputingService(app, appbuilder, db)
        app.extensions['edge_computing_service'] = iot_service

        log.info(f"Successfully integrated Edge Computing capability")

    except Exception as e:
        log.error(f"Failed to integrate Edge Computing capability: {e}")
        raise


