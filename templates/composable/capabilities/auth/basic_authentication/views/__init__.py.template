"""
Basic Authentication View Contracts
===================================

Framework-neutral APG UI view contracts for user, role, and permission
management. UI adapters map these contracts to web, desktop, CLI, or API
surfaces at composition time.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any


@dataclass(slots=True)
class ViewAction:
    name: str
    label: str
    requires_confirmation: bool = False


@dataclass(slots=True)
class ViewContract:
    name: str
    model: str
    list_fields: list[str] = field(default_factory=list)
    search_fields: list[str] = field(default_factory=list)
    edit_fields: list[str] = field(default_factory=list)
    actions: list[ViewAction] = field(default_factory=list)
    theme_tokens: dict[str, Any] = field(default_factory=dict)

    def to_manifest(self) -> dict[str, Any]:
        return {
            "name": self.name,
            "model": self.model,
            "list_fields": list(self.list_fields),
            "search_fields": list(self.search_fields),
            "edit_fields": list(self.edit_fields),
            "actions": [action.__dict__.copy() for action in self.actions],
            "theme_tokens": dict(self.theme_tokens),
        }


VIEW_CONTRACTS = [
    ViewContract(
        name="UserView",
        model="User",
        list_fields=["username", "first_name", "last_name", "email", "active", "last_login", "login_count"],
        search_fields=["username", "first_name", "last_name", "email"],
        edit_fields=["first_name", "last_name", "username", "email", "active", "roles"],
        actions=[
            ViewAction("activate_user", "Activate user", requires_confirmation=True),
            ViewAction("deactivate_user", "Deactivate user", requires_confirmation=True),
        ],
    ),
    ViewContract(
        name="RoleView",
        model="Role",
        list_fields=["name"],
        search_fields=["name"],
        edit_fields=["name", "permissions"],
    ),
    ViewContract(
        name="PermissionView",
        model="Permission",
        list_fields=["name"],
        search_fields=["name"],
        edit_fields=["name"],
    ),
]


def list_views() -> list[str]:
    return [view.name for view in VIEW_CONTRACTS]


def describe_views() -> list[dict[str, Any]]:
    return [view.to_manifest() for view in VIEW_CONTRACTS]
