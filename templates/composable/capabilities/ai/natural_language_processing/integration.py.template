"""
Natural Language Processing Integration
=======================================

APG capability-contract integration for Natural Language Processing.
This template is framework-neutral; transport, UI, and persistence adapters
are selected by the composing application.
"""

import logging
from importlib import import_module
from typing import Any


log = logging.getLogger(__name__)

CAPABILITY_CONTRACT: dict[str, Any] = {
    'name': 'Natural Language Processing',
    'category': 'ai',
    'version': '1.0.0',
    'features': ['Sentiment Analysis', 'Named Entity Recognition', 'Text Classification', 'Language Detection', 'Text Summarization', 'Keyword Extraction', 'Topic Modeling', 'Text Similarity'],
    'models': ['TextDocument', 'NLPResult', 'Entity', 'Sentiment'],
    'views': ['TextAnalysisView', 'EntityView', 'SentimentView'],
    'apis': ['nlp/analyze', 'nlp/sentiment', 'nlp/entities', 'nlp/summarize'],
    'templates': ['nlp_dashboard.html', 'text_analysis.html'],
    'static_files': [],
    'configuration': {},
}


def integrate_natural_language_processing(application: Any = None, registry: Any = None, configuration: dict[str, Any] | None = None) -> dict[str, Any]:
    """Register Natural Language Processing metadata with an APG application or registry."""
    contract = dict(CAPABILITY_CONTRACT)
    contract['configuration'] = {
        **contract.get('configuration', {}),
        **(configuration or {}),
    }

    package_prefix = f"{__package__}." if __package__ else ""
    for module_name in ("models", "views"):
        try:
            import_module(f"{package_prefix}{module_name}")
        except ImportError as import_error:
            log.debug("Optional %s module %s not loaded: %s", 'Natural Language Processing', module_name, import_error)

    if registry is not None:
        if hasattr(registry, "register_capability"):
            registry.register_capability(contract)
        elif isinstance(registry, dict):
            registry[contract['name']] = contract

    if application is not None and hasattr(application, "capabilities"):
        application.capabilities[contract['name']] = contract

    log.info("Registered APG capability: %s", contract['name'])
    return contract


class NaturalLanguageProcessingCapability:
    """Executable capability wrapper for Natural Language Processing."""

    def __init__(self, application: Any = None, registry: Any = None, configuration: dict[str, Any] | None = None):
        self.application = application
        self.registry = registry
        self.config = configuration or {}
        self.initialized = False
        self.contract: dict[str, Any] | None = None
        if application is not None or registry is not None:
            self.init_app(application, registry, configuration)

    def init_app(self, application: Any = None, registry: Any = None, configuration: dict[str, Any] | None = None) -> dict[str, Any]:
        self.application = application
        self.registry = registry
        self.config = configuration or self.config
        self.contract = integrate_natural_language_processing(application, registry, self.config)
        self.initialized = True
        return self.contract

    def get_status(self) -> dict[str, Any]:
        return {
            'initialized': self.initialized,
            'capability': 'Natural Language Processing',
            'configuration_keys': sorted(self.config),
        }
