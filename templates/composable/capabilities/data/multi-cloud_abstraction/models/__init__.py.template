"""
Multi-Cloud Abstraction Model Contracts
=======================================

Framework-neutral APG model contracts for Multi-Cloud Abstraction.
Persistence adapters map these contracts to an ORM, document store, graph store,
or event log at composition time.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime
from typing import Any


MODEL_CONTRACTS: list[str] = ['CloudProvider', 'CloudResource', 'CloudOperation', 'MigrationJob']


@dataclass(slots=True)
class APGModelRecord:
    """Portable APG model record."""

    model: str
    data: dict[str, Any] = field(default_factory=dict)
    record_id: str | None = None
    created_at: datetime = field(default_factory=datetime.utcnow)
    updated_at: datetime = field(default_factory=datetime.utcnow)

    def to_manifest(self) -> dict[str, Any]:
        return {
            "model": self.model,
            "record_id": self.record_id,
            "data": dict(self.data),
            "created_at": self.created_at.isoformat(),
            "updated_at": self.updated_at.isoformat(),
        }


@dataclass(slots=True)
class MultiCloudAbstractionModelCatalog:
    """Model catalog emitted by the Multi-Cloud Abstraction capability."""

    capability: str = 'Multi-Cloud Abstraction'
    category: str = 'data'
    models: list[str] = field(default_factory=lambda: list(MODEL_CONTRACTS))

    def create_record(self, model: str, data: dict[str, Any] | None = None, record_id: str | None = None) -> APGModelRecord:
        if model not in self.models:
            raise ValueError(f"Unknown Multi-Cloud Abstraction model: {model}")
        return APGModelRecord(model=model, data=data or {}, record_id=record_id)

    def to_manifest(self) -> dict[str, Any]:
        return {
            "capability": self.capability,
            "category": self.category,
            "models": list(self.models),
        }


def list_models() -> list[str]:
    return list(MODEL_CONTRACTS)


def describe_models() -> dict[str, Any]:
    return MultiCloudAbstractionModelCatalog().to_manifest()
