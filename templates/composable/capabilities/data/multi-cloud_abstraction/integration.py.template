class MultiCloudAbstractionView(BaseView):
    """
    Main view for Multi-Cloud Abstraction capability.
    """

    route_base = "/multi_cloud_abstraction"

    @expose("/")
    def index(self):
        """Main cloud dashboard view"""
        return self.render_template("multi_cloud_abstraction_dashboard.html")

    @expose("/resources")
    def resources(self):
        """Cloud resources view"""
        return self.render_template("multi_cloud_abstraction_resources.html")
