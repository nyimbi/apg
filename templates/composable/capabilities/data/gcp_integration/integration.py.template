class GCPIntegrationView(BaseView):
    """
    Main view for GCP Integration capability.
    """

    route_base = "/gcp_integration"

    @expose("/")
    def index(self):
        """Main cloud dashboard view"""
        return self.render_template("gcp_integration_dashboard.html")

    @expose("/resources")
    def resources(self):
        """Cloud resources view"""
        return self.render_template("gcp_integration_resources.html")
