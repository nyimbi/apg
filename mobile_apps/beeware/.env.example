# APG Workflow Mobile - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
APG_ENVIRONMENT=development
# Options: development, staging, production, testing

APG_DEBUG=true
# Set to false in production

# =============================================================================
# API CONFIGURATION
# =============================================================================
APG_API__BASE_URL=http://localhost:5000
# Production: https://api.datacraft.co.ke/apg
# Staging: https://staging-api.datacraft.co.ke/apg

APG_API__TIMEOUT=30.0
APG_API__RETRY_ATTEMPTS=3
APG_API__RETRY_DELAY=1.0

# API Authentication - REQUIRED for production
APG_API__API_KEY=your-api-key-here
APG_API__CLIENT_ID=your-client-id-here
APG_API__CLIENT_SECRET=your-client-secret-here

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Encryption Key - REQUIRED: Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APG_SECURITY__ENCRYPTION_KEY=your-32-character-encryption-key-here

# JWT Secret - REQUIRED: Generate a secure random string
APG_SECURITY__JWT_SECRET=your-jwt-secret-key-here

# JWT Configuration
APG_SECURITY__JWT_EXPIRY=3600
APG_SECURITY__JWT_REFRESH_THRESHOLD=300

# Biometric Settings
APG_SECURITY__BIOMETRIC_TIMEOUT=30
APG_SECURITY__BIOMETRIC_MAX_ATTEMPTS=3

# Password Policy
APG_SECURITY__PASSWORD_MIN_LENGTH=8
APG_SECURITY__PASSWORD_REQUIRE_UPPERCASE=true
APG_SECURITY__PASSWORD_REQUIRE_LOWERCASE=true
APG_SECURITY__PASSWORD_REQUIRE_NUMBERS=true
APG_SECURITY__PASSWORD_REQUIRE_SYMBOLS=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
APG_DATABASE__SQLITE_PATH=~/.apg_workflow_mobile/offline.db
APG_DATABASE__CACHE_SQLITE_PATH=~/.apg_workflow_mobile/cache.db
APG_DATABASE__CACHE_TTL=3600
APG_DATABASE__POOL_SIZE=10

# =============================================================================
# SYNCHRONIZATION CONFIGURATION
# =============================================================================
APG_SYNC__SYNC_INTERVAL=300
APG_SYNC__SYNC_BATCH_SIZE=50
APG_SYNC__SYNC_TIMEOUT=60
APG_SYNC__MAX_SYNC_RETRIES=3
APG_SYNC__BACKGROUND_SYNC_ENABLED=true
APG_SYNC__BACKGROUND_SYNC_WIFI_ONLY=false

# =============================================================================
# FILE CONFIGURATION
# =============================================================================
APG_FILES__MAX_FILE_SIZE=104857600
# 100MB = 104857600 bytes

APG_FILES__UPLOAD_CHUNK_SIZE=1048576
# 1MB = 1048576 bytes

APG_FILES__UPLOAD_TIMEOUT=300
APG_FILES__DOWNLOAD_TIMEOUT=600

# =============================================================================
# UI CONFIGURATION
# =============================================================================
APG_UI__THEME_MODE=auto
# Options: light, dark, auto

APG_UI__PRIMARY_COLOR=#1976D2
APG_UI__SECONDARY_COLOR=#FFC107
APG_UI__ANIMATION_DURATION=300
APG_UI__TOAST_DURATION=3000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
APG_LOGGING__LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

APG_LOGGING__CONSOLE_LOG_LEVEL=INFO
APG_LOGGING__FILE_LOG_LEVEL=DEBUG
APG_LOGGING__LOG_FILE_PATH=~/.apg_workflow_mobile/logs/app.log
APG_LOGGING__COLORED_LOGS=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
APG_FEATURES__BIOMETRIC_AUTH_ENABLED=true
APG_FEATURES__OFFLINE_MODE_ENABLED=true
APG_FEATURES__REAL_TIME_SYNC_ENABLED=true
APG_FEATURES__PUSH_NOTIFICATIONS_ENABLED=true
APG_FEATURES__FILE_UPLOAD_ENABLED=true
APG_FEATURES__ANALYTICS_ENABLED=true
APG_FEATURES__CRASH_REPORTING_ENABLED=true

# Debug Features (disable in production)
APG_FEATURES__DEBUG_MODE_ENABLED=true
APG_FEATURES__MOCK_API_ENABLED=false
APG_FEATURES__VERBOSE_LOGGING_ENABLED=false

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Push Notifications
FIREBASE_API_KEY=your-firebase-api-key
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id

# Analytics
GOOGLE_ANALYTICS_ID=your-google-analytics-id
MIXPANEL_TOKEN=your-mixpanel-token

# Error Reporting
SENTRY_DSN=your-sentry-dsn

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# Override configuration file path
# APG_CONFIG_FILE=/path/to/custom/config.yml

# Development flags
APG_DEV_MODE=true
APG_MOCK_DATA=false