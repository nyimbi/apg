# APG Billing System Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
FLASK_ENV=production
APP_SECRET_KEY=your-secret-key-change-this-in-production
LOG_LEVEL=INFO
DEFAULT_CURRENCY=USD
DEFAULT_TRIAL_DAYS=14
DEFAULT_GRACE_PERIOD_DAYS=3

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL (Production)
DATABASE_URL=postgresql://user:password@localhost:5432/apg_billing

# SQLite (Development)
# DATABASE_URL=sqlite:///apg_billing.db

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Redis
REDIS_URL=redis://localhost:6379/0

# Cache TTL Settings (seconds)
CUSTOMER_CACHE_TTL=3600
PLAN_CACHE_TTL=7200
ANALYTICS_CACHE_TTL=1800

# =============================================================================
# PAYMENT PROCESSOR CONFIGURATION
# =============================================================================

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
PAYPAL_MODE=live  # or sandbox for testing

# Additional Processors
SQUARE_APPLICATION_ID=your_square_app_id_here
SQUARE_ACCESS_TOKEN=your_square_access_token_here
ADYEN_API_KEY=your_adyen_api_key_here
ADYEN_MERCHANT_ACCOUNT=your_adyen_merchant_account_here

# =============================================================================
# TAX SERVICE CONFIGURATION
# =============================================================================

# Avalara
AVALARA_ACCOUNT_ID=your_avalara_account_id
AVALARA_LICENSE_KEY=your_avalara_license_key
AVALARA_ENVIRONMENT=production  # or sandbox

# TaxJar
TAXJAR_API_TOKEN=your_taxjar_api_token_here

# =============================================================================
# EMAIL SERVICE CONFIGURATION
# =============================================================================

# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=billing@yourdomain.com
SENDGRID_FROM_NAME=Your Company Billing

# SMTP Fallback
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=billing@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true

# =============================================================================
# SMS SERVICE CONFIGURATION
# =============================================================================

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# AWS SNS
AWS_SNS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SNS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SNS_REGION=us-west-2

# =============================================================================
# PUSH NOTIFICATION CONFIGURATION
# =============================================================================

# Firebase
FIREBASE_SERVER_KEY=your_firebase_server_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id

# AWS SNS Mobile
AWS_SNS_MOBILE_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SNS_MOBILE_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SNS_MOBILE_REGION=us-west-2

# =============================================================================
# ANALYTICS AND MARKETING APIS
# =============================================================================

# Google Analytics
GOOGLE_ANALYTICS_PROPERTY_ID=your_ga_property_id
GOOGLE_ANALYTICS_CREDENTIALS_JSON=path/to/service-account.json

# Google Ads
GOOGLE_ADS_CUSTOMER_ID=your_google_ads_customer_id
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_CREDENTIALS_JSON=path/to/google-ads-credentials.json

# Facebook Marketing
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#billing-alerts

# PagerDuty
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key

# Email Alerts
HEALTH_ALERT_EMAILS=ops@yourdomain.com,admin@yourdomain.com
CRITICAL_ALERT_EMAILS=cto@yourdomain.com,oncall@yourdomain.com

# DataDog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# New Relic
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=APG Billing System

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Core Features
USAGE_TRACKING_ENABLED=true
TAX_CALCULATION_ENABLED=true
DUNNING_ENABLED=true
REVENUE_RECOGNITION_ENABLED=true
FRAUD_DETECTION_ENABLED=true
AI_BILLING_INTELLIGENCE_ENABLED=true

# Integrations
STRIPE_ENABLED=true
PAYPAL_ENABLED=true
AVALARA_ENABLED=true
TAXJAR_ENABLED=true
SENDGRID_ENABLED=true
TWILIO_ENABLED=true

# Advanced Features
CHURN_PREDICTION_ENABLED=true
REVENUE_OPTIMIZATION_ENABLED=true
PREDICTIVE_BILLING_ENABLED=true
AUTONOMOUS_PAYMENT_ORCHESTRATION_ENABLED=true

# =============================================================================
# BACKGROUND TASK CONFIGURATION
# =============================================================================

# Task Intervals (seconds)
RENEWAL_CHECK_INTERVAL=3600
INVOICE_GENERATION_INTERVAL=3600
DUNNING_CHECK_INTERVAL=3600
REVENUE_RECOGNITION_INTERVAL=86400
HEALTH_CHECK_INTERVAL=300
USAGE_AGGREGATION_INTERVAL=1800

# Task Concurrency
MAX_CONCURRENT_RENEWALS=10
MAX_CONCURRENT_INVOICES=20
MAX_CONCURRENT_PAYMENTS=15

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================

# Webhook Settings
WEBHOOK_TIMEOUT=30
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5
WEBHOOK_SIGNATURE_TOLERANCE=300

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Debug Flags (set to false in production)
DEBUG_MODE=false
DEBUG_PAYMENTS=false
DEBUG_EMAILS=false
DEBUG_WEBHOOKS=false

# Test Mode (set to false in production)
TEST_MODE=false
USE_TEST_PAYMENT_METHODS=false
SKIP_EMAIL_SENDING=false

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================

# Data Retention (days)
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years
PAYMENT_DATA_RETENTION_DAYS=2555
CUSTOMER_DATA_RETENTION_DAYS=2555

# Compliance Features
PCI_COMPLIANCE_MODE=true
GDPR_COMPLIANCE_MODE=true
SOX_COMPLIANCE_MODE=true