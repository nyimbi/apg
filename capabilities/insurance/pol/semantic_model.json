  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/ins-pol/policys",
      "description": "List Policy records"
    },
    {
      "method": "POST",
      "path": "/api/ins-pol/policys",
      "description": "Create Policy"
    },
    {
      "method": "GET",
      "path": "/api/ins-pol/policys/{id}",
      "description": "Get Policy by ID"
    },
    {
      "method": "PUT",
      "path": "/api/ins-pol/policys/{id}",
      "description": "Update Policy"
    },
    {
      "method": "DELETE",
      "path": "/api/ins-pol/policys/{id}",
      "description": "Delete Policy"
    }
  ],
  "events": {
    "publishes": [
      "policy.issued",
      "policy.renewed",
      "policy.cancelled"
    ],
    "subscribes": []
  }
