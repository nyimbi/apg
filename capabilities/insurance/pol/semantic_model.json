{
  "capability_id": "ins_pol",
  "capability_name": "Policy Administration",
  "version": "1.0.0",
  "domain": "insurance",
  "entities": {
    "Policy": {
      "type": "object",
      "description": "Policy entity for Policy Administration",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "Endorsement": {
