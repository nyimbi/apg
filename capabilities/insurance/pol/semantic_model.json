        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "Renewal": {
      "type": "object",
      "description": "Renewal entity for Policy Administration",
      "properties": {
        "id": {
