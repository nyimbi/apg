      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "NotificationAgentPanel",
          "permission": "ckm_not:govern",
          "route": "/ckm-not/agents"
        },
        "analytics": {
          "component": "NotificationAnalytics",
          "permission": "ckm_not:view",
          "route": "/ckm-not/analytics"
        },
        "audit": {
          "component": "NotificationAudit",
          "permission": "ckm_not:view",
          "route": "/ckm-not/audit"
        },
        "campaigns": {
          "component": "CampaignConsole",
          "permission": "ckm_not:manage_campaigns",
          "route": "/ckm-not/campaigns"
        },
        "dashboard": {
          "component": "NotificationDashboard",
          "permission": "ckm_not:view",
          "route": "/ckm-not/dashboard"
        },
        "deliveries": {
          "component": "DeliveryWorkbench",
          "permission": "ckm_not:send",
          "route": "/ckm-not/deliveries"
        },
        "preferences": {
          "component": "PreferenceCenter",
          "permission": "ckm_not:view_preferences",
          "route": "/ckm-not/preferences"
        },
        "providers": {
          "component": "ProviderRegistry",
          "permission": "ckm_not:admin",
          "route": "/ckm-not/providers"
        },
        "rules": {
          "component": "NotificationRules",
          "permission": "ckm_not:govern",
          "route": "/ckm-not/rules"
        },
        "settings": {
          "component": "NotificationSettings",
          "permission": "ckm_not:admin",
          "route": "/ckm-not/settings"
        },
        "templates": {
          "component": "TemplateStudio",
          "permission": "ckm_not:manage_templates",
          "route": "/ckm-not/templates"
        }
      },
      "streaming": {
        "batch_mutation_guardrail": "batch_notification_mutation_requires_bytewax",
        "events": [
          "notification_template_created",
          "notification_template_approved",
          "notification_campaign_requested",
          "notification_campaign_approved",
          "notification_delivery_requested",
          "notification_delivery_deferred",
          "notification_delivery_recorded",
          "notification_preference_updated",
          "notification_provider_registered",
          "notification_agent_registered"
        ],
        "processor": "bytewax",
        "state": [
          "templates",
          "campaigns",
          "deliveries",
          "preferences",
          "providers",
          "notification_agents",
          "audit_events"
        ],
        "topic": "apg.ckm_not.lifecycle"
      },
      "theme": {
        "components": {
          "audit": {
            "status_style": "decision-chip",
            "visual": "event-ledger"
          },
          "campaign_console": {
            "icon": "send",
            "risk_style": "audience-band",
            "status_indicator": "approval-pill"
          },
          "delivery_workbench": {
            "icon": "radio",
            "risk_style": "sla-band",
            "status_indicator": "delivery-chip"
          },
          "notification_agent_panel": {
            "icon": "bot",
            "status_indicator": "scope-chip"
          },
          "preference_center": {
            "icon": "sliders-horizontal",
            "status_indicator": "consent-chip"
          },
          "provider_registry": {
            "icon": "plug",
            "status_indicator": "secret-chip"
          },
          "stream_health": {
            "status_style": "stream-chip",
            "visual": "event-lane"
          },
          "template_studio": {
            "icon": "file-text",
            "risk_style": "content-band",
            "status_indicator": "approval-pill"
          }
        },
        "name": "ckm_not_notification_ops",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#2A9D8F",
          "color.danger": "#C53030",
          "color.primary": "#264653",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7F8FA",
          "surface.panel": "#FFFFFF",
          "text.primary": "#172033",
          "text.secondary": "#52606D"
        }
      },
      "ui": {
        "api_prefix": "/ckm-not/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "NotificationDashboard",
            "name": "dashboard",
            "nav_group": "Overview",
