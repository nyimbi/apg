{
  "agents": {},
  "app": {
    "description": "Notification System package-backed APG capability",
    "entity_count": 0,
    "name": "ckm_not",
    "version": "1.0.0"
  },
  "capabilities": {
    "ckm_not": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "adapters": {
          "api_helpers": "api.py",
          "audit_sink": "audl",
          "compliance": "comp",
          "configuration": "conf",
          "encryption": "encr",
          "event_stream": "bytewax",
          "generated_app_runtime": "lifecycle.NotificationLifecycleService",
          "monitoring": "moni",
          "scheduler": "schd",
          "view_models": "views.py"
        },
        "campaigns": {
          "approval_required_for_bulk": true,
          "audience_policy_required": true,
          "experiment_governance_supported": true,
          "send_window_required": true
        },
        "channels": {
          "delivery_fallback_required": true,
          "provider_registry_required": true,
          "provider_secret_reference_required": true,
          "supported": [
            "email",
            "sms",
            "push",
            "in_app",
            "voice",
            "webhook",
            "whatsapp",
            "slack",
            "teams",
            "web_push"
          ]
        },
        "delivery": {
          "preference_enforcement_required": true,
          "priority_escalation_supported": true,
          "quiet_hours_deferral_required": true,
          "recipient_consent_required": true,
          "tenant_context_required": true
        },
        "governance": {
          "audit_notification_events": true,
          "batch_event_stream": "bytewax",
          "consent_trace_required": true,
          "state_change_requires_audit": true
        },
        "notification_agents": {
          "agent_assist_enabled": true,
          "agent_contribution_disclosure_required": true,
          "agent_registration_required": true,
          "agent_runtime_required": true,
          "agent_scope_required": true,
          "allowed_roles": [
            "template_reviewer",
            "audience_reviewer",
            "delivery_reviewer",
            "compliance_reviewer",
            "escalation_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "observability": {
          "agent_activity_required": true,
          "audit_required": true,
          "delivery_metrics_required": true,
          "event_stream": "bytewax",
          "trace_required": true
        },
        "preferences": {
          "channel_opt_out_supported": true,
          "consent_evidence_required": true,
          "topic_opt_out_supported": true,
          "user_managed": true
        },
        "templates": {
          "approval_required": true,
          "channel_content_required": true,
          "locale_required": true,
          "variable_schema_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "ckm_not_notification_ops"
        },
        "ui": {
          "enable_agent_panel": true,
          "enable_analytics": true,
          "enable_audit": true,
          "enable_campaign_console": true,
          "enable_dashboard": true,
          "enable_delivery_workbench": true,
          "enable_preference_center": true,
          "enable_provider_registry": true,
          "enable_rules": true,
          "enable_template_studio": true
        }
      },
      "erp_modules": [
        "ckm"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Notification System",
      "provides": [
        "notification_delivery",
        "template_management",
        "campaign_orchestration",
        "preference_center",
        "channel_provider_registry",
        "engagement_analytics",
        "notification_agents"
      ],
      "requires": [
        "auth",
        "conf",
        "encr",
        "audl"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "Notification operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "channel_content_complete": false,
              "operation": "create_template"
            },
            "description": "Templates require content for every declared delivery channel.",
            "effect": {
              "decision": "deny",
              "reason": "channel_content_required",
              "required_action": "add_channel_content"
            },
            "name": "template_requires_channel_content"
          },
          {
            "condition": {
              "operation": "activate_template",
              "variable_schema_attached": false
            },
            "description": "Templates require variable schema evidence before activation.",
            "effect": {
              "decision": "deny",
              "reason": "template_variable_schema_required",
              "required_action": "attach_variable_schema"
            },
            "name": "template_requires_variable_schema"
          },
          {
            "condition": {
              "delivery_requested": true,
              "external_channel_requested": true,
              "recipient_consent_present": false
            },
            "description": "External notifications require recipient consent evidence.",
            "effect": {
              "decision": "deny",
              "reason": "recipient_consent_required",
              "required_action": "capture_recipient_consent"
            },
            "name": "external_delivery_requires_consent"
          },
          {
            "condition": {
              "channel_allowed_by_preference": false,
              "delivery_requested": true
            },
            "description": "Delivery channels must be allowed by recipient preferences.",
            "effect": {
              "decision": "deny",
              "reason": "notification_channel_not_allowed",
              "required_action": "honor_recipient_channel_preference"
            },
            "name": "delivery_channel_must_be_allowed"
          },
          {
            "condition": {
              "delivery_requested": true,
              "recipient_suppressed": true
            },
            "description": "Suppressed recipients cannot receive notifications.",
            "effect": {
              "decision": "deny",
              "reason": "recipient_suppressed",
              "required_action": "honor_recipient_preference"
            },
            "name": "suppressed_recipient_blocks_delivery"
          },
          {
            "condition": {
              "deferral_scheduled": false,
              "delivery_requested": true,
              "urgent_override_present": false,
              "within_quiet_hours": true
            },
            "description": "Quiet-hour notifications require deferral unless a permitted urgent override is present.",
            "effect": {
              "decision": "require_review",
              "reason": "quiet_hours_deferral_required",
              "required_action": "schedule_delivery_deferral"
            },
            "name": "quiet_hours_requires_deferral"
          },
          {
            "condition": {
              "audience_policy_attached": false,
              "campaign_operation": true
            },
            "description": "Campaign sends require an audience policy.",
            "effect": {
              "decision": "deny",
              "reason": "audience_policy_required",
              "required_action": "attach_audience_policy"
            },
            "name": "campaign_requires_audience_policy"
          },
          {
            "condition": {
              "approval_recorded": false,
              "campaign_operation": true,
              "recipient_count_gt": 500
            },
            "description": "Bulk campaigns require approval before execution.",
            "effect": {
              "decision": "require_review",
              "reason": "bulk_campaign_approval_required",
              "required_action": "record_campaign_approval"
            },
            "name": "bulk_campaign_requires_approval"
          },
          {
            "condition": {
              "operation": "register_provider",
              "provider_secret_ref_present": false
            },
            "description": "Provider credentials must be referenced through managed secrets.",
            "effect": {
              "decision": "deny",
              "reason": "provider_secret_reference_required",
              "required_action": "store_provider_secret_reference"
            },
            "name": "provider_credentials_require_secret_reference"
          },
          {
            "condition": {
              "agent_registered": false,
              "notification_agent_present": true
            },
            "description": "AI notification agents must be registered.",
            "effect": {
              "decision": "deny",
              "reason": "notification_agent_registration_required",
              "required_action": "register_notification_agent"
            },
            "name": "notification_agent_requires_registration"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "notification_agent_present": true
            },
            "description": "AI notification agents must use a supported runtime.",
            "effect": {
              "decision": "deny",
              "reason": "notification_agent_runtime_not_supported",
              "required_action": "choose_supported_notification_agent_runtime"
            },
            "name": "notification_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "notification_agent_present": true
            },
            "description": "AI notification agents must use a supported role.",
            "effect": {
              "decision": "deny",
              "reason": "notification_agent_role_not_supported",
              "required_action": "choose_supported_notification_agent_role"
            },
            "name": "notification_agent_role_supported"
          },
          {
            "condition": {
              "agent_scope_present": false,
              "notification_agent_present": true
            },
            "description": "AI notification agents require explicit scope.",
            "effect": {
              "decision": "deny",
              "reason": "notification_agent_scope_required",
              "required_action": "set_notification_agent_scope"
            },
            "name": "notification_agent_requires_scope"
          },
          {
            "condition": {
              "agent_contribution_disclosed": false,
              "notification_agent_present": true
            },
            "description": "AI notification-agent contributions require disclosure.",
            "effect": {
              "decision": "deny",
              "reason": "notification_agent_disclosure_required",
              "required_action": "disclose_notification_agent"
            },
            "name": "notification_agent_requires_disclosure"
          },
          {
            "condition": {
              "audit_event_recorded": false,
              "state_change_requested": true
            },
            "description": "Notification lifecycle state changes require audit evidence.",
            "effect": {
              "decision": "deny",
              "reason": "notification_audit_event_required",
              "required_action": "record_notification_audit_event"
            },
            "name": "notification_state_change_requires_audit"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "requested_operation": "batch_notification_mutation"
            },
            "description": "Batch notification mutations must use Bytewax event streams.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "use_bytewax_event_stream"
            },
            "name": "batch_notification_mutation_requires_bytewax"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
        {
          "condition": {
            "tenant_context_present": false
          },
          "description": "Notification operations require tenant context.",
          "effect": {
            "decision": "deny",
