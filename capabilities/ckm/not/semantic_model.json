            "path": "/ckm-not/campaigns",
            "permission": "ckm_not:manage_campaigns"
          },
          {
            "component": "DeliveryWorkbench",
            "name": "deliveries",
            "nav_group": "Operations",
            "path": "/ckm-not/deliveries",
            "permission": "ckm_not:send"
          },
          {
            "component": "PreferenceCenter",
            "name": "preferences",
            "nav_group": "Governance",
            "path": "/ckm-not/preferences",
            "permission": "ckm_not:view_preferences"
          },
          {
            "component": "ProviderRegistry",
            "name": "providers",
            "nav_group": "Administration",
            "path": "/ckm-not/providers",
            "permission": "ckm_not:admin"
          },
          {
            "component": "NotificationAgentPanel",
            "name": "agents",
            "nav_group": "Governance",
            "path": "/ckm-not/agents",
            "permission": "ckm_not:govern"
          },
          {
            "component": "NotificationRules",
            "name": "rules",
            "nav_group": "Governance",
            "path": "/ckm-not/rules",
            "permission": "ckm_not:govern"
          },
          {
            "component": "NotificationAnalytics",
            "name": "analytics",
            "nav_group": "Insights",
            "path": "/ckm-not/analytics",
            "permission": "ckm_not:view"
          },
          {
            "component": "NotificationAudit",
            "name": "audit",
            "nav_group": "Governance",
            "path": "/ckm-not/audit",
            "permission": "ckm_not:view"
          },
          {
            "component": "NotificationSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/ckm-not/settings",
            "permission": "ckm_not:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
      }
    }
