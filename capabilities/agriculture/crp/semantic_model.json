  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/agr-crp/crops",
      "description": "List Crop records"
    },
    {
      "method": "POST",
      "path": "/api/agr-crp/crops",
      "description": "Create Crop"
    },
    {
      "method": "GET",
      "path": "/api/agr-crp/crops/{id}",
      "description": "Get Crop by ID"
    },
    {
      "method": "PUT",
      "path": "/api/agr-crp/crops/{id}",
      "description": "Update Crop"
    },
    {
      "method": "DELETE",
      "path": "/api/agr-crp/crops/{id}",
      "description": "Delete Crop"
    }
  ],
  "events": {
    "publishes": [
      "crop.planted",
      "crop.harvested",
      "yield.recorded"
    ],
    "subscribes": []
  }
}