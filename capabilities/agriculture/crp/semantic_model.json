        "id",
        "tenant_id"
      ]
    },
    "CropVariety": {
      "type": "object",
      "description": "CropVariety entity for Crop Management",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
