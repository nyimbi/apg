{
  "capability_id": "agr_crp",
  "capability_name": "Crop Management",
  "version": "1.0.0",
  "domain": "agriculture",
  "entities": {
    "Crop": {
      "type": "object",
      "description": "Crop entity for Crop Management",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "PlantingRecord": {
      "type": "object",
      "description": "PlantingRecord entity for Crop Management",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "YieldRecord": {
      "type": "object",
      "description": "YieldRecord entity for Crop Management",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
