  "rules": {
    "activation_requires_validation": {
      "condition": {
        "operation": "activate_configuration",
        "validation_evidence_present": false
      },
      "description": "Configurations require validation evidence before activation.",
      "effect": {
        "decision": "deny",
        "reason": "configuration_validation_required",
        "required_action": "attach_validation_evidence"
      },
      "name": "activation_requires_validation"
    },
    "batch_change_requires_bytewax": {
      "condition": {
        "event_stream_ne": "bytewax",
        "operation": "batch_configuration_change"
      },
      "description": "Batch configuration changes require Bytewax coordination.",
      "effect": {
        "decision": "deny",
        "reason": "bytewax_event_stream_required",
        "required_action": "route_batch_config_change_to_bytewax"
      },
      "name": "batch_change_requires_bytewax"
    },
    "config_agent_role_supported": {
      "condition": {
        "agent_role_supported": false,
        "operation": "register_config_agent"
      },
      "description": "Configuration agents must use an approved role.",
      "effect": {
        "decision": "deny",
        "reason": "config_agent_role_not_supported",
        "required_action": "select_supported_agent_role"
      },
      "name": "config_agent_role_supported"
    },
    "config_agent_runtime_supported": {
      "condition": {
        "agent_runtime_supported": false,
        "operation": "register_config_agent"
      },
      "description": "Configuration agents must use an approved runtime.",
      "effect": {
        "decision": "deny",
        "reason": "config_agent_runtime_not_supported",
        "required_action": "select_supported_agent_runtime"
      },
      "name": "config_agent_runtime_supported"
    },
    "configuration_requires_policy": {
      "condition": {
        "operation_type": "write",
        "policy_attached": false
      },
      "description": "Configuration writes require policy attachment.",
      "effect": {
        "decision": "deny",
        "reason": "operation_policy_required",
        "required_action": "attach_operation_policy"
      },
      "name": "configuration_requires_policy"
    },
    "deployment_requires_bytewax_stream": {
      "condition": {
        "event_stream_ne": "bytewax",
        "operation": "deploy_configuration"
      },
      "description": "Configuration deployment events must be emitted through Bytewax.",
      "effect": {
        "decision": "deny",
        "reason": "bytewax_event_stream_required",
        "required_action": "route_config_deployment_to_bytewax"
      },
      "name": "deployment_requires_bytewax_stream"
    },
    "high_impact_deployment_requires_canary": {
      "condition": {
        "canary_evidence_present": false,
        "impact_level": "high",
        "operation": "deploy_configuration"
      },
      "description": "High-impact configuration deployments require canary evidence.",
      "effect": {
        "decision": "require_review",
        "reason": "canary_evidence_required",
        "required_action": "attach_canary_evidence"
      },
      "name": "high_impact_deployment_requires_canary"
    },
    "namespace_requires_environment": {
      "condition": {
        "environment_present": false,
        "operation": "register_namespace"
      },
      "description": "Configuration namespaces require an environment.",
      "effect": {
        "decision": "deny",
        "reason": "namespace_environment_required",
        "required_action": "select_environment"
      },
      "name": "namespace_requires_environment"
    },
    "namespace_requires_owner": {
      "condition": {
        "namespace_owner_assigned": false,
        "operation": "register_namespace"
      },
      "description": "Configuration namespaces require an accountable owner.",
      "effect": {
        "decision": "deny",
        "reason": "namespace_owner_required",
        "required_action": "assign_namespace_owner"
      },
      "name": "namespace_requires_owner"
    },
    "privileged_agent_config_action_requires_human_approval": {
      "condition": {
        "human_approval_recorded": false,
        "operation": "agent_config_action",
        "privileged_scope": true
      },
      "description": "Privileged configuration actions proposed by agents require human approval.",
      "effect": {
        "decision": "deny",
        "reason": "human_approval_required",
        "required_action": "record_human_approval"
      },
      "name": "privileged_agent_config_action_requires_human_approval"
    },
    "production_deployment_requires_approval": {
      "condition": {
        "approval_recorded": false,
        "environment": "production",
        "operation": "deploy_configuration"
      },
      "description": "Production deployments require approval.",
      "effect": {
        "decision": "deny",
        "reason": "production_deployment_approval_required",
        "required_action": "record_deployment_approval"
      },
      "name": "production_deployment_requires_approval"
    },
    "restricted_configuration_requires_schema": {
