      },
      "name": "rollback_requires_bytewax_stream"
    },
    "rollback_requires_reason": {
      "condition": {
        "operation": "rollback_configuration",
        "rollback_reason_present": false
      },
      "description": "Configuration rollback requires a reason.",
      "effect": {
        "decision": "deny",
        "reason": "rollback_reason_required",
        "required_action": "attach_rollback_reason"
