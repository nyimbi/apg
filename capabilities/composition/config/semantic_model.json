        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "ConfigAgentWorkbench",
          "permission": "composition_config:admin",
          "route": "/composition-config/agents"
        },
        "configurations": {
          "component": "ConfigEditor",
          "permission": "composition_config:edit",
          "route": "/composition-config/configurations"
        },
        "dashboard": {
          "component": "ConfigDashboard",
          "permission": "composition_config:view",
          "route": "/composition-config/dashboard"
        },
        "drift": {
          "component": "ConfigDriftMonitor",
          "permission": "composition_config:operate",
          "route": "/composition-config/drift"
        },
        "namespaces": {
