          "permission": "composition_config:admin",
          "route": "/composition-config/namespaces"
        },
        "releases": {
          "component": "ConfigReleaseBoard",
          "permission": "composition_config:release",
          "route": "/composition-config/releases"
        },
        "settings": {
          "component": "ConfigSettings",
          "permission": "composition_config:admin",
          "route": "/composition-config/settings"
        },
        "templates": {
          "component": "ConfigTemplateLibrary",
          "permission": "composition_config:edit",
          "route": "/composition-config/templates"
        }
      },
      "streaming": {
        "events": [
          "namespace_registered",
          "configuration_created",
          "configuration_validated",
          "configuration_activated",
          "configuration_deployed",
          "configuration_rolled_back",
          "template_created",
          "drift_detected",
          "config_agent_registered"
        ],
        "guardrails": [
          "deployment_requires_bytewax_stream",
          "rollback_requires_bytewax_stream",
          "batch_change_requires_bytewax",
          "privileged_agent_config_action_requires_human_approval"
        ],
        "key": "tenant_id",
        "processor": "bytewax",
        "states": [
          "draft",
          "validated",
          "active",
          "release_pending",
          "deployed",
          "rolled_back",
          "drifted",
          "blocked"
        ],
        "stream": "apg.composition.config.lifecycle"
      },
      "theme": {
        "components": {
          "agent_workbench": {
            "status_style": "approval-chip",
