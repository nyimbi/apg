{
  "agents": {},
  "app": {
    "description": "Central configuration package-backed APG capability",
    "entity_count": 6,
    "name": "composition_config",
    "version": "2.1.0"
  },
  "capabilities": {
    "composition_config": {
      "configuration": {
        "adapters": {
          "audit": "adapter",
          "authorization": "adapter",
          "event_stream": "bytewax",
          "notification": "adapter",
          "secrets": "adapter",
          "theme": "adapter"
        },
        "config_agents": {
          "enabled": true,
          "human_approval_required": true,
          "max_autonomous_scope": "recommend_and_validate",
          "supported_roles": [
            "config_architect",
            "schema_reviewer",
            "release_reviewer",
            "drift_reviewer",
            "security_reviewer",
            "rollback_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "configurations": {
          "drift_detection_enabled": true,
          "schema_required_for_restricted": true,
          "secret_reference_required": true,
          "validation_required_before_activation": true,
          "versioning_enabled": true
        },
        "deployments": {
          "approval_required_for_production": true,
          "canary_required_for_high_impact": true,
          "deployment_stream_required": true,
          "rollback_supported": true
        },
        "governance": {
          "audit_state_changes": true,
          "policy_attached_for_writes": true,
          "redact_secret_values": true,
          "require_tenant_context": true
        },
        "namespaces": {
          "capability_boundary_required": true,
          "environment_required": true,
          "owner_required": true,
          "path_prefix_required": true
        },
        "observability": {
          "emit_config_events": true,
          "emit_deployment_events": true,
          "emit_drift_events": true,
          "emit_namespace_events": true,
          "event_stream": "apg.composition.config.lifecycle",
          "stream_processor": "bytewax"
        },
        "templates": {
          "owner_required": true,
          "review_required_for_shared": true,
          "variable_schema_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "composition_config_control"
        },
        "ui": {
          "enable_agent_workbench": true,
          "enable_config_editor": true,
          "enable_dashboard": true,
          "enable_drift_monitor": true,
          "enable_namespace_console": true,
          "enable_release_board": true,
          "enable_settings": true,
          "enable_template_library": true
        }
      },
      "name": "Central Configuration Management",
      "provides": [
        "configuration_namespace_registry",
        "configuration_value_lifecycle",
        "configuration_schema_validation",
        "configuration_release_workflows",
        "configuration_template_library",
        "configuration_drift_monitoring",
        "config_agents"
      ],
      "requires": [
        "auth",
        "audl",
        "ntfy",
        "registry",
        "composition_access"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All central-configuration operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "namespace_owner_assigned": false,
              "operation": "register_namespace"
            },
            "description": "Configuration namespaces require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "namespace_owner_required",
              "required_action": "assign_namespace_owner"
            },
            "name": "namespace_requires_owner"
          },
          {
            "condition": {
              "environment_present": false,
              "operation": "register_namespace"
            },
            "description": "Configuration namespaces require an environment.",
            "effect": {
              "decision": "deny",
              "reason": "namespace_environment_required",
              "required_action": "select_environment"
            },
            "name": "namespace_requires_environment"
          },
          {
            "condition": {
              "operation_type": "write",
              "policy_attached": false
            },
            "description": "Configuration writes require policy attachment.",
            "effect": {
              "decision": "deny",
              "reason": "operation_policy_required",
              "required_action": "attach_operation_policy"
            },
            "name": "configuration_requires_policy"
          },
          {
            "condition": {
              "operation": "create_configuration",
              "restricted_config": true,
              "schema_present": false
            },
            "description": "Restricted configuration values require a schema.",
            "effect": {
              "decision": "deny",
              "reason": "configuration_schema_required",
              "required_action": "attach_configuration_schema"
            },
            "name": "restricted_configuration_requires_schema"
          },
          {
            "condition": {
              "operation": "create_configuration",
              "secret_config": true,
              "secret_reference_present": false
            },
            "description": "Secret configuration values must use a secret reference.",
            "effect": {
              "decision": "deny",
              "reason": "secret_reference_required",
              "required_action": "attach_secret_reference"
            },
            "name": "secret_configuration_requires_reference"
          },
          {
            "condition": {
              "operation": "activate_configuration",
              "validation_evidence_present": false
            },
            "description": "Configurations require validation evidence before activation.",
            "effect": {
              "decision": "deny",
              "reason": "configuration_validation_required",
              "required_action": "attach_validation_evidence"
            },
            "name": "activation_requires_validation"
          },
          {
            "condition": {
              "approval_recorded": false,
              "environment": "production",
              "operation": "deploy_configuration"
            },
            "description": "Production deployments require approval.",
            "effect": {
              "decision": "deny",
              "reason": "production_deployment_approval_required",
              "required_action": "record_deployment_approval"
            },
            "name": "production_deployment_requires_approval"
          },
          {
            "condition": {
              "canary_evidence_present": false,
              "impact_level": "high",
              "operation": "deploy_configuration"
            },
            "description": "High-impact configuration deployments require canary evidence.",
            "effect": {
              "decision": "require_review",
              "reason": "canary_evidence_required",
              "required_action": "attach_canary_evidence"
            },
            "name": "high_impact_deployment_requires_canary"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "deploy_configuration"
            },
            "description": "Configuration deployment events must be emitted through Bytewax.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_config_deployment_to_bytewax"
            },
            "name": "deployment_requires_bytewax_stream"
          },
          {
            "condition": {
              "operation": "rollback_configuration",
              "rollback_reason_present": false
            },
            "description": "Configuration rollback requires a reason.",
            "effect": {
              "decision": "deny",
              "reason": "rollback_reason_required",
              "required_action": "attach_rollback_reason"
            },
            "name": "rollback_requires_reason"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "rollback_configuration"
            },
            "description": "Configuration rollback events must be emitted through Bytewax.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_config_rollback_to_bytewax"
            },
            "name": "rollback_requires_bytewax_stream"
          },
          {
            "condition": {
              "operation": "create_template",
              "review_recorded": false,
              "shared_template": true
            },
            "description": "Shared templates require review.",
            "effect": {
              "decision": "require_review",
              "reason": "shared_template_review_required",
              "required_action": "record_template_review"
            },
            "name": "shared_template_requires_review"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "batch_configuration_change"
            },
            "description": "Batch configuration changes require Bytewax coordination.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_batch_config_change_to_bytewax"
            },
            "name": "batch_change_requires_bytewax"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "operation": "register_config_agent"
            },
            "description": "Configuration agents must use an approved runtime.",
            "effect": {
              "decision": "deny",
              "reason": "config_agent_runtime_not_supported",
              "required_action": "select_supported_agent_runtime"
            },
            "name": "config_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "operation": "register_config_agent"
            },
            "description": "Configuration agents must use an approved role.",
            "effect": {
              "decision": "deny",
              "reason": "config_agent_role_not_supported",
              "required_action": "select_supported_agent_role"
            },
            "name": "config_agent_role_supported"
          },
          {
            "condition": {
              "human_approval_recorded": false,
              "operation": "agent_config_action",
              "privileged_scope": true
            },
            "description": "Privileged configuration actions proposed by agents require human approval.",
            "effect": {
              "decision": "deny",
              "reason": "human_approval_required",
              "required_action": "record_human_approval"
            },
            "name": "privileged_agent_config_action_requires_human_approval"
          }
        ],
        "type": "deterministic"
      },
