{
  "agents": {},
  "app": {
    "description": "Capability registry package-backed APG capability",
    "entity_count": 7,
    "name": "composition_registry",
    "version": "2.1.0"
  },
  "capabilities": {
    "composition_registry": {
      "configuration": {
        "adapters": {
          "audit": "adapter",
          "authorization": "adapter",
          "event_stream": "bytewax",
          "notification": "adapter",
          "search_index": "adapter",
          "theme": "adapter"
        },
        "catalog": {
          "category_required": true,
          "contract_required": true,
          "owner_required": true,
          "provides_required": true,
          "version_required": true
        },
        "composition_blueprints": {
          "capability_required": true,
          "owner_required": true,
          "publish_validation_required": true,
          "validation_required": true
        },
        "dependencies": {
          "cycle_detection_enabled": true,
          "dependency_type_required": true,
          "target_required": true,
          "version_constraint_required": true
        },
        "governance": {
          "audit_state_changes": true,
          "policy_attached_for_writes": true,
          "privileged_registry_changes_reviewed": true,
          "require_tenant_context": true
        },
        "marketplace": {
          "documentation_required": true,
          "publication_review_required": true,
          "security_review_required": true
        },
        "observability": {
          "emit_agent_events": true,
          "emit_catalog_events": true,
          "emit_composition_events": true,
          "emit_dependency_events": true,
          "event_stream": "apg.composition.registry.lifecycle",
          "stream_processor": "bytewax"
        },
        "registry_agents": {
          "enabled": true,
          "human_approval_required": true,
          "max_autonomous_scope": "recommend_validate_and_prepare",
          "supported_roles": [
            "capability_curator",
            "dependency_reviewer",
            "composition_reviewer",
            "version_reviewer",
            "marketplace_reviewer",
            "security_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "composition_registry_control"
        },
        "ui": {
          "enable_agents": true,
          "enable_catalog": true,
          "enable_compositions": true,
          "enable_dashboard": true,
          "enable_dependencies": true,
          "enable_marketplace": true,
          "enable_rules": true,
          "enable_settings": true,
          "enable_versions": true
        },
        "versions": {
          "compatibility_evidence_required": true,
          "migration_plan_required_for_deprecation": true,
          "release_review_required": true
        }
      },
      "name": "Capability Registry",
      "provides": [
        "capability_catalog_lifecycle",
        "dependency_graph_management",
        "composition_blueprint_validation",
        "version_compatibility_governance",
        "marketplace_publication_governance",
        "registry_discovery",
        "registry_agents"
      ],
      "requires": [
        "auth",
        "audl",
        "ntfy",
        "composition_events",
        "composition_config",
        "composition_access"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "Registry operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation_type": "write",
              "policy_attached": false
            },
            "description": "Registry write operations require policy attachment.",
            "effect": {
              "decision": "deny",
              "reason": "operation_policy_required",
              "required_action": "attach_operation_policy"
            },
            "name": "registry_write_requires_policy"
          },
          {
            "condition": {
              "capability_owner_assigned": false,
              "operation": "register_capability"
            },
            "description": "Registered capabilities require an owner.",
            "effect": {
              "decision": "deny",
              "reason": "capability_owner_required",
              "required_action": "assign_capability_owner"
            },
            "name": "capability_requires_owner"
          },
          {
            "condition": {
              "capability_category_present": false,
              "operation": "register_capability"
            },
            "description": "Registered capabilities require a category.",
            "effect": {
              "decision": "deny",
              "reason": "capability_category_required",
              "required_action": "set_capability_category"
            },
            "name": "capability_requires_category"
          },
          {
            "condition": {
              "capability_version_present": false,
              "operation": "register_capability"
            },
            "description": "Registered capabilities require a version.",
            "effect": {
              "decision": "deny",
              "reason": "capability_version_required",
              "required_action": "set_capability_version"
            },
            "name": "capability_requires_version"
          },
          {
            "condition": {
              "capability_provides_present": false,
              "operation": "register_capability"
            },
            "description": "Registered capabilities require at least one provided surface.",
            "effect": {
              "decision": "deny",
              "reason": "capability_provides_required",
              "required_action": "declare_provided_surfaces"
            },
            "name": "capability_requires_provides"
          },
          {
            "condition": {
              "capability_contract_present": false,
              "operation": "register_capability"
            },
            "description": "Registered capabilities require an executable contract reference.",
            "effect": {
              "decision": "deny",
              "reason": "capability_contract_required",
              "required_action": "attach_capability_contract"
            },
            "name": "capability_requires_contract"
          },
          {
            "condition": {
              "dependency_target_present": false,
              "operation": "add_dependency"
            },
            "description": "Dependencies require a target capability.",
            "effect": {
              "decision": "deny",
              "reason": "dependency_target_required",
              "required_action": "attach_dependency_target"
            },
            "name": "dependency_requires_target"
          },
          {
            "condition": {
              "dependency_type_present": false,
              "operation": "add_dependency"
            },
            "description": "Dependencies require a dependency type.",
            "effect": {
              "decision": "deny",
              "reason": "dependency_type_required",
