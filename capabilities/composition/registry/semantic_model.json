          "component": "RegistryAgentWorkbench",
          "permission": "composition_registry:admin",
          "route": "/composition-registry/agents"
        },
        "catalog": {
          "component": "CapabilityCatalog",
          "permission": "composition_registry:manage_catalog",
          "route": "/composition-registry/catalog"
        },
        "compositions": {
          "component": "CompositionBlueprints",
          "permission": "composition_registry:compose",
          "route": "/composition-registry/compositions"
        },
        "dashboard": {
          "component": "RegistryDashboard",
          "permission": "composition_registry:view",
          "route": "/composition-registry/dashboard"
        },
        "dependencies": {
          "component": "DependencyGraph",
          "permission": "composition_registry:manage_dependencies",
          "route": "/composition-registry/dependencies"
        },
        "marketplace": {
          "component": "MarketplacePublication",
          "permission": "composition_registry:publish",
          "route": "/composition-registry/marketplace"
        },
        "rules": {
          "component": "RegistryRuleCenter",
          "permission": "composition_registry:govern",
          "route": "/composition-registry/rules"
        },
        "settings": {
          "component": "RegistrySettings",
          "permission": "composition_registry:admin",
          "route": "/composition-registry/settings"
        },
        "versions": {
          "component": "VersionGovernance",
          "permission": "composition_registry:release",
          "route": "/composition-registry/versions"
        }
