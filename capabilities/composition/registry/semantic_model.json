      "streaming": {
        "events": [
          "capability_registered",
          "dependency_added",
          "composition_created",
          "composition_validated",
          "version_released",
          "capability_deprecated",
          "marketplace_publication_prepared",
          "registry_agent_registered"
        ],
        "guardrails": [
          "registry_import_requires_bytewax",
          "registry_event_requires_bytewax",
          "privileged_agent_registry_action_requires_human_approval"
        ],
        "key": "tenant_id",
        "processor": "bytewax",
        "states": [
          "draft",
          "registered",
          "validated",
          "released",
          "published",
          "deprecated",
          "retired"
        ],
        "stream": "apg.composition.registry.lifecycle"
      },
      "theme": {
        "components": {
          "agent_workbench": {
            "status_style": "approval-chip",
            "visual": "review-lane"
          },
          "catalog": {
            "icon": "blocks",
            "risk_style": "quality-band",
            "status_indicator": "capability-pill"
          },
          "compositions": {
            "status_style": "validation-chip",
            "visual": "composition-board"
          },
          "dependencies": {
            "status_style": "edge-chip",
            "visual": "dependency-graph"
          },
          "marketplace": {
            "status_style": "review-chip",
            "visual": "publication-list"
          },
          "rule_center": {
            "status_style": "guardrail-chip",
            "visual": "rule-grid"
          },
          "versions": {
            "status_style": "compatibility-chip",
            "visual": "version-lanes"
          }
        },
        "name": "composition_registry_control",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#C44536",
          "color.danger": "#C53030",
