            "effect": {
              "decision": "require_review",
              "reason": "marketplace_review_required",
              "required_action": "record_marketplace_review"
            },
            "name": "marketplace_publish_requires_review"
          },
          {
            "condition": {
              "documentation_present": false,
              "operation": "publish_marketplace"
