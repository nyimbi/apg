            "description": "Marketplace publication requires documentation.",
            "effect": {
              "decision": "deny",
              "reason": "marketplace_documentation_required",
              "required_action": "attach_marketplace_documentation"
            },
            "name": "marketplace_publish_requires_documentation"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "registry_import"
            },
            "description": "Registry import batches require Bytewax coordination.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_registry_import_to_bytewax"
            },
            "name": "registry_import_requires_bytewax"
          },
          {
