            },
            "name": "registry_event_requires_bytewax"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "operation": "register_registry_agent"
            },
            "description": "Registry agents must use an approved runtime.",
            "effect": {
              "decision": "deny",
              "reason": "registry_agent_runtime_not_supported",
              "required_action": "select_supported_agent_runtime"
            },
            "name": "registry_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
