      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "GatewayAgentWorkbench",
          "permission": "composition_gateway:admin",
          "route": "/composition-gateway/agents"
        },
        "certificates": {
          "component": "GatewayCertificateConsole",
          "permission": "composition_gateway:admin",
          "route": "/composition-gateway/certificates"
        },
        "dashboard": {
          "component": "GatewayDashboard",
          "permission": "composition_gateway:view",
          "route": "/composition-gateway/dashboard"
        },
        "policies": {
          "component": "GatewayPolicyCenter",
          "permission": "composition_gateway:govern",
          "route": "/composition-gateway/policies"
        },
        "routes": {
          "component": "GatewayRouteConsole",
          "permission": "composition_gateway:manage_routes",
          "route": "/composition-gateway/routes"
        },
        "services": {
          "component": "GatewayServiceRegistry",
          "permission": "composition_gateway:manage_services",
          "route": "/composition-gateway/services"
        },
        "settings": {
          "component": "GatewaySettings",
          "permission": "composition_gateway:admin",
          "route": "/composition-gateway/settings"
        },
        "traffic": {
          "component": "GatewayTrafficConsole",
          "permission": "composition_gateway:operate",
          "route": "/composition-gateway/traffic"
        }
      },
      "streaming": {
        "events": [
          "service_registered",
          "route_created",
          "policy_attached",
          "traffic_shifted",
          "certificate_registered",
          "health_recorded",
          "gateway_agent_registered"
        ],
        "guardrails": [
          "route_requires_bytewax_stream",
          "traffic_shift_requires_bytewax_stream",
          "batch_route_change_requires_bytewax",
          "privileged_agent_gateway_action_requires_human_approval"
        ],
        "key": "tenant_id",
        "processor": "bytewax",
        "states": [
          "draft",
          "active",
          "healthy",
          "degraded",
          "canary",
          "blocked",
          "retired"
        ],
        "stream": "apg.composition.gateway.lifecycle"
      },
      "theme": {
        "components": {
          "agent_workbench": {
            "status_style": "approval-chip",
            "visual": "review-lane"
          },
          "certificate_console": {
            "status_style": "expiry-chip",
            "visual": "certificate-list"
          },
          "policy_center": {
            "status_style": "guardrail-chip",
            "visual": "policy-grid"
          },
          "route_console": {
            "status_style": "route-chip",
            "visual": "route-table"
          },
          "service_registry": {
            "icon": "server",
            "risk_style": "health-band",
            "status_indicator": "service-pill"
          },
          "traffic_console": {
            "status_style": "canary-chip",
            "visual": "traffic-lanes"
          }
        },
        "name": "composition_gateway_control",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#C44536",
          "color.danger": "#C53030",
          "color.primary": "#28536B",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7F8FA",
          "surface.panel": "#FFFFFF",
          "text.primary": "#172033",
          "text.secondary": "#52606D"
        }
      },
      "ui": {
        "api_prefix": "/composition-gateway/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "GatewayDashboard",
            "name": "dashboard",
            "nav_group": "Overview",
            "path": "/composition-gateway/dashboard",
            "permission": "composition_gateway:view"
          },
          {
            "component": "GatewayServiceRegistry",
            "name": "services",
            "nav_group": "Services",
            "path": "/composition-gateway/services",
            "permission": "composition_gateway:manage_services"
