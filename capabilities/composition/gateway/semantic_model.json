          "audit": "adapter",
          "authorization": "adapter",
          "event_stream": "bytewax",
          "notification": "adapter",
          "secrets": "adapter",
          "theme": "adapter"
        },
        "gateway_agents": {
          "enabled": true,
          "human_approval_required": true,
          "max_autonomous_scope": "recommend_and_validate",
          "supported_roles": [
            "mesh_architect",
            "route_reviewer",
            "policy_reviewer",
            "traffic_reviewer",
            "certificate_reviewer",
            "incident_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "governance": {
          "audit_state_changes": true,
          "policy_attached_for_writes": true,
          "privileged_route_changes_reviewed": true,
          "require_tenant_context": true
        },
        "observability": {
          "emit_policy_events": true,
          "emit_route_events": true,
          "emit_service_events": true,
          "emit_traffic_events": true,
          "event_stream": "apg.composition.gateway.lifecycle",
          "stream_processor": "bytewax"
        },
        "routes": {
          "approval_required_for_public": true,
          "match_rule_required": true,
          "policy_required_for_public": true,
          "service_required": true
        },
        "security": {
          "certificate_owner_required": true,
          "m_tls_supported": true,
          "secret_reference_required": true,
          "tls_required_for_public": true
        },
        "services": {
          "capability_binding_required": true,
          "endpoint_required": true,
          "health_check_required": true,
          "owner_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "composition_gateway_control"
        },
        "traffic": {
          "canary_evidence_required": true,
          "canary_supported": true,
          "circuit_breaker_required": true,
          "rate_limit_required_for_public": true
        },
        "ui": {
          "enable_agent_workbench": true,
          "enable_certificate_console": true,
          "enable_dashboard": true,
          "enable_policy_center": true,
          "enable_route_console": true,
          "enable_service_registry": true,
          "enable_settings": true,
          "enable_traffic_console": true
        }
      },
      "id": "composition_gateway",
      "provides": [
        "service_mesh_registry",
        "gateway_route_lifecycle",
        "traffic_management",
        "gateway_policy_enforcement",
        "certificate_lifecycle",
        "mesh_health_observability",
        "gateway_agents"
      ],
      "requires": [
        "auth",
        "audl",
        "ntfy",
        "registry",
        "composition_access",
        "composition_events"
      ]
    }
  },
  "deployment": {
    "source": "capability_contract.py",
    "target": "python"
  },
  "diagnostics": [],
  "flows": {},
  "format": "apg.semantic-model.v1",
  "graphs": {
    "capability": {
      "edges": 6,
      "kind": "capability",
      "nodes": 1
    }
  },
  "ok": true,
  "packages": {
    "composition_gateway": {
      "entrypoint": "app.py",
      "profile": "capability"
    }
  },
  "rules": {
    "batch_route_change_requires_bytewax": {
      "condition": {
        "event_stream_ne": "bytewax",
        "operation": "batch_route_change"
      },
      "description": "Batch route changes require Bytewax coordination.",
      "effect": {
        "decision": "deny",
        "reason": "bytewax_event_stream_required",
        "required_action": "route_batch_gateway_changes_to_bytewax"
      },
      "name": "batch_route_change_requires_bytewax"
    },
    "certificate_requires_owner": {
      "condition": {
        "certificate_owner_assigned": false,
        "operation": "register_certificate"
      },
      "description": "Certificates require an owner.",
      "effect": {
        "decision": "deny",
        "reason": "certificate_owner_required",
        "required_action": "assign_certificate_owner"
      },
      "name": "certificate_requires_owner"
    },
    "certificate_requires_secret_reference": {
      "condition": {
        "operation": "register_certificate",
        "secret_reference_present": false
      },
      "description": "Certificates require a secret reference.",
      "effect": {
        "decision": "deny",
        "reason": "certificate_secret_reference_required",
        "required_action": "attach_secret_reference"
      },
      "name": "certificate_requires_secret_reference"
    },
    "gateway_agent_role_supported": {
      "condition": {
        "agent_role_supported": false,
        "operation": "register_gateway_agent"
      },
      "description": "Gateway agents must use an approved role.",
      "effect": {
        "decision": "deny",
        "reason": "gateway_agent_role_not_supported",
        "required_action": "select_supported_agent_role"
      },
      "name": "gateway_agent_role_supported"
    },
    "gateway_agent_runtime_supported": {
      "condition": {
        "agent_runtime_supported": false,
        "operation": "register_gateway_agent"
      },
      "description": "Gateway agents must use an approved runtime.",
      "effect": {
        "decision": "deny",
        "reason": "gateway_agent_runtime_not_supported",
        "required_action": "select_supported_agent_runtime"
      },
      "name": "gateway_agent_runtime_supported"
    },
    "gateway_write_requires_policy": {
      "condition": {
        "operation_type": "write",
        "policy_attached": false
      },
      "description": "Gateway write operations require policy attachment.",
      "effect": {
        "decision": "deny",
        "reason": "operation_policy_required",
        "required_action": "attach_operation_policy"
      },
      "name": "gateway_write_requires_policy"
    },
    "privileged_agent_gateway_action_requires_human_approval": {
      "condition": {
        "human_approval_recorded": false,
        "operation": "agent_gateway_action",
        "privileged_scope": true
      },
      "description": "Privileged gateway actions proposed by agents require human approval.",
      "effect": {
        "decision": "deny",
        "reason": "human_approval_required",
        "required_action": "record_human_approval"
      },
      "name": "privileged_agent_gateway_action_requires_human_approval"
    },
    "public_route_requires_approval": {
      "condition": {
        "approval_recorded": false,
        "operation": "create_route",
        "public_route": true
      },
      "description": "Public routes require approval.",
      "effect": {
        "decision": "deny",
        "reason": "public_route_approval_required",
        "required_action": "record_route_approval"
      },
      "name": "public_route_requires_approval"
    },
    "public_route_requires_policy": {
      "condition": {
        "operation": "create_route",
        "public_route": true,
        "route_policy_attached": false
      },
      "description": "Public routes require an attached policy.",
      "effect": {
        "decision": "deny",
        "reason": "public_route_policy_required",
        "required_action": "attach_route_policy"
      },
      "name": "public_route_requires_policy"
    },
    "public_route_requires_tls": {
      "condition": {
        "operation": "create_route",
        "public_route": true,
        "tls_enabled": false
      },
      "description": "Public routes require TLS.",
      "effect": {
        "decision": "deny",
        "reason": "public_route_tls_required",
        "required_action": "enable_tls"
      },
      "name": "public_route_requires_tls"
    },
    "public_service_requires_circuit_breaker": {
      "condition": {
        "circuit_breaker_configured": false,
        "operation": "attach_policy",
        "public_service": true
      },
      "description": "Public services require circuit breakers.",
      "effect": {
        "decision": "deny",
        "reason": "circuit_breaker_required",
        "required_action": "configure_circuit_breaker"
      },
      "name": "public_service_requires_circuit_breaker"
    },
    "public_service_requires_rate_limit": {
      "condition": {
        "operation": "attach_policy",
        "public_service": true,
        "rate_limit_configured": false
      },
      "description": "Public services require rate limits.",
      "effect": {
        "decision": "deny",
        "reason": "rate_limit_required",
        "required_action": "configure_rate_limit"
      },
      "name": "public_service_requires_rate_limit"
    },
    "route_requires_bytewax_stream": {
      "condition": {
        "event_stream_ne": "bytewax",
        "operation": "create_route"
      },
      "description": "Route lifecycle events must use Bytewax.",
      "effect": {
        "decision": "deny",
        "reason": "bytewax_event_stream_required",
        "required_action": "route_gateway_lifecycle_to_bytewax"
      },
      "name": "route_requires_bytewax_stream"
    },
    "service_requires_endpoint": {
      "condition": {
        "endpoint_present": false,
        "operation": "register_service"
      },
      "description": "Mesh services require at least one endpoint.",
      "effect": {
        "decision": "deny",
        "reason": "service_endpoint_required",
        "required_action": "attach_service_endpoint"
      },
      "name": "service_requires_endpoint"
    },
    "service_requires_health_check": {
      "condition": {
        "health_check_present": false,
        "operation": "register_service"
      },
      "description": "Mesh services require health-check configuration.",
      "effect": {
        "decision": "deny",
        "reason": "service_health_check_required",
        "required_action": "attach_health_check"
      },
      "name": "service_requires_health_check"
    },
    "service_requires_owner": {
      "condition": {
        "operation": "register_service",
        "service_owner_assigned": false
      },
      "description": "Mesh services require an accountable owner.",
      "effect": {
        "decision": "deny",
        "reason": "service_owner_required",
        "required_action": "assign_service_owner"
      },
      "name": "service_requires_owner"
    },
    "tenant_context_required": {
      "condition": {
        "tenant_context_present": false
      },
      "description": "All gateway operations require tenant context.",
      "effect": {
        "decision": "deny",
        "reason": "tenant_context_required",
        "required_action": "attach_tenant_context"
      },
      "name": "tenant_context_required"
    },
    "traffic_shift_requires_bytewax_stream": {
      "condition": {
        "event_stream_ne": "bytewax",
        "operation": "shift_traffic"
      },
      "description": "Traffic-shift events must use Bytewax.",
      "effect": {
        "decision": "deny",
        "reason": "bytewax_event_stream_required",
        "required_action": "route_traffic_shift_to_bytewax"
      },
      "name": "traffic_shift_requires_bytewax_stream"
    },
    "traffic_shift_requires_canary_evidence": {
      "condition": {
        "canary_evidence_present": false,
        "canary_shift": true,
        "operation": "shift_traffic"
      },
      "description": "Canary traffic shifts require evidence.",
      "effect": {
        "decision": "require_review",
        "reason": "canary_evidence_required",
        "required_action": "attach_canary_evidence"
      },
      "name": "traffic_shift_requires_canary_evidence"
    }
  }
}
