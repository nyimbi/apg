        "agents": {
          "component": "WorkflowAgentWorkbench",
          "permission": "composition_orchestration:admin",
          "route": "/composition-orchestration/agents"
        },
        "dashboard": {
          "component": "OrchestrationDashboard",
          "permission": "composition_orchestration:view",
          "route": "/composition-orchestration/dashboard"
        },
        "definitions": {
          "component": "WorkflowDefinitionLibrary",
          "permission": "composition_orchestration:manage_definitions",
          "route": "/composition-orchestration/definitions"
        },
        "designer": {
          "component": "WorkflowDesigner",
          "permission": "composition_orchestration:design",
          "route": "/composition-orchestration/designer"
        },
