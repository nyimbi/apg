      "description": "Approval tasks require an approval policy.",
      "effect": {
        "decision": "deny",
        "reason": "approval_policy_required",
        "required_action": "attach_approval_policy"
      },
      "name": "approval_task_requires_policy"
    },
    "batch_schedule_requires_bytewax": {
      "condition": {
        "event_stream_ne": "bytewax",
        "operation": "batch_schedule"
      },
      "description": "Batch execution scheduling requires Bytewax coordination.",
      "effect": {
        "decision": "deny",
        "reason": "bytewax_event_stream_required",
        "required_action": "route_batch_schedule_to_bytewax"
      },
      "name": "batch_schedule_requires_bytewax"
    },
    "compensation_required_for_transaction": {
      "condition": {
        "compensation_present": false,
