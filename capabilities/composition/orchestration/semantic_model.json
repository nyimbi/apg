{
  "agents": {},
  "app": {
    "description": "Workflow orchestration package-backed APG capability",
    "entity_count": 7,
    "name": "composition_orchestration",
    "version": "2.1.0"
  },
  "capabilities": {
    "composition_orchestration": {
      "configuration": {
        "adapters": {
          "audit": "adapter",
          "authorization": "adapter",
          "event_stream": "bytewax",
          "notification": "adapter",
          "registry": "adapter",
          "theme": "adapter"
        },
        "automation_agents": {
          "enabled": true,
          "human_approval_required": true,
          "max_autonomous_scope": "recommend_validate_and_prepare",
          "supported_roles": [
            "workflow_architect",
            "bpml_reviewer",
            "release_reviewer",
            "incident_reviewer",
            "compliance_reviewer",
            "optimization_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "execution": {
          "bytewax_required": true,
          "compensation_required_for_transactions": true,
          "idempotency_required": true,
          "max_parallel_branches": 64,
          "retry_limit_required": true
        },
        "governance": {
          "audit_state_changes": true,
          "policy_attached_for_writes": true,
          "privileged_workflow_changes_reviewed": true,
          "require_tenant_context": true
        },
        "observability": {
          "emit_agent_events": true,
          "emit_definition_events": true,
          "emit_execution_events": true,
          "emit_release_events": true,
          "event_stream": "apg.composition.orchestration.lifecycle",
          "stream_processor": "bytewax"
        },
        "releases": {
          "approval_required_for_high_risk": true,
          "dry_run_required": true,
          "rollback_plan_required": true,
          "validation_required": true
        },
        "tasks": {
          "approval_policy_required": true,
          "cross_capability_contract_required": true,
          "handler_required": true,
          "human_assignee_required": true,
          "sla_escalation_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "composition_orchestration_control"
        },
        "ui": {
          "enable_agent_workbench": true,
          "enable_dashboard": true,
          "enable_definition_library": true,
          "enable_designer": true,
          "enable_execution_console": true,
          "enable_release_console": true,
          "enable_rule_center": true,
          "enable_settings": true,
          "enable_task_console": true
        },
        "workflow_definitions": {
          "cycle_detection_enabled": true,
          "owner_required": true,
          "start_event_required": true,
          "task_graph_required": true,
          "terminal_state_required": true,
          "version_required": true
        }
      },
      "name": "Workflow Orchestration",
      "provides": [
        "workflow_definition_lifecycle",
        "workflow_graph_validation",
        "workflow_execution_lifecycle",
        "human_task_coordination",
        "workflow_release_governance",
        "workflow_rule_enforcement",
        "workflow_agents"
      ],
      "requires": [
        "auth",
        "audl",
        "ntfy",
        "registry",
        "composition_events",
        "composition_config"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "Workflow orchestration operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation_type": "write",
              "policy_attached": false
            },
            "description": "Workflow definition and execution write operations require policy attachment.",
            "effect": {
              "decision": "deny",
              "reason": "operation_policy_required",
              "required_action": "attach_operation_policy"
            },
            "name": "workflow_write_requires_policy"
          },
          {
            "condition": {
              "operation": "define_workflow",
              "workflow_owner_assigned": false
            },
            "description": "Workflow definitions require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "workflow_owner_required",
              "required_action": "assign_workflow_owner"
            },
            "name": "workflow_requires_owner"
          },
          {
            "condition": {
              "operation": "define_workflow",
              "workflow_version_present": false
            },
            "description": "Workflow definitions require a version.",
            "effect": {
              "decision": "deny",
              "reason": "workflow_version_required",
              "required_action": "set_workflow_version"
            },
            "name": "workflow_requires_version"
          },
          {
            "condition": {
              "operation": "define_workflow",
              "start_event_present": false
            },
            "description": "Workflow definitions require at least one start event.",
            "effect": {
              "decision": "deny",
              "reason": "workflow_start_event_required",
              "required_action": "add_start_event"
            },
            "name": "workflow_requires_start_event"
          },
          {
            "condition": {
              "operation": "define_workflow",
              "task_graph_present": false
            },
            "description": "Workflow definitions require at least one executable task.",
            "effect": {
              "decision": "deny",
              "reason": "workflow_task_graph_required",
              "required_action": "add_executable_task_graph"
            },
            "name": "workflow_requires_task_graph"
          },
          {
            "condition": {
              "operation": "define_workflow",
              "terminal_state_present": false
            },
            "description": "Workflow definitions require a terminal state.",
            "effect": {
              "decision": "deny",
              "reason": "workflow_terminal_state_required",
              "required_action": "add_terminal_state"
            },
            "name": "workflow_requires_terminal_state"
          },
          {
            "condition": {
              "handler_present": false,
              "operation": "define_task"
            },
            "description": "Automated and integration tasks require a handler.",
            "effect": {
              "decision": "deny",
              "reason": "task_handler_required",
              "required_action": "attach_task_handler"
            },
            "name": "task_requires_handler"
          },
          {
            "condition": {
              "assignee_present": false,
              "human_task": true,
              "operation": "define_task"
            },
            "description": "Human tasks require an assignee, group, or role.",
            "effect": {
              "decision": "deny",
              "reason": "human_task_assignee_required",
              "required_action": "assign_human_task"
            },
            "name": "human_task_requires_assignee"
          },
          {
            "condition": {
              "approval_policy_present": false,
              "approval_task": true,
              "operation": "define_task"
            },
            "description": "Approval tasks require an approval policy.",
            "effect": {
              "decision": "deny",
              "reason": "approval_policy_required",
              "required_action": "attach_approval_policy"
            },
            "name": "approval_task_requires_policy"
          },
          {
            "condition": {
              "capability_contract_present": false,
              "cross_capability_task": true,
              "operation": "define_task"
            },
            "description": "Cross-capability tasks require an APG capability contract reference.",
            "effect": {
              "decision": "deny",
              "reason": "capability_contract_required",
              "required_action": "attach_capability_contract"
            },
            "name": "cross_capability_task_requires_contract"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "start_execution"
            },
            "description": "Workflow execution lifecycle events must use Bytewax.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_execution_lifecycle_to_bytewax"
            },
            "name": "execution_requires_bytewax_stream"
          },
          {
            "condition": {
              "idempotency_key_present": false,
              "operation": "start_execution"
            },
            "description": "Workflow execution starts require idempotency keys.",
            "effect": {
              "decision": "deny",
              "reason": "idempotency_key_required",
              "required_action": "attach_idempotency_key"
            },
            "name": "execution_requires_idempotency_key"
          },
          {
            "condition": {
              "operation": "start_execution",
              "review_recorded": false,
              "risk_level": "high"
            },
            "description": "High-risk workflow executions require review.",
            "effect": {
              "decision": "require_review",
              "reason": "high_risk_review_required",
              "required_action": "record_execution_review"
            },
            "name": "high_risk_execution_requires_review"
          },
          {
            "condition": {
              "operation": "release_workflow",
              "validation_evidence_present": false
            },
            "description": "Workflow releases require validation evidence.",
            "effect": {
              "decision": "deny",
              "reason": "release_validation_required",
              "required_action": "attach_validation_evidence"
            },
            "name": "release_requires_validation"
          },
          {
            "condition": {
              "dry_run_passed": false,
              "operation": "release_workflow"
            },
            "description": "Workflow releases require a dry-run result.",
            "effect": {
              "decision": "deny",
              "reason": "release_dry_run_required",
              "required_action": "run_release_dry_run"
            },
            "name": "release_requires_dry_run"
          },
          {
            "condition": {
              "operation": "release_workflow",
              "rollback_plan_present": false
            },
            "description": "Workflow releases require a rollback plan.",
            "effect": {
              "decision": "deny",
              "reason": "release_rollback_plan_required",
              "required_action": "attach_rollback_plan"
            },
            "name": "release_requires_rollback_plan"
          },
          {
            "condition": {
              "operation": "define_task",
              "retry_limit_present": false,
              "retry_policy_present": true
            },
            "description": "Retry policies require bounded attempts.",
            "effect": {
              "decision": "deny",
              "reason": "retry_limit_required",
              "required_action": "set_retry_limit"
            },
            "name": "retry_policy_requires_limit"
          },
          {
            "condition": {
              "escalation_present": false,
              "operation": "define_task",
              "sla_present": true
            },
            "description": "SLA-bound tasks require escalation rules.",
            "effect": {
              "decision": "require_review",
              "reason": "sla_escalation_required",
              "required_action": "attach_escalation_rule"
            },
            "name": "sla_task_requires_escalation"
          },
          {
            "condition": {
              "compensation_present": false,
              "operation": "define_workflow",
              "transactional_workflow": true
            },
            "description": "Transactional workflows require compensation steps.",
            "effect": {
              "decision": "deny",
              "reason": "compensation_required",
              "required_action": "attach_compensation_steps"
            },
            "name": "compensation_required_for_transaction"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "batch_schedule"
            },
            "description": "Batch execution scheduling requires Bytewax coordination.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_batch_schedule_to_bytewax"
            },
            "name": "batch_schedule_requires_bytewax"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "operation": "register_workflow_agent"
            },
            "description": "Workflow agents must use an approved runtime.",
            "effect": {
              "decision": "deny",
              "reason": "workflow_agent_runtime_not_supported",
              "required_action": "select_supported_agent_runtime"
            },
            "name": "workflow_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "operation": "register_workflow_agent"
            },
            "description": "Workflow agents must use an approved role.",
            "effect": {
              "decision": "deny",
              "reason": "workflow_agent_role_not_supported",
              "required_action": "select_supported_agent_role"
            },
            "name": "workflow_agent_role_supported"
          },
          {
            "condition": {
              "human_approval_recorded": false,
              "operation": "agent_workflow_action",
              "privileged_scope": true
            },
            "description": "Privileged workflow actions proposed by agents require human approval.",
            "effect": {
              "decision": "deny",
              "reason": "human_approval_required",
              "required_action": "record_human_approval"
            },
            "name": "privileged_agent_workflow_action_requires_human_approval"
          }
        ],
        "type": "deterministic"
      },
