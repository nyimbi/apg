          "component": "AccessAgentWorkbench",
          "permission": "composition_access:admin",
          "route": "/composition-access/agents"
        },
        "audit": {
          "component": "AccessAuditConsole",
          "permission": "composition_access:audit",
          "route": "/composition-access/audit"
        },
        "dashboard": {
          "component": "AccessDashboard",
          "permission": "composition_access:view",
          "route": "/composition-access/dashboard"
        },
        "decisions": {
          "component": "AccessDecisionExplorer",
          "permission": "composition_access:view",
          "route": "/composition-access/decisions"
        },
        "grants": {
          "component": "AccessGrantWorkbench",
          "permission": "composition_access:grant",
          "route": "/composition-access/grants"
        },
        "policies": {
