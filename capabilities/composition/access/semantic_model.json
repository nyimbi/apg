      "streaming": {
        "events": [
          "provider_registered",
          "provider_activated",
          "resource_registered",
          "policy_created",
          "policy_activated",
          "grant_created",
          "grant_revoked",
          "session_evaluated",
          "access_decision_recorded",
          "access_agent_registered"
        ],
        "guardrails": [
          "decision_requires_bytewax_stream",
          "batch_grant_requires_bytewax",
          "privileged_agent_action_requires_human_approval"
        ],
        "key": "tenant_id",
        "processor": "bytewax",
        "states": [
          "draft",
          "active",
          "review_required",
          "approved",
          "denied",
          "revoked",
          "blocked"
        ],
        "stream": "apg.composition.access.lifecycle"
