{
  "agents": {},
  "app": {
    "description": "Composition access-control package-backed APG capability",
    "entity_count": 7,
    "name": "composition_access",
    "version": "2.1.0"
  },
  "capabilities": {
    "composition_access": {
      "configuration": {
        "access_agents": {
          "enabled": true,
          "human_approval_required": true,
          "max_autonomous_scope": "read_and_recommend",
          "supported_roles": [
            "access_architect",
            "policy_reviewer",
            "grant_reviewer",
            "risk_reviewer",
            "session_reviewer",
            "audit_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "adapters": {
          "audit": "adapter",
          "authorization": "adapter",
          "event_stream": "bytewax",
          "identity": "adapter",
          "notification": "adapter",
          "theme": "adapter"
        },
        "governance": {
          "audit_state_changes": true,
          "cross_capability_guardrails": true,
          "privileged_action_review": true,
          "require_tenant_context": true
        },
        "grants": {
          "approval_required_for_privileged": true,
          "expiry_required_for_elevated_access": true,
          "justification_required": true,
          "separation_of_duties_required": true
        },
        "identity_providers": {
          "metadata_validation_required": true,
          "provider_owner_required": true,
          "secret_reference_required": true,
          "supported_types": [
            "local",
            "oidc",
            "saml",
            "ldap",
            "api_key",
            "jwt"
          ],
          "test_evidence_required": true
        },
        "observability": {
          "emit_decision_events": true,
          "emit_grant_events": true,
          "emit_policy_events": true,
          "emit_provider_events": true,
          "event_stream": "apg.composition.access.lifecycle",
          "stream_processor": "bytewax"
        },
        "policies": {
          "conditions_required_for_sensitive_resources": true,
          "effect_required": true,
          "policy_owner_required": true,
          "review_required_for_deny_override": true,
          "simulation_required_for_high_risk": true
        },
        "resources": {
          "composition_boundary_required": true,
          "owner_required": true,
          "registry_required": true,
          "scope_required": true
        },
        "sessions": {
          "adaptive_step_up_enabled": true,
          "continuous_evaluation_enabled": true,
          "max_risk_without_review": 74,
          "risk_scoring_enabled": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "composition_access_control"
        },
        "ui": {
          "enable_agent_workbench": true,
          "enable_audit_console": true,
          "enable_dashboard": true,
          "enable_decision_explorer": true,
          "enable_grant_workbench": true,
          "enable_policy_studio": true,
          "enable_provider_console": true,
          "enable_settings": true
        }
      },
      "name": "Access Control Integration Hub",
      "provides": [
        "identity_provider_composition",
        "resource_access_registry",
        "policy_orchestration",
        "grant_lifecycle",
        "session_risk_control",
        "access_decision_audit",
        "access_agents"
      ],
      "requires": [
        "auth",
        "audl",
        "ntfy",
        "conf",
        "registry"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All composition access operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "register_provider",
              "provider_owner_assigned": false
            },
            "description": "Identity providers require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "provider_owner_required",
              "required_action": "assign_provider_owner"
            },
            "name": "provider_requires_owner"
          },
          {
            "condition": {
              "operation": "activate_provider",
              "provider_metadata_validated": false
            },
            "description": "Identity providers require validated metadata and test evidence before activation.",
            "effect": {
              "decision": "deny",
              "reason": "provider_metadata_validation_required",
              "required_action": "validate_provider_metadata"
            },
            "name": "provider_requires_metadata_evidence"
          },
          {
            "condition": {
              "external_provider": true,
              "operation": "activate_provider",
              "secret_reference_present": false
            },
            "description": "External providers require a vault or secret-manager reference.",
            "effect": {
              "decision": "deny",
              "reason": "provider_secret_reference_required",
              "required_action": "attach_secret_reference"
            },
            "name": "provider_requires_secret_reference"
          },
          {
            "condition": {
              "operation": "register_resource",
              "resource_owner_assigned": false
            },
            "description": "Protected resources require an owner and registered scope.",
            "effect": {
              "decision": "deny",
              "reason": "resource_owner_required",
              "required_action": "assign_resource_owner"
            },
            "name": "resource_requires_owner"
          },
          {
            "condition": {
              "operation": "register_resource",
              "scope_present": false
            },
            "description": "Protected resources require at least one access scope.",
            "effect": {
              "decision": "deny",
              "reason": "resource_scope_required",
              "required_action": "define_resource_scope"
            },
            "name": "resource_requires_scope"
          },
          {
            "condition": {
              "operation": "create_policy",
              "policy_owner_assigned": false
            },
            "description": "Policies require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "policy_owner_required",
              "required_action": "assign_policy_owner"
            },
            "name": "policy_requires_owner"
          },
          {
            "condition": {
              "operation": "create_policy",
              "policy_conditions_present": false,
              "sensitive_resource": true
            },
            "description": "Sensitive-resource policies require explicit conditions.",
            "effect": {
              "decision": "deny",
              "reason": "policy_conditions_required",
              "required_action": "define_policy_conditions"
            },
            "name": "sensitive_policy_requires_conditions"
          },
          {
            "condition": {
              "operation": "activate_policy",
              "risk_level": "high",
              "simulation_evidence_present": false
            },
            "description": "High-risk policy changes require simulation evidence.",
            "effect": {
              "decision": "require_review",
              "reason": "policy_simulation_required",
              "required_action": "attach_policy_simulation"
            },
            "name": "high_risk_policy_requires_simulation"
          },
          {
            "condition": {
              "approval_recorded": false,
              "operation": "create_grant",
              "privileged_scope": true
            },
            "description": "Privileged grants require approval.",
            "effect": {
              "decision": "deny",
              "reason": "privileged_grant_approval_required",
              "required_action": "record_grant_approval"
            },
            "name": "privileged_grant_requires_approval"
          },
          {
            "condition": {
              "expiry_present": false,
              "operation": "create_grant",
              "privileged_scope": true
            },
            "description": "Privileged grants require an expiry time.",
            "effect": {
              "decision": "deny",
              "reason": "privileged_grant_expiry_required",
              "required_action": "set_grant_expiry"
            },
            "name": "privileged_grant_requires_expiry"
          },
          {
            "condition": {
              "operation": "create_grant",
              "separation_of_duties_passed": false
            },
            "description": "A requester cannot self-approve privileged access.",
            "effect": {
              "decision": "deny",
              "reason": "separation_of_duties_required",
              "required_action": "select_independent_approver"
            },
            "name": "grant_requires_separation_of_duties"
          },
          {
            "condition": {
              "justification_present": false,
              "operation": "create_grant"
            },
            "description": "Access grants require business justification.",
            "effect": {
              "decision": "deny",
              "reason": "grant_justification_required",
              "required_action": "attach_grant_justification"
            },
            "name": "grant_requires_justification"
          },
          {
            "condition": {
              "operation": "evaluate_session",
              "risk_score_gt": 74,
              "step_up_completed": false
            },
            "description": "High-risk sessions require adaptive step-up authentication.",
            "effect": {
              "decision": "deny",
              "reason": "adaptive_step_up_required",
              "required_action": "complete_step_up_authentication"
            },
            "name": "high_risk_session_requires_step_up"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "record_decision"
            },
            "description": "Access decisions must be emitted through Bytewax.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_access_decision_to_bytewax"
            },
            "name": "decision_requires_bytewax_stream"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "batch_grant"
            },
            "description": "Batch grant changes require Bytewax lifecycle coordination.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_batch_grants_to_bytewax"
            },
            "name": "batch_grant_requires_bytewax"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "operation": "register_access_agent"
            },
            "description": "Access-control agents must use an approved runtime.",
            "effect": {
              "decision": "deny",
              "reason": "access_agent_runtime_not_supported",
              "required_action": "select_supported_agent_runtime"
            },
            "name": "access_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "operation": "register_access_agent"
            },
            "description": "Access-control agents must use an approved role.",
            "effect": {
              "decision": "deny",
              "reason": "access_agent_role_not_supported",
              "required_action": "select_supported_agent_role"
            },
            "name": "access_agent_role_supported"
          },
          {
            "condition": {
              "human_approval_recorded": false,
              "operation": "agent_access_action",
              "privileged_scope": true
            },
            "description": "Privileged access actions proposed by agents require human approval.",
            "effect": {
              "decision": "deny",
              "reason": "human_approval_required",
              "required_action": "record_human_approval"
            },
            "name": "privileged_agent_action_requires_human_approval"
          }
        ],
        "type": "deterministic"
      },
