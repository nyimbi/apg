{
  "capability_id": "ngo_ben",
  "capability_name": "Beneficiary Registry",
  "version": "1.0.0",
  "domain": "ngo",
  "entities": {
    "Beneficiary": {
      "type": "object",
      "description": "Beneficiary entity for Beneficiary Registry",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
