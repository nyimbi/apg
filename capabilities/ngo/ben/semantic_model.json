  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/ngo-ben/beneficiarys",
      "description": "List Beneficiary records"
    },
    {
      "method": "POST",
      "path": "/api/ngo-ben/beneficiarys",
      "description": "Create Beneficiary"
    },
    {
      "method": "GET",
      "path": "/api/ngo-ben/beneficiarys/{id}",
      "description": "Get Beneficiary by ID"
    },
    {
      "method": "PUT",
      "path": "/api/ngo-ben/beneficiarys/{id}",
