{
  "capability_id": "hos_pms",
  "capability_name": "Property Management System",
  "version": "1.0.0",
  "domain": "hospitality",
  "entities": {
    "Room": {
      "type": "object",
      "description": "Room entity for Property Management System",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "Reservation": {
      "type": "object",
      "description": "Reservation entity for Property Management System",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "Folio": {
      "type": "object",
      "description": "Folio entity for Property Management System",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "HousekeepingTask": {
      "type": "object",
      "description": "HousekeepingTask entity for Property Management System",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    }
  },
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/hos-pms/rooms",
      "description": "List Room records"
    },
    {
      "method": "POST",
      "path": "/api/hos-pms/rooms",
      "description": "Create Room"
    },
    {
      "method": "GET",
      "path": "/api/hos-pms/rooms/{id}",
      "description": "Get Room by ID"
    },
    {
      "method": "PUT",
      "path": "/api/hos-pms/rooms/{id}",
      "description": "Update Room"
    },
    {
      "method": "DELETE",
      "path": "/api/hos-pms/rooms/{id}",
      "description": "Delete Room"
    }
  ],
  "events": {
    "publishes": [
      "guest.checked_in",
      "guest.checked_out",
      "room.cleaned"
    ],
    "subscribes": [
      "reservation.confirmed"
    ]
  }
}