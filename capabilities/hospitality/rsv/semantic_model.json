  "api_endpoints": [
    {
      "method": "GET",
      "path": "/api/hos-rsv/bookings",
      "description": "List Booking records"
    },
    {
      "method": "POST",
      "path": "/api/hos-rsv/bookings",
      "description": "Create Booking"
    },
    {
      "method": "GET",
      "path": "/api/hos-rsv/bookings/{id}",
      "description": "Get Booking by ID"
    },
    {
      "method": "PUT",
      "path": "/api/hos-rsv/bookings/{id}",
      "description": "Update Booking"
    },
    {
      "method": "DELETE",
      "path": "/api/hos-rsv/bookings/{id}",
      "description": "Delete Booking"
    }
  ],
  "events": {
    "publishes": [
      "reservation.confirmed",
      "reservation.cancelled",
      "availability.synced"
    ],
    "subscribes": []
  }
