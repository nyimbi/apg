{
  "capability_id": "hos_rsv",
  "capability_name": "Reservations & Channel Manager",
  "version": "1.0.0",
  "domain": "hospitality",
  "entities": {
    "Booking": {
      "type": "object",
      "description": "Booking entity for Reservations & Channel Manager",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "ChannelAllotment": {
      "type": "object",
