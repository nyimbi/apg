        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "EsbFlowRun": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    },
    "EsbDeadLetter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id"
      ]
    }
