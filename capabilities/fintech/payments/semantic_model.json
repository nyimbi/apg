            "condition": {
              "human_approval_recorded": false,
              "operation": "payment_agent_action",
              "privileged_scope": true
            },
            "description": "Privileged payment-agent actions require human approval.",
            "effect": {
              "decision": "deny",
              "reason": "human_approval_required",
              "required_action": "record_human_approval"
            },
            "name": "privileged_payment_agent_action_requires_human_approval"
          }
        ],
        "type": "deterministic"
      },
