{
  "app": {
    "description": "Know Your Customer package-backed APG capability",
    "entity_count": 5,
    "name": "fintech_kyc",
    "version": "1.1.0"
  },
  "capabilities": {
    "fintech_kyc": {
      "configuration": {
        "adapters": {
          "audit": "audl",
          "auth": "auth",
          "biometrics": "biop",
          "consent": "cons",
          "event_stream": "bytewax",
          "keys": "keym",
          "nlp": "nlpc",
          "notifications": "ntfy",
          "payments": "fintech_payments",
          "vision": "cvsn",
          "wallets": "fintech_wallets"
        },
        "agents": {
          "enabled": true,
          "human_approval_required_for_privileged_actions": true,
          "supported_roles": [
            "kyc_ops_reviewer",
            "document_reviewer",
            "sanctions_reviewer",
            "risk_reviewer",
            "onboarding_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "decisions": {
          "address_document_required": true,
          "consent_required": true,
          "expiry_days": 365,
          "identity_document_required": true,
          "risk_assessment_required": true,
          "screening_required": true
        },
        "documents": {
          "extracted_subject_required": true,
          "minimum_confidence": 0.75,
          "supported_types": [
            "passport",
            "national_id",
            "driver_license",
            "resident_permit",
            "business_registration",
            "tax_id",
            "utility_bill",
            "bank_statement"
          ],
          "token_reference_required": true
        },
        "governance": {
          "audit_kyc_events": true,
          "customer_consent_required": true,
          "policy_attached_for_writes": true,
          "require_tenant_context": true
        },
        "observability": {
          "emit_agent_events": true,
          "emit_document_events": true,
          "emit_profile_events": true,
          "emit_screening_events": true,
          "event_stream": "apg.fintech.kyc.lifecycle",
          "stream_processor": "bytewax"
        },
        "profiles": {
          "consent_required": true,
          "country_required": true,
          "legal_name_required": true,
          "supported_customer_types": [
            "individual",
            "sole_proprietor",
            "business",
            "nonprofit",
            "government"
          ]
        },
        "risk": {
          "enhanced_due_diligence_required": true,
          "high_risk_threshold": 75,
          "medium_risk_threshold": 45
        },
        "screening": {
          "adverse_media_required": true,
          "pep_required": true,
          "review_required_for_hits": true,
          "sanctions_required": true,
          "watchlist_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "fintech_kyc_control"
        },
        "ui": {
          "enable_agents": true,
          "enable_dashboard": true,
          "enable_documents": true,
          "enable_profiles": true,
          "enable_reviews": true,
          "enable_risk": true,
          "enable_screening": true
        }
      },
      "name": "Know Your Customer",
      "provides": [
        "customer_identity_lifecycle",
        "document_verification_workflow",
        "sanctions_pep_screening",
        "kyc_risk_scoring",
        "customer_due_diligence",
        "enhanced_due_diligence",
        "kyc_agent_workflow"
      ],
      "requires": [
        "auth",
        "audl",
        "cons",
        "ntfy",
        "biop",
        "cvsn",
        "nlpc",
        "keym",
        "fintech_payments",
        "fintech_wallets"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "KYC operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation_type": "write",
              "policy_attached": false
            },
            "description": "KYC writes require policy evidence.",
            "effect": {
              "decision": "deny",
              "reason": "kyc_policy_required",
              "required_action": "attach_kyc_policy"
            },
            "name": "kyc_write_requires_policy"
          },
          {
            "condition": {
              "operation": "open_profile",
              "subject_present": false
            },
            "description": "KYC profiles require subject reference.",
            "effect": {
              "decision": "deny",
              "reason": "kyc_subject_required",
              "required_action": "attach_subject_reference"
            },
            "name": "profile_subject_required"
          },
          {
            "condition": {
              "legal_name_present": false,
              "operation": "open_profile"
            },
            "description": "KYC profiles require legal name.",
            "effect": {
              "decision": "deny",
              "reason": "legal_name_required",
              "required_action": "capture_legal_name"
            },
            "name": "profile_legal_name_required"
          },
          {
            "condition": {
              "customer_type_supported": false,
              "operation": "open_profile"
            },
            "description": "KYC customer type must be supported.",
            "effect": {
              "decision": "deny",
              "reason": "customer_type_not_supported",
              "required_action": "select_supported_customer_type"
            },
            "name": "profile_customer_type_supported"
          },
          {
            "condition": {
              "country_present": false,
              "operation": "open_profile"
            },
            "description": "KYC profiles require country code.",
            "effect": {
              "decision": "deny",
              "reason": "country_required",
              "required_action": "capture_country_code"
            },
            "name": "profile_country_required"
          },
          {
            "condition": {
              "consent_recorded": false,
              "operation": "open_profile"
            },
            "description": "KYC profiles require consent evidence.",
            "effect": {
              "decision": "deny",
              "reason": "customer_consent_required",
              "required_action": "record_customer_consent"
            },
            "name": "profile_consent_required"
          },
          {
            "condition": {
              "operation": "register_document",
              "profile_present": false
            },
            "description": "Documents require an existing KYC profile.",
            "effect": {
              "decision": "deny",
              "reason": "kyc_profile_required",
              "required_action": "select_profile"
            },
            "name": "document_profile_required"
          },
          {
            "condition": {
              "document_type_supported": false,
              "operation": "register_document"
            },
            "description": "Document type must be supported.",
            "effect": {
              "decision": "deny",
              "reason": "document_type_not_supported",
              "required_action": "select_supported_document_type"
            },
            "name": "document_type_supported"
          },
          {
            "condition": {
              "operation": "register_document",
              "token_reference_present": false
            },
            "description": "Documents require tokenized storage reference.",
            "effect": {
              "decision": "deny",
              "reason": "document_token_required",
              "required_action": "attach_document_token"
            },
            "name": "document_token_required"
          },
          {
            "condition": {
              "extracted_subject_present": false,
              "operation": "register_document"
            },
            "description": "Documents require extracted subject evidence.",
            "effect": {
              "decision": "deny",
              "reason": "document_subject_required",
              "required_action": "extract_document_subject"
            },
            "name": "document_subject_required"
          },
          {
            "condition": {
              "confidence_below_minimum": true,
              "operation": "register_document"
            },
            "description": "Document confidence must meet the configured minimum.",
            "effect": {
              "decision": "deny",
              "reason": "document_confidence_below_minimum",
              "required_action": "reverify_document"
            },
            "name": "document_confidence_minimum"
          },
          {
            "condition": {
              "operation": "record_screening",
              "profile_present": false
            },
            "description": "Screening requires an existing KYC profile.",
            "effect": {
              "decision": "deny",
              "reason": "kyc_profile_required",
              "required_action": "select_profile"
            },
            "name": "screening_profile_required"
