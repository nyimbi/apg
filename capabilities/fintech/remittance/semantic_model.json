        "agents": {
          "enabled": true,
          "human_approval_required_for_privileged_actions": true,
          "supported_roles": [
            "remittance_ops_reviewer",
            "compliance_reviewer",
            "payout_reviewer",
            "treasury_reviewer",
            "customer_support_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "compliance": {
          "aml_review_requires_human_approval": true,
          "aml_screen_required": true,
          "fraud_review_requires_human_approval": true,
          "sanctions_hit_blocks": true
        },
        "corridors": {
          "corridor_policy_required": true,
          "same_country_blocked": true,
          "supported_countries": [
            "KE",
            "UG",
            "TZ",
            "RW",
            "GH",
            "NG",
            "ZA",
            "GB",
            "US",
            "AE",
            "IN"
          ]
        },
        "governance": {
          "audit_remittance_events": true,
          "customer_consent_required": true,
          "policy_attached_for_writes": true,
          "require_tenant_context": true
        },
        "observability": {
          "emit_agent_events": true,
          "emit_payout_events": true,
          "emit_quote_events": true,
          "emit_refund_events": true,
          "emit_transfer_events": true,
          "event_stream": "apg.fintech.remittance.lifecycle",
          "stream_processor": "bytewax"
        },
        "payouts": {
          "provider_receipt_required": true,
          "settlement_reference_required": true,
          "supported_methods": [
            "bank_account",
            "mobile_money",
            "wallet",
            "cash_pickup",
            "card_push"
          ]
        },
        "quotes": {
          "expiry_required": true,
          "fee_non_negative_required": true,
          "positive_amount_required": true,
          "positive_fx_rate_required": true,
          "supported_currencies": [
            "KES",
            "UGX",
            "TZS",
            "RWF",
            "GHS",
            "NGN",
            "ZAR",
            "GBP",
            "USD",
            "AED",
            "INR",
            "EUR"
          ]
        },
        "refunds": {
          "reason_required": true,
          "reviewer_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "fintech_remittance_control"
