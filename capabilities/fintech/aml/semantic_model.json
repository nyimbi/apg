{
  "app": {
    "description": "Anti Money Laundering package-backed APG capability",
    "entity_count": 5,
    "name": "fintech_aml",
    "version": "1.1.0"
  },
  "capabilities": {
    "fintech_aml": {
      "configuration": {
        "adapters": {
          "audit": "audl",
          "auth": "auth",
          "event_stream": "bytewax",
          "keys": "keym",
          "kyc": "fintech_kyc",
          "nlp": "nlpc",
          "notifications": "ntfy",
          "payments": "fintech_payments",
          "wallets": "fintech_wallets"
        },
        "agents": {
          "enabled": true,
          "human_approval_required_for_privileged_actions": true,
          "supported_roles": [
            "aml_ops_reviewer",
            "transaction_monitoring_analyst",
            "sanctions_reviewer",
            "case_investigator",
            "sar_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "alerts": {
          "auto_close_allowed": false,
          "disposition_required_to_close": true,
          "evidence_required": true,
          "supported_severities": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "supported_types": [
            "large_transaction",
            "velocity",
            "structuring",
            "sanctions",
            "pep",
            "high_risk_kyc",
            "mule_account",
            "agent_review"
          ]
        },
        "cases": {
          "evidence_required": true,
          "investigator_required_for_escalation": true,
          "sar_allowed_statuses": [
            "escalated",
            "under_investigation",
            "confirmed_suspicious"
          ],
          "supported_types": [
            "transaction_monitoring",
            "sanctions_alert",
            "structuring_alert",
            "mule_account",
            "high_risk_customer",
            "suspicious_activity_report"
          ]
        },
        "governance": {
          "audit_aml_events": true,
          "human_approval_required_for_sar": true,
          "kyc_link_required": true,
          "policy_attached_for_writes": true,
          "require_tenant_context": true
        },
        "monitoring": {
          "high_risk_score_threshold": 75,
          "large_transaction_threshold": 10000.0,
          "structuring_count_threshold": 3,
          "structuring_threshold": 9500.0,
          "velocity_amount_threshold": 25000.0,
          "velocity_count_threshold": 5,
          "velocity_window_minutes": 60
        },
        "observability": {
          "emit_agent_events": true,
          "emit_alert_events": true,
          "emit_case_events": true,
          "emit_sar_events": true,
          "emit_transaction_events": true,
          "event_stream": "apg.fintech.aml.lifecycle",
          "stream_processor": "bytewax"
        },
        "sar": {
          "evidence_required": true,
          "human_approval_required": true,
          "jurisdiction_required": true,
          "narrative_required": true,
          "subject_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "fintech_aml_control"
        },
        "ui": {
          "enable_agents": true,
          "enable_alerts": true,
          "enable_cases": true,
          "enable_dashboard": true,
          "enable_monitoring": true,
          "enable_sar": true,
          "enable_typologies": true
