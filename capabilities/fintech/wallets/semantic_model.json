      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "WalletAgentWorkbench",
          "permission": "fintech_wallets:admin",
          "route": "/fintech-wallets/agents"
        },
        "dashboard": {
          "component": "WalletsDashboard",
          "permission": "fintech_wallets:view",
          "route": "/fintech-wallets/dashboard"
        },
        "holds": {
          "component": "WalletHoldConsole",
          "permission": "fintech_wallets:operate",
          "route": "/fintech-wallets/holds"
        },
        "instruments": {
          "component": "WalletInstrumentVault",
          "permission": "fintech_wallets:manage_instruments",
          "route": "/fintech-wallets/instruments"
        },
        "ledger": {
          "component": "WalletLedger",
          "permission": "fintech_wallets:view_ledger",
          "route": "/fintech-wallets/ledger"
        },
        "limits": {
          "component": "WalletLimitConsole",
          "permission": "fintech_wallets:govern_limits",
          "route": "/fintech-wallets/limits"
        },
        "settings": {
          "component": "WalletSettings",
          "permission": "fintech_wallets:admin",
          "route": "/fintech-wallets/settings"
        },
        "wallets": {
          "component": "WalletWorkbench",
          "permission": "fintech_wallets:manage_wallets",
          "route": "/fintech-wallets/wallets"
        }
      },
      "streaming": {
        "events": [
          "wallet_opened",
          "wallet_instrument_registered",
          "wallet_credited",
          "wallet_debited",
          "wallet_transfer_posted",
          "wallet_hold_placed",
          "wallet_hold_released",
          "wallet_limit_updated",
          "wallet_agent_registered"
        ],
        "guardrails": [
          "wallet_batch_requires_bytewax",
          "wallet_event_requires_bytewax",
          "privileged_wallet_agent_action_requires_human_approval"
        ],
        "key": "tenant_id",
        "processor": "bytewax",
        "stream": "apg.fintech.wallets.lifecycle"
      },
      "theme": {
        "components": {
          "agents": {
            "status_style": "agent-chip",
            "visual": "review-lane"
          },
          "holds": {
            "status_style": "reserve-chip",
            "visual": "hold-lane"
          },
          "instruments": {
            "icon": "credit-card",
