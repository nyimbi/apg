            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_schedule",
              "schedule_owner_assigned": false
            },
            "description": "Schedules require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "schedule_owner_required",
              "required_action": "assign_schedule_owner"
            },
            "name": "schedule_requires_owner"
          },
          {
            "condition": {
              "operation": "create_schedule",
              "timezone_present": false
            },
            "description": "Schedules require an explicit timezone.",
            "effect": {
              "decision": "deny",
              "reason": "timezone_required",
              "required_action": "set_timezone"
            },
            "name": "timezone_required"
          },
          {
            "condition": {
              "job_criticality": "critical",
              "monitoring_attached": false
            },
            "description": "Critical jobs require monitoring.",
            "effect": {
              "decision": "deny",
              "reason": "critical_job_monitoring_required",
              "required_action": "attach_monitoring"
            },
            "name": "critical_job_requires_monitoring"
          },
