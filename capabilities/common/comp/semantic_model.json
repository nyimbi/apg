            "component": "FindingTracker",
            "name": "findings",
            "nav_group": "Remediation",
            "path": "/comp/findings",
            "permission": "comp:remediate"
          },
          {
            "component": "ReportBuilder",
            "name": "reports",
            "nav_group": "Reporting",
            "path": "/comp/reports",
            "permission": "comp:approve_reports"
          },
          {
            "component": "AttestationCenter",
            "name": "attestations",
            "nav_group": "Reporting",
            "path": "/comp/attestations",
            "permission": "comp:approve_reports"
          },
          {
            "component": "COMPSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/comp/settings",
            "permission": "comp:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
