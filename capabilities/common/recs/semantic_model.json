            "nav_group": "Data",
            "path": "/recs/catalogs",
            "permission": "recs:view"
          },
          {
            "component": "ProfileFeatures",
            "name": "profiles",
            "nav_group": "Data",
            "path": "/recs/profiles",
            "permission": "recs:view"
          },
          {
            "component": "ExperimentStudio",
            "name": "experiments",
            "nav_group": "Optimization",
            "path": "/recs/experiments",
            "permission": "recs:run_experiments"
          },
          {
            "component": "RankingPolicies",
            "name": "policies",
            "nav_group": "Governance",
            "path": "/recs/policies",
            "permission": "recs:admin"
          },
          {
            "component": "RECSSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/recs/settings",
            "permission": "recs:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
