{
  "agents": {},
  "app": {
    "description": "Recommender Systems package-backed APG capability",
    "entity_count": 0,
    "name": "recs",
    "version": "1.0.0"
  },
  "capabilities": {
    "recs": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "experiments": {
          "business_metric_required": true,
          "experiment_approval_required": true,
          "holdout_required": true,
          "max_experiment_percent": 25
        },
        "governance": {
          "audit_recommendations": true,
          "explainability_required_for_high_impact": true,
          "profile_consent_required": true,
          "require_tenant_context": true
        },
        "models": {
          "drift_monitoring_required": true,
          "enabled_algorithms": [
            "collaborative_filtering",
            "content_based",
            "hybrid",
            "contextual_bandit"
          ],
          "minimum_training_events": 1000,
          "model_owner_required": true
        },
        "ranking": {
          "diversity_constraints_enabled": true,
          "minimum_recommendation_confidence": 0.65,
          "ranking_policy_required": true,
          "sensitive_attribute_filtering": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "recs_recommendation_console"
        },
        "ui": {
          "enable_experiment_studio": true,
          "enable_model_registry": true,
          "enable_ranking_policy": true,
          "enable_recommendation_console": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Recommender Systems",
      "provides": [
        "recs_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All recommendation operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "recommend",
              "profile_consent_recorded": false
            },
            "description": "Personalized recommendations require profile consent.",
            "effect": {
              "decision": "deny",
              "reason": "profile_consent_required",
              "required_action": "record_profile_consent"
            },
            "name": "profile_consent_required"
          },
          {
            "condition": {
              "operation": "recommend",
              "ranking_policy_attached": false
            },
            "description": "Recommendations require an attached ranking policy.",
            "effect": {
              "decision": "deny",
              "reason": "ranking_policy_required",
              "required_action": "attach_ranking_policy"
            },
            "name": "ranking_policy_required"
          },
          {
            "condition": {
              "operation": "train_model",
              "training_event_count_lt": 1000
            },
            "description": "Training requires sufficient events.",
            "effect": {
              "decision": "deny",
              "reason": "insufficient_training_events",
              "required_action": "collect_training_events"
            },
            "name": "model_training_requires_events"
          },
          {
            "condition": {
              "explanation_attached": false,
              "impact_level": "high"
            },
            "description": "High-impact recommendations require explanations.",
            "effect": {
              "decision": "deny",
              "reason": "explainability_required",
              "required_action": "attach_explanation"
            },
            "name": "high_impact_requires_explainability"
          },
          {
            "condition": {
              "experiment_percent_gt": 25,
              "experiment_review_recorded": false
            },
            "description": "Large recommendation experiments require review.",
            "effect": {
              "decision": "require_review",
              "reason": "experiment_review_required",
              "required_action": "review_experiment"
            },
            "name": "large_experiment_requires_review"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
        {
          "condition": {
            "tenant_context_present": false
          },
