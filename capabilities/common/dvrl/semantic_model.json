  "roles": {},
  "rules": {
    "cache_ttl_requires_limit": {
      "condition": {
        "cache_ttl_seconds_gt": 3600,
        "operation": "cache_result"
      },
      "description": "Query cache TTL cannot exceed tenant configuration.",
      "effect": {
        "decision": "deny",
        "reason": "cache_ttl_limit_exceeded",
        "required_action": "reduce_cache_ttl"
      },
      "name": "cache_ttl_requires_limit"
    },
    "cross_source_join_requires_review": {
      "condition": {
        "join_review_recorded": false,
        "join_source_count_gt": 3,
        "operation": "execute_query"
      },
      "description": "Cross-source joins above the tenant threshold require review.",
      "effect": {
        "decision": "require_review",
        "reason": "cross_source_join_review_required",
        "required_action": "record_join_review"
      },
      "name": "cross_source_join_requires_review"
    },
    "high_cost_query_requires_review": {
      "condition": {
        "cost_review_recorded": false,
        "estimated_query_cost_gt": 1000.0,
        "operation": "execute_query"
      },
      "description": "High cost federated queries require review.",
      "effect": {
        "decision": "require_review",
        "reason": "query_cost_review_required",
        "required_action": "record_query_cost_review"
      },
      "name": "high_cost_query_requires_review"
    },
    "policy_change_requires_review": {
      "condition": {
        "operation": "change_policy",
        "policy_review_recorded": false
      },
      "description": "Virtualization policy changes require review.",
      "effect": {
        "decision": "require_review",
        "reason": "policy_review_required",
        "required_action": "record_policy_review"
      },
      "name": "policy_change_requires_review"
    },
    "query_requires_lineage_capture": {
      "condition": {
        "lineage_capture_enabled": false,
        "operation": "execute_query"
      },
      "description": "Federated queries require lineage capture.",
      "effect": {
        "decision": "deny",
        "reason": "lineage_capture_required",
        "required_action": "enable_lineage_capture"
      },
      "name": "query_requires_lineage_capture"
    },
    "query_requires_parameterization": {
      "condition": {
        "operation": "execute_query",
        "parameterized": false
      },
      "description": "Federated queries require parameterization evidence.",
      "effect": {
        "decision": "deny",
        "reason": "parameterization_required",
        "required_action": "parameterize_query"
      },
      "name": "query_requires_parameterization"
    },
    "query_result_limit_enforced": {
      "condition": {
        "operation": "execute_query",
        "requested_rows_gt": 100000
      },
      "description": "Federated query result limits cannot exceed tenant configuration.",
      "effect": {
        "decision": "deny",
        "reason": "query_result_limit_exceeded",
        "required_action": "reduce_result_limit"
      },
      "name": "query_result_limit_enforced"
    },
    "restricted_query_requires_rbac": {
      "condition": {
        "data_classification": "restricted",
        "operation": "execute_query",
        "rbac_authorized": false
      },
      "description": "Restricted data queries require RBAC authorization.",
      "effect": {
        "decision": "deny",
        "reason": "rbac_authorization_required",
        "required_action": "authorize_query_access"
      },
      "name": "restricted_query_requires_rbac"
    },
    "schema_refresh_requires_review": {
      "condition": {
        "operation": "refresh_schema",
        "schema_age_days_gt": 30,
        "schema_review_recorded": false
      },
      "description": "Stale virtual schemas require refresh review.",
      "effect": {
        "decision": "require_review",
        "reason": "schema_refresh_review_required",
        "required_action": "record_schema_refresh_review"
      },
      "name": "schema_refresh_requires_review"
    },
    "sensitive_results_block_cache": {
      "condition": {
        "cache_requested": true,
        "operation": "execute_query",
        "result_contains_sensitive_data": true
      },
      "description": "Sensitive query results cannot be cached by default.",
      "effect": {
        "decision": "deny",
        "reason": "sensitive_result_cache_blocked",
        "required_action": "disable_result_cache"
      },
      "name": "sensitive_results_block_cache"
    },
    "source_activation_requires_approval": {
      "condition": {
        "operation": "activate_source",
        "source_approval_recorded": false
      },
      "description": "Virtual sources require approval before activation.",
      "effect": {
        "decision": "require_review",
        "reason": "source_approval_required",
        "required_action": "record_source_approval"
      },
      "name": "source_activation_requires_approval"
    },
    "source_connection_requires_encryption": {
      "condition": {
        "connection_encrypted": false,
        "operation": "register_source"
      },
      "description": "Virtual source connections require encryption.",
      "effect": {
        "decision": "deny",
        "reason": "connection_encryption_required",
        "required_action": "enable_connection_encryption"
      },
      "name": "source_connection_requires_encryption"
    },
    "source_registration_requires_credentials": {
      "condition": {
        "credentials_vaulted": false,
        "operation": "register_source"
      },
      "description": "Virtual sources require vaulted credentials.",
      "effect": {
        "decision": "deny",
        "reason": "vaulted_credentials_required",
        "required_action": "store_credentials_in_keym"
      },
      "name": "source_registration_requires_credentials"
    },
    "source_registration_requires_owner": {
      "condition": {
        "operation": "register_source",
        "source_owner_assigned": false
      },
      "description": "Virtual sources require an accountable owner.",
      "effect": {
        "decision": "deny",
        "reason": "source_owner_required",
        "required_action": "assign_source_owner"
      },
      "name": "source_registration_requires_owner"
    },
    "source_retirement_requires_impact_review": {
      "condition": {
        "impact_review_recorded": false,
        "operation": "retire_source"
      },
      "description": "Retiring a virtual source requires impact review.",
      "effect": {
        "decision": "deny",
        "reason": "impact_review_required",
        "required_action": "record_source_impact_review"
      },
      "name": "source_retirement_requires_impact_review"
    },
    "source_type_must_be_supported": {
      "condition": {
        "operation": "register_source",
        "unsupported_source_type": true
      },
      "description": "Virtual source type must be configured for the tenant.",
      "effect": {
        "decision": "deny",
        "reason": "unsupported_source_type",
        "required_action": "choose_supported_source_type"
      },
      "name": "source_type_must_be_supported"
    },
    "tenant_context_required": {
      "condition": {
        "tenant_context_present": false
      },
      "description": "All virtualization operations require tenant context.",
      "effect": {
        "decision": "deny",
        "reason": "tenant_context_required",
        "required_action": "attach_tenant_context"
      },
      "name": "tenant_context_required"
    },
    "virtual_table_requires_classification": {
      "condition": {
        "classification_complete": false,
        "operation": "publish_virtual_table"
      },
      "description": "Virtual tables require data classification before publication.",
      "effect": {
        "decision": "deny",
        "reason": "classification_required",
        "required_action": "classify_virtual_table"
      },
      "name": "virtual_table_requires_classification"
    },
    "virtual_table_requires_owner": {
      "condition": {
        "operation": "publish_virtual_table",
        "virtual_table_owner_assigned": false
      },
      "description": "Virtual tables require an accountable owner.",
      "effect": {
        "decision": "deny",
        "reason": "virtual_table_owner_required",
        "required_action": "assign_virtual_table_owner"
      },
      "name": "virtual_table_requires_owner"
    },
    "write_query_blocked": {
      "condition": {
        "operation": "execute_query",
        "write_query": true
      },
      "description": "DVRL generated-app queries are read-only by default.",
      "effect": {
        "decision": "deny",
        "reason": "write_query_blocked",
        "required_action": "route_to_write_capability"
      },
      "name": "write_query_blocked"
    }
  },
