            "path": "/dvrl/metrics",
            "permission": "dvrl:view_metrics"
          },
          {
            "component": "DVRLSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/dvrl/settings",
            "permission": "dvrl:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
