{
  "agents": {},
  "app": {
    "description": "AI Agent Composition package-backed APG capability",
    "entity_count": 0,
    "name": "agnt",
    "version": "1.0.0"
  },
  "capabilities": {
    "agnt": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "agents": {
          "io_contract_required": true,
          "model_required": true,
          "runtime_required": true,
          "system_prompt_required": true,
          "tool_allowlist_required": true
        },
        "governance": {
          "audit_agent_runs": true,
          "cost_limit_required": true,
          "human_approval_for_external_side_effects": true,
          "require_tenant_context": true
        },
        "memory": {
          "memory_store_required": true,
          "retention_policy_required": true,
          "sensitive_memory_redaction_required": true,
          "vector_memory_supported": true
        },
        "runtimes": {
          "default_runtime": "local",
          "external_runtime_approval_required": true,
          "registered": [
            "local",
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ],
          "workspace_sandbox_required": true
        },
        "teams": {
          "cycle_review_required": true,
          "handoff_validation_required": true,
          "minimum_agents": 1,
          "parallel_execution_enabled": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "agnt_agent_ops"
        },
        "ui": {
          "enable_agent_registry": true,
          "enable_execution_trace": true,
          "enable_runtime_manager": true,
          "enable_team_builder": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "AI Agent Composition",
      "provides": [
        "agnt_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All agent-composition operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "model_present": false,
              "operation": "register_agent"
            },
            "description": "First-class AI agents require a model.",
            "effect": {
              "decision": "deny",
              "reason": "agent_model_required",
              "required_action": "declare_agent_model"
            },
            "name": "agent_requires_model"
          },
          {
            "condition": {
              "runtime_registered": false
            },
            "description": "Agent runtimes must resolve to a registered backend.",
            "effect": {
              "decision": "deny",
              "reason": "runtime_not_registered",
              "required_action": "register_runtime_backend"
            },
            "name": "agent_runtime_must_be_registered"
          },
          {
            "condition": {
              "agent_count_lt": 1,
              "operation": "register_team"
            },
            "description": "Agent teams require at least one member.",
            "effect": {
              "decision": "deny",
              "reason": "team_agent_required",
              "required_action": "add_team_agent"
            },
            "name": "team_requires_agent"
          },
          {
            "condition": {
              "handoff_endpoint_resolved": false
            },
            "description": "Handoff graph endpoints must resolve to declared agents.",
            "effect": {
              "decision": "deny",
              "reason": "handoff_endpoint_unknown",
              "required_action": "fix_handoff_reference"
            },
            "name": "handoff_endpoint_must_resolve"
          },
          {
            "condition": {
              "sandbox_policy_attached": false,
              "workspace_runtime": true
            },
            "description": "Workspace-aware agent runtimes require sandbox policy.",
            "effect": {
              "decision": "deny",
              "reason": "workspace_sandbox_required",
              "required_action": "attach_sandbox_policy"
            },
            "name": "workspace_runtime_requires_sandbox"
          },
          {
            "condition": {
              "approval_recorded": false,
              "external_runtime": true
            },
            "description": "External agent backends require approval before use.",
            "effect": {
              "decision": "require_review",
              "reason": "external_runtime_approval_required",
              "required_action": "review_external_runtime"
            },
            "name": "external_runtime_requires_approval"
          }
        ],
        "type": "deterministic"
      },
