      "ui": {
        "api_prefix": "/mten/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "MultiTenantDashboard",
            "name": "dashboard",
            "nav_group": "Overview",
            "path": "/mten/dashboard",
            "permission": "mten:view"
          },
          {
            "component": "TenantPortfolioView",
            "name": "tenants",
            "nav_group": "Operations",
            "path": "/mten/tenants",
