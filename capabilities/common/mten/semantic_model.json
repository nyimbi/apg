      "runtime": {
        "api": "api.py",
        "api_helpers": "api_helpers.py",
        "entrypoint": "app.py",
        "runtime": "mten_runtime.py",
        "service": "service.py",
        "view_models": "view_models.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "TenantAgentRoster",
          "permission": "mten:admin",
          "route": "/mten/agents"
        },
        "analytics": {
          "component": "TenantAnalyticsHub",
          "permission": "mten:view_analytics",
          "route": "/mten/analytics"
        },
        "audit": {
          "component": "TenantGovernanceTimeline",
          "permission": "mten:view",
          "route": "/mten/audit"
        },
        "capacity_approvals": {
          "component": "CapacityApprovalQueue",
          "permission": "mten:approve_capacity",
          "route": "/mten/capacity/approvals"
        },
        "dashboard": {
          "component": "MultiTenantDashboard",
          "permission": "mten:view",
          "route": "/mten/dashboard"
        },
        "isolation": {
          "component": "TenantIsolationIncidentCenter",
          "permission": "mten:admin",
