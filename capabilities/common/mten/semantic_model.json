          },
          {
            "component": "TenantAnalyticsHub",
            "name": "analytics",
            "nav_group": "Intelligence",
            "path": "/mten/analytics",
            "permission": "mten:view_analytics"
          },
          {
            "component": "ResourceOptimizationWorkbench",
