      "first_class": true,
      "guardrails": [
        "tenant_agent_runtime_supported",
        "tenant_agent_role_supported",
        "tenant_agent_privileged_action_requires_approval"
      ],
      "privileged_roles": [
        "capacity_reviewer",
        "compliance_reviewer",
        "isolation_reviewer",
        "migration_reviewer"
      ],
      "supported_roles": [
        "tenant_provisioner",
        "isolation_reviewer",
        "capacity_reviewer",
        "migration_reviewer",
        "resource_optimizer",
        "compliance_reviewer",
        "tenant_support"
      ],
      "supported_runtimes": [
