            "path": "/mten/isolation",
            "permission": "mten:admin"
          },
          {
            "component": "LiveMigrationQueue",
            "name": "live_migrations",
            "nav_group": "Operations",
            "path": "/mten/migrations",
            "permission": "mten:migrate"
          },
          {
            "component": "TenantTemplateCatalog",
