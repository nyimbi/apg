      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "SecurityAgentRoster",
          "permission": "secu:admin",
          "route": "/secu/agents"
        },
        "audit": {
          "component": "SecurityAuditTimeline",
