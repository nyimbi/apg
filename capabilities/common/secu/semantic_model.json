          "route": "/secu/policies"
        },
        "quarantine": {
          "component": "DeviceQuarantineConsole",
          "permission": "secu:respond",
          "route": "/secu/quarantine"
        },
        "risk": {
          "component": "RiskAssessmentConsole",
