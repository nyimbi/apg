        "agents": {
          "component": "DeliveryAgentPanel",
          "permission": "cicd:promote",
          "route": "/cicd/agents"
        },
        "analytics": {
          "component": "PipelineAnalytics",
          "permission": "cicd:view",
          "route": "/cicd/analytics"
        },
        "artifacts": {
          "component": "ArtifactRegistry",
          "permission": "cicd:view",
          "route": "/cicd/artifacts"
        },
        "audit": {
