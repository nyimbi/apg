        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All CI/CD operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_pipeline",
              "pipeline_owner_assigned": false
            },
            "description": "Pipelines require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "pipeline_owner_required",
              "required_action": "assign_pipeline_owner"
            },
            "name": "pipeline_requires_owner"
          },
          {
            "condition": {
              "operation": "run_build",
              "secret_scope_attached": false
            },
            "description": "Builds require secret scope policy.",
            "effect": {
              "decision": "deny",
              "reason": "secret_scope_required",
              "required_action": "attach_secret_scope"
            },
            "name": "build_requires_secret_scope"
          },
          {
            "condition": {
              "artifact_promotion_requested": true,
              "artifact_signed": false
            },
            "description": "Promotion artifacts require signatures.",
            "effect": {
              "decision": "deny",
              "reason": "artifact_signature_required",
              "required_action": "sign_artifact"
            },
            "name": "artifact_requires_signature"
          },
          {
            "condition": {
              "operation": "promote_artifact",
              "quality_gate_passed": false
            },
            "description": "Promotions require passing quality gates.",
            "effect": {
              "decision": "deny",
              "reason": "quality_gate_required",
              "required_action": "pass_quality_gate"
            },
            "name": "promotion_requires_quality_gate"
          },
          {
            "condition": {
              "capacity_review_recorded": false,
              "parallel_job_count_gt": 100
            },
            "description": "High parallelism requires capacity review.",
            "effect": {
              "decision": "require_review",
              "reason": "capacity_review_required",
              "required_action": "review_pipeline_capacity"
            },
            "name": "high_parallelism_requires_review"
          }
        ],
        "type": "deterministic"
      },
