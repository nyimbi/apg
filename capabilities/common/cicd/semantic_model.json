{
  "agents": {},
  "app": {
    "description": "Continuous Integration and Delivery package-backed APG capability",
    "entity_count": 0,
    "name": "cicd",
    "version": "1.0.0"
  },
  "capabilities": {
    "cicd": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "adapters": {
          "api_helpers": "api.py",
          "audit_sink": "audl",
          "deployment": "depl",
          "environment": "envm",
          "event_stream": "bytewax",
          "generated_app_runtime": "service.CicdService",
          "logs": "logt",
          "monitoring": "moni",
          "notifications": "ntfy",
          "secrets": "scpt",
          "view_models": "views.py"
        },
        "builds": {
          "cache_policy_required": true,
          "log_trace_capture_required": true,
          "secret_scope_required": true,
          "worker_pool_required": true
        },
        "delivery_agents": {
          "agent_assist_enabled": true,
          "agent_contribution_disclosure_required": true,
          "agent_registration_required": true,
          "agent_runtime_required": true,
          "agent_scope_required": true,
          "allowed_roles": [
            "pipeline_designer",
            "build_operator",
            "security_reviewer",
            "release_manager",
            "incident_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "gates": {
          "artifact_signature_required": true,
          "promotion_approval_required": true,
          "quality_gate_required": true,
          "security_scan_required": true
        },
        "governance": {
          "audit_pipeline_runs": true,
          "batch_event_stream": "bytewax",
          "environment_policy_required": true,
          "require_tenant_context": true,
          "separation_of_duties_required": true,
          "state_change_reason_required": true,
          "tenant_isolation_required": true
        },
        "observability": {
          "agent_activity_required": true,
          "audit_required": true,
          "event_stream": "bytewax",
          "quality_metrics_required": true,
          "trace_required": true
        },
        "pipelines": {
          "max_parallel_jobs": 100,
          "pipeline_owner_required": true,
          "source_policy_required": true,
          "versioning_enabled": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "cicd_pipeline_ops"
        },
        "ui": {
          "enable_agent_panel": true,
          "enable_analytics": true,
          "enable_artifact_registry": true,
          "enable_audit": true,
          "enable_build_monitor": true,
          "enable_gate_dashboard": true,
          "enable_pipeline_console": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Continuous Integration and Delivery",
      "provides": [
        "pipeline_management",
        "build_orchestration",
        "quality_gates",
        "artifact_promotion",
        "release_automation",
        "delivery_agents"
      ],
      "requires": [
        "depl",
        "envm",
        "logt"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All CI/CD operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_pipeline",
              "pipeline_owner_assigned": false
            },
            "description": "Pipelines require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "pipeline_owner_required",
              "required_action": "assign_pipeline_owner"
            },
            "name": "pipeline_requires_owner"
          },
          {
            "condition": {
              "operation": "run_build",
              "secret_scope_attached": false
            },
            "description": "Builds require secret scope policy.",
            "effect": {
              "decision": "deny",
              "reason": "secret_scope_required",
              "required_action": "attach_secret_scope"
            },
            "name": "build_requires_secret_scope"
          },
          {
            "condition": {
              "artifact_promotion_requested": true,
              "artifact_signed": false
            },
            "description": "Promotion artifacts require signatures.",
            "effect": {
              "decision": "deny",
              "reason": "artifact_signature_required",
              "required_action": "sign_artifact"
            },
            "name": "artifact_requires_signature"
          },
          {
            "condition": {
              "operation": "promote_artifact",
              "quality_gate_passed": false
            },
            "description": "Promotions require passing quality gates.",
            "effect": {
              "decision": "deny",
              "reason": "quality_gate_required",
              "required_action": "pass_quality_gate"
            },
            "name": "promotion_requires_quality_gate"
          },
          {
            "condition": {
              "capacity_review_recorded": false,
              "parallel_job_count_gt": 100
            },
            "description": "High parallelism requires capacity review.",
            "effect": {
              "decision": "require_review",
              "reason": "capacity_review_required",
              "required_action": "review_pipeline_capacity"
            },
            "name": "high_parallelism_requires_review"
          },
          {
            "condition": {
              "operation": "create_pipeline",
              "source_policy_attached": false
            },
            "description": "Pipelines require source policy references.",
            "effect": {
              "decision": "deny",
              "reason": "source_policy_required",
              "required_action": "attach_source_policy"
            },
            "name": "pipeline_requires_source_policy"
          },
          {
            "condition": {
              "operation": "create_pipeline",
              "worker_pool_attached": false
            },
            "description": "Pipelines require worker pool assignment.",
            "effect": {
              "decision": "deny",
              "reason": "worker_pool_required",
              "required_action": "assign_worker_pool"
            },
            "name": "pipeline_requires_worker_pool"
          },
          {
            "condition": {
              "operation": "create_pipeline",
              "stage_count_lte": 0
            },
            "description": "Pipelines require at least one stage.",
            "effect": {
              "decision": "deny",
              "reason": "pipeline_stages_required",
              "required_action": "define_pipeline_stages"
            },
            "name": "pipeline_requires_stages"
          },
          {
            "condition": {
              "operation": "create_pipeline",
              "secret_scope_attached": false
            },
            "description": "Pipelines require secret scope policy.",
            "effect": {
              "decision": "deny",
              "reason": "secret_scope_required",
              "required_action": "attach_secret_scope"
            },
            "name": "pipeline_requires_secret_scope"
          },
          {
            "condition": {
              "cache_policy_attached": false,
              "operation": "create_pipeline"
            },
            "description": "Pipelines require build cache policy.",
            "effect": {
              "decision": "deny",
              "reason": "cache_policy_required",
              "required_action": "attach_cache_policy"
            },
            "name": "pipeline_requires_cache_policy"
          },
          {
            "condition": {
              "operation": "create_pipeline",
              "quality_gate_attached": false
            },
            "description": "Pipelines require quality gate policy.",
            "effect": {
              "decision": "deny",
              "reason": "quality_gate_required",
              "required_action": "attach_quality_gate"
            },
            "name": "pipeline_requires_quality_gate"
          },
          {
            "condition": {
              "log_trace_captured": false,
              "operation": "run_build"
            },
            "description": "Builds require trace and log capture.",
            "effect": {
              "decision": "deny",
              "reason": "log_trace_capture_required",
              "required_action": "enable_log_trace_capture"
            },
            "name": "build_requires_trace_capture"
          },
          {
            "condition": {
              "operation": "record_quality_gate",
              "security_scan_passed": false
            },
            "description": "Quality gates require security scan evidence.",
            "effect": {
              "decision": "deny",
              "reason": "security_scan_required",
              "required_action": "run_security_scan"
            },
            "name": "gate_requires_security_scan"
          },
          {
            "condition": {
              "approval_recorded": false,
              "operation": "promote_artifact"
            },
            "description": "Promotions require explicit approval evidence.",
            "effect": {
              "decision": "deny",
              "reason": "promotion_approval_required",
              "required_action": "record_promotion_approval"
            },
            "name": "promotion_requires_approval"
          },
          {
            "condition": {
              "environment_policy_attached": false,
              "operation": "promote_artifact"
            },
            "description": "Promotions require source and target environment policy.",
            "effect": {
              "decision": "deny",
              "reason": "environment_policy_required",
              "required_action": "attach_environment_policy"
            },
            "name": "promotion_requires_environment_policy"
          },
          {
            "condition": {
              "operation": "promote_artifact",
              "separation_of_duties_met": false
            },
            "description": "Promotions require release requester and approver separation.",
            "effect": {
              "decision": "deny",
              "reason": "separation_of_duties_required",
              "required_action": "assign_independent_approver"
            },
            "name": "promotion_requires_separation_of_duties"
          },
          {
            "condition": {
              "agent_registered": false,
              "delivery_agent_present": true
            },
            "description": "AI delivery agents must be registered.",
            "effect": {
              "decision": "deny",
              "reason": "delivery_agent_registration_required",
              "required_action": "register_delivery_agent"
            },
            "name": "delivery_agent_requires_registration"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "delivery_agent_present": true
            },
            "description": "AI delivery agents must use a supported runtime.",
            "effect": {
              "decision": "deny",
              "reason": "delivery_agent_runtime_not_supported",
              "required_action": "choose_supported_delivery_agent_runtime"
            },
            "name": "delivery_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "delivery_agent_present": true
            },
            "description": "AI delivery agents must use a supported role.",
            "effect": {
              "decision": "deny",
              "reason": "delivery_agent_role_not_supported",
              "required_action": "choose_supported_delivery_agent_role"
            },
            "name": "delivery_agent_role_supported"
          },
          {
            "condition": {
              "agent_scope_present": false,
              "delivery_agent_present": true
            },
            "description": "AI delivery agents require explicit scope.",
            "effect": {
              "decision": "deny",
              "reason": "delivery_agent_scope_required",
              "required_action": "set_delivery_agent_scope"
            },
            "name": "delivery_agent_requires_scope"
          },
          {
            "condition": {
              "agent_contribution_disclosed": false,
              "delivery_agent_present": true
            },
            "description": "AI delivery-agent contributions require disclosure.",
            "effect": {
              "decision": "deny",
              "reason": "delivery_agent_disclosure_required",
              "required_action": "disclose_delivery_agent"
            },
            "name": "delivery_agent_requires_disclosure"
          },
          {
            "condition": {
              "state_change_reason_present": false,
              "state_change_requested": true
            },
            "description": "Pipeline lifecycle state changes require a reason.",
            "effect": {
              "decision": "deny",
              "reason": "cicd_state_change_reason_required",
              "required_action": "record_state_change_reason"
            },
            "name": "cicd_state_change_requires_reason"
          },
          {
            "condition": {
              "audit_event_recorded": false,
              "state_change_requested": true
            },
            "description": "Pipeline lifecycle state changes require audit evidence.",
            "effect": {
              "decision": "deny",
              "reason": "cicd_audit_event_required",
              "required_action": "record_cicd_audit_event"
            },
            "name": "cicd_state_change_requires_audit"
          },
          {
            "condition": {
              "cross_tenant_access": true
            },
            "description": "CI/CD records may not cross tenant boundaries.",
            "effect": {
              "decision": "deny",
              "reason": "cross_tenant_pipeline_access_denied",
              "required_action": "use_tenant_local_context"
            },
            "name": "cross_tenant_pipeline_access_denied"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "batch_pipeline_mutation"
            },
            "description": "Batch pipeline mutations must use Bytewax event streams.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "use_bytewax_event_stream"
            },
            "name": "batch_pipeline_mutation_requires_bytewax"
          }
        ],
        "type": "deterministic"
      },
