{
  "agents": {},
  "app": {
    "description": "Website Builder package-backed APG capability",
    "entity_count": 0,
    "name": "wsbl",
    "version": "1.0.0"
  },
  "capabilities": {
    "wsbl": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "adapters": {
          "accessibility": "adapter",
          "analytics": "adapter",
          "authorization": "adapter",
          "consent": "adapter",
          "event_stream": "bytewax",
          "theme": "adapter"
        },
        "governance": {
          "audit_publication_changes": true,
          "component_policy_required": true,
          "public_site_controls_required": true,
          "require_tenant_context": true,
          "state_change_audit_required": true
        },
        "observability": {
          "emit_page_events": true,
          "emit_publish_events": true,
          "emit_site_events": true,
          "event_stream": "apg.wsbl.lifecycle",
          "stream_processor": "bytewax"
        },
        "pages": {
          "content_versioning_enabled": true,
          "custom_component_review_required": true,
          "draft_autosave_enabled": true,
          "page_review_required": true,
          "structured_sections_required": true
        },
        "publishing": {
          "accessibility_pass_required": true,
          "approval_required": true,
          "privacy_banner_policy_required": true,
          "publish_stream_required": true,
          "rollback_supported": true
        },
        "sites": {
          "domain_validation_required": true,
          "environment_preview_enabled": true,
          "multi_locale_enabled": true,
          "preview_evidence_required": true,
          "site_owner_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "wsbl_site_builder"
        },
        "ui": {
          "enable_agent_workbench": true,
          "enable_component_library": true,
          "enable_page_editor": true,
          "enable_policy_center": true,
          "enable_publish_queue": true,
          "enable_site_console": true
        },
        "wsbl_agents": {
          "disclose_agent_recommendations": true,
          "enabled": true,
          "human_approval_required": true,
          "max_autonomous_scope": "non_privileged",
          "supported_roles": [
            "site_reviewer",
            "component_reviewer",
            "accessibility_reviewer",
            "privacy_reviewer",
            "publish_reviewer",
            "seo_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Website Builder",
      "provides": [
        "site_management",
        "page_composition",
        "component_library",
        "publishing_workflows",
        "site_theming",
        "website_governance",
        "wsbl_agents"
      ],
      "requires": [
        "them",
        "auth",
        "ncod",
        "accs",
        "cons"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All website-builder operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_site",
              "site_owner_assigned": false
            },
            "description": "Sites require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "site_owner_required",
              "required_action": "assign_site_owner"
            },
            "name": "site_requires_owner"
          },
          {
            "condition": {
              "domain_validation_complete": false,
              "operation": "publish_site"
            },
            "description": "Publishing requires validated site domains.",
            "effect": {
              "decision": "deny",
              "reason": "domain_validation_required",
              "required_action": "validate_site_domains"
            },
            "name": "domain_requires_validation_before_publish"
          },
          {
            "condition": {
              "operation": "publish_site",
              "structured_sections_present": false
            },
            "description": "Publishing requires at least one structured page section.",
            "effect": {
              "decision": "deny",
              "reason": "structured_sections_required",
              "required_action": "add_structured_page_sections"
            },
            "name": "page_requires_structured_sections"
          },
          {
            "condition": {
              "operation": "publish_site",
              "preview_evidence_present": false
            },
            "description": "Publishing requires preview evidence for the target environment.",
            "effect": {
              "decision": "deny",
              "reason": "preview_evidence_required",
              "required_action": "attach_environment_preview"
            },
            "name": "preview_requires_evidence"
          },
          {
            "condition": {
              "approval_recorded": false,
              "operation": "publish_site"
            },
            "description": "Site publishing requires approval.",
            "effect": {
              "decision": "deny",
              "reason": "site_publish_approval_required",
              "required_action": "record_publish_approval"
            },
            "name": "publish_requires_approval"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "publish_site"
            },
            "description": "Site publishing lifecycle events must be emitted through Bytewax.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_publish_lifecycle_to_bytewax"
            },
            "name": "publish_requires_bytewax_stream"
          },
          {
            "condition": {
              "component_review_recorded": false,
              "custom_component_present": true,
              "operation": "add_page_section"
            },
            "description": "Custom components require review before use.",
            "effect": {
              "decision": "deny",
              "reason": "component_review_required",
              "required_action": "review_custom_component"
            },
            "name": "custom_component_requires_review"
          },
          {
            "condition": {
              "component_policy_attached": false,
              "custom_component_present": true,
              "operation": "review_component"
            },
            "description": "Custom components require component policy attribution.",
            "effect": {
              "decision": "deny",
              "reason": "component_policy_required",
              "required_action": "attach_component_policy"
            },
            "name": "custom_component_requires_policy"
          },
          {
            "condition": {
              "accessibility_passed": false,
              "operation": "publish_site",
              "public_site": true
            },
            "description": "Public sites require an accessibility pass.",
            "effect": {
              "decision": "deny",
              "reason": "accessibility_pass_required",
              "required_action": "complete_accessibility_pass"
            },
            "name": "public_site_requires_accessibility_pass"
          },
          {
            "condition": {
              "consent_policy_attached": false,
              "operation": "publish_site",
              "privacy_banner_required": true
            },
            "description": "Privacy banners require an attached consent policy.",
            "effect": {
              "decision": "require_review",
              "reason": "consent_policy_required",
              "required_action": "attach_consent_policy"
            },
            "name": "privacy_banner_requires_consent_policy"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "rollback_site"
            },
            "description": "Rollback lifecycle events must be emitted through Bytewax.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_rollback_lifecycle_to_bytewax"
            },
            "name": "rollback_requires_bytewax_stream"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "batch_publish"
            },
            "description": "Batch site publishing requires Bytewax stream coordination.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_batch_publish_to_bytewax"
            },
            "name": "batch_publish_requires_bytewax"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "operation": "register_wsbl_agent"
            },
            "description": "Website builder agents must use an approved runtime.",
            "effect": {
              "decision": "deny",
              "reason": "wsbl_agent_runtime_not_supported",
              "required_action": "select_supported_agent_runtime"
            },
            "name": "wsbl_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "operation": "register_wsbl_agent"
            },
            "description": "Website builder agents must use an approved role.",
            "effect": {
              "decision": "deny",
              "reason": "wsbl_agent_role_not_supported",
              "required_action": "select_supported_agent_role"
            },
            "name": "wsbl_agent_role_supported"
          },
          {
            "condition": {
              "human_approval_recorded": false,
              "operation": "agent_publish_action",
              "privileged_scope": true
            },
            "description": "Privileged publishing actions proposed by agents require human approval.",
            "effect": {
              "decision": "deny",
              "reason": "human_approval_required",
              "required_action": "record_human_approval"
            },
            "name": "privileged_agent_publish_action_requires_human_approval"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
        {
          "condition": {
            "tenant_context_present": false
          },
          "description": "All website-builder operations require tenant context.",
