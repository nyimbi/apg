        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All website-builder operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_site",
              "site_owner_assigned": false
            },
            "description": "Sites require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "site_owner_required",
              "required_action": "assign_site_owner"
            },
            "name": "site_requires_owner"
          },
          {
            "condition": {
              "approval_recorded": false,
              "operation": "publish_site"
            },
            "description": "Site publishing requires approval.",
            "effect": {
              "decision": "deny",
              "reason": "site_publish_approval_required",
              "required_action": "record_publish_approval"
            },
            "name": "publish_requires_approval"
          },
          {
            "condition": {
              "component_review_recorded": false,
              "custom_component_present": true
            },
            "description": "Custom components require review before use.",
            "effect": {
              "decision": "deny",
              "reason": "component_review_required",
              "required_action": "review_custom_component"
            },
            "name": "custom_component_requires_review"
          },
          {
            "condition": {
              "accessibility_passed": false,
              "public_site": true
            },
            "description": "Public sites require an accessibility pass.",
            "effect": {
              "decision": "deny",
              "reason": "accessibility_pass_required",
              "required_action": "complete_accessibility_pass"
            },
            "name": "public_site_requires_accessibility_pass"
          },
          {
            "condition": {
              "consent_policy_attached": false,
              "privacy_banner_required": true
            },
            "description": "Privacy banners require an attached consent policy.",
            "effect": {
              "decision": "require_review",
              "reason": "consent_policy_required",
              "required_action": "attach_consent_policy"
            },
            "name": "privacy_banner_requires_consent_policy"
          }
        ],
        "type": "deterministic"
      },
