      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "WSBLAgentWorkbench",
          "permission": "wsbl:admin",
          "route": "/wsbl/agents"
        },
        "analytics": {
          "component": "SiteAnalytics",
          "permission": "wsbl:view",
          "route": "/wsbl/analytics"
        },
        "components": {
          "component": "ComponentLibrary",
          "permission": "wsbl:build",
          "route": "/wsbl/components"
        },
        "dashboard": {
          "component": "WSBLDashboard",
          "permission": "wsbl:view",
          "route": "/wsbl/dashboard"
        },
        "editor": {
          "component": "PageEditor",
          "permission": "wsbl:build",
          "route": "/wsbl/editor"
        },
        "pages": {
          "component": "PageLibrary",
          "permission": "wsbl:build",
          "route": "/wsbl/pages"
        },
        "policy": {
          "component": "WSBLPolicyCenter",
          "permission": "wsbl:admin",
          "route": "/wsbl/policy"
        },
        "publishing": {
          "component": "PublishQueue",
          "permission": "wsbl:publish",
          "route": "/wsbl/publishing"
        },
        "settings": {
          "component": "WSBLSettings",
          "permission": "wsbl:admin",
          "route": "/wsbl/settings"
        },
        "sites": {
          "component": "SiteConsole",
          "permission": "wsbl:manage_sites",
          "route": "/wsbl/sites"
        }
      },
      "streaming": {
        "events": [
          "site_created",
          "domain_registered",
          "domain_validated",
          "component_created",
          "component_reviewed",
          "page_created",
          "page_section_added",
          "publish_request_created",
          "site_published",
          "site_rolled_back",
          "wsbl_agent_registered"
        ],
        "guardrails": [
          "publish_requires_bytewax_stream",
          "rollback_requires_bytewax_stream",
          "batch_publish_requires_bytewax",
          "privileged_agent_publish_action_requires_human_approval"
        ],
        "key": "tenant_id",
        "processor": "bytewax",
        "states": [
          "draft",
          "domain_pending",
          "ready",
          "review_required",
          "approved",
          "published",
          "rolled_back",
          "blocked"
        ],
        "stream": "apg.wsbl.lifecycle"
      },
      "theme": {
        "components": {
          "agent_workbench": {
            "status_style": "approval-chip",
            "visual": "review-lane"
          },
          "analytics_panel": {
            "status_style": "trend-chip",
            "visual": "traffic-grid"
          },
          "page_editor": {
            "highlight": "component-chip",
            "visual": "section-builder"
          },
          "policy_center": {
            "status_style": "guardrail-chip",
            "visual": "rule-grid"
          },
          "publish_queue": {
            "status_style": "approval-chip",
            "visual": "release-checklist"
          },
          "site_card": {
            "icon": "layout-template",
            "risk_style": "publish-band",
            "status_indicator": "site-pill"
          }
        },
        "name": "wsbl_site_builder",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#38A169",
          "color.danger": "#C53030",
          "color.primary": "#2C5282",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7F8FA",
          "surface.panel": "#FFFFFF",
          "text.primary": "#172033",
          "text.secondary": "#52606D"
        }
      },
      "ui": {
        "api_prefix": "/wsbl/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "WSBLDashboard",
            "name": "dashboard",
            "nav_group": "Overview",
            "path": "/wsbl/dashboard",
            "permission": "wsbl:view"
          },
          {
            "component": "SiteConsole",
            "name": "sites",
            "nav_group": "Sites",
            "path": "/wsbl/sites",
            "permission": "wsbl:manage_sites"
          },
          {
            "component": "PageLibrary",
            "name": "pages",
            "nav_group": "Pages",
            "path": "/wsbl/pages",
            "permission": "wsbl:build"
          },
          {
            "component": "PageEditor",
            "name": "editor",
            "nav_group": "Build",
            "path": "/wsbl/editor",
            "permission": "wsbl:build"
          },
          {
            "component": "ComponentLibrary",
            "name": "components",
            "nav_group": "Build",
            "path": "/wsbl/components",
            "permission": "wsbl:build"
          },
          {
            "component": "PublishQueue",
            "name": "publishing",
            "nav_group": "Release",
            "path": "/wsbl/publishing",
            "permission": "wsbl:publish"
          },
          {
            "component": "SiteAnalytics",
            "name": "analytics",
            "nav_group": "Operations",
            "path": "/wsbl/analytics",
            "permission": "wsbl:view"
          },
          {
            "component": "WSBLAgentWorkbench",
            "name": "agents",
            "nav_group": "Automation",
            "path": "/wsbl/agents",
            "permission": "wsbl:admin"
          },
          {
            "component": "WSBLPolicyCenter",
            "name": "policy",
            "nav_group": "Governance",
            "path": "/wsbl/policy",
            "permission": "wsbl:admin"
          },
          {
            "component": "WSBLSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/wsbl/settings",
            "permission": "wsbl:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
      }
