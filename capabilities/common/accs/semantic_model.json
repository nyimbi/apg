          },
          "compliance_panel": {
            "status_style": "evidence-chip",
            "visual": "standard-matrix"
          },
          "exception_board": {
            "status_style": "risk-acceptance-chip",
            "visual": "expiry-list"
          },
          "finding_board": {
            "highlight": "blocked-chip",
            "visual": "kanban-list"
          }
        },
        "name": "accs_accessibility_ops",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#3182CE",
          "color.danger": "#C53030",
          "color.primary": "#22543D",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7F8FA",
          "surface.panel": "#FFFFFF",
          "text.primary": "#172033",
          "text.secondary": "#52606D"
        }
      },
      "ui": {
        "api_prefix": "/accs/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "ACCSDashboard",
