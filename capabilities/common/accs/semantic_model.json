{
  "agents": {},
  "app": {
    "description": "Accessibility Services package-backed APG capability",
    "entity_count": 0,
    "name": "accs",
    "version": "1.0.0"
  },
  "capabilities": {
    "accs": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "accessibility_agents": {
          "agent_assist_enabled": true,
          "agent_contribution_disclosure_required": true,
          "agent_registration_required": true,
          "agent_runtime_required": true,
          "agent_scope_required": true,
          "allowed_roles": [
            "audit_reviewer",
            "remediation_planner",
            "caption_reviewer",
            "standards_advisor",
            "release_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "adapters": {
          "api_helpers": "api.py",
          "audit_sink": "audl",
          "compliance": "comp",
          "event_stream": "bytewax",
          "generated_app_runtime": "service.AccsService",
          "i18n": "i18n",
          "nlp_guidance": "nlpc",
          "theme": "them",
          "view_models": "views.py"
        },
        "assistive": {
          "keyboard_navigation_required": true,
          "media_captions_required": true,
          "screen_reader_preview_enabled": true,
          "semantic_labels_required": true
        },
        "audits": {
          "audit_standard_required": true,
          "automated_checks_enabled": true,
          "critical_issue_review_required": true,
          "published_ui_contrast_required": true
        },
        "governance": {
          "audit_change_logging": true,
          "batch_event_stream": "bytewax",
          "compliance_exports_enabled": true,
          "remediation_owner_required": true,
          "require_tenant_context": true,
          "state_change_reason_required": true,
          "tenant_isolation_required": true
        },
        "observability": {
          "accessibility_metrics_required": true,
          "agent_activity_required": true,
          "audit_required": true,
          "event_stream": "bytewax",
          "trace_required": true
        },
        "standards": {
          "default_standard": "WCAG-2.2-AA",
          "localized_guidance_enabled": true,
          "policy_versioning_enabled": true,
          "standard_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "accs_accessibility_ops"
        },
        "ui": {
          "enable_agent_panel": true,
          "enable_analytics": true,
          "enable_assistive_preview": true,
          "enable_audit_console": true,
          "enable_audit_events": true,
          "enable_findings_board": true,
          "enable_remediation_queue": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Accessibility Services",
      "provides": [
        "accessibility_audits",
        "remediation_workflows",
        "accessibility_exceptions",
        "assistive_metadata",
        "media_accessibility",
        "standards_governance",
        "accessibility_agents"
      ],
      "requires": [
        "them",
        "i18n",
        "nlpc"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All accessibility operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "start_audit",
              "standard_selected": false
            },
            "description": "Accessibility audits require a selected standard.",
            "effect": {
              "decision": "deny",
              "reason": "audit_standard_required",
              "required_action": "select_accessibility_standard"
            },
            "name": "audit_requires_standard"
          },
          {
            "condition": {
              "remediation_owner_assigned": false,
              "violation_detected": true
            },
            "description": "Accessibility findings require a remediation owner.",
            "effect": {
              "decision": "deny",
              "reason": "remediation_owner_required",
              "required_action": "assign_remediation_owner"
            },
            "name": "violation_requires_remediation_owner"
          },
          {
            "condition": {
              "contrast_passed": false,
              "published_ui": true
            },
            "description": "Published UI requires contrast validation.",
            "effect": {
              "decision": "deny",
              "reason": "contrast_validation_required",
              "required_action": "fix_contrast"
            },
            "name": "published_ui_requires_contrast"
          },
          {
            "condition": {
              "captions_available": false,
              "media_content_present": true
            },
            "description": "Media content requires captions or transcripts.",
            "effect": {
              "decision": "deny",
              "reason": "captions_required",
              "required_action": "add_captions_or_transcript"
            },
            "name": "media_requires_captions"
          },
          {
            "condition": {
              "issue_severity": "critical",
              "review_recorded": false
            },
            "description": "Critical accessibility issues require formal review.",
            "effect": {
              "decision": "require_review",
              "reason": "critical_accessibility_review_required",
              "required_action": "review_critical_issue"
            },
            "name": "critical_issue_requires_review"
          },
          {
            "condition": {
              "operation": "close_finding",
              "resolution_evidence_present": false
            },
            "description": "Finding closure requires resolution evidence.",
            "effect": {
              "decision": "deny",
              "reason": "resolution_evidence_required",
              "required_action": "attach_resolution_evidence"
            },
            "name": "finding_closure_requires_resolution"
          },
          {
            "condition": {
              "exception_expiry_present": false,
              "operation": "record_accessibility_exception"
            },
            "description": "Accessibility exceptions require an active expiry date.",
            "effect": {
              "decision": "deny",
              "reason": "accessibility_exception_expiry_required",
              "required_action": "set_accessibility_exception_expiry"
            },
            "name": "accessibility_exception_requires_expiry"
          },
          {
            "condition": {
              "compensating_controls_present": false,
              "operation": "record_accessibility_exception"
            },
            "description": "Accessibility exceptions require compensating controls.",
            "effect": {
              "decision": "deny",
              "reason": "accessibility_exception_compensating_controls_required",
              "required_action": "attach_compensating_controls"
            },
            "name": "accessibility_exception_requires_compensating_controls"
          },
          {
            "condition": {
              "accessibility_agent_present": true,
              "agent_registered": false
            },
            "description": "AI accessibility agents must be registered.",
            "effect": {
              "decision": "deny",
              "reason": "accessibility_agent_registration_required",
              "required_action": "register_accessibility_agent"
            },
            "name": "accessibility_agent_requires_registration"
          },
          {
            "condition": {
              "accessibility_agent_present": true,
              "agent_runtime_supported": false
            },
            "description": "AI accessibility agents must use a supported runtime.",
            "effect": {
              "decision": "deny",
              "reason": "accessibility_agent_runtime_not_supported",
              "required_action": "choose_supported_accessibility_agent_runtime"
            },
            "name": "accessibility_agent_runtime_supported"
          },
          {
            "condition": {
              "accessibility_agent_present": true,
              "agent_role_supported": false
            },
            "description": "AI accessibility agents must use a supported role.",
            "effect": {
              "decision": "deny",
              "reason": "accessibility_agent_role_not_supported",
              "required_action": "choose_supported_accessibility_agent_role"
            },
            "name": "accessibility_agent_role_supported"
          },
          {
            "condition": {
              "accessibility_agent_present": true,
              "agent_scope_present": false
            },
            "description": "AI accessibility agents require explicit scope.",
            "effect": {
              "decision": "deny",
              "reason": "accessibility_agent_scope_required",
              "required_action": "set_accessibility_agent_scope"
            },
            "name": "accessibility_agent_requires_scope"
          },
          {
            "condition": {
              "accessibility_agent_present": true,
              "agent_contribution_disclosed": false
            },
            "description": "AI accessibility-agent contributions require disclosure.",
            "effect": {
              "decision": "deny",
              "reason": "accessibility_agent_disclosure_required",
              "required_action": "disclose_accessibility_agent"
            },
            "name": "accessibility_agent_requires_disclosure"
          },
          {
            "condition": {
              "audit_event_recorded": false,
              "state_change_requested": true
            },
            "description": "Accessibility lifecycle state changes require audit evidence.",
            "effect": {
              "decision": "deny",
              "reason": "accs_audit_event_required",
              "required_action": "record_accessibility_audit_event"
            },
            "name": "accs_state_change_requires_audit"
          },
          {
            "condition": {
              "cross_tenant_access": true
            },
            "description": "Accessibility records may not cross tenant boundaries.",
            "effect": {
              "decision": "deny",
              "reason": "cross_tenant_accessibility_access_denied",
              "required_action": "use_tenant_local_context"
            },
            "name": "cross_tenant_accessibility_access_denied"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "batch_accessibility_mutation"
            },
            "description": "Batch accessibility mutations must use Bytewax event streams.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "use_bytewax_event_stream"
            },
            "name": "batch_accessibility_mutation_requires_bytewax"
          }
        ],
        "type": "deterministic"
      },
