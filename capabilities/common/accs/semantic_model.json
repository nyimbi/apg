      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "AccessibilityAgentPanel",
          "permission": "accs:audit",
          "route": "/accs/agents"
        },
        "analytics": {
          "component": "AccessibilityAnalytics",
          "permission": "accs:view",
          "route": "/accs/analytics"
        },
        "assistive": {
          "component": "AssistivePreview",
          "permission": "accs:audit",
          "route": "/accs/assistive"
        },
        "audit": {
          "component": "AccessibilityAuditTrail",
          "permission": "accs:audit",
          "route": "/accs/audit"
        },
        "audits": {
          "component": "AuditConsole",
          "permission": "accs:audit",
          "route": "/accs/audits"
        },
        "compliance": {
          "component": "AccessibilityCompliance",
          "permission": "accs:manage_standards",
          "route": "/accs/compliance"
        },
        "dashboard": {
          "component": "ACCSDashboard",
          "permission": "accs:view",
          "route": "/accs/dashboard"
        },
        "exceptions": {
          "component": "AccessibilityExceptionBoard",
          "permission": "accs:review",
          "route": "/accs/exceptions"
        },
        "findings": {
          "component": "FindingsBoard",
          "permission": "accs:view",
          "route": "/accs/findings"
        },
        "media": {
          "component": "MediaAccessibility",
          "permission": "accs:remediate",
          "route": "/accs/media"
        },
        "remediation": {
          "component": "RemediationQueue",
          "permission": "accs:remediate",
          "route": "/accs/remediation"
        },
        "settings": {
          "component": "ACCSSettings",
          "permission": "accs:admin",
          "route": "/accs/settings"
        }
      },
      "streaming": {
        "batch_mutation_guardrail": "batch_accessibility_mutation_requires_bytewax",
        "events": [
          "standard_registered",
          "target_registered",
          "audit_completed",
          "finding_recorded",
          "remediation_updated",
          "finding_review_recorded",
          "finding_closed",
          "accessibility_exception_recorded",
          "accessibility_agent_registered"
        ],
        "processor": "bytewax",
        "state": [
          "standards",
          "targets",
          "audits",
          "findings",
          "remediations",
          "reviews",
          "accessibility_exceptions",
          "accessibility_agents",
          "audit_events"
        ],
        "topic": "apg.accs.lifecycle"
      },
      "theme": {
        "components": {
          "agent_panel": {
            "icon": "bot",
            "status_style": "scope-chip"
          },
          "assistive_preview": {
            "status_style": "label-chip",
            "visual": "semantic-tree"
          },
          "audit_score": {
            "icon": "badge-check",
            "risk_style": "severity-band",
            "status_indicator": "score-pill"
          },
          "audit_timeline": {
            "icon": "list-checks",
