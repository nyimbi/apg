            "path": "/accs/agents",
            "permission": "accs:audit"
          },
          {
            "component": "AccessibilityAuditTrail",
            "name": "audit",
            "nav_group": "Governance",
            "path": "/accs/audit",
            "permission": "accs:audit"
          },
          {
            "component": "AccessibilityAnalytics",
            "name": "analytics",
            "nav_group": "Operations",
            "path": "/accs/analytics",
            "permission": "accs:view"
          },
          {
            "component": "ACCSSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/accs/settings",
            "permission": "accs:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
