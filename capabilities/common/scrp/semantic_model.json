{
  "agents": {},
  "app": {
    "description": "Scraper/Data Harvesting package-backed APG capability",
    "entity_count": 0,
    "name": "scrp",
    "version": "1.0.0"
  },
  "capabilities": {
    "scrp": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "adapters": {
          "api_helpers": "api.py",
          "audit_sink": "audl",
          "auth": "auth",
          "connections": "conn",
          "dlp": "dlpd",
          "etl_pipeline": "etlp",
          "event_stream": "bytewax",
          "generated_app_runtime": "service.ScrpService",
          "scheduler": "schd",
          "view_models": "views.py"
        },
        "compliance": {
          "audit_harvest_runs": true,
          "pii_handling_policy_required": true,
          "restricted_source_review_required": true,
          "robots_policy_required": true
        },
        "extraction": {
          "incremental_mode_supported": true,
          "pipeline_handoff_required": true,
          "result_retention_days": 30,
          "schema_validation_required": true
        },
        "governance": {
          "approval_for_sensitive_sources": true,
          "batch_event_stream": "bytewax",
          "dlp_scan_required": true,
          "job_schedule_policy_required": true,
          "require_tenant_context": true,
          "state_change_reason_required": true,
          "tenant_isolation_required": true
        },
        "harvest_agents": {
          "agent_assist_enabled": true,
          "agent_contribution_disclosure_required": true,
          "agent_registration_required": true,
          "agent_runtime_required": true,
          "agent_scope_required": true,
          "allowed_roles": [
            "source_reviewer",
            "extractor_designer",
            "compliance_reviewer",
            "run_operator",
            "pipeline_operator"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "observability": {
          "agent_activity_required": true,
          "audit_required": true,
          "event_stream": "bytewax",
          "latency_metrics_required": true,
          "quality_metrics_required": true
        },
        "sources": {
          "credential_vault_required": true,
          "rate_limit_required": true,
          "source_owner_required": true,
          "terms_evidence_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "scrp_harvest_ops"
        },
        "ui": {
          "enable_agent_panel": true,
          "enable_analytics": true,
          "enable_audit": true,
          "enable_compliance_review": true,
          "enable_extractor_workbench": true,
          "enable_job_monitor": true,
          "enable_source_console": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Scraper/Data Harvesting",
      "provides": [
        "source_registry",
        "harvest_jobs",
        "extractor_profiles",
        "compliance_controls",
        "pipeline_handoff",
        "harvest_agents"
      ],
      "requires": [
        "conn",
        "etlp",
        "auth"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All harvesting operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "register_source",
              "source_owner_assigned": false
            },
            "description": "Harvest sources require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "source_owner_required",
              "required_action": "assign_source_owner"
            },
            "name": "source_requires_owner"
          },
          {
            "condition": {
              "terms_evidence_present": false
            },
            "description": "Harvest sources require terms or authorization evidence.",
            "effect": {
              "decision": "deny",
              "reason": "source_terms_required",
              "required_action": "attach_terms_evidence"
            },
            "name": "source_terms_required"
          },
          {
            "condition": {
              "pii_expected": true,
              "pii_policy_attached": false
            },
            "description": "PII-bearing harvests require a handling policy.",
            "effect": {
              "decision": "deny",
              "reason": "pii_policy_required",
              "required_action": "attach_pii_policy"
            },
            "name": "pii_requires_handling_policy"
          },
          {
            "condition": {
              "operation": "run_harvest",
              "schedule_policy_attached": false
            },
            "description": "Harvest jobs require rate and schedule policy.",
            "effect": {
              "decision": "deny",
              "reason": "schedule_policy_required",
              "required_action": "attach_schedule_policy"
            },
            "name": "harvest_requires_schedule_policy"
          },
          {
            "condition": {
              "sensitive_source": true,
              "source_review_recorded": false
            },
            "description": "Sensitive sources require review.",
            "effect": {
              "decision": "require_review",
              "reason": "sensitive_source_review_required",
              "required_action": "review_source"
            },
            "name": "sensitive_source_requires_review"
          },
          {
            "condition": {
              "credential_vault_present": false,
              "operation": "register_source"
            },
            "description": "Harvest sources require credential vault references.",
            "effect": {
              "decision": "deny",
              "reason": "credential_vault_required",
              "required_action": "attach_credential_vault_ref"
            },
            "name": "credential_vault_required"
          },
          {
            "condition": {
              "robots_policy_attached": false
            },
            "description": "Web and feed sources require robots/terms policy evidence.",
            "effect": {
              "decision": "deny",
              "reason": "robots_policy_required",
              "required_action": "attach_robots_policy"
            },
            "name": "robots_policy_required"
          },
          {
            "condition": {
              "operation": "register_source",
              "rate_limit_per_minute_lte": 0
            },
            "description": "Harvest sources require positive rate limits.",
            "effect": {
              "decision": "deny",
              "reason": "rate_limit_required",
              "required_action": "set_rate_limit"
            },
            "name": "rate_limit_required"
          },
          {
            "condition": {
              "operation": "create_extractor",
              "schema_present": false
            },
            "description": "Extractor profiles require schema validation.",
            "effect": {
              "decision": "deny",
              "reason": "schema_validation_required",
              "required_action": "attach_extractor_schema"
            },
            "name": "extractor_schema_required"
          },
          {
            "condition": {
              "operation": "create_harvest_job",
              "pipeline_target_present": false
            },
            "description": "Harvest jobs require downstream pipeline handoff.",
            "effect": {
              "decision": "deny",
              "reason": "pipeline_handoff_required",
              "required_action": "set_pipeline_target"
            },
            "name": "pipeline_handoff_required"
          },
          {
            "condition": {
              "dlp_scanned": false,
              "operation": "complete_harvest_run",
              "pii_expected": true
            },
            "description": "PII-bearing harvest runs require DLP scans before completion.",
            "effect": {
              "decision": "deny",
              "reason": "dlp_scan_required",
              "required_action": "run_dlp_scan"
            },
            "name": "dlp_scan_required"
          },
          {
            "condition": {
              "agent_registered": false,
              "harvest_agent_present": true
            },
            "description": "AI harvest agents must be registered.",
            "effect": {
              "decision": "deny",
              "reason": "harvest_agent_registration_required",
              "required_action": "register_harvest_agent"
            },
            "name": "harvest_agent_requires_registration"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "harvest_agent_present": true
            },
            "description": "AI harvest agents must use a supported runtime.",
            "effect": {
              "decision": "deny",
              "reason": "harvest_agent_runtime_not_supported",
              "required_action": "choose_supported_harvest_agent_runtime"
            },
            "name": "harvest_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "harvest_agent_present": true
            },
            "description": "AI harvest agents must use a supported role.",
            "effect": {
              "decision": "deny",
              "reason": "harvest_agent_role_not_supported",
              "required_action": "choose_supported_harvest_agent_role"
            },
            "name": "harvest_agent_role_supported"
          },
          {
            "condition": {
              "agent_scope_present": false,
              "harvest_agent_present": true
            },
            "description": "AI harvest agents require explicit scope.",
            "effect": {
              "decision": "deny",
              "reason": "harvest_agent_scope_required",
              "required_action": "set_harvest_agent_scope"
            },
            "name": "harvest_agent_requires_scope"
          },
          {
            "condition": {
              "agent_contribution_disclosed": false,
              "harvest_agent_present": true
            },
            "description": "AI harvest-agent contributions require disclosure.",
            "effect": {
              "decision": "deny",
              "reason": "harvest_agent_disclosure_required",
              "required_action": "disclose_harvest_agent"
            },
            "name": "harvest_agent_requires_disclosure"
          },
          {
            "condition": {
              "state_change_reason_present": false,
              "state_change_requested": true
            },
            "description": "Harvest lifecycle state changes require a reason.",
            "effect": {
              "decision": "deny",
              "reason": "scrp_state_change_reason_required",
              "required_action": "record_state_change_reason"
            },
            "name": "scrp_state_change_requires_reason"
          },
          {
            "condition": {
              "audit_event_recorded": false,
              "state_change_requested": true
            },
            "description": "Harvest lifecycle state changes require audit evidence.",
            "effect": {
              "decision": "deny",
              "reason": "scrp_audit_event_required",
              "required_action": "record_scrp_audit_event"
            },
            "name": "scrp_state_change_requires_audit"
          },
          {
            "condition": {
              "cross_tenant_access": true
            },
            "description": "Harvest records may not cross tenant boundaries.",
            "effect": {
              "decision": "deny",
              "reason": "cross_tenant_harvest_access_denied",
              "required_action": "use_tenant_local_context"
            },
            "name": "cross_tenant_harvest_access_denied"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "batch_harvest_mutation"
            },
            "description": "Batch harvest mutations must use Bytewax event streams.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "use_bytewax_event_stream"
            },
            "name": "batch_harvest_mutation_requires_bytewax"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
