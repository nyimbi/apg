      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "HarvestAgentPanel",
          "permission": "scrp:approve_harvests",
          "route": "/scrp/agents"
        },
        "analytics": {
          "component": "HarvestAnalytics",
          "permission": "scrp:view",
          "route": "/scrp/analytics"
        },
        "audit": {
          "component": "HarvestAuditTrail",
          "permission": "scrp:audit",
          "route": "/scrp/audit"
        },
        "compliance": {
          "component": "HarvestCompliance",
          "permission": "scrp:approve_harvests",
          "route": "/scrp/compliance"
        },
        "dashboard": {
          "component": "SCRPDashboard",
          "permission": "scrp:view",
          "route": "/scrp/dashboard"
        },
        "extractors": {
          "component": "ExtractorWorkbench",
          "permission": "scrp:configure_sources",
          "route": "/scrp/extractors"
        },
        "jobs": {
          "component": "HarvestJobMonitor",
          "permission": "scrp:run_jobs",
          "route": "/scrp/jobs"
        },
        "pipelines": {
          "component": "PipelineHandoff",
          "permission": "scrp:view",
          "route": "/scrp/pipelines"
        },
        "results": {
          "component": "HarvestResults",
          "permission": "scrp:view",
          "route": "/scrp/results"
        },
        "settings": {
          "component": "SCRPSettings",
          "permission": "scrp:admin",
          "route": "/scrp/settings"
        },
        "sources": {
          "component": "SourceRegistry",
          "permission": "scrp:configure_sources",
          "route": "/scrp/sources"
        }
      },
      "streaming": {
        "batch_mutation_guardrail": "batch_harvest_mutation_requires_bytewax",
        "events": [
          "source_registered",
          "extractor_created",
          "harvest_job_created",
          "harvest_run_started",
          "harvest_run_completed",
          "harvest_agent_registered",
          "harvest_job_state_changed"
        ],
        "processor": "bytewax",
        "state": [
          "sources",
          "extractors",
          "jobs",
          "runs",
          "results",
          "handoffs",
          "harvest_agents",
          "audit_events"
        ],
        "topic": "apg.scrp.lifecycle"
      },
      "theme": {
        "components": {
          "agent_panel": {
            "icon": "bot",
            "status_style": "scope-chip"
          },
          "audit_timeline": {
            "icon": "list-todo",
            "status_style": "governance-chip"
          },
          "compliance_panel": {
            "status_style": "approval-chip",
            "visual": "policy-checklist"
          },
          "extractor_workbench": {
            "status_style": "parser-chip",
            "visual": "schema-mapper"
          },
          "job_monitor": {
            "highlight": "rate-chip",
            "visual": "harvest-timeline"
          },
          "source_card": {
            "icon": "database-zap",
            "risk_style": "terms-band",
            "status_indicator": "source-pill"
          }
        },
        "name": "scrp_harvest_ops",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#38A169",
          "color.danger": "#C53030",
          "color.primary": "#28536B",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7F8FA",
          "surface.panel": "#FFFFFF",
          "text.primary": "#172033",
          "text.secondary": "#52606D"
        }
      },
      "ui": {
        "api_prefix": "/scrp/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "SCRPDashboard",
            "name": "dashboard",
            "nav_group": "Overview",
            "path": "/scrp/dashboard",
            "permission": "scrp:view"
          },
          {
            "component": "SourceRegistry",
            "name": "sources",
            "nav_group": "Sources",
            "path": "/scrp/sources",
            "permission": "scrp:configure_sources"
          },
          {
            "component": "HarvestJobMonitor",
            "name": "jobs",
            "nav_group": "Jobs",
            "path": "/scrp/jobs",
            "permission": "scrp:run_jobs"
          },
          {
            "component": "ExtractorWorkbench",
            "name": "extractors",
            "nav_group": "Extraction",
            "path": "/scrp/extractors",
            "permission": "scrp:configure_sources"
          },
          {
            "component": "PipelineHandoff",
            "name": "pipelines",
            "nav_group": "Extraction",
            "path": "/scrp/pipelines",
            "permission": "scrp:view"
          },
          {
            "component": "HarvestCompliance",
            "name": "compliance",
            "nav_group": "Governance",
            "path": "/scrp/compliance",
            "permission": "scrp:approve_harvests"
