        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All diagnostic operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_pipeline",
              "pipeline_owner_assigned": false
            },
            "description": "Ingestion pipelines require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "pipeline_owner_required",
              "required_action": "assign_pipeline_owner"
            },
            "name": "pipeline_requires_owner"
          },
          {
            "condition": {
              "operation": "ingest_trace",
              "trace_context_present": false
            },
            "description": "Trace ingestion requires trace context.",
            "effect": {
              "decision": "deny",
              "reason": "trace_context_required",
              "required_action": "attach_trace_context"
            },
            "name": "trace_context_required"
          },
          {
            "condition": {
              "redaction_applied": false,
              "sensitive_log_content": true
            },
            "description": "Sensitive logs must be redacted.",
            "effect": {
              "decision": "deny",
              "reason": "log_redaction_required",
              "required_action": "apply_log_redaction"
            },
            "name": "sensitive_log_requires_redaction"
          },
          {
            "condition": {
              "approval_recorded": false,
              "operation": "export_logs"
            },
            "description": "Diagnostic exports require approval.",
            "effect": {
              "decision": "deny",
              "reason": "export_approval_required",
              "required_action": "record_export_approval"
            },
            "name": "log_export_requires_approval"
          },
          {
            "condition": {
              "query_review_recorded": false,
              "query_window_hours_gt": 168
            },
            "description": "Large diagnostic queries require review.",
            "effect": {
              "decision": "require_review",
              "reason": "large_query_review_required",
              "required_action": "review_query_scope"
            },
            "name": "large_query_requires_review"
          }
        ],
        "type": "deterministic"
