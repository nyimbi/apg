{
  "agents": {},
  "app": {
    "description": "Digital Twin Framework package-backed APG capability",
    "entity_count": 0,
    "name": "dtwn",
    "version": "1.0.0"
  },
  "capabilities": {
    "dtwn": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "adapters": {
          "anomaly": "anom",
          "api_helpers": "api.py",
          "audit_sink": "audl",
          "edge": "edge",
          "event_stream": "bytewax",
          "generated_app_runtime": "service.DtwnService",
          "geospatial": "geos",
          "iot": "iotd",
          "machine": "mchn",
          "prediction": "pred",
          "view_models": "views.py",
          "vision": "cvsn"
        },
        "governance": {
          "audit_twin_changes": true,
          "batch_event_stream": "bytewax",
          "high_risk_prediction_review_required": true,
          "model_drift_monitoring": true,
          "require_tenant_context": true,
          "state_change_reason_required": true,
          "tenant_isolation_required": true
        },
        "observability": {
          "agent_activity_required": true,
          "audit_required": true,
          "event_stream": "bytewax",
          "telemetry_metrics_required": true,
          "trace_required": true
        },
        "simulation": {
          "calibration_evidence_required": true,
          "model_required": true,
          "prediction_confidence_threshold": 0.75,
          "simulation_approval_required": true
        },
        "telemetry": {
          "authenticated_source_required": true,
          "geospatial_context_enabled": true,
          "iot_ingestion_required": true,
          "vision_signal_supported": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "dtwn_digital_twin_ops"
        },
        "twin_agents": {
          "agent_assist_enabled": true,
          "agent_contribution_disclosure_required": true,
          "agent_registration_required": true,
          "agent_runtime_required": true,
          "agent_scope_required": true,
          "allowed_roles": [
            "twin_designer",
            "telemetry_reviewer",
            "simulation_operator",
            "prediction_reviewer",
            "incident_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "twins": {
          "asset_identity_required": true,
          "state_versioning_enabled": true,
          "topology_mapping_enabled": true,
          "twin_owner_required": true
        },
        "ui": {
          "enable_agent_panel": true,
          "enable_analytics": true,
          "enable_audit": true,
          "enable_model_library": true,
          "enable_simulation_lab": true,
          "enable_topology_view": true,
          "enable_twin_console": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Digital Twin Framework",
      "provides": [
        "twin_registry",
        "simulation_models",
        "telemetry_fusion",
        "prediction_workflows",
        "asset_topology",
        "twin_agents"
      ],
      "requires": [
        "pred",
        "iotd",
        "geos",
        "cvsn"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All digital-twin operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_twin",
              "twin_owner_assigned": false
            },
            "description": "Digital twins require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "twin_owner_required",
              "required_action": "assign_twin_owner"
            },
            "name": "twin_requires_owner"
          },
          {
            "condition": {
              "asset_identity_present": false,
              "operation": "create_twin"
            },
            "description": "Digital twins require asset identity.",
            "effect": {
              "decision": "deny",
              "reason": "asset_identity_required",
              "required_action": "attach_asset_identity"
            },
            "name": "twin_requires_asset_identity"
          },
          {
            "condition": {
              "calibration_evidence_present": false,
              "operation": "register_simulation_model"
            },
            "description": "Simulation models require calibration evidence.",
            "effect": {
              "decision": "deny",
              "reason": "calibration_evidence_required",
              "required_action": "attach_calibration_evidence"
            },
            "name": "simulation_model_requires_calibration"
          },
          {
            "condition": {
              "model_confidence_lt": 0.75,
              "operation": "register_simulation_model"
            },
            "description": "Simulation models must meet confidence threshold.",
            "effect": {
              "decision": "deny",
              "reason": "prediction_confidence_threshold",
              "required_action": "raise_model_confidence"
            },
            "name": "simulation_model_requires_confidence"
          },
          {
            "condition": {
              "model_present": false,
              "operation": "run_simulation"
            },
            "description": "Simulations require an approved model.",
            "effect": {
              "decision": "deny",
              "reason": "simulation_model_required",
              "required_action": "attach_simulation_model"
            },
            "name": "simulation_requires_model"
          },
          {
            "condition": {
              "telemetry_source_authenticated": false
            },
            "description": "Telemetry requires authenticated source identity.",
            "effect": {
              "decision": "deny",
              "reason": "telemetry_source_auth_required",
              "required_action": "authenticate_telemetry_source"
            },
            "name": "telemetry_requires_authenticated_source"
          },
          {
            "condition": {
              "measurement_count_lte": 0,
              "operation": "ingest_telemetry"
            },
            "description": "Telemetry ingestion requires measurements.",
            "effect": {
              "decision": "deny",
              "reason": "telemetry_measurements_required",
              "required_action": "attach_telemetry_measurements"
            },
            "name": "telemetry_requires_measurements"
          },
          {
            "condition": {
              "approval_recorded": false,
              "operation": "run_production_simulation"
            },
            "description": "Production simulation runs require approval.",
            "effect": {
              "decision": "deny",
              "reason": "simulation_approval_required",
              "required_action": "record_simulation_approval"
            },
            "name": "simulation_requires_approval"
          },
          {
            "condition": {
              "prediction_review_recorded": false,
              "prediction_risk_score_gt": 0.8
            },
            "description": "High-risk twin predictions require review.",
            "effect": {
              "decision": "require_review",
              "reason": "prediction_review_required",
              "required_action": "review_prediction"
            },
            "name": "high_risk_prediction_requires_review"
          },
          {
            "condition": {
              "agent_registered": false,
              "twin_agent_present": true
            },
            "description": "AI twin agents must be registered.",
            "effect": {
              "decision": "deny",
              "reason": "twin_agent_registration_required",
              "required_action": "register_twin_agent"
            },
            "name": "twin_agent_requires_registration"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "twin_agent_present": true
            },
            "description": "AI twin agents must use a supported runtime.",
            "effect": {
              "decision": "deny",
              "reason": "twin_agent_runtime_not_supported",
              "required_action": "choose_supported_twin_agent_runtime"
            },
            "name": "twin_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "twin_agent_present": true
            },
            "description": "AI twin agents must use a supported role.",
            "effect": {
              "decision": "deny",
              "reason": "twin_agent_role_not_supported",
              "required_action": "choose_supported_twin_agent_role"
            },
            "name": "twin_agent_role_supported"
          },
          {
            "condition": {
              "agent_scope_present": false,
              "twin_agent_present": true
            },
            "description": "AI twin agents require explicit scope.",
            "effect": {
              "decision": "deny",
              "reason": "twin_agent_scope_required",
              "required_action": "set_twin_agent_scope"
            },
            "name": "twin_agent_requires_scope"
          },
          {
            "condition": {
              "agent_contribution_disclosed": false,
              "twin_agent_present": true
            },
            "description": "AI twin-agent contributions require disclosure.",
            "effect": {
              "decision": "deny",
              "reason": "twin_agent_disclosure_required",
              "required_action": "disclose_twin_agent"
            },
            "name": "twin_agent_requires_disclosure"
          },
          {
            "condition": {
              "state_change_reason_present": false,
              "state_change_requested": true
            },
            "description": "Digital-twin lifecycle state changes require a reason.",
            "effect": {
              "decision": "deny",
              "reason": "dtwn_state_change_reason_required",
              "required_action": "record_state_change_reason"
            },
            "name": "dtwn_state_change_requires_reason"
          },
          {
            "condition": {
              "audit_event_recorded": false,
              "state_change_requested": true
            },
            "description": "Digital-twin lifecycle state changes require audit evidence.",
            "effect": {
              "decision": "deny",
              "reason": "dtwn_audit_event_required",
              "required_action": "record_twin_audit_event"
            },
            "name": "dtwn_state_change_requires_audit"
          },
          {
            "condition": {
              "cross_tenant_access": true
            },
            "description": "Digital-twin records may not cross tenant boundaries.",
            "effect": {
              "decision": "deny",
              "reason": "cross_tenant_twin_access_denied",
              "required_action": "use_tenant_local_context"
            },
            "name": "cross_tenant_twin_access_denied"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "batch_twin_mutation"
            },
            "description": "Batch twin mutations must use Bytewax event streams.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "use_bytewax_event_stream"
            },
            "name": "batch_twin_mutation_requires_bytewax"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
