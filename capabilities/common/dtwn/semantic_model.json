      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "TwinAgentPanel",
          "permission": "dtwn:model",
          "route": "/dtwn/agents"
        },
        "analytics": {
          "component": "TwinAnalytics",
          "permission": "dtwn:view",
          "route": "/dtwn/analytics"
        },
        "audit": {
          "component": "TwinAuditTrail",
          "permission": "dtwn:audit",
          "route": "/dtwn/audit"
        },
        "dashboard": {
          "component": "DTWNDashboard",
          "permission": "dtwn:view",
          "route": "/dtwn/dashboard"
        },
        "models": {
          "component": "ModelLibrary",
          "permission": "dtwn:model",
          "route": "/dtwn/models"
        },
        "predictions": {
          "component": "TwinPredictions",
          "permission": "dtwn:view",
          "route": "/dtwn/predictions"
        },
        "settings": {
          "component": "DTWNSettings",
          "permission": "dtwn:admin",
          "route": "/dtwn/settings"
        },
        "simulations": {
          "component": "SimulationLab",
          "permission": "dtwn:simulate",
          "route": "/dtwn/simulations"
        },
        "telemetry": {
          "component": "TelemetryFusion",
          "permission": "dtwn:view",
          "route": "/dtwn/telemetry"
        },
        "topology": {
          "component": "TwinTopology",
          "permission": "dtwn:view",
          "route": "/dtwn/topology"
        },
        "twins": {
          "component": "TwinRegistry",
          "permission": "dtwn:manage_twins",
          "route": "/dtwn/twins"
        }
      },
      "streaming": {
        "batch_mutation_guardrail": "batch_twin_mutation_requires_bytewax",
        "events": [
          "twin_created",
          "model_registered",
          "telemetry_ingested",
          "topology_linked",
          "simulation_completed",
          "prediction_recorded",
          "prediction_reviewed",
          "twin_status_changed",
          "twin_agent_registered"
        ],
        "processor": "bytewax",
        "state": [
          "twins",
          "models",
          "telemetry",
          "topology",
          "simulations",
          "predictions",
          "twin_agents",
          "audit_events"
        ],
        "topic": "apg.dtwn.lifecycle"
      },
      "theme": {
        "components": {
          "agent_panel": {
            "icon": "bot",
            "status_style": "scope-chip"
          },
          "audit_timeline": {
            "icon": "list-checks",
            "status_style": "governance-chip"
          },
          "simulation_lab": {
            "status_style": "approval-chip",
            "visual": "scenario-timeline"
          },
          "telemetry_panel": {
            "status_style": "source-chip",
            "visual": "signal-grid"
          },
          "topology_view": {
            "highlight": "dependency-chip",
            "visual": "asset-graph"
          },
          "twin_card": {
            "icon": "box",
            "risk_style": "prediction-band",
            "status_indicator": "state-pill"
          }
        },
        "name": "dtwn_digital_twin_ops",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#38A169",
          "color.danger": "#C53030",
          "color.primary": "#28536B",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7F8FA",
          "surface.panel": "#FFFFFF",
          "text.primary": "#172033",
          "text.secondary": "#52606D"
        }
      },
      "ui": {
        "api_prefix": "/dtwn/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "DTWNDashboard",
            "name": "dashboard",
            "nav_group": "Overview",
            "path": "/dtwn/dashboard",
            "permission": "dtwn:view"
          },
          {
            "component": "TwinRegistry",
            "name": "twins",
            "nav_group": "Twins",
            "path": "/dtwn/twins",
            "permission": "dtwn:manage_twins"
          },
          {
            "component": "ModelLibrary",
            "name": "models",
            "nav_group": "Models",
            "path": "/dtwn/models",
            "permission": "dtwn:model"
          },
          {
            "component": "TelemetryFusion",
            "name": "telemetry",
            "nav_group": "Signals",
            "path": "/dtwn/telemetry",
            "permission": "dtwn:view"
          },
          {
            "component": "SimulationLab",
            "name": "simulations",
            "nav_group": "Simulations",
            "path": "/dtwn/simulations",
            "permission": "dtwn:simulate"
          },
          {
            "component": "TwinPredictions",
            "name": "predictions",
            "nav_group": "Intelligence",
            "path": "/dtwn/predictions",
            "permission": "dtwn:view"
          },
          {
            "component": "TwinTopology",
            "name": "topology",
            "nav_group": "Twins",
            "path": "/dtwn/topology",
            "permission": "dtwn:view"
          },
          {
            "component": "TwinAgentPanel",
            "name": "agents",
            "nav_group": "Agents",
            "path": "/dtwn/agents",
            "permission": "dtwn:model"
          },
          {
            "component": "TwinAuditTrail",
            "name": "audit",
            "nav_group": "Governance",
            "path": "/dtwn/audit",
            "permission": "dtwn:audit"
          },
          {
            "component": "TwinAnalytics",
            "name": "analytics",
            "nav_group": "Operations",
            "path": "/dtwn/analytics",
            "permission": "dtwn:view"
          },
          {
            "component": "DTWNSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/dtwn/settings",
            "permission": "dtwn:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
      }
    }
