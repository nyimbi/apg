            "nav_group": "Rendering",
            "path": "/mchn/templates",
            "permission": "mchn:manage_templates"
          },
          {
            "component": "RouteConsole",
            "name": "routes",
            "nav_group": "Routing",
            "path": "/mchn/routes",
            "permission": "mchn:route"
          },
          {
            "component": "ChannelMonitor",
            "name": "channels",
            "nav_group": "Channels",
            "path": "/mchn/channels",
            "permission": "mchn:admin"
          },
          {
            "component": "OutputAnalytics",
            "name": "analytics",
            "nav_group": "Operations",
            "path": "/mchn/analytics",
            "permission": "mchn:view"
          },
          {
            "component": "OutputPolicies",
            "name": "policies",
            "nav_group": "Governance",
            "path": "/mchn/policies",
            "permission": "mchn:admin"
          },
          {
            "component": "MCHNSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/mchn/settings",
            "permission": "mchn:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
      }
    }
