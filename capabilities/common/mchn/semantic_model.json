        },
        "name": "mchn_omnichannel_output",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#DD6B20",
          "color.danger": "#C53030",
          "color.primary": "#28536B",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
