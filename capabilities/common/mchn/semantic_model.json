{
  "agents": {},
  "app": {
    "description": "Multi-Channel Output package-backed APG capability",
    "entity_count": 0,
    "name": "mchn",
    "version": "1.0.0"
  },
  "capabilities": {
    "mchn": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "channels": {
          "channel_owner_required": true,
          "enabled": [
            "email",
            "sms",
            "push",
            "pdf",
            "web",
            "api",
            "print"
          ],
          "fallback_required": true,
          "health_required": true
        },
        "delivery": {
          "delivery_receipts_enabled": true,
          "recipient_policy_required": true,
          "sensitive_output_encryption_required": true,
          "throttle_policy_required": true
        },
        "governance": {
          "audit_output_events": true,
          "compliance_policy_required": true,
          "require_tenant_context": true,
          "restricted_content_filtering": true
        },
        "rendering": {
          "format_validation_required": true,
          "localization_supported": true,
          "template_approval_required": true,
          "theme_policy_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "mchn_omnichannel_output"
        },
        "ui": {
          "enable_channel_monitor": true,
          "enable_output_dashboard": true,
          "enable_route_console": true,
          "enable_template_manager": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Multi-Channel Output",
      "provides": [
        "mchn_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All output operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "channel_owner_assigned": false,
              "operation": "create_channel"
            },
            "description": "Output channels require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "channel_owner_required",
              "required_action": "assign_channel_owner"
            },
            "name": "channel_requires_owner"
          },
          {
            "condition": {
              "operation": "publish_template",
              "template_approved": false
            },
            "description": "Output templates require approval.",
            "effect": {
              "decision": "deny",
              "reason": "template_approval_required",
              "required_action": "approve_template"
            },
            "name": "template_requires_approval"
          },
          {
            "condition": {
              "output_encrypted": false,
              "sensitive_output": true
            },
            "description": "Sensitive output requires encryption.",
            "effect": {
              "decision": "deny",
              "reason": "output_encryption_required",
              "required_action": "encrypt_output"
            },
            "name": "sensitive_output_requires_encryption"
          },
          {
            "condition": {
              "channel_health": "unhealthy",
              "delivery_requested": true
            },
            "description": "Unhealthy channels cannot receive delivery.",
            "effect": {
              "decision": "deny",
              "reason": "channel_unhealthy",
              "required_action": "reroute_or_restore_channel"
            },
            "name": "unhealthy_channel_blocks_delivery"
          },
          {
            "condition": {
              "delivery_review_recorded": false,
              "recipient_count_gt": 10000
            },
            "description": "Large deliveries require review.",
            "effect": {
              "decision": "require_review",
              "reason": "large_delivery_review_required",
              "required_action": "review_delivery"
            },
            "name": "large_delivery_requires_review"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
        {
          "condition": {
            "tenant_context_present": false
          },
          "description": "All output operations require tenant context.",
          "effect": {
            "decision": "deny",
            "reason": "tenant_context_required",
