        },
        {
          "condition": {
            "delivery_review_recorded": false,
            "recipient_count_gt": 10000
          },
          "description": "Large deliveries require review.",
          "effect": {
            "decision": "require_review",
            "reason": "large_delivery_review_required",
            "required_action": "review_delivery"
          },
          "name": "large_delivery_requires_review"
        }
      ],
      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "analytics": {
          "component": "OutputAnalytics",
          "permission": "mchn:view",
          "route": "/mchn/analytics"
        },
        "channels": {
          "component": "ChannelMonitor",
          "permission": "mchn:admin",
          "route": "/mchn/channels"
        },
        "dashboard": {
          "component": "MCHNDashboard",
          "permission": "mchn:view",
          "route": "/mchn/dashboard"
        },
        "policies": {
          "component": "OutputPolicies",
          "permission": "mchn:admin",
          "route": "/mchn/policies"
        },
        "render": {
          "component": "RenderConsole",
          "permission": "mchn:render",
          "route": "/mchn/render"
        },
        "routes": {
          "component": "RouteConsole",
          "permission": "mchn:route",
          "route": "/mchn/routes"
        },
        "settings": {
          "component": "MCHNSettings",
          "permission": "mchn:admin",
          "route": "/mchn/settings"
        },
        "templates": {
          "component": "TemplateManager",
          "permission": "mchn:manage_templates",
          "route": "/mchn/templates"
        }
      },
      "streaming": {},
      "theme": {
        "components": {
          "channel_monitor": {
            "status_style": "health-chip",
            "visual": "channel-health-table"
          },
          "render_preview": {
            "status_style": "validation-chip",
            "visual": "format-preview"
          },
          "route_console": {
            "icon": "route",
            "risk_style": "policy-band",
