      "guardrails": [
        "runtime_supported",
        "role_supported",
        "scope_required",
        "owner_required",
        "purpose_required",
        "human_approval_for_privileged_roles",
        "contribution_disclosure_required"
      ],
      "privileged_roles": [
        "compromise_responder",
        "export_reviewer",
        "hsm_attestation_reviewer",
        "rotation_exception_reviewer"
      ],
      "supported_roles": [
        "key_policy_reviewer",
        "key_lifecycle_reviewer",
        "key_custody_reviewer",
        "export_reviewer",
        "rotation_exception_reviewer",
        "compromise_responder",
