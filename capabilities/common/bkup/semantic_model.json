      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All backup operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_backup_plan",
              "plan_owner_assigned": false
            },
            "description": "Backup plans require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "plan_owner_required",
              "required_action": "assign_plan_owner"
            },
            "name": "backup_plan_requires_owner"
          },
          {
            "condition": {
              "operation": "create_snapshot",
              "snapshot_encrypted": false
            },
            "description": "Snapshots must be encrypted.",
            "effect": {
              "decision": "deny",
              "reason": "snapshot_encryption_required",
              "required_action": "encrypt_snapshot"
            },
            "name": "snapshot_requires_encryption"
          },
          {
            "condition": {
              "operation": "create_snapshot",
              "snapshot_integrity_passed": false
            },
            "description": "Snapshots require integrity evidence.",
            "effect": {
              "decision": "deny",
              "reason": "snapshot_integrity_check_required",
              "required_action": "pass_snapshot_integrity_check"
            },
            "name": "snapshot_requires_integrity"
          },
          {
            "condition": {
              "integrity_check_passed": false,
              "operation": "restore"
            },
            "description": "Restore operations require integrity checks.",
            "effect": {
              "decision": "deny",
              "reason": "integrity_check_required",
              "required_action": "pass_integrity_check"
            },
            "name": "restore_requires_integrity_check"
          },
          {
            "condition": {
              "approval_recorded": false,
              "target_environment": "production"
            },
            "description": "Production restores require approval.",
            "effect": {
              "decision": "deny",
              "reason": "production_restore_approval_required",
              "required_action": "record_restore_approval"
            },
            "name": "production_restore_requires_approval"
          },
          {
            "condition": {
              "days_since_restore_test_gt": 90,
              "restore_test_review_recorded": false
            },
            "description": "Stale restore tests require review.",
            "effect": {
              "decision": "require_review",
              "reason": "restore_test_review_required",
              "required_action": "review_restore_test"
            },
            "name": "stale_restore_test_requires_review"
          },
          {
            "condition": {
              "operation": "approve_restore",
              "restore_reviewer_same_as_requester": true
            },
            "description": "Restore approvals and reviews require an independent reviewer.",
            "effect": {
              "decision": "deny",
              "reason": "independent_restore_reviewer_required",
              "required_action": "route_to_independent_restore_reviewer"
            },
            "name": "restore_review_requires_independent_reviewer"
          },
          {
            "condition": {
              "legal_hold_active": true,
              "operation": "retention_disposition"
            },
            "description": "Snapshots under legal hold cannot be disposed.",
            "effect": {
              "decision": "deny",
              "reason": "legal_hold_blocks_disposition",
              "required_action": "release_legal_hold_before_disposition"
            },
            "name": "retention_disposition_blocks_legal_hold"
          },
          {
            "condition": {
              "operation": "approve_retention_disposition",
              "retention_reviewer_same_as_requester": true
            },
            "description": "Retention disposition approvals require an independent reviewer.",
            "effect": {
              "decision": "deny",
              "reason": "independent_retention_reviewer_required",
              "required_action": "route_to_independent_retention_reviewer"
            },
            "name": "retention_review_requires_independent_reviewer"
          }
        ],
        "type": "deterministic"
      },
