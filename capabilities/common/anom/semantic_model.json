            "path": "/anom/investigations",
            "permission": "anom:investigate"
          },
          {
            "component": "AnomalyRuleManager",
            "name": "rules",
            "nav_group": "Governance",
            "path": "/anom/rules",
            "permission": "anom:manage_rules"
          },
          {
            "component": "FeedbackReview",
            "name": "feedback",
            "nav_group": "Quality",
            "path": "/anom/feedback",
            "permission": "anom:tune"
          },
          {
            "component": "ANOMSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/anom/settings",
            "permission": "anom:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "__init__.py"
