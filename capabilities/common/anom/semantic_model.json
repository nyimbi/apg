{
  "agents": {},
  "app": {
    "description": "Anomaly Detection package-backed APG capability",
    "entity_count": 0,
    "name": "anom",
    "version": "1.0.0"
  },
  "capabilities": {
    "anom": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "baselines": {
          "auto_baseline_enabled": true,
          "baseline_review_required": true,
          "drift_reset_requires_approval": true
        },
        "detection": {
          "default_sensitivity": "medium",
          "event_detection_enabled": true,
          "metric_detection_enabled": true,
          "minimum_baseline_points": 50
        },
        "governance": {
          "audit_detections": true,
          "monitoring_source_required": true,
          "require_tenant_context": true
        },
        "investigation": {
          "critical_anomalies_require_owner": true,
          "feedback_loop_enabled": true,
          "root_cause_hints_enabled": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "anom_signal_console"
        },
        "ui": {
          "enable_baseline_console": true,
          "enable_feedback_review": true,
          "enable_investigation_queue": true,
          "enable_signal_board": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Anomaly Detection",
      "provides": [
        "anom_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All anomaly detection operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "monitoring_source_present": false,
              "operation": "detect"
            },
            "description": "Anomaly detection requires a monitoring source.",
            "effect": {
              "decision": "deny",
              "reason": "monitoring_source_required",
              "required_action": "attach_monitoring_source"
            },
            "name": "detection_requires_monitoring_source"
          },
          {
            "condition": {
              "history_points_lt": 50,
              "operation": "create_baseline"
            },
            "description": "Baselines require enough historical observations.",
            "effect": {
              "decision": "deny",
              "reason": "insufficient_baseline_history",
              "required_action": "collect_more_history"
            },
            "name": "baseline_requires_history"
          },
          {
            "condition": {
              "owner_assigned": false,
              "severity": "critical"
            },
            "description": "Critical anomalies require an investigation owner.",
            "effect": {
              "decision": "deny",
              "reason": "investigation_owner_required",
              "required_action": "assign_owner"
            },
            "name": "critical_anomaly_requires_owner"
          },
          {
            "condition": {
              "approval_recorded": false,
              "operation": "reset_baseline"
            },
            "description": "Baseline reset after drift requires approval.",
            "effect": {
              "decision": "deny",
              "reason": "baseline_reset_approval_required",
              "required_action": "record_approval"
            },
            "name": "baseline_reset_requires_approval"
          },
          {
            "condition": {
              "false_positive_rate_gt": 0.2,
              "tuning_review_recorded": false
            },
            "description": "High false-positive rates require tuning review.",
            "effect": {
              "decision": "require_review",
              "reason": "tuning_review_required",
              "required_action": "record_tuning_review"
            },
            "name": "high_false_positive_rate_requires_tuning"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
