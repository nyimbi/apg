{
  "agents": {},
  "app": {
    "description": "Environment Management package-backed APG capability",
    "entity_count": 0,
    "name": "envm",
    "version": "1.0.0"
  },
  "capabilities": {
    "envm": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "drift": {
          "configuration_source_required": true,
          "drift_detection_enabled": true,
          "drift_threshold_percent": 5,
          "remediation_supported": true
        },
        "environments": {
          "environment_owner_required": true,
          "production_locked_by_default": true,
          "region_policy_required": true,
          "stage_policy_required": true
        },
        "governance": {
          "audit_environment_changes": true,
          "rbac_policy_required": true,
          "require_tenant_context": true,
          "secret_scope_policy_required": true
        },
        "promotion": {
          "approval_required": true,
          "deployment_link_required": true,
          "promotion_path_required": true,
          "rollback_environment_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "envm_environment_ops"
        },
        "ui": {
          "enable_drift_dashboard": true,
          "enable_environment_inventory": true,
          "enable_promotion_console": true,
          "enable_secret_scope_manager": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Environment Management",
      "provides": [
        "envm_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All environment operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "environment_owner_assigned": false,
              "operation": "create_environment"
            },
            "description": "Environments require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "environment_owner_required",
              "required_action": "assign_environment_owner"
            },
            "name": "environment_requires_owner"
          },
          {
            "condition": {
              "approval_recorded": false,
              "environment": "production"
            },
            "description": "Production environment changes require approval.",
            "effect": {
              "decision": "deny",
              "reason": "production_approval_required",
              "required_action": "record_production_approval"
            },
            "name": "production_change_requires_approval"
          },
          {
            "condition": {
              "operation": "promote",
              "promotion_path_attached": false
            },
            "description": "Promotion requires a declared path.",
            "effect": {
              "decision": "deny",
              "reason": "promotion_path_required",
              "required_action": "attach_promotion_path"
            },
            "name": "promotion_requires_path"
          },
          {
            "condition": {
              "secret_policy_attached": false,
              "secret_scope_present": true
            },
            "description": "Environment secrets require scope policy.",
            "effect": {
              "decision": "deny",
              "reason": "secret_policy_required",
              "required_action": "attach_secret_policy"
            },
            "name": "secret_scope_requires_policy"
          },
          {
            "condition": {
              "drift_percent_gt": 5,
              "drift_review_recorded": false
            },
            "description": "High configuration drift requires review.",
            "effect": {
              "decision": "require_review",
              "reason": "drift_review_required",
              "required_action": "review_drift"
            },
            "name": "high_drift_requires_review"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
        {
          "condition": {
