            "path": "/envm/drift",
            "permission": "envm:view"
          },
          {
            "component": "SecretScopes",
            "name": "secrets",
            "nav_group": "Security",
            "path": "/envm/secrets",
            "permission": "envm:manage_secrets"
          },
          {
            "component": "EnvironmentPolicies",
            "name": "policies",
            "nav_group": "Governance",
            "path": "/envm/policies",
            "permission": "envm:admin"
          },
          {
            "component": "EnvironmentAnalytics",
            "name": "analytics",
            "nav_group": "Operations",
            "path": "/envm/analytics",
            "permission": "envm:view"
          },
          {
            "component": "ENVMSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/envm/settings",
            "permission": "envm:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
