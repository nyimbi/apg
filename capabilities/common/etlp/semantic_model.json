      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "view_models.py"
      },
      "screens": {
        "adapters": {
          "component": "ETLPAdapterHealth",
          "permission": "etlp:admin",
          "route": "/etlp/adapters"
        },
        "audit": {
          "component": "ETLPAuditTimeline",
          "permission": "etlp:audit:read",
          "route": "/etlp/audit"
        },
        "dashboard": {
          "component": "ETLPDashboard",
          "permission": "etlp:pipeline:read",
          "route": "/etlp/dashboard"
        },
        "datasources": {
          "component": "DatasourceManager",
          "permission": "etlp:datasource:read",
          "route": "/etlp/datasources"
        },
        "designer": {
          "component": "PipelineDesigner",
          "permission": "etlp:pipeline:write",
          "route": "/etlp/designer"
        },
        "executions": {
          "component": "ExecutionMonitor",
          "permission": "etlp:pipeline:execute",
          "route": "/etlp/executions"
        },
        "field_mapper": {
          "component": "FieldMapper",
          "permission": "etlp:transformation:write",
          "route": "/etlp/field-mapper"
        },
        "lineage": {
          "component": "PipelineLineage",
          "permission": "etlp:lineage:read",
          "route": "/etlp/lineage"
        },
        "pipelines": {
          "component": "PipelineWorkbench",
          "permission": "etlp:pipeline:read",
          "route": "/etlp/pipelines"
        },
        "publish": {
          "component": "PublishReviewQueue",
          "permission": "etlp:publish:review",
          "route": "/etlp/publish"
        },
        "quality": {
          "component": "QualityGateConsole",
          "permission": "etlp:quality:read",
          "route": "/etlp/quality"
        },
        "replay": {
          "component": "ReplayConsole",
          "permission": "etlp:execution:replay",
          "route": "/etlp/replay"
        },
        "schedules": {
          "component": "ScheduleConsole",
          "permission": "etlp:pipeline:write",
          "route": "/etlp/schedules"
