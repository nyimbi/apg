{
  "agents": {},
  "app": {
    "description": "ETL/ELT Processing package-backed APG capability",
    "entity_count": 0,
    "name": "etlp",
    "version": "1.0.0"
  },
  "capabilities": {
    "etlp": {
      "adapters": {
        "connector_registry": "adapter",
        "event_stream": "bytewax",
        "execution_engine": "adapter",
        "generated_app_runtime": "service.ETLPLifecycleService",
        "lineage_emitter": "adapter",
        "metadata_catalog": "meta",
        "production_runtime": "service.ETLPService",
        "quality_engine": "adapter",
        "secret_store": "adapter"
      },
      "approvals": {
        "datasource": "ETLPDatasourceRecord",
        "execution": "ETLPExecutionRecord",
        "publish": "ETLPPublishRecord",
        "replay": "ETLPReplayRecord",
        "schedule": "ETLPScheduleRecord"
      },
      "business_rules": [],
      "components": {},
      "configuration": {
        "adapters": {
          "connector_registry": "adapter",
          "event_stream": "bytewax",
          "execution_engine": "adapter",
          "generated_app_runtime": "service.ETLPLifecycleService",
          "lineage_emitter": "adapter",
          "metadata_catalog": "meta",
          "production_runtime": "service.ETLPService",
          "quality_engine": "adapter",
          "secret_store": "adapter"
        },
        "datasources": {
          "approval_required": true,
          "embedded_secret_denied": true,
          "owner_required": true,
          "secret_reference_required": true,
          "supported_types": [
            "database",
            "file",
            "api",
            "stream",
            "warehouse",
            "lakehouse",
            "object_store"
          ]
        },
        "execution": {
          "backfill_requires_review": true,
          "default_retry_limit": 3,
          "idempotency_key_required": true,
          "max_replay_window_hours": 72,
          "max_retry_limit": 5
        },
        "governance": {
          "audit_all_executions": true,
          "destructive_delete_review_required": true,
          "lineage_emission_required": true,
          "production_approval_required": true,
          "publish_approval_required": true,
          "require_tenant_context": true
        },
        "mappings": {
          "field_mapping_required": true,
          "lineage_required": true,
          "schema_validation_required": true
        },
        "optimization": {
          "ai_optimization_enabled": true,
          "cost_guardrail_enabled": true,
          "max_estimated_cost": 1000.0,
          "self_healing_enabled": true
        },
        "pipelines": {
          "default_status": "draft",
          "max_concurrent_executions": 10,
          "owner_required": true,
          "retire_requires_impact_review": true,
          "schedule_required_for_production": true,
          "supported_modes": [
            "elt",
            "etl",
            "batch",
            "streaming",
            "hybrid"
          ],
          "visual_designer_enabled": true
        },
        "processing": {
          "batch_enabled": true,
          "bytewax_streams_enabled": true,
          "default_mode": "elt",
          "federated_processing_enabled": true,
          "streaming_enabled": true
        },
        "quality": {
          "minimum_publish_score": 80.0,
          "quality_gate_enabled": true,
          "quarantine_failed_records": true,
          "required_dimensions": [
            "completeness",
            "validity",
            "freshness",
            "lineage",
            "mapping"
          ]
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "etlp_pipeline_console"
        },
        "ui": {
          "enable_adapter_health": true,
          "enable_audit_timeline": true,
          "enable_execution_monitor": true,
          "enable_field_mapper": true,
          "enable_pipeline_designer": true,
          "enable_publish_review": true,
          "enable_quality_console": true,
          "enable_replay_console": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "ETL/ELT Processing",
      "pipeline_lifecycle": {
        "audit": "ETLPAuditEventRecord",
        "datasource": "ETLPDatasourceRecord",
        "execution": "ETLPExecutionRecord",
        "mapping": "ETLPMappingRecord",
        "pipeline": "ETLPPipelineRecord",
        "publish": "ETLPPublishRecord",
        "quality": "ETLPQualityRecord",
        "replay": "ETLPReplayRecord",
        "schedule": "ETLPScheduleRecord"
      },
      "provides": [
        "etlp_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All pipeline operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "register_pipeline",
              "owner_assigned": false
            },
            "description": "Pipeline registration requires an assigned owner.",
            "effect": {
              "decision": "deny",
              "reason": "pipeline_owner_required",
              "required_action": "assign_pipeline_owner"
            },
            "name": "pipeline_registration_requires_owner"
          },
          {
            "condition": {
              "operation": "register_pipeline",
              "unsupported_mode": true
            },
            "description": "Pipeline mode must be configured for the tenant.",
            "effect": {
              "decision": "deny",
              "reason": "unsupported_pipeline_mode",
              "required_action": "choose_supported_mode"
            },
            "name": "pipeline_mode_must_be_supported"
          },
          {
            "condition": {
              "operation": "execute_pipeline",
              "owner_assigned": false
            },
            "description": "Pipeline execution requires an assigned owner.",
            "effect": {
              "decision": "deny",
              "reason": "pipeline_owner_required",
              "required_action": "assign_pipeline_owner"
            },
            "name": "pipeline_execution_requires_owner"
          },
          {
            "condition": {
              "approval_recorded": false,
              "environment": "production",
              "operation": "execute_pipeline"
            },
            "description": "Production executions require approval.",
            "effect": {
              "decision": "deny",
              "reason": "production_approval_required",
              "required_action": "record_execution_approval"
            },
            "name": "production_execution_requires_approval"
          },
          {
            "condition": {
              "idempotency_key_present": false,
              "operation": "execute_pipeline"
            },
            "description": "Pipeline executions require idempotency evidence.",
            "effect": {
              "decision": "deny",
              "reason": "idempotency_key_required",
              "required_action": "attach_idempotency_key"
            },
            "name": "execution_requires_idempotency_key"
          },
          {
            "condition": {
              "datasource_owner_assigned": false,
              "operation": "register_datasource"
            },
            "description": "Data source registration requires an assigned owner.",
            "effect": {
              "decision": "deny",
              "reason": "datasource_owner_required",
              "required_action": "assign_datasource_owner"
            },
            "name": "datasource_registration_requires_owner"
          },
          {
            "condition": {
              "operation": "register_datasource",
              "secret_reference_present": false
            },
            "description": "Data source registration requires a secret-store reference.",
            "effect": {
              "decision": "deny",
              "reason": "secret_reference_required",
              "required_action": "attach_secret_reference"
            },
            "name": "datasource_requires_secret_reference"
          },
          {
            "condition": {
              "datasource_approved": false,
              "operation": "register_datasource"
            },
            "description": "Data sources require approval before execution.",
            "effect": {
              "decision": "require_review",
              "reason": "datasource_approval_required",
              "required_action": "approve_datasource"
            },
            "name": "datasource_requires_approval"
          },
          {
            "condition": {
              "operation": "register_datasource",
              "unsupported_datasource_type": true
            },
            "description": "Data source type must be configured for the tenant.",
            "effect": {
              "decision": "deny",
              "reason": "unsupported_datasource_type",
              "required_action": "choose_supported_datasource_type"
            },
            "name": "datasource_type_must_be_supported"
          },
          {
            "condition": {
              "embedded_secret_present": true,
              "operation": "register_datasource"
            },
            "description": "Data source secret material must use secret-store references.",
            "effect": {
              "decision": "deny",
              "reason": "embedded_secret_denied",
              "required_action": "store_secret_reference"
            },
            "name": "datasource_secrets_must_use_reference"
          },
          {
            "condition": {
              "operation": "register_mapping",
              "schema_validated": false
            },
            "description": "Field mappings require schema validation before use.",
            "effect": {
              "decision": "deny",
              "reason": "schema_validation_required",
              "required_action": "validate_mapping_schema"
            },
            "name": "mapping_requires_schema_validation"
          },
          {
            "condition": {
              "operation": "register_mapping",
              "source_and_target_registered": false
            },
            "description": "Field mappings require registered source and target data sources.",
            "effect": {
              "decision": "deny",
              "reason": "registered_datasources_required",
              "required_action": "register_mapping_datasources"
            },
            "name": "mapping_requires_registered_datasources"
          },
          {
            "condition": {
              "operation": "publish_output",
              "quality_gate_passed": false
            },
            "description": "Publishing transformed data requires passing quality gates.",
            "effect": {
              "decision": "deny",
              "reason": "quality_gate_required",
              "required_action": "resolve_quality_failures"
            },
            "name": "publish_requires_quality_gate"
          },
          {
            "condition": {
              "operation": "publish_output",
              "quality_score_lt": 80.0
            },
            "description": "Publishing transformed data requires the configured minimum quality score.",
            "effect": {
              "decision": "deny",
              "reason": "minimum_quality_required",
              "required_action": "raise_quality_score"
            },
            "name": "publish_requires_minimum_quality"
          },
          {
            "condition": {
              "operation": "publish_output",
              "publish_approval_recorded": false
            },
            "description": "Publishing production outputs requires an approval record.",
            "effect": {
              "decision": "deny",
              "reason": "publish_approval_required",
              "required_action": "record_publish_approval"
            },
            "name": "publish_requires_approval"
          },
          {
            "condition": {
              "environment": "production",
              "operation": "schedule_pipeline",
              "schedule_review_recorded": false
            },
            "description": "Production schedules require current review evidence.",
            "effect": {
              "decision": "require_review",
              "reason": "schedule_review_required",
              "required_action": "record_schedule_review"
            },
            "name": "production_schedule_requires_review"
          },
          {
            "condition": {
              "lineage_emitted": false,
              "operation": "execute_pipeline",
              "transformation_present": true
            },
            "description": "Transformations require lineage emission.",
            "effect": {
              "decision": "deny",
              "reason": "lineage_emission_required",
              "required_action": "emit_lineage_event"
            },
            "name": "lineage_required_for_transformations"
          },
          {
            "condition": {
              "cost_review_recorded": false,
              "estimated_cost_gt": 1000.0,
              "operation": "execute_pipeline"
            },
            "description": "High estimated execution cost requires review.",
            "effect": {
              "decision": "require_review",
              "reason": "cost_review_required",
              "required_action": "record_cost_review"
            },
            "name": "high_cost_execution_requires_review"
          },
          {
            "condition": {
              "operation": "retry_execution",
              "retry_count_gt": 3,
              "retry_review_recorded": false
            },
            "description": "Retry requests above tenant limits require review.",
            "effect": {
              "decision": "require_review",
              "reason": "retry_review_required",
              "required_action": "record_retry_review"
            },
            "name": "retry_limit_requires_review"
          },
          {
            "condition": {
              "operation": "replay_execution",
              "reason_present": false
            },
            "description": "Replay and backfill requests require a business reason.",
            "effect": {
              "decision": "deny",
              "reason": "replay_reason_required",
              "required_action": "attach_replay_reason"
            },
            "name": "replay_requires_reason"
          },
          {
            "condition": {
              "operation": "replay_execution",
              "replay_review_recorded": false,
              "replay_window_hours_gt": 72
            },
            "description": "Replay windows above the tenant limit require review.",
            "effect": {
              "decision": "require_review",
              "reason": "replay_window_review_required",
              "required_action": "record_replay_review"
            },
            "name": "replay_window_requires_review"
          },
          {
            "condition": {
              "impact_review_recorded": false,
              "operation": "retire_pipeline"
            },
            "description": "Destructive pipeline deletion requires impact review.",
            "effect": {
              "decision": "deny",
              "reason": "impact_review_required",
              "required_action": "record_impact_review"
            },
            "name": "destructive_delete_requires_review"
          }
        ],
        "type": "deterministic"
      },
