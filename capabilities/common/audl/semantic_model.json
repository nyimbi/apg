          "claude_code",
          "opencode",
          "pi"
        ]
      },
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "agents": {
          "enabled": true,
          "privileged_roles_require_human_approval": true,
          "supported_roles": [
            "audit_reviewer",
            "evidence_reviewer",
            "legal_hold_reviewer",
            "export_reviewer",
            "purge_reviewer",
            "investigation_reviewer",
