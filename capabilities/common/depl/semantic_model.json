            "path": "/depl/evidence",
            "permission": "depl:view"
          },
          {
            "component": "DeploymentAuditTrail",
            "name": "audit",
            "nav_group": "Governance",
            "path": "/depl/audit",
            "permission": "depl:audit"
          },
          {
            "component": "DeploymentAnalytics",
            "name": "analytics",
