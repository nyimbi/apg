          "separation_of_duties_required": true
        },
        "releases": {
          "approval_required": true,
          "artifact_signature_required": true,
          "manifest_required": true,
          "release_owner_required": true
        },
        "rollouts": {
          "health_gate_required": true,
          "max_canary_percent": 25,
          "rollback_plan_required": true,
          "supported_strategies": [
            "rolling",
            "blue_green",
            "canary"
          ]
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "depl_release_ops"
        },
        "ui": {
          "enable_health_gate_view": true,
          "enable_release_console": true,
          "enable_rollback_center": true,
          "enable_rollout_monitor": true
        }
