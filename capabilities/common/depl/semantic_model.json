{
  "agents": {},
  "app": {
    "description": "Deployment Management package-backed APG capability",
    "entity_count": 0,
    "name": "depl",
    "version": "1.0.0"
  },
  "capabilities": {
    "depl": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "adapters": {
          "api_helpers": "api.py",
          "audit_sink": "audl",
          "ci_cd": "cicd",
          "composition": "comp",
          "environment": "envm",
          "event_stream": "bytewax",
          "generated_app_runtime": "service.DeplService",
          "logs": "logt",
          "monitoring": "moni",
          "notifications": "ntfy",
          "view_models": "views.py"
        },
        "deployment_agents": {
          "agent_assist_enabled": true,
          "agent_contribution_disclosure_required": true,
          "agent_registration_required": true,
          "agent_runtime_required": true,
          "agent_scope_required": true,
          "allowed_roles": [
            "release_planner",
            "rollout_operator",
            "health_reviewer",
            "rollback_coordinator",
            "incident_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        },
        "evidence": {
          "change_ticket_required": true,
          "deployment_audit_required": true,
          "health_report_required": true,
          "log_trace_link_required": true
        },
        "governance": {
          "batch_event_stream": "bytewax",
          "environment_policy_required": true,
          "production_approval_required": true,
          "require_tenant_context": true,
          "separation_of_duties_required": true,
          "state_change_reason_required": true,
          "tenant_isolation_required": true
        },
        "observability": {
          "agent_activity_required": true,
          "audit_required": true,
          "event_stream": "bytewax",
          "health_metrics_required": true,
          "trace_required": true
        },
        "releases": {
          "approval_required": true,
          "artifact_signature_required": true,
          "manifest_required": true,
          "release_owner_required": true
        },
        "rollouts": {
          "health_gate_required": true,
          "max_canary_percent": 25,
          "rollback_plan_required": true,
          "supported_strategies": [
            "rolling",
            "blue_green",
            "canary"
          ]
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "depl_release_ops"
        },
        "ui": {
          "enable_agent_panel": true,
          "enable_analytics": true,
          "enable_audit": true,
          "enable_health_gate_view": true,
          "enable_release_console": true,
          "enable_rollback_center": true,
          "enable_rollout_monitor": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Deployment Management",
      "provides": [
        "release_management",
        "deployment_rollouts",
        "health_gates",
        "rollback_control",
        "deployment_audit",
        "deployment_agents"
      ],
      "requires": [
        "logt",
        "moni",
        "hlth"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All deployment operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_release",
              "release_owner_assigned": false
            },
            "description": "Releases require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "release_owner_required",
              "required_action": "assign_release_owner"
            },
            "name": "release_requires_owner"
          },
          {
            "condition": {
              "manifest_attached": false,
              "operation": "create_release"
            },
            "description": "Releases require manifest evidence.",
            "effect": {
              "decision": "deny",
              "reason": "manifest_required",
              "required_action": "attach_release_manifest"
            },
            "name": "release_requires_manifest"
          },
          {
            "condition": {
              "artifact_signature_attached": false,
              "operation": "create_release"
            },
            "description": "Release artifacts require signature evidence.",
            "effect": {
              "decision": "deny",
              "reason": "artifact_signature_required",
              "required_action": "attach_artifact_signature"
            },
            "name": "release_requires_signature"
          },
          {
            "condition": {
              "change_ticket_attached": false,
              "operation": "create_release"
            },
            "description": "Releases require change-ticket evidence.",
            "effect": {
              "decision": "deny",
              "reason": "change_ticket_required",
              "required_action": "attach_change_ticket"
            },
            "name": "release_requires_change_ticket"
          },
          {
            "condition": {
              "check_count_lte": 0,
              "operation": "record_health_gate"
            },
            "description": "Health gates require at least one check.",
            "effect": {
              "decision": "deny",
              "reason": "health_checks_required",
              "required_action": "record_health_checks"
            },
            "name": "health_gate_requires_checks"
          },
          {
            "condition": {
              "health_gate_passed": false,
              "operation": "deploy"
            },
            "description": "Deployments require a passing health gate.",
            "effect": {
              "decision": "deny",
              "reason": "health_gate_required",
              "required_action": "pass_health_gate"
            },
            "name": "deployment_requires_health_gate"
          },
          {
            "condition": {
              "approval_recorded": false,
              "target_environment": "production"
            },
            "description": "Production deployment requires approval.",
            "effect": {
              "decision": "deny",
              "reason": "production_approval_required",
              "required_action": "record_production_approval"
            },
            "name": "production_requires_approval"
          },
          {
            "condition": {
              "operation": "deploy",
              "rollback_plan_attached": false
            },
            "description": "Deployments require rollback plans.",
            "effect": {
              "decision": "deny",
              "reason": "rollback_plan_required",
              "required_action": "attach_rollback_plan"
            },
            "name": "rollback_requires_plan"
          },
          {
            "condition": {
              "canary_percent_gt": 25,
              "canary_review_recorded": false
            },
            "description": "Large canary deployments require review.",
            "effect": {
              "decision": "require_review",
              "reason": "canary_review_required",
              "required_action": "review_canary_scope"
            },
            "name": "large_canary_requires_review"
          },
          {
            "condition": {
              "log_trace_captured": false,
              "operation": "deploy"
            },
            "description": "Deployment runs require log and trace evidence.",
            "effect": {
              "decision": "deny",
              "reason": "log_trace_link_required",
              "required_action": "attach_log_trace_link"
            },
            "name": "deployment_requires_trace"
          },
          {
            "condition": {
              "agent_registered": false,
              "deployment_agent_present": true
            },
            "description": "AI deployment agents must be registered.",
            "effect": {
              "decision": "deny",
              "reason": "deployment_agent_registration_required",
              "required_action": "register_deployment_agent"
            },
            "name": "deployment_agent_requires_registration"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "deployment_agent_present": true
            },
            "description": "AI deployment agents must use a supported runtime.",
            "effect": {
              "decision": "deny",
              "reason": "deployment_agent_runtime_not_supported",
              "required_action": "choose_supported_deployment_agent_runtime"
            },
            "name": "deployment_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "deployment_agent_present": true
            },
            "description": "AI deployment agents must use a supported role.",
            "effect": {
              "decision": "deny",
              "reason": "deployment_agent_role_not_supported",
              "required_action": "choose_supported_deployment_agent_role"
            },
            "name": "deployment_agent_role_supported"
          },
          {
            "condition": {
              "agent_scope_present": false,
              "deployment_agent_present": true
            },
            "description": "AI deployment agents require explicit scope.",
            "effect": {
              "decision": "deny",
              "reason": "deployment_agent_scope_required",
              "required_action": "set_deployment_agent_scope"
            },
            "name": "deployment_agent_requires_scope"
          },
          {
            "condition": {
              "agent_contribution_disclosed": false,
              "deployment_agent_present": true
            },
            "description": "AI deployment-agent contributions require disclosure.",
            "effect": {
              "decision": "deny",
              "reason": "deployment_agent_disclosure_required",
              "required_action": "disclose_deployment_agent"
            },
            "name": "deployment_agent_requires_disclosure"
          },
          {
            "condition": {
              "state_change_reason_present": false,
              "state_change_requested": true
            },
            "description": "Deployment lifecycle state changes require a reason.",
            "effect": {
              "decision": "deny",
              "reason": "depl_state_change_reason_required",
              "required_action": "record_state_change_reason"
            },
            "name": "depl_state_change_requires_reason"
          },
          {
            "condition": {
              "audit_event_recorded": false,
              "state_change_requested": true
            },
            "description": "Deployment lifecycle state changes require audit evidence.",
            "effect": {
              "decision": "deny",
              "reason": "depl_audit_event_required",
              "required_action": "record_deployment_audit_event"
            },
            "name": "depl_state_change_requires_audit"
          },
          {
            "condition": {
              "cross_tenant_access": true
            },
            "description": "Deployment records may not cross tenant boundaries.",
            "effect": {
              "decision": "deny",
              "reason": "cross_tenant_deployment_access_denied",
              "required_action": "use_tenant_local_context"
            },
            "name": "cross_tenant_deployment_access_denied"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "batch_deployment_mutation"
            },
            "description": "Batch deployment mutations must use Bytewax event streams.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "use_bytewax_event_stream"
            },
            "name": "batch_deployment_mutation_requires_bytewax"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
