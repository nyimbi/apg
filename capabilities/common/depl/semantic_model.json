      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "DeploymentAgentPanel",
          "permission": "depl:deploy",
          "route": "/depl/agents"
        },
        "analytics": {
          "component": "DeploymentAnalytics",
          "permission": "depl:view",
          "route": "/depl/analytics"
        },
        "audit": {
          "component": "DeploymentAuditTrail",
          "permission": "depl:audit",
          "route": "/depl/audit"
        },
        "dashboard": {
          "component": "DEPLDashboard",
          "permission": "depl:view",
          "route": "/depl/dashboard"
        },
        "deployments": {
          "component": "DeploymentMonitor",
          "permission": "depl:deploy",
          "route": "/depl/deployments"
        },
        "evidence": {
          "component": "DeploymentEvidence",
          "permission": "depl:view",
          "route": "/depl/evidence"
        },
        "health": {
          "component": "HealthGates",
          "permission": "depl:view",
          "route": "/depl/health"
        },
        "releases": {
          "component": "ReleaseConsole",
          "permission": "depl:plan",
          "route": "/depl/releases"
        },
        "rollback": {
          "component": "RollbackCenter",
          "permission": "depl:rollback",
          "route": "/depl/rollback"
        },
        "rollouts": {
          "component": "RolloutStrategies",
          "permission": "depl:deploy",
          "route": "/depl/rollouts"
        },
        "settings": {
          "component": "DEPLSettings",
          "permission": "depl:admin",
          "route": "/depl/settings"
        }
      },
      "streaming": {
        "batch_mutation_guardrail": "batch_deployment_mutation_requires_bytewax",
        "events": [
          "environment_registered",
          "release_created",
          "rollback_plan_attached",
          "health_gate_recorded",
          "deployment_plan_created",
          "deployment_review_approved",
          "deployment_plan_state_changed",
          "deployment_executed",
          "rollback_executed",
          "deployment_agent_registered"
        ],
        "processor": "bytewax",
        "state": [
          "environments",
          "releases",
          "rollback_plans",
          "health_gates",
          "deployment_plans",
          "deployment_runs",
          "rollback_events",
          "deployment_agents",
          "audit_events"
        ],
        "topic": "apg.depl.lifecycle"
      },
      "theme": {
        "components": {
          "agent_panel": {
            "icon": "bot",
            "status_style": "scope-chip"
          },
          "audit_timeline": {
            "icon": "list-checks",
            "status_style": "governance-chip"
          },
          "health_gate": {
            "status_style": "health-chip",
            "visual": "gate-checklist"
          },
          "release_board": {
            "icon": "rocket",
            "risk_style": "approval-band",
            "status_indicator": "release-pill"
          },
          "rollback_center": {
            "status_style": "rollback-chip",
            "visual": "recovery-timeline"
          },
          "rollout_monitor": {
            "highlight": "canary-chip",
            "visual": "progress-lanes"
          }
        },
        "name": "depl_release_ops",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#38A169",
          "color.danger": "#C53030",
          "color.primary": "#2C5282",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7F8FA",
          "surface.panel": "#FFFFFF",
          "text.primary": "#172033",
          "text.secondary": "#52606D"
        }
      },
      "ui": {
        "api_prefix": "/depl/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "DEPLDashboard",
            "name": "dashboard",
            "nav_group": "Overview",
            "path": "/depl/dashboard",
            "permission": "depl:view"
          },
          {
            "component": "ReleaseConsole",
            "name": "releases",
            "nav_group": "Releases",
            "path": "/depl/releases",
            "permission": "depl:plan"
          },
          {
            "component": "DeploymentMonitor",
            "name": "deployments",
            "nav_group": "Runtime",
            "path": "/depl/deployments",
            "permission": "depl:deploy"
          },
          {
            "component": "RolloutStrategies",
            "name": "rollouts",
            "nav_group": "Runtime",
            "path": "/depl/rollouts",
            "permission": "depl:deploy"
          },
          {
            "component": "HealthGates",
            "name": "health",
            "nav_group": "Quality",
            "path": "/depl/health",
            "permission": "depl:view"
          },
          {
            "component": "RollbackCenter",
            "name": "rollback",
            "nav_group": "Recovery",
            "path": "/depl/rollback",
            "permission": "depl:rollback"
          },
          {
            "component": "DeploymentAgentPanel",
            "name": "agents",
            "nav_group": "Agents",
            "path": "/depl/agents",
            "permission": "depl:deploy"
          },
          {
            "component": "DeploymentEvidence",
            "name": "evidence",
