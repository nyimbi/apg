            "nav_group": "Design",
            "path": "/ntfy/templates",
            "permission": "ntfy:manage_templates"
          },
          {
            "component": "CampaignConsole",
            "name": "campaigns",
            "nav_group": "Campaigns",
            "path": "/ntfy/campaigns",
            "permission": "ntfy:manage_campaigns"
          },
          {
            "component": "PreferenceCenter",
            "name": "preferences",
            "nav_group": "Recipients",
            "path": "/ntfy/preferences",
            "permission": "ntfy:view"
          },
          {
            "component": "ChannelHealth",
            "name": "channels",
            "nav_group": "Operations",
            "path": "/ntfy/channels",
            "permission": "ntfy:admin"
          },
          {
            "component": "DeliveryAnalytics",
            "name": "analytics",
            "nav_group": "Operations",
            "path": "/ntfy/analytics",
            "permission": "ntfy:view"
          },
          {
            "component": "NTFYSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/ntfy/settings",
            "permission": "ntfy:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
      }
    }
