          "component": "MessageConsole",
          "permission": "ntfy:send",
          "route": "/ntfy/messages"
        },
        "preferences": {
          "component": "PreferenceCenter",
          "permission": "ntfy:view",
          "route": "/ntfy/preferences"
        },
        "settings": {
          "component": "NTFYSettings",
          "permission": "ntfy:admin",
          "route": "/ntfy/settings"
        },
        "templates": {
          "component": "TemplateStudio",
          "permission": "ntfy:manage_templates",
