        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Video Conferencing",
      "provides": [
        "vidc_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All video operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "host_present": false,
              "operation": "start_meeting"
            },
            "description": "Meetings require an accountable host.",
            "effect": {
              "decision": "deny",
              "reason": "host_required",
              "required_action": "assign_or_wait_for_host"
            },
            "name": "meeting_requires_host"
          },
          {
            "condition": {
              "external_guest_present": true,
              "guest_policy_attached": false
            },
            "description": "External guests require an access policy.",
            "effect": {
              "decision": "deny",
              "reason": "guest_policy_required",
              "required_action": "attach_guest_policy"
            },
            "name": "external_guest_requires_policy"
          },
          {
            "condition": {
              "recording_consent_recorded": false,
              "recording_requested": true
            },
            "description": "Meeting recordings require consent.",
            "effect": {
              "decision": "deny",
              "reason": "recording_consent_required",
              "required_action": "record_meeting_consent"
            },
            "name": "recording_requires_consent"
          },
          {
            "condition": {
              "recording_encrypted": false,
              "recording_requested": true
            },
            "description": "Meeting recordings must be encrypted.",
            "effect": {
              "decision": "deny",
              "reason": "recording_encryption_required",
              "required_action": "encrypt_recording"
            },
            "name": "recording_requires_encryption"
          },
          {
            "condition": {
              "capacity_review_recorded": false,
              "participant_count_gt": 500
            },
            "description": "Large meetings require capacity and moderation review.",
            "effect": {
              "decision": "require_review",
              "reason": "large_meeting_review_required",
              "required_action": "review_meeting_capacity"
            },
            "name": "large_meeting_requires_review"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
