          },
          {
            "component": "MeetingAnalytics",
            "name": "analytics",
            "nav_group": "Operations",
            "path": "/vidc/analytics",
            "permission": "vidc:view"
          },
          {
            "component": "VIDCSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/vidc/settings",
            "permission": "vidc:admin"
