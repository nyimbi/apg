          "adapter_status_panel": {
            "status_indicator": "adapter-state",
            "visual": "backend-grid"
          },
          "audit_decision_timeline": {
            "highlight": "matched-rule-chip",
            "visual": "decision-timeline"
          },
          "baseline_freshness_panel": {
            "status_indicator": "freshness-chip",
