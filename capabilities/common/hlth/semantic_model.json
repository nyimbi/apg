        "service": "service.py",
        "views": "view_models.py"
      },
      "screens": {
        "adapters": {
          "component": "HealthAdapterHealth",
          "permission": "health.admin",
          "route": "/hlth/adapters"
        },
        "alerts": {
          "component": "HealthAlertCenter",
          "permission": "health.alerts.acknowledge",
          "route": "/hlth/alerts"
        },
        "audit": {
          "component": "HealthAuditTimeline",
          "permission": "health.admin",
          "route": "/hlth/audit"
        },
        "baselines": {
          "component": "HealthBaselineConsole",
          "permission": "health.manage",
          "route": "/hlth/baselines"
        },
