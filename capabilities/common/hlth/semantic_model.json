          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7FAF8",
          "surface.panel": "#FFFFFF",
          "text.primary": "#14261F",
          "text.secondary": "#52635B"
        }
      },
      "ui": {
