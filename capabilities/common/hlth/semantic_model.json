      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "alerts": {
          "component": "HealthAlertCenter",
          "permission": "health.alerts.acknowledge",
          "route": "/hlth/alerts"
        },
        "components": {
          "component": "ComponentHealthMap",
          "permission": "health.view",
          "route": "/hlth/components"
        },
        "dashboard": {
          "component": "HealthDashboard",
          "permission": "health.view",
          "route": "/hlth/dashboard"
        },
