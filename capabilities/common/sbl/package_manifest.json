{
  "format": "apg.package-manifest.v1",
  "name": "common_sbl",
  "display_name": "SaaS Billing Engine",
  "version": "1.0.0",
  "base_target": "python",
  "profile": "capability",
  "profile_artifacts": [
    "package_manifest.json"
  ],
  "generated_artifacts": [
    "__init__.py",
    "capability_contract.py",
    "models.py",
    "service.py",
    "semantic_model.json"
  ],
  "dependencies": {
    "python": ">=3.11",
    "pydantic": ">=2.0",
    "uuid6": ">=2022.10.25"
  },
  "provides": [
    "subscription_management",
    "usage_metering",
    "invoice_generation",
    "tenant_provisioning",
    "billing_analytics"
  ],
  "requires": [
    "auth",
    "audl",
    "ntfy",
    "fin_gl",
    "fintech_payments"
  ],
  "publishes": [
    "subscription.created",
    "subscription.upgraded",
    "invoice.generated",
    "usage.limit_approaching"
  ],
  "event_stream": "apg.common.sbl.lifecycle",
  "stream_processor": "bytewax"
}
