            "permission": "chat:moderate"
          },
          {
            "component": "RetentionPolicy",
            "name": "retention",
            "nav_group": "Governance",
            "path": "/chat/retention",
            "permission": "chat:admin"
          },
          {
            "component": "ChatAnalytics",
            "name": "analytics",
