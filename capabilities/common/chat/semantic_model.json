{
  "agents": {},
  "app": {
    "description": "Chat and Messaging package-backed APG capability",
    "entity_count": 0,
    "name": "chat",
    "version": "1.0.0"
  },
  "capabilities": {
    "chat": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "governance": {
          "audit_moderation_actions": true,
          "external_guest_policy_required": true,
          "require_tenant_context": true,
          "retention_policy_required": true
        },
        "messaging": {
          "attachments_enabled": true,
          "delivery_receipts_enabled": true,
          "event_bus_required": true,
          "max_message_length": 8000
        },
        "moderation": {
          "moderation_policy_required": true,
          "moderator_review_supported": true,
          "nlp_assisted_moderation": true,
          "restricted_content_filtering": true
        },
        "rooms": {
          "max_members_per_room": 5000,
          "private_rooms_enabled": true,
          "public_rooms_enabled": true,
          "room_owner_required": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "chat_team_messaging"
        },
        "ui": {
          "enable_chat_console": true,
          "enable_moderation_queue": true,
          "enable_presence_panel": true,
          "enable_room_manager": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Chat and Messaging",
      "provides": [
        "chat_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All chat operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_room",
              "room_owner_assigned": false
            },
            "description": "Rooms require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "room_owner_required",
              "required_action": "assign_room_owner"
            },
            "name": "room_requires_owner"
          },
          {
            "condition": {
              "retention_policy_attached": false
            },
            "description": "Message rooms require a retention policy.",
            "effect": {
              "decision": "deny",
              "reason": "retention_policy_required",
              "required_action": "attach_retention_policy"
            },
            "name": "retention_policy_required"
          },
          {
            "condition": {
              "external_guest_present": true,
              "guest_policy_attached": false
            },
            "description": "External guests require a guest policy.",
            "effect": {
              "decision": "deny",
              "reason": "guest_policy_required",
              "required_action": "attach_guest_policy"
            },
            "name": "external_guest_requires_policy"
          },
          {
            "condition": {
              "moderation_completed": false,
              "restricted_content_detected": true
            },
            "description": "Restricted content requires moderation before release.",
            "effect": {
              "decision": "deny",
              "reason": "moderation_required",
              "required_action": "complete_moderation"
            },
            "name": "restricted_content_requires_moderation"
          },
          {
            "condition": {
              "access_review_recorded": false,
              "member_count_gt": 5000
            },
            "description": "Large rooms require access review.",
            "effect": {
              "decision": "require_review",
              "reason": "large_room_review_required",
              "required_action": "review_room_access"
            },
            "name": "large_room_requires_review"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
