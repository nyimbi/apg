      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "agents": {
          "component": "PoseAgentPanel",
          "permission": "pose:manage_models",
          "route": "/pose/agents"
        },
        "analysis": {
          "component": "BiomechanicalAnalysis",
          "permission": "pose:analyze",
          "route": "/pose/analysis"
        },
        "analytics": {
          "component": "POSEAnalytics",
          "permission": "pose:view",
          "route": "/pose/analytics"
        },
        "audit": {
          "component": "POSEAuditTrail",
          "permission": "pose:audit",
          "route": "/pose/audit"
        },
        "dashboard": {
          "component": "POSEDashboard",
          "permission": "pose:view",
          "route": "/pose/dashboard"
        },
        "estimate": {
          "component": "PoseEstimator",
          "permission": "pose:estimate",
          "route": "/pose/estimate"
        },
        "models": {
          "component": "PoseModelRegistry",
          "permission": "pose:manage_models",
          "route": "/pose/models"
        },
        "quality": {
          "component": "PoseQuality",
          "permission": "pose:view",
          "route": "/pose/quality"
        },
        "reconstruction": {
          "component": "Pose3DReconstruction",
          "permission": "pose:analyze",
          "route": "/pose/reconstruction"
        },
        "sessions": {
          "component": "PoseSessions",
          "permission": "pose:view",
          "route": "/pose/sessions"
        },
        "settings": {
          "component": "POSESettings",
          "permission": "pose:admin",
          "route": "/pose/settings"
        },
        "tracking": {
          "component": "TrackingConsole",
          "permission": "pose:track",
          "route": "/pose/tracking"
        }
      },
      "streaming": {
        "batch_mutation_guardrail": "batch_pose_mutation_requires_bytewax",
        "events": [
          "pose_model_registered",
          "pose_session_started",
          "pose_frame_recorded",
          "pose_estimated",
          "pose_analysis_completed",
          "pose_3d_reconstructed",
          "pose_agent_registered",
          "pose_session_state_changed"
        ],
        "processor": "bytewax",
        "state": [
          "models",
          "sessions",
          "frames",
          "estimates",
          "analyses",
          "reconstructions",
          "pose_agents"
        ],
        "topic": "apg.pose.lifecycle"
      },
      "theme": {
        "components": {
          "agent_panel": {
            "status_style": "scope-chip",
            "visual": "agent-roster"
          },
          "biomechanics_panel": {
            "status_style": "review-chip",
            "visual": "angle-metrics"
          },
          "model_registry": {
            "status_style": "confidence-chip",
            "visual": "model-grid"
          },
          "pose_viewer": {
            "icon": "activity",
            "risk_style": "consent-band",
            "status_indicator": "quality-pill"
          },
          "reconstruction_panel": {
            "status_style": "calibration-chip",
            "visual": "skeleton-3d"
          },
          "tracking_timeline": {
            "highlight": "latency-chip",
            "visual": "motion-timeline"
          }
        },
        "name": "pose_motion_intelligence",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#38A169",
          "color.danger": "#C53030",
          "color.primary": "#234E70",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7F8FA",
          "surface.panel": "#FFFFFF",
          "text.primary": "#172033",
          "text.secondary": "#52606D"
        }
      },
      "ui": {
        "api_prefix": "/pose/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "POSEDashboard",
            "name": "dashboard",
