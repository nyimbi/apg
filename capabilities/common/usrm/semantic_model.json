      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "access": {
          "component": "AccessReview",
          "permission": "usrm:review_access",
          "route": "/usrm/access"
        },
        "agents": {
          "component": "USRMAgentWorkbench",
          "permission": "usrm:admin",
          "route": "/usrm/agents"
        },
        "dashboard": {
          "component": "USRMDashboard",
          "permission": "usrm:view",
          "route": "/usrm/dashboard"
        },
        "deprovisioning": {
          "component": "DeprovisioningCenter",
          "permission": "usrm:deprovision",
          "route": "/usrm/deprovisioning"
        },
        "lifecycle": {
          "component": "LifecycleQueue",
          "permission": "usrm:manage_users",
          "route": "/usrm/lifecycle"
        },
        "policy": {
          "component": "USRMPolicyCenter",
          "permission": "usrm:admin",
          "route": "/usrm/policy"
        },
        "privacy": {
          "component": "PrivacyPreferences",
          "permission": "usrm:view",
          "route": "/usrm/privacy"
        },
        "profiles": {
          "component": "ProfileManager",
          "permission": "usrm:manage_users",
          "route": "/usrm/profiles"
        },
        "settings": {
          "component": "USRMSettings",
          "permission": "usrm:admin",
          "route": "/usrm/settings"
        },
        "users": {
          "component": "UserDirectory",
          "permission": "usrm:manage_users",
          "route": "/usrm/users"
        }
      },
      "streaming": {
        "events": [
          "user_created",
          "profile_updated",
          "user_invited",
          "role_assigned",
          "access_review_recorded",
          "user_deprovisioned",
          "bulk_suspend_users",
          "usrm_agent_registered"
        ],
        "guardrails": [
          "invite_requires_bytewax_stream",
          "deprovision_requires_bytewax_stream",
          "bulk_user_action_requires_bytewax",
          "privileged_agent_user_action_requires_human_approval"
        ],
        "key": "tenant_id",
        "processor": "bytewax",
        "states": [
          "active",
          "invited",
          "suspended",
          "review_required",
          "deprovisioned",
          "blocked"
        ],
        "stream": "apg.usrm.lifecycle"
      },
      "theme": {
        "components": {
          "access_review": {
            "status_style": "mfa-chip",
            "visual": "entitlement-matrix"
          },
          "agent_workbench": {
            "status_style": "approval-chip",
            "visual": "review-lane"
          },
          "lifecycle_queue": {
            "highlight": "stage-chip",
            "visual": "approval-list"
          },
          "policy_center": {
            "status_style": "guardrail-chip",
            "visual": "rule-grid"
          },
          "privacy_panel": {
            "status_style": "consent-chip",
            "visual": "preference-list"
          },
          "user_card": {
            "icon": "user-cog",
            "risk_style": "access-band",
            "status_indicator": "status-pill"
          }
        },
        "name": "usrm_user_lifecycle",
        "tokens": {
          "border.radius": "8px",
          "color.accent": "#38A169",
          "color.danger": "#C53030",
          "color.primary": "#2B4C7E",
          "color.success": "#2F855A",
          "color.warning": "#B7791F",
          "density": "compact",
          "surface.canvas": "#F7F8FA",
          "surface.panel": "#FFFFFF",
          "text.primary": "#172033",
          "text.secondary": "#52606D"
        }
      },
      "ui": {
        "api_prefix": "/usrm/api/v1",
        "requires_theme": true,
        "routes": [
          {
            "component": "USRMDashboard",
            "name": "dashboard",
            "nav_group": "Overview",
            "path": "/usrm/dashboard",
            "permission": "usrm:view"
          },
          {
            "component": "UserDirectory",
            "name": "users",
            "nav_group": "Users",
            "path": "/usrm/users",
            "permission": "usrm:manage_users"
          },
          {
            "component": "ProfileManager",
            "name": "profiles",
            "nav_group": "Users",
            "path": "/usrm/profiles",
            "permission": "usrm:manage_users"
          },
          {
            "component": "LifecycleQueue",
            "name": "lifecycle",
            "nav_group": "Lifecycle",
            "path": "/usrm/lifecycle",
            "permission": "usrm:manage_users"
          },
          {
            "component": "AccessReview",
            "name": "access",
            "nav_group": "Access",
            "path": "/usrm/access",
            "permission": "usrm:review_access"
          },
          {
            "component": "PrivacyPreferences",
            "name": "privacy",
            "nav_group": "Privacy",
            "path": "/usrm/privacy",
            "permission": "usrm:view"
          },
          {
            "component": "DeprovisioningCenter",
            "name": "deprovisioning",
            "nav_group": "Lifecycle",
            "path": "/usrm/deprovisioning",
            "permission": "usrm:deprovision"
          },
          {
            "component": "USRMAgentWorkbench",
            "name": "agents",
            "nav_group": "Automation",
            "path": "/usrm/agents",
            "permission": "usrm:admin"
          },
          {
            "component": "USRMPolicyCenter",
            "name": "policy",
            "nav_group": "Governance",
            "path": "/usrm/policy",
            "permission": "usrm:admin"
          },
          {
            "component": "USRMSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/usrm/settings",
            "permission": "usrm:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
      }
