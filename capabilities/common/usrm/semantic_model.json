{
  "agents": {},
  "app": {
    "description": "User Management package-backed APG capability",
    "entity_count": 0,
    "name": "usrm",
    "version": "1.0.0"
  },
  "capabilities": {
    "usrm": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "access": {
          "least_privilege_policy_required": true,
          "periodic_access_review_required": true,
          "privileged_mfa_required": true,
          "privileged_role_approval_required": true,
          "role_assignment_audit_required": true
        },
        "adapters": {
          "audit": "adapter",
          "authorization": "adapter",
          "consent": "adapter",
          "event_stream": "bytewax",
          "identity": "adapter",
          "mfa": "adapter"
        },
        "governance": {
          "audit_user_changes": true,
          "identity_federation_supported": true,
          "privacy_preference_sync_required": true,
          "require_tenant_context": true,
          "state_change_audit_required": true
        },
        "lifecycle": {
          "bulk_action_review_threshold": 25,
          "bulk_action_stream_required": true,
          "deprovision_access_revocation_required": true,
          "deprovision_evidence_required": true,
          "invite_consent_notice_required": true,
          "manager_approval_required": true
        },
        "observability": {
          "emit_access_events": true,
          "emit_lifecycle_events": true,
          "emit_user_events": true,
          "event_stream": "apg.usrm.lifecycle",
          "stream_processor": "bytewax"
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "usrm_user_lifecycle"
        },
        "ui": {
          "enable_access_review": true,
          "enable_agent_workbench": true,
          "enable_lifecycle_queue": true,
          "enable_policy_center": true,
          "enable_privacy_preferences": true,
          "enable_user_directory": true
        },
        "users": {
          "profile_validation_required": true,
          "status_history_enabled": true,
          "unique_identity_required": true,
          "user_owner_required": true
        },
        "usrm_agents": {
          "disclose_agent_recommendations": true,
          "enabled": true,
          "human_approval_required": true,
          "max_autonomous_scope": "non_privileged",
          "supported_roles": [
            "identity_reviewer",
            "lifecycle_reviewer",
            "access_reviewer",
            "deprovision_reviewer",
            "privacy_reviewer",
            "entitlement_reviewer"
          ],
          "supported_runtimes": [
            "codex",
            "claude_code",
            "opencode",
            "pi"
          ]
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "User Management",
      "provides": [
        "user_directory",
        "profile_management",
        "consented_invitations",
        "role_assignment_governance",
        "access_review_workflows",
        "deprovisioning_governance",
        "user_audit_events",
        "usrm_agents"
      ],
      "requires": [
        "auth",
        "mfau",
        "cons",
        "audl",
        "idfd"
      ],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All user-management operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_user",
              "unique_identity_present": false
            },
            "description": "Users require a unique identity.",
            "effect": {
              "decision": "deny",
              "reason": "unique_identity_required",
              "required_action": "attach_unique_identity"
            },
            "name": "user_requires_identity"
          },
          {
            "condition": {
              "operation": "create_user",
              "user_owner_assigned": false
            },
            "description": "Users require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "user_owner_required",
              "required_action": "assign_user_owner"
            },
            "name": "user_requires_owner"
          },
          {
            "condition": {
              "operation": "create_user",
              "profile_validated": false
            },
            "description": "User creation requires profile validation evidence.",
            "effect": {
              "decision": "deny",
              "reason": "profile_validation_required",
              "required_action": "validate_user_profile"
            },
            "name": "user_requires_profile_validation"
          },
          {
            "condition": {
              "consent_notice_attached": false,
              "operation": "invite_user"
            },
            "description": "User invitations require a privacy/consent notice.",
            "effect": {
              "decision": "deny",
              "reason": "consent_notice_required",
              "required_action": "attach_consent_notice"
            },
            "name": "invite_requires_consent_notice"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "invite_user"
            },
            "description": "User invitation lifecycle events must be emitted through Bytewax.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_user_invitation_to_bytewax"
            },
            "name": "invite_requires_bytewax_stream"
          },
          {
            "condition": {
              "operation": "update_profile",
              "privacy_sync_recorded": false
            },
            "description": "Profile changes require privacy preference sync evidence.",
            "effect": {
              "decision": "deny",
              "reason": "privacy_preference_sync_required",
              "required_action": "sync_privacy_preferences"
            },
            "name": "profile_requires_privacy_sync"
          },
          {
            "condition": {
              "mfa_enabled": false,
              "privileged_user": true
            },
            "description": "Privileged users require MFA.",
            "effect": {
              "decision": "deny",
              "reason": "mfa_required",
              "required_action": "enable_mfa"
            },
            "name": "privileged_user_requires_mfa"
          },
          {
            "condition": {
              "operation": "assign_role",
              "privileged_role": true,
              "role_approval_recorded": false
            },
            "description": "Privileged role assignments require approval.",
            "effect": {
              "decision": "deny",
              "reason": "role_assignment_approval_required",
              "required_action": "record_role_assignment_approval"
            },
            "name": "privileged_role_requires_approval"
          },
          {
            "condition": {
              "access_reviewer_present": false,
              "operation": "record_access_review"
            },
            "description": "Access reviews require reviewer attribution.",
            "effect": {
              "decision": "deny",
              "reason": "access_reviewer_required",
              "required_action": "assign_access_reviewer"
            },
            "name": "access_review_requires_reviewer"
          },
          {
            "condition": {
              "access_revoked": false,
              "operation": "deprovision_user"
            },
            "description": "Deprovisioning requires access revocation evidence.",
            "effect": {
              "decision": "deny",
              "reason": "access_revocation_required",
              "required_action": "revoke_user_access"
            },
            "name": "deprovision_requires_access_revocation"
          },
          {
            "condition": {
              "deprovision_evidence_present": false,
              "operation": "deprovision_user"
            },
            "description": "Deprovisioning requires a durable evidence reference.",
            "effect": {
              "decision": "deny",
              "reason": "deprovision_evidence_required",
              "required_action": "attach_deprovision_evidence"
            },
            "name": "deprovision_requires_evidence"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "deprovision_user"
            },
            "description": "Deprovision lifecycle events must be emitted through Bytewax.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_deprovision_lifecycle_to_bytewax"
            },
            "name": "deprovision_requires_bytewax_stream"
          },
          {
            "condition": {
              "affected_user_count_gt": 25,
              "bulk_review_recorded": false
            },
            "description": "Bulk user actions require review.",
            "effect": {
              "decision": "require_review",
              "reason": "bulk_user_review_required",
              "required_action": "review_bulk_user_action"
            },
            "name": "bulk_user_action_requires_review"
          },
          {
            "condition": {
              "event_stream_ne": "bytewax",
              "operation": "bulk_user_action"
            },
            "description": "Bulk user lifecycle actions require Bytewax stream coordination.",
            "effect": {
              "decision": "deny",
              "reason": "bytewax_event_stream_required",
              "required_action": "route_bulk_user_action_to_bytewax"
            },
            "name": "bulk_user_action_requires_bytewax"
          },
          {
            "condition": {
              "agent_runtime_supported": false,
              "operation": "register_usrm_agent"
            },
            "description": "User-management agents must use an approved runtime.",
            "effect": {
              "decision": "deny",
              "reason": "usrm_agent_runtime_not_supported",
              "required_action": "select_supported_agent_runtime"
            },
            "name": "usrm_agent_runtime_supported"
          },
          {
            "condition": {
              "agent_role_supported": false,
              "operation": "register_usrm_agent"
            },
            "description": "User-management agents must use an approved role.",
            "effect": {
              "decision": "deny",
              "reason": "usrm_agent_role_not_supported",
              "required_action": "select_supported_agent_role"
            },
            "name": "usrm_agent_role_supported"
          },
          {
            "condition": {
              "human_approval_recorded": false,
              "operation": "agent_user_action",
              "privileged_scope": true
            },
            "description": "Privileged user actions proposed by agents require human approval.",
            "effect": {
              "decision": "deny",
              "reason": "human_approval_required",
              "required_action": "record_human_approval"
            },
            "name": "privileged_agent_user_action_requires_human_approval"
          }
        ],
        "type": "deterministic"
      },
