          "high_value_review_threshold": 100000,
          "key_custody_required": true,
          "signature_required": true
        },
        "ui": {
          "enable_contract_registry": true,
          "enable_key_custody_view": true,
          "enable_ledger_console": true,
          "enable_transaction_monitor": true
        }
