            "nav_group": "Providers",
            "path": "/idfd/providers",
            "permission": "idfd:manage_providers"
          },
          {
            "component": "ProtocolWorkbench",
            "name": "protocols",
            "nav_group": "Providers",
            "path": "/idfd/protocols",
            "permission": "idfd:manage_providers"
          },
          {
            "component": "IdentityMappings",
            "name": "mappings",
            "nav_group": "Mappings",
            "path": "/idfd/mappings",
            "permission": "idfd:manage_mappings"
          },
          {
            "component": "FederatedSessions",
            "name": "sessions",
            "nav_group": "Operations",
            "path": "/idfd/sessions",
            "permission": "idfd:view"
          },
          {
            "component": "CertificateCenter",
            "name": "certificates",
            "nav_group": "Security",
            "path": "/idfd/certificates",
            "permission": "idfd:rotate_keys"
          },
          {
            "component": "FederationAudit",
            "name": "audit",
            "nav_group": "Governance",
            "path": "/idfd/audit",
            "permission": "idfd:view"
          },
          {
            "component": "IDFDSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/idfd/settings",
            "permission": "idfd:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
      }
