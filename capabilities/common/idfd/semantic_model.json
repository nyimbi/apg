      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "audit": {
          "component": "FederationAudit",
          "permission": "idfd:view",
          "route": "/idfd/audit"
        },
        "certificates": {
          "component": "CertificateCenter",
          "permission": "idfd:rotate_keys",
          "route": "/idfd/certificates"
        },
        "dashboard": {
