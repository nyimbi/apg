            "component": "AnnotationThreads",
            "name": "annotations",
            "nav_group": "Artifacts",
            "path": "/colb/annotations",
            "permission": "colb:collaborate"
          },
          {
            "component": "ProtocolMonitor",
            "name": "protocols",
            "nav_group": "Operations",
            "path": "/colb/protocols",
            "permission": "colb:admin"
          },
          {
            "component": "CollaborationAnalytics",
            "name": "analytics",
            "nav_group": "Operations",
            "path": "/colb/analytics",
            "permission": "colb:view"
          },
          {
            "component": "COLBSettings",
            "name": "settings",
            "nav_group": "Administration",
            "path": "/colb/settings",
            "permission": "colb:admin"
          }
        ],
        "shell": "apg_python",
        "template_roots": [
          "templates/",
          "static/"
        ],
        "view_module": "views.py"
