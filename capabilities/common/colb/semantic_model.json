{
  "agents": {},
  "app": {
    "description": "Collaboration Tools package-backed APG capability",
    "entity_count": 0,
    "name": "colb",
    "version": "1.0.0"
  },
  "capabilities": {
    "colb": {
      "approvals": {},
      "business_rules": [],
      "components": {},
      "configuration": {
        "governance": {
          "audit_collaboration_events": true,
          "external_collaboration_policy_required": true,
          "require_tenant_context": true,
          "retention_policy_required": true
        },
        "protocols": {
          "enabled": [
            "websocket",
            "webrtc",
            "mqtt",
            "grpc"
          ],
          "fallback_protocol_enabled": true,
          "protocol_health_required": true,
          "secure_transport_required": true
        },
        "sessions": {
          "conflict_resolution": "operational_transform",
          "presence_required": true,
          "realtime_sync_enabled": true,
          "session_recording_supported": true
        },
        "tenant_id": "default",
        "theme": {
          "allow_tenant_overrides": true,
          "default_theme": "colb_collaboration_workspace"
        },
        "ui": {
          "enable_annotation_panel": true,
          "enable_protocol_monitor": true,
          "enable_session_console": true,
          "enable_workspace_dashboard": true
        },
        "workspaces": {
          "artifact_policy_required": true,
          "guest_access_supported": true,
          "max_participants_per_workspace": 1000,
          "workspace_owner_required": true
        }
      },
      "erp_modules": [
        "common"
      ],
      "i18n": {},
      "master_data": {},
      "name": "Collaboration Tools",
      "provides": [
        "colb_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All collaboration operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_workspace",
              "workspace_owner_assigned": false
            },
            "description": "Workspaces require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "workspace_owner_required",
              "required_action": "assign_workspace_owner"
            },
            "name": "workspace_requires_owner"
          },
          {
            "condition": {
              "external_participant_present": true,
              "external_policy_attached": false
            },
            "description": "External collaboration requires a tenant policy.",
            "effect": {
              "decision": "deny",
              "reason": "external_policy_required",
              "required_action": "attach_external_collaboration_policy"
            },
            "name": "external_collaboration_requires_policy"
          },
          {
            "condition": {
              "realtime_session": true,
              "secure_transport": false
            },
            "description": "Realtime protocols require secure transport.",
            "effect": {
              "decision": "deny",
              "reason": "secure_transport_required",
              "required_action": "enable_secure_transport"
            },
            "name": "secure_transport_required"
          },
          {
            "condition": {
              "artifact_policy_attached": false,
              "shared_artifact_present": true
            },
            "description": "Shared artifacts require an artifact policy.",
            "effect": {
              "decision": "deny",
              "reason": "artifact_policy_required",
              "required_action": "attach_artifact_policy"
            },
            "name": "artifact_policy_required"
          },
          {
            "condition": {
              "membership_review_recorded": false,
              "participant_count_gt": 1000
            },
            "description": "Large workspaces require membership review.",
            "effect": {
              "decision": "require_review",
              "reason": "large_workspace_review_required",
              "required_action": "review_workspace_membership"
            },
            "name": "large_workspace_requires_review"
          }
        ],
        "type": "deterministic"
      },
      "rules": [
        {
          "condition": {
            "tenant_context_present": false
          },
