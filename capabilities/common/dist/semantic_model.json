      "provides": [
        "dist_operations"
      ],
      "requires": [],
      "rule_engine": {
        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All distributed operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "job_owner_assigned": false,
              "operation": "submit_job"
            },
            "description": "Distributed jobs require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "job_owner_required",
              "required_action": "assign_job_owner"
            },
            "name": "job_requires_owner"
          },
          {
            "condition": {
              "idempotency_key_present": false,
              "operation": "submit_job"
            },
            "description": "Distributed jobs require idempotency keys.",
            "effect": {
              "decision": "deny",
              "reason": "idempotency_key_required",
              "required_action": "attach_idempotency_key"
            },
            "name": "idempotency_key_required"
          },
          {
            "condition": {
              "health_check_attached": false,
              "worker_pool_selected": true
            },
            "description": "Worker pools require health checks.",
            "effect": {
              "decision": "deny",
              "reason": "worker_health_required",
              "required_action": "attach_worker_health_check"
            },
            "name": "worker_pool_requires_health"
          },
          {
            "condition": {
              "job_submission_requested": true,
              "quota_policy_attached": false
            },
            "description": "Distributed execution requires tenant quota policy.",
            "effect": {
              "decision": "deny",
              "reason": "quota_policy_required",
              "required_action": "attach_quota_policy"
            },
            "name": "quota_policy_required"
          },
          {
            "condition": {
              "partition_count_gt": 1000,
              "partition_review_recorded": false
            },
            "description": "Large partitioned jobs require review.",
            "effect": {
              "decision": "require_review",
              "reason": "partition_review_required",
              "required_action": "review_partition_plan"
            },
            "name": "large_partition_job_requires_review"
          }
        ],
        "type": "deterministic"
      },
