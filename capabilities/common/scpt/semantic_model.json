        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All scripting operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "operation": "create_script",
              "script_owner_assigned": false
            },
            "description": "Scripts require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "script_owner_required",
              "required_action": "assign_script_owner"
            },
            "name": "script_requires_owner"
          },
          {
            "condition": {
              "operation": "execute_script",
              "sandbox_attached": false
            },
            "description": "Script execution requires an active sandbox.",
            "effect": {
              "decision": "deny",
              "reason": "sandbox_required",
              "required_action": "attach_sandbox"
            },
            "name": "sandbox_required"
          },
          {
            "condition": {
              "approval_recorded": false,
              "dangerous_permission_requested": true
            },
            "description": "Dangerous permissions require approval.",
            "effect": {
              "decision": "deny",
              "reason": "dangerous_permission_approval_required",
              "required_action": "record_permission_approval"
            },
            "name": "dangerous_permission_requires_approval"
          },
          {
            "condition": {
              "network_access_requested": true,
              "network_policy_attached": false
            },
            "description": "Network access requires an explicit policy.",
            "effect": {
              "decision": "deny",
              "reason": "network_policy_required",
              "required_action": "attach_network_policy"
            },
            "name": "external_network_requires_policy"
          },
          {
            "condition": {
              "requested_memory_mb_gt": 512,
              "resource_review_recorded": false
            },
            "description": "High resource scripts require review.",
            "effect": {
              "decision": "require_review",
              "reason": "resource_review_required",
              "required_action": "review_script_resources"
            },
            "name": "high_resource_script_requires_review"
          }
        ],
        "type": "deterministic"
