      "runtime": {
        "api": "api.py",
        "entrypoint": "app.py",
        "service": "service.py",
        "views": "views.py"
      },
      "screens": {
        "analytics": {
          "component": "GatewayAnalytics",
          "permission": "apig:view_metrics",
          "route": "/apig/analytics"
        },
        "dashboard": {
          "component": "APIGDashboard",
          "permission": "apig:view",
          "route": "/apig/dashboard"
        },
