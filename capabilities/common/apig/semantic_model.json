{
  "agents": {},
  "app": {
    "description": "APG Intelligent Gateway package-backed APG capability",
    "entity_count": 0,
    "name": "apig",
    "version": "1.0.0"
  },
  "capabilities": {
    "apig": {
      "approvals": {},
      "business_rules": [],
      "components": {},
