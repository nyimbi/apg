        "rules": [
          {
            "condition": {
              "tenant_context_present": false
            },
            "description": "All localization operations require tenant context.",
            "effect": {
              "decision": "deny",
              "reason": "tenant_context_required",
              "required_action": "attach_tenant_context"
            },
            "name": "tenant_context_required"
          },
          {
            "condition": {
              "locale_owner_assigned": false,
              "operation": "create_locale"
            },
            "description": "Locales require an accountable owner.",
            "effect": {
              "decision": "deny",
              "reason": "locale_owner_required",
              "required_action": "assign_locale_owner"
            },
            "name": "locale_requires_owner"
          },
          {
            "condition": {
              "machine_translation_used": true,
              "translation_review_recorded": false
            },
            "description": "Machine translations require review before publishing.",
            "effect": {
              "decision": "deny",
              "reason": "translation_review_required",
              "required_action": "review_translation"
            },
            "name": "machine_translation_requires_review"
          },
          {
            "condition": {
              "approval_recorded": false,
              "operation": "publish_translations"
            },
            "description": "Translation publication requires approval.",
            "effect": {
              "decision": "deny",
              "reason": "publication_approval_required",
              "required_action": "record_publication_approval"
            },
            "name": "publish_requires_approval"
          },
          {
            "condition": {
              "rbac_filter_applied": false,
              "restricted_content_present": true
            },
            "description": "Restricted content requires RBAC filtering.",
            "effect": {
              "decision": "deny",
              "reason": "rbac_filter_required",
              "required_action": "apply_rbac_filter"
            },
            "name": "restricted_content_requires_filtering"
          },
          {
            "condition": {
              "coverage_percent_lt": 95,
              "coverage_review_recorded": false
            },
            "description": "Low localization coverage requires review.",
            "effect": {
              "decision": "require_review",
              "reason": "coverage_review_required",
              "required_action": "review_locale_coverage"
            },
            "name": "low_coverage_requires_review"
          }
        ],
        "type": "deterministic"
