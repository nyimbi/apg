    "MfMroAsset": {"description": "Production asset tracked for maintenance", "fields": {"id": {"type": "string"}, "asset_code": {"type": "string"}, "asset_name": {"type": "string"}, "status": {"type": "string"}, "criticality": {"type": "string"}}}
