{
  "capability": "mfg_mro",
  "version": "1.0.0",
  "domain": "mfg",
  "entities": {
    "MfMroWorkOrder": {"description": "Maintenance work order", "fields": {"id": {"type": "string"}, "asset_id": {"type": "string"}, "work_order_type": {"type": "string"}, "priority": {"type": "string"}, "status": {"type": "string"}, "scheduled_date": {"type": "string"}}},
