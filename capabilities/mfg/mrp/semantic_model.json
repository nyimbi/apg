{
  "capability": "mfg_mrp",
  "version": "1.0.0",
  "domain": "mfg",
  "description": "Material Requirements Planning — MRP-II semantic model",
  "entities": {
    "MfMrpPlanningRun": {
      "description": "An MRP explosion run (full regenerative or net-change)",
      "fields": {
        "id": {"type": "string", "format": "uuid7", "primary_key": true},
        "tenant_id": {"type": "string"},
        "run_type": {"type": "string", "enum": ["full", "net_change"]},
        "horizon": {"type": "string", "enum": ["day", "week", "month", "quarter"]},
        "horizon_days": {"type": "integer"},
        "status": {"type": "string", "enum": ["pending", "running", "completed", "failed"]},
        "items_exploded": {"type": "integer"},
        "orders_created": {"type": "integer"},
        "requisitions_created": {"type": "integer"},
        "messages_raised": {"type": "integer"},
        "started_at": {"type": "string", "format": "datetime", "nullable": true},
        "completed_at": {"type": "string", "format": "datetime", "nullable": true},
        "triggered_by": {"type": "string"},
        "created_at": {"type": "string", "format": "datetime"}
      }
    },
    "MfMrpProductionOrder": {
      "description": "A planned or released production order generated by MRP",
      "fields": {
        "id": {"type": "string", "format": "uuid7", "primary_key": true},
        "tenant_id": {"type": "string"},
        "item_id": {"type": "string"},
        "item_code": {"type": "string"},
        "order_type": {"type": "string", "enum": ["planned", "firm_planned", "released", "completed", "cancelled"]},
        "quantity": {"type": "number"},
        "uom": {"type": "string"},
        "start_date": {"type": "string", "format": "date"},
        "due_date": {"type": "string", "format": "date"},
        "bom_id": {"type": "string", "nullable": true},
        "work_center_id": {"type": "string", "nullable": true},
        "source_demand_id": {"type": "string", "nullable": true},
        "priority": {"type": "integer"},
        "released_at": {"type": "string", "format": "datetime", "nullable": true},
        "completed_at": {"type": "string", "format": "datetime", "nullable": true},
        "created_at": {"type": "string", "format": "datetime"}
      }
    },
    "MfMrpPurchaseRequisition": {
      "description": "A purchase requisition created by MRP for externally-sourced items",
      "fields": {
        "id": {"type": "string", "format": "uuid7", "primary_key": true},
        "tenant_id": {"type": "string"},
        "item_id": {"type": "string"},
        "item_code": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "submitted", "approved", "ordered", "received", "cancelled"]},
        "quantity": {"type": "number"},
        "uom": {"type": "string"},
        "unit_cost": {"type": "number", "nullable": true},
        "currency": {"type": "string"},
        "required_date": {"type": "string", "format": "date"},
        "supplier_id": {"type": "string", "nullable": true},
        "approver_id": {"type": "string", "nullable": true},
        "approved_at": {"type": "string", "format": "datetime", "nullable": true},
        "created_at": {"type": "string", "format": "datetime"}
      }
    },
    "MfMrpExceptionMessage": {
      "description": "An MRP action message flagging a supply/demand imbalance",
      "fields": {
        "id": {"type": "string", "format": "uuid7", "primary_key": true},
        "tenant_id": {"type": "string"},
        "planning_run_id": {"type": "string", "nullable": true},
        "message_type": {"type": "string", "enum": ["expedite", "defer", "cancel", "new_order", "quantity_change"]},
        "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
        "item_id": {"type": "string"},
        "item_code": {"type": "string"},
        "description": {"type": "string"},
        "suggested_action": {"type": "string"},
        "processed": {"type": "boolean"},
        "processed_at": {"type": "string", "format": "datetime", "nullable": true},
        "created_at": {"type": "string", "format": "datetime"}
      }
    },
    "MfMrpPeggingRecord": {
      "description": "Supply-to-demand pegging link",
      "fields": {
        "id": {"type": "string", "format": "uuid7", "primary_key": true},
        "tenant_id": {"type": "string"},
        "supply_type": {"type": "string", "enum": ["production_order", "purchase_requisition", "on_hand"]},
        "supply_id": {"type": "string"},
        "demand_type": {"type": "string", "enum": ["sales_order", "production_order", "forecast", "safety_stock"]},
        "demand_id": {"type": "string"},
        "item_id": {"type": "string"},
        "quantity_pegged": {"type": "number"},
        "peg_date": {"type": "string", "format": "date"},
        "created_at": {"type": "string", "format": "datetime"}
      }
    }
  },
  "api_endpoints": {
    "POST /mfg-mrp/api/v1/planning-runs": {"description": "Initiate MRP planning run", "request": "MfMrpPlanningRun", "response": "MfMrpPlanningRun"},
    "POST /mfg-mrp/api/v1/planning-runs/{id}/execute": {"description": "Execute a pending planning run", "response": "MfMrpPlanningRun"},
    "GET /mfg-mrp/api/v1/planning-runs": {"description": "List planning runs", "response": "list[MfMrpPlanningRun]"},
    "GET /mfg-mrp/api/v1/planning-runs/{id}": {"description": "Get planning run", "response": "MfMrpPlanningRun"},
    "POST /mfg-mrp/api/v1/production-orders": {"description": "Create production order", "response": "MfMrpProductionOrder"},
    "POST /mfg-mrp/api/v1/production-orders/{id}/release": {"description": "Release production order", "response": "MfMrpProductionOrder"},
    "POST /mfg-mrp/api/v1/production-orders/{id}/complete": {"description": "Complete production order", "response": "MfMrpProductionOrder"},
    "GET /mfg-mrp/api/v1/production-orders": {"description": "List production orders", "response": "list[MfMrpProductionOrder]"},
    "POST /mfg-mrp/api/v1/purchase-requisitions": {"description": "Create purchase requisition", "response": "MfMrpPurchaseRequisition"},
    "POST /mfg-mrp/api/v1/purchase-requisitions/{id}/approve": {"description": "Approve purchase requisition", "response": "MfMrpPurchaseRequisition"},
    "GET /mfg-mrp/api/v1/purchase-requisitions": {"description": "List purchase requisitions", "response": "list[MfMrpPurchaseRequisition]"},
    "GET /mfg-mrp/api/v1/exception-messages": {"description": "List exception messages", "response": "list[MfMrpExceptionMessage]"},
    "POST /mfg-mrp/api/v1/exception-messages/{id}/process": {"description": "Mark exception processed", "response": "MfMrpExceptionMessage"},
    "GET /mfg-mrp/api/v1/pegging/demand/{demand_id}": {"description": "Get pegging for a demand", "response": "list[MfMrpPeggingRecord]"},
    "GET /mfg-mrp/api/v1/dashboard": {"description": "Dashboard summary", "response": "object"}
  },
  "events": {
    "publishes": [
      "apg.mfg.mrp.production_order_created",
      "apg.mfg.mrp.production_order_released",
      "apg.mfg.mrp.purchase_requisition_created",
      "apg.mfg.mrp.planning_run_completed",
      "apg.mfg.mrp.exception_message_raised"
    ],
    "subscribes": [
      "apg.mfg.bom.bom_changed",
      "apg.inv.inventory_adjusted",
      "apg.crm.sales_order_created",
      "apg.mfg.ppl.master_schedule_updated"
    ]
  }
}
