{
  "capability": "mfg_mes",
  "version": "1.0.0",
  "domain": "mfg",
  "description": "Manufacturing Execution System semantic model",
  "entities": {
    "MfMesWorkOrder": {
      "description": "Shop-floor work order tracking production execution",
      "fields": {
        "id": {"type": "string", "format": "uuid7", "primary_key": true},
        "tenant_id": {"type": "string"},
        "item_id": {"type": "string"},
        "item_code": {"type": "string"},
        "quantity_scheduled": {"type": "number"},
        "quantity_started": {"type": "number"},
        "quantity_completed": {"type": "number"},
        "quantity_scrapped": {"type": "number"},
        "status": {"type": "string", "enum": ["created", "released", "started", "in_progress", "paused", "completed", "closed", "cancelled"]},
        "scheduled_start": {"type": "string", "format": "datetime"},
        "scheduled_end": {"type": "string", "format": "datetime"},
        "actual_start": {"type": "string", "format": "datetime", "nullable": true},
        "actual_end": {"type": "string", "format": "datetime", "nullable": true},
        "work_center_id": {"type": "string", "nullable": true},
        "production_order_id": {"type": "string", "nullable": true},
        "priority": {"type": "integer"},
        "created_at": {"type": "string", "format": "datetime"}
      }
    },
    "MfMesProductionEvent": {
      "description": "Discrete shop-floor event (start, pause, complete, scrap, etc.)",
      "fields": {
        "id": {"type": "string", "format": "uuid7", "primary_key": true},
        "tenant_id": {"type": "string"},
        "work_order_id": {"type": "string"},
        "event_type": {"type": "string", "enum": ["start", "pause", "resume", "scrap", "rework", "complete", "downtime", "setup", "teardown"]},
        "quantity": {"type": "number"},
        "operator_id": {"type": "string", "nullable": true},
        "notes": {"type": "string"},
        "recorded_at": {"type": "string", "format": "datetime"}
      }
    },
    "MfMesDowntimeRecord": {
      "description": "Resource downtime event with ISO 22400-2 categorisation",
      "fields": {
        "id": {"type": "string", "format": "uuid7", "primary_key": true},
        "tenant_id": {"type": "string"},
        "resource_id": {"type": "string"},
        "category": {"type": "string", "enum": ["planned", "unplanned", "maintenance", "changeover", "breakdown", "quality"]},
        "work_order_id": {"type": "string", "nullable": true},
        "description": {"type": "string"},
        "start_time": {"type": "string", "format": "datetime"},
        "end_time": {"type": "string", "format": "datetime", "nullable": true},
        "duration_minutes": {"type": "number", "nullable": true},
        "created_at": {"type": "string", "format": "datetime"}
      }
    },
    "MfMesOeeRecord": {
      "description": "Overall Equipment Effectiveness record per resource per period (ISO 22400-2)",
      "fields": {
        "id": {"type": "string", "format": "uuid7", "primary_key": true},
        "tenant_id": {"type": "string"},
        "resource_id": {"type": "string"},
        "period_start": {"type": "string", "format": "datetime"},
        "period_end": {"type": "string", "format": "datetime"},
        "planned_production_time_min": {"type": "number"},
        "actual_run_time_min": {"type": "number"},
        "total_count": {"type": "number"},
        "good_count": {"type": "number"},
        "availability": {"type": "number"},
        "performance": {"type": "number"},
        "quality": {"type": "number"},
        "oee": {"type": "number"},
        "calculated_at": {"type": "string", "format": "datetime"}
      }
    }
  },
  "api_endpoints": {
    "POST /mfg-mes/api/v1/work-orders": {"description": "Create work order", "response": "MfMesWorkOrder"},
    "POST /mfg-mes/api/v1/work-orders/{id}/start": {"description": "Start work order", "response": "MfMesWorkOrder"},
    "POST /mfg-mes/api/v1/work-orders/{id}/pause": {"description": "Pause work order", "response": "MfMesWorkOrder"},
    "POST /mfg-mes/api/v1/work-orders/{id}/complete": {"description": "Complete work order", "response": "MfMesWorkOrder"},
    "GET /mfg-mes/api/v1/work-orders": {"description": "List work orders", "response": "list[MfMesWorkOrder]"},
    "GET /mfg-mes/api/v1/work-orders/{id}": {"description": "Get work order", "response": "MfMesWorkOrder"},
    "POST /mfg-mes/api/v1/production-events": {"description": "Record production event", "response": "MfMesProductionEvent"},
    "GET /mfg-mes/api/v1/production-events": {"description": "List production events", "response": "list[MfMesProductionEvent]"},
    "POST /mfg-mes/api/v1/downtime": {"description": "Record downtime", "response": "MfMesDowntimeRecord"},
    "GET /mfg-mes/api/v1/downtime": {"description": "List downtime records", "response": "list[MfMesDowntimeRecord]"},
    "POST /mfg-mes/api/v1/oee/calculate": {"description": "Calculate OEE for a resource/period", "response": "MfMesOeeRecord"},
    "GET /mfg-mes/api/v1/oee": {"description": "List OEE records", "response": "list[MfMesOeeRecord]"},
    "GET /mfg-mes/api/v1/dashboard": {"description": "Dashboard summary", "response": "object"}
  },
  "events": {
    "publishes": [
      "apg.mfg.mes.work_order_started",
      "apg.mfg.mes.work_order_completed",
      "apg.mfg.mes.production_event_recorded",
      "apg.mfg.mes.downtime_recorded",
      "apg.mfg.mes.oee_calculated",
      "apg.mfg.mes.scrap_recorded"
    ],
    "subscribes": [
      "apg.mfg.mrp.production_order_released",
      "apg.mfg.sfc.operation_completed",
      "apg.mfg.qms.ncr_raised"
    ]
  }
}
