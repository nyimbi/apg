{# marketplace.html.j2 — APG Connector Marketplace #}

<nav class="flex items-center gap-2 text-sm mb-5 text-gray-500 flex-wrap">
  <a href="/ui" class="hover:text-apg-primary transition-colors">Application</a>
  <span>/</span>
  <span class="font-semibold text-gray-900">Connector Marketplace</span>
</nav>

<section class="mb-6">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Connector Marketplace</h1>
      <p class="text-sm text-gray-500 mt-1">
        Discover installed connectors and generated integration blueprints for this application.
      </p>
    </div>
    {% if has_installed_connectors %}
    <span class="apg-badge apg-badge-success">{{ installed_count }} installed</span>
    {% else %}
    <span class="apg-badge">{{ installed_count }} installed</span>
    {% endif %}
  </div>
</section>

<section class="apg-card apg-list-toolbar mb-6" aria-label="Marketplace discovery">
  <form method="get" action="/ui/marketplace" class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide">Search
      <input name="q" value="{{ query }}" placeholder="Search connectors..."
             class="mt-1 w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-apg-primary focus:border-transparent bg-white">
    </label>
    <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide">Category
      <select name="category" class="mt-1 w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-apg-primary bg-white">
        <option value="all"{% if active_category == 'all' %} selected{% endif %}>All categories</option>
        {% for category in categories %}
        <option value="{{ category.name }}"{% if category.active %} selected{% endif %}>{{ category.name }} ({{ category.count }})</option>
        {% endfor %}
      </select>
    </label>
    <div class="flex items-center gap-2">
      <button type="submit" class="apg-btn">Apply</button>
      {% if has_filters %}
      <a href="/ui/marketplace" class="apg-btn apg-btn-secondary">Clear</a>
      {% endif %}
    </div>
  </form>
  <div class="flex items-center gap-2 flex-wrap mt-4 text-xs text-gray-500">
    <span>{{ filtered_count }} of {{ connector_count }} shown</span>
    {% for category in categories %}
    <a href="/ui/marketplace?category={{ category.name | urlencode }}"
       class="px-2 py-1 border border-gray-200 rounded-lg hover:border-apg-primary{% if category.active %} text-apg-primary border-apg-primary{% endif %}">
      {{ category.name }}
    </a>
    {% endfor %}
  </div>
</section>

{% if connectors %}
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
  {% for conn in connectors %}
  <article class="apg-card hover:border-apg-primary transition-colors">
    <div class="flex items-start gap-4 mb-3">
      <div class="w-12 h-12 rounded-xl flex items-center justify-center text-white text-xl font-bold flex-shrink-0"
           style="background: var(--apg-primary, #1E5B5A)">
        {{ (conn.title or conn.name or '?')[:1] | upper }}
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h2 class="text-sm font-bold text-gray-900">{{ conn.title or conn.name }}</h2>
          <span class="apg-badge">{{ conn.category }}</span>
        </div>
        <p class="text-xs text-gray-500 mt-1">{{ conn.description }}</p>
      </div>
    </div>
    <dl class="grid grid-cols-2 gap-3 mb-4">
      <div class="border border-gray-100 rounded-lg p-3">
        <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Operations</dt>
        <dd class="text-lg font-bold text-gray-900">{{ conn.operation_count }}</dd>
      </div>
      <div class="border border-gray-100 rounded-lg p-3">
        <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">Status</dt>
        <dd class="text-sm font-semibold text-gray-900">{{ conn.status }}</dd>
      </div>
    </dl>
    {% if conn.operations %}
    <div class="flex items-center gap-2 flex-wrap mb-4">
      {% for operation in conn.operations[:3] %}
      <span class="text-xs text-gray-500 bg-gray-50 border border-gray-100 rounded-lg px-2 py-1">{{ operation }}</span>
      {% endfor %}
    </div>
    {% endif %}
    <div class="flex items-center gap-2">
      <span class="flex-1 text-xs text-gray-400 font-mono truncate">{{ conn.file or conn.name }}</span>
      <a href="{{ conn.href }}" class="apg-btn apg-btn-secondary">Open</a>
    </div>
  </article>
  {% endfor %}
</div>
{% else %}
<div class="apg-card text-center py-12">
  <div class="text-5xl mb-4 opacity-20">Plug</div>
  <h2 class="text-base font-semibold text-gray-900 mb-2">No connectors match these filters</h2>
  <p class="text-sm text-gray-500 mb-4">Clear the search or category filter to return to generated integration blueprints.</p>
  <a href="/ui/marketplace" class="apg-btn">Clear filters</a>
</div>
{% endif %}
