{# entity_list.html.j2 — APG entity list + create form
   Variables: entity_name, entity_type, safe_entity, fields, records,
              total, count, records_table, create_inputs, notice, query,
              has_kanban (bool), q (search term) #}

{# Breadcrumb + view toggle #}
<nav class="flex items-center gap-2 text-sm mb-5 text-gray-500 flex-wrap">
  <a href="/ui" class="hover:text-apg-primary transition-colors">Application</a>
  <span>/</span>
  <span class="font-semibold text-gray-900">{{ entity_name }}</span>
  <div class="ml-auto flex items-center gap-1">
    {% if has_kanban %}
    <span class="px-3 py-1 text-xs bg-apg-primary text-white rounded-lg font-medium">≡ List</span>
    <a href="/ui/entities/{{ safe_entity }}?view=kanban"
       class="px-3 py-1 text-xs border border-gray-200 rounded-lg text-gray-600 hover:border-apg-primary hover:text-apg-primary transition-colors">
      ⊞ Kanban
    </a>
    {% endif %}
    <a href="/entities/{{ safe_entity }}/records"
       class="px-3 py-1 text-xs border border-gray-200 rounded-lg text-gray-500 hover:border-gray-300 transition-colors">
      API JSON ↗
    </a>
  </div>
</nav>

{% if notice %}
<div role="alert"
     class="mb-4 px-4 py-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-800">
  ⚠ {{ notice }}
</div>
{% endif %}

{# Search bar #}
<form method="get" action="/ui/entities/{{ safe_entity }}" class="mb-5">
  <div class="relative max-w-sm">
    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none">🔍</span>
    <input type="text" name="q" value="{{ q or '' }}"
           placeholder="Search {{ entity_name }} records…"
           class="w-full pl-8 pr-8 py-1.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-apg-primary focus:border-transparent bg-white">
    {% if q %}
    <a href="/ui/entities/{{ safe_entity }}"
       class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 text-xs leading-none">✕</a>
    {% endif %}
  </div>
</form>

<div class="flex items-start gap-5 flex-col lg:flex-row">

  {# ── Create form ─────────────────────────────────────────────── #}
  <aside class="w-full lg:w-72 shrink-0">
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden sticky top-4">
      <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-gray-900">New {{ entity_name }}</h2>
        <span class="text-xs font-medium uppercase tracking-wide text-gray-400 bg-gray-100 px-2 py-0.5 rounded">{{ entity_type }}</span>
      </div>
      <form method="post" action="/ui/entities/{{ safe_entity }}/records" novalidate>
        <div class="overflow-y-auto max-h-[55vh] px-4 pt-4 space-y-3">
          {{ create_inputs | safe }}
        </div>
        <div class="px-4 pb-4 pt-3 border-t border-gray-100">
          <button type="submit"
                  class="w-full px-3 py-2 bg-apg-primary text-white text-sm font-medium rounded-lg hover:opacity-90 active:opacity-80 transition-opacity focus:outline-none focus:ring-2 focus:ring-apg-primary focus:ring-offset-2">
            Create {{ entity_name }}
          </button>
        </div>
      </form>
    </div>
  </aside>

  {# ── Records section ─────────────────────────────────────────── #}
  <section class="flex-1 min-w-0">
    <div class="flex items-center gap-3 mb-3 flex-wrap">
      <h1 class="text-lg font-semibold text-gray-900">{{ entity_name }}</h1>
      <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full font-medium">
        {{ total }} record{{ 's' if total != 1 else '' }}
      </span>
      {% if count != total %}
      <span class="text-xs text-apg-primary bg-blue-50 px-2 py-0.5 rounded-full">
        {{ count }} match{% if q %} for "{{ q }}"{% endif %}
      </span>
      {% endif %}
    </div>

    <p class="text-xs text-gray-500 mb-2">Showing {{ count }} of {{ total }} matching records.</p>

    {% if records %}
      {{ records_table | safe }}
    {% else %}
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-12 text-center">
        <div class="text-3xl mb-3 opacity-30">📋</div>
        {% if q %}
        <p class="text-sm font-medium text-gray-500">No {{ entity_name }} records match "{{ q }}".</p>
        <p class="text-xs text-gray-400 mt-1">
          <a href="/ui/entities/{{ safe_entity }}" class="text-apg-primary hover:underline">Clear search</a>
        </p>
        {% else %}
        <p class="text-sm font-medium text-gray-500">No {{ entity_name }} records yet.</p>
        <p class="text-xs text-gray-400 mt-1">Use the form on the left to create the first one.</p>
        {% endif %}
      </div>
    {% endif %}
  </section>

</div>

<details class="mt-4">
  <summary class="text-xs text-gray-400 cursor-pointer hover:text-gray-600 select-none">Advanced filter</summary>
  <div class="mt-2">{{ query_form | safe }}</div>
</details>

<details class="mt-2">
  <summary class="text-xs text-gray-400 cursor-pointer hover:text-gray-600 select-none">Record JSON</summary>
  <pre class="mt-2 text-xs bg-gray-50 border border-gray-200 rounded-lg p-3 overflow-auto max-h-64 font-mono">{{ records_json }}</pre>
</details>
