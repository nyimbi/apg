<!--- entity_list.html.j2 — APG entity list page template --->
{# Variables: entity_name, entity_type, fields, records, total, count, notice,
              safe_entity, query, records_json #}
<nav class="flex items-center gap-2 text-sm mb-6 pb-3 border-b border-gray-200 dark:border-gray-700">
  <a href="/ui" class="text-apg-primary hover:underline">Application</a>
  <span class="text-gray-400">/</span>
  <span class="font-medium text-gray-900 dark:text-gray-100">{{ entity_name }}</span>
  <span class="ml-auto">
    <a href="/entities/{{ safe_entity }}/records"
       class="text-xs text-gray-400 hover:text-apg-primary">JSON ↗</a>
  </span>
</nav>

{% if notice %}
<div role="alert"
     class="mb-4 px-4 py-3 bg-yellow-50 border border-yellow-200 rounded text-sm text-yellow-800 dark:bg-yellow-900/20 dark:border-yellow-700 dark:text-yellow-300">
  {{ notice }}
</div>
{% endif %}

<div class="flex items-start gap-6 flex-col xl:flex-row">
  {# Create record form #}
  <div class="w-full xl:w-80 shrink-0">
    <div class="apg-card">
      <div class="apg-card-header">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">New {{ entity_name }}</h2>
        <span class="apg-badge apg-badge-neutral">{{ entity_type }}</span>
      </div>
      <form method="post" action="/ui/entities/{{ safe_entity }}/records" class="space-y-3" novalidate>
        {% for field in fields %}
        <div class="apg-field">
          <label for="field-{{ field.name }}"
                 class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">
            {{ field.name }}
            {% if field.required %}<span class="text-red-500 ml-0.5" aria-hidden="true">*</span>{% endif %}
          </label>
          {% if field.type in ('text', 'string', 'varchar') %}
          <textarea id="field-{{ field.name }}" name="{{ field.name }}" rows="2"
                    class="block w-full px-2.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-apg-primary resize-none"
                    {% if field.required %}required{% endif %}></textarea>
          {% elif field.type in ('int', 'integer', 'float', 'number', 'decimal', 'money') %}
          <input type="number" id="field-{{ field.name }}" name="{{ field.name }}"
                 class="block w-full px-2.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-apg-primary"
                 {% if field.required %}required{% endif %}>
          {% elif field.type in ('bool', 'boolean') %}
          <select id="field-{{ field.name }}" name="{{ field.name }}"
                  class="block w-full px-2.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-apg-primary">
            <option value="">—</option>
            <option value="true">True</option>
            <option value="false">False</option>
          </select>
          {% else %}
          <input type="text" id="field-{{ field.name }}" name="{{ field.name }}"
                 class="block w-full px-2.5 py-1.5 text-sm border border-gray-300 dark:border-gray-600 rounded bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-apg-primary"
                 {% if field.required %}required{% endif %}>
          {% endif %}
        </div>
        {% endfor %}
        <button type="submit"
                class="w-full px-3 py-2 bg-apg-primary text-white text-sm font-medium rounded hover:opacity-90 transition-opacity focus:outline-none focus:ring-2 focus:ring-apg-primary focus:ring-offset-2">
          Create {{ entity_name }}
        </button>
      </form>
    </div>
  </div>

  {# Records list #}
  <div class="flex-1 min-w-0">
    <div class="flex items-center justify-between mb-3">
      <h1 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
        {{ entity_name }}
        <span class="ml-2 text-xs font-normal text-gray-400">({{ total }} total)</span>
      </h1>
      <p class="text-xs text-gray-500">Showing {{ count }} of {{ total }}</p>
    </div>

    {{ records_table | safe }}

    <details class="mt-4">
      <summary class="text-xs text-gray-400 cursor-pointer hover:text-gray-600 dark:hover:text-gray-300 select-none py-1">
        Raw JSON
      </summary>
      <pre class="mt-2 text-xs">{{ records_json }}</pre>
    </details>
  </div>
</div>
