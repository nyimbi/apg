{# entity_list.html.j2 — APG entity list + create form
   Variables: entity_name, entity_type, safe_entity, fields, records,
              total, count, records_table, create_inputs, notice, query,
              saved_views, active_filters, has_kanban (bool), q (search term) #}

{# Breadcrumb + view toggle #}
<nav class="flex items-center gap-2 text-sm mb-5 text-gray-500 flex-wrap">
  <a href="/ui" class="hover:text-apg-primary transition-colors">Application</a>
  <span>/</span>
  <span class="font-semibold text-gray-900">{{ entity_name }}</span>
  <div class="ml-auto flex items-center gap-1">
    {% if has_kanban %}
    <span class="px-3 py-1 text-xs bg-apg-primary text-white rounded-lg font-medium">≡ List</span>
    <a href="/ui/entities/{{ safe_entity }}?view=kanban"
       class="px-3 py-1 text-xs border border-gray-200 rounded-lg text-gray-600 hover:border-apg-primary hover:text-apg-primary transition-colors">
      ⊞ Kanban
    </a>
    {% endif %}
    <a href="/ui/entities/{{ safe_entity }}?view=analytics"
       class="px-3 py-1 text-xs border border-gray-200 rounded-lg text-gray-600 hover:border-apg-primary hover:text-apg-primary transition-colors">
      Analytics
    </a>
    <button type="button" class="apg-btn" onclick="document.getElementById('apg-create-drawer').showModal();">
      New {{ entity_name }}
    </button>
  </div>
</nav>

{% if notice %}
<div role="alert"
     class="mb-4 px-4 py-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-800">
  ⚠ {{ notice }}
</div>
{% endif %}

<section class="apg-card apg-list-toolbar" aria-label="{{ entity_name }} table controls">
  <div class="apg-view-strip" aria-label="Saved views">
    {% for view in saved_views %}
    <a href="{{ view.url }}"
       class="apg-view-tab{% if view.active %} active{% endif %}"
       {% if view.active %}aria-current="page"{% endif %}>
      <span>{{ view.name }}</span>
      <small>{{ view.description }}</small>
    </a>
    {% endfor %}
  </div>

  <form method="get" action="/ui/entities/{{ safe_entity }}" class="apg-search-form">
    <label class="sr-only" for="apg-entity-search">Search {{ entity_name }} records</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none">Search</span>
      <input id="apg-entity-search" type="text" name="q" value="{{ q or '' }}"
             placeholder="Search {{ entity_name }} records..."
             class="w-full pl-14 pr-8 py-1.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-apg-primary focus:border-transparent bg-white">
      {% if q %}
      <a href="{{ clear_filters_url }}"
         aria-label="Clear search"
         class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700 text-xs leading-none">x</a>
      {% endif %}
    </div>
  </form>

  {% if active_filters %}
  <div class="apg-filter-chip-row" aria-label="Active filters">
    {% for chip in active_filters %}
    <span class="apg-filter-chip">
      <span>{{ chip.label }}: {{ chip.value }}</span>
      <a href="{{ chip.clear_url }}" aria-label="Clear {{ chip.label }}">x</a>
    </span>
    {% endfor %}
    <a href="{{ clear_filters_url }}" class="apg-filter-clear">Clear all</a>
  </div>
  {% endif %}

  <details class="apg-filter-panel"{% if active_filters %} open{% endif %}>
    <summary>Advanced filter</summary>
    <div class="mt-2">{{ query_form | safe }}</div>
  </details>
</section>

<section class="apg-list-intelligence" aria-label="{{ entity_name }} list intelligence">
  <article>
    <span>Shareable State</span>
    <strong>{{ list_intelligence.share_url }}</strong>
    <button type="button" class="apg-mini-btn" data-apg-copy-url="{{ list_intelligence.share_url }}">Copy</button>
  </article>
  <article>
    <span>Column Memory</span>
    <strong>{{ list_intelligence.column_controls | length }} fields</strong>
    <div class="apg-column-chip-row">
      {% for col in list_intelligence.column_controls %}
      <a href="{{ col.sort_url }}" class="apg-column-chip{% if col.active %} active{% endif %}">{{ col.label }}</a>
      {% endfor %}
    </div>
  </article>
  <article>
    <span>Virtual Window</span>
    <strong>{{ list_intelligence.visible_window }} of {{ list_intelligence.total }}</strong>
    <small>{{ list_intelligence.page_size }} rows per page{% if list_intelligence.filtered %} after filters{% endif %}</small>
  </article>
  <article>
    <span>Keyboard Fuzzy Filter</span>
    <strong>/ focuses search</strong>
    <small>Bulk bar and CSV export stay offline</small>
  </article>
</section>

<script>
(function() {
  var densityKey = {{ list_intelligence.density_key | tojson }};
  var root = document.documentElement;
  var savedDensity = localStorage.getItem(densityKey);
  if (savedDensity === 'compact') root.classList.add('apg-density-compact');
  document.addEventListener('click', function(event) {
    var copy = event.target.closest('[data-apg-copy-url]');
    if (copy && navigator.clipboard) {
      navigator.clipboard.writeText(location.origin + copy.dataset.apgCopyUrl);
      APGToast('List URL copied', 'success');
    }
  });
  document.addEventListener('keydown', function(event) {
    if (event.key === '/' && !/input|textarea|select/i.test(event.target.tagName || '')) {
      var search = document.getElementById('apg-entity-search');
      if (search) {
        event.preventDefault();
        search.focus();
      }
    }
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'd') {
      event.preventDefault();
      var compact = !root.classList.contains('apg-density-compact');
      root.classList.toggle('apg-density-compact', compact);
      localStorage.setItem(densityKey, compact ? 'compact' : 'comfortable');
      APGToast(compact ? 'Compact rows enabled' : 'Comfortable rows enabled', 'info');
    }
  });
})();
</script>

<dialog id="apg-create-drawer" class="apg-drawer" aria-labelledby="apg-create-title">
  <form id="apg-create-form" method="post" action="/ui/entities/{{ safe_entity }}/records" class="apg-drawer-panel"
        data-apg-draft-key="{{ form_intelligence.draft_key }}"
        data-apg-undo-seconds="{{ form_intelligence.undo_seconds }}">
    <header class="apg-card-header">
      <div>
        <h2 id="apg-create-title" class="text-base font-semibold text-gray-900">New {{ entity_name }}</h2>
        <p class="text-xs text-gray-400 mt-1">{{ entity_type }}</p>
      </div>
      <button type="button" class="apg-btn apg-btn-secondary" onclick="document.getElementById('apg-create-drawer').close();">Close</button>
    </header>
    <section class="apg-form-intelligence" aria-label="{{ entity_name }} form intelligence">
      <article>
        <span>Autosave Draft</span>
        <strong id="apg-draft-state">Ready</strong>
        <small>Restores locally before submit</small>
      </article>
      <article>
        <span>Async Field Validation</span>
        <strong id="apg-validation-state">{{ form_intelligence.validation_fields | length }} fields watched</strong>
        <small>{{ form_intelligence.required_fields | length }} required</small>
      </article>
      <article>
        <span>Smart Defaults</span>
        {% if form_intelligence.smart_defaults %}
        <div class="apg-default-chip-row">
          {% for item in form_intelligence.smart_defaults %}
          <button type="button" class="apg-default-chip" data-apg-default-field="{{ item.field }}" data-apg-default-value="{{ item.value }}">{{ item.label }}</button>
          {% endfor %}
        </div>
        {% else %}
        <strong>No sibling defaults</strong>
        {% endif %}
      </article>
      <article>
        <span>Dependency Tree</span>
        {% if form_intelligence.dependency_edges %}
        <ul class="apg-dependency-tree">
          {% for edge in form_intelligence.dependency_edges %}
          <li>{{ edge.from }} -> {{ edge.to }}</li>
          {% endfor %}
        </ul>
        {% else %}
        <small>No conditional edges detected</small>
        {% endif %}
      </article>
    </section>
    <div class="overflow-y-auto max-h-[70vh] space-y-3">
      {{ create_inputs | safe }}
    </div>
    <footer class="flex items-center justify-end gap-2 pt-4 border-t border-gray-100 mt-4">
      <button type="button" class="apg-btn apg-btn-secondary" onclick="document.getElementById('apg-create-drawer').close();">Cancel</button>
      <button type="submit" class="apg-btn">Create {{ entity_name }}</button>
    </footer>
  </form>
</dialog>

<script>
(function() {
  var drawer = document.getElementById('apg-create-drawer');
  var form = document.getElementById('apg-create-form');
  if (!drawer || !form) return;
  var draftKey = form.dataset.apgDraftKey;
  var undoSeconds = parseInt(form.dataset.apgUndoSeconds || '5', 10);
  var draftState = document.getElementById('apg-draft-state');
  var validationState = document.getElementById('apg-validation-state');
  var pendingSubmit = null;
  var dirty = false;
  function serializeForm() {
    var data = {};
    Array.prototype.forEach.call(form.elements, function(field) {
      if (!field.name || field.type === 'hidden' || field.type === 'submit' || field.type === 'button') return;
      data[field.name] = field.type === 'checkbox' ? field.checked : field.value;
    });
    return data;
  }
  function restoreDraft() {
    if (!draftKey || !localStorage.getItem(draftKey)) return;
    var data = {};
    try { data = JSON.parse(localStorage.getItem(draftKey) || '{}'); } catch (error) { data = {}; }
    Object.keys(data).forEach(function(name) {
      var field = form.elements[name];
      if (!field) return;
      if (field.type === 'checkbox') field.checked = !!data[name];
      else field.value = data[name];
    });
    dirty = true;
    if (draftState) draftState.textContent = 'Draft restored';
    APGToast('Draft restored locally', 'info');
  }
  function saveDraft() {
    if (!draftKey) return;
    localStorage.setItem(draftKey, JSON.stringify(serializeForm()));
    if (draftState) draftState.textContent = 'Saved locally';
  }
  function validateLater() {
    if (validationState) validationState.textContent = 'Checking...';
    window.setTimeout(function() {
      var invalid = form.querySelectorAll(':invalid').length;
      if (validationState) validationState.textContent = invalid ? invalid + ' field warnings' : 'Ready to submit';
    }, 180);
  }
  restoreDraft();
  form.addEventListener('input', function() {
    dirty = true;
    saveDraft();
    validateLater();
  });
  form.addEventListener('click', function(event) {
    var chip = event.target.closest('[data-apg-default-field]');
    if (!chip) return;
    var field = form.elements[chip.dataset.apgDefaultField];
    if (!field) return;
    field.value = chip.dataset.apgDefaultValue || '';
    dirty = true;
    saveDraft();
    validateLater();
    APGToast('Smart default applied', 'success');
  });
  form.addEventListener('submit', function(event) {
    if (form.dataset.apgSubmitArmed === '1') {
      localStorage.removeItem(draftKey);
      dirty = false;
      return;
    }
    event.preventDefault();
    if (pendingSubmit) window.clearTimeout(pendingSubmit);
    APGToast('Submitting in ' + undoSeconds + 's. Press Escape to undo.', 'info');
    pendingSubmit = window.setTimeout(function() {
      form.dataset.apgSubmitArmed = '1';
      form.requestSubmit();
    }, undoSeconds * 1000);
  });
  drawer.addEventListener('cancel', function(event) {
    if (pendingSubmit) {
      window.clearTimeout(pendingSubmit);
      pendingSubmit = null;
      APGToast('Submit undone', 'success');
      event.preventDefault();
      return;
    }
    if (!dirty) return;
    event.preventDefault();
    apgConfirm('Discard this draft?', function() {
      dirty = false;
      if (draftKey) localStorage.removeItem(draftKey);
      drawer.close();
    });
  });
  document.addEventListener('keydown', function(event) {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's' && drawer.open) {
      event.preventDefault();
      form.requestSubmit();
    }
  });
})();
</script>

<div class="flex items-start gap-5 flex-col lg:flex-row">

  {# ── Records section ─────────────────────────────────────────── #}
  <section class="flex-1 min-w-0" data-apg-live="entity:{{ entity_name }}">
    <div class="flex items-center gap-3 mb-3 flex-wrap">
      <h1 class="text-lg font-semibold text-gray-900">{{ entity_name }}</h1>
      <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full font-medium">
        {{ total }} record{{ 's' if total != 1 else '' }}
      </span>
      {% if count != total %}
      <span class="text-xs text-apg-primary bg-blue-50 px-2 py-0.5 rounded-full">
        {{ count }} match{% if q %} for "{{ q }}"{% endif %}
      </span>
      {% endif %}
    </div>

    <p class="text-xs text-gray-500 mb-2">Showing {{ count }} of {{ total }} matching records.</p>

    {% if records %}
      {{ records_table | safe }}
    {% else %}
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-12 text-center">
        <div class="text-3xl mb-3 opacity-30">📋</div>
        {% if q %}
        <p class="text-sm font-medium text-gray-500">No {{ entity_name }} records match "{{ q }}".</p>
        <p class="text-xs text-gray-400 mt-1">
          <a href="/ui/entities/{{ safe_entity }}" class="text-apg-primary hover:underline">Clear search</a>
        </p>
        {% else %}
        <p class="text-sm font-medium text-gray-500">No {{ entity_name }} records yet.</p>
        <p class="text-xs text-gray-400 mt-1">Create the first record to get started.</p>
        <button type="button" class="apg-btn mt-4" onclick="document.getElementById('apg-create-drawer').showModal();">New {{ entity_name }}</button>
        {% endif %}
      </div>
    {% endif %}

    {# Pagination controls #}
    {% if total_pages > 1 %}
    <nav class="mt-4 flex items-center justify-between flex-wrap gap-3" aria-label="Pagination">
      <div class="flex items-center gap-1 flex-wrap">
        {% if page > 1 %}
        <a href="{{ prev_page_url }}"
           class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg text-gray-600 hover:border-apg-primary hover:text-apg-primary transition-colors">← Prev</a>
        {% else %}
        <span class="px-3 py-1.5 text-sm border border-gray-100 rounded-lg text-gray-300 select-none">← Prev</span>
        {% endif %}

        {% if page > 3 %}
        <a href="{{ first_page_url }}"
           class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg text-gray-600 hover:border-apg-primary hover:text-apg-primary transition-colors">1</a>
        {% if page > 4 %}<span class="px-1 text-xs text-gray-400">…</span>{% endif %}
        {% endif %}

        {% for page_link in pagination_pages %}
        <a href="{{ page_link.url }}"
           class="px-3 py-1.5 text-sm rounded-lg {% if page_link.number == page %}bg-apg-primary text-white font-semibold{% else %}border border-gray-200 text-gray-600 hover:border-apg-primary hover:text-apg-primary{% endif %} transition-colors">{{ page_link.number }}</a>
        {% endfor %}

        {% if page < total_pages - 2 %}
        {% if page < total_pages - 3 %}<span class="px-1 text-xs text-gray-400">…</span>{% endif %}
        <a href="{{ last_page_url }}"
           class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg text-gray-600 hover:border-apg-primary hover:text-apg-primary transition-colors">{{ total_pages }}</a>
        {% endif %}

        {% if page < total_pages %}
        <a href="{{ next_page_url }}"
           class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg text-gray-600 hover:border-apg-primary hover:text-apg-primary transition-colors">Next →</a>
        {% else %}
        <span class="px-3 py-1.5 text-sm border border-gray-100 rounded-lg text-gray-300 select-none">Next →</span>
        {% endif %}
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-400">
        <span>Page {{ page }} of {{ total_pages }}</span>
        <select onchange="location.href=this.options[this.selectedIndex].dataset.url"
                class="px-2 py-1 border border-gray-200 rounded text-xs text-gray-500 bg-white cursor-pointer focus:outline-none focus:ring-1 focus:ring-apg-primary">
          {% for option in per_page_options %}
          <option value="{{ option.value }}" data-url="{{ option.url }}"{% if option.value == per %} selected{% endif %}>{{ option.value }} / page</option>
          {% endfor %}
        </select>
      </div>
    </nav>
    {% endif %}
  </section>

</div>

<details class="mt-4 apg-developer-panel">
  <summary class="text-xs text-gray-400 cursor-pointer hover:text-gray-600 select-none">Developer exports</summary>
  <div class="mt-2 flex items-center gap-2 flex-wrap">
    <a href="{{ csv_url }}" class="apg-btn apg-btn-secondary">Export CSV</a>
    <a href="{{ developer_api_url }}" class="apg-btn apg-btn-secondary">API JSON</a>
  </div>
  <p class="text-xs text-gray-400 mt-3">Rendered page records</p>
  <pre class="mt-2 text-xs bg-gray-50 border border-gray-200 rounded-lg p-3 overflow-auto max-h-64 font-mono">{{ records_json }}</pre>
</details>
