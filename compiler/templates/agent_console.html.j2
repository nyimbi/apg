{% set description = description | default({}) %}
{% set user_message = user_message | default('') %}
{% set payload_json = payload_json | default('{}') %}
{% set result_status = result_status | default('') %}
{% set team_members = team_members | default([]) %}
{% set team_flow = team_flow | default([]) %}
<section class="mb-6">
  <p class="text-sm text-gray-500 mb-2"><a href="/ui" class="hover:text-blue-600">Application</a> / <a href="/agents" class="hover:text-blue-600">Agent catalog</a> / <span class="font-semibold text-gray-900">{{ name }}</span></p>
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-xl font-bold text-gray-900">{{ name }}</h1>
      <p class="text-sm text-gray-500 mt-1">{{ 'Team console' if team else 'Agent console' }}</p>
    </div>
    {% if result_status %}
    <span class="apg-badge apg-badge-neutral">{{ result_status }}</span>
    {% endif %}
  </div>
</section>

<section class="grid grid-cols-1 lg:grid-cols-3 gap-4">
  <article class="apg-card lg:col-span-2 flex flex-col min-h-16" data-apg-live="{{ live_topic }}">
    <header class="apg-card-header">
      <div>
        <h2 class="text-base font-semibold text-gray-900">Conversation</h2>
        <p class="text-xs text-gray-500">Prompt, stream, inspect, and retry from one place.</p>
      </div>
      <span class="text-xs text-gray-400">{{ live_topic }}</span>
    </header>

    <div id="apg-agent-stream" class="flex-1 space-y-3 mb-4" aria-live="polite" aria-busy="false">
      {% if not user_message and not result and not error %}
      <div class="rounded-lg bg-gray-50 border border-gray-200 p-4">
        <p class="text-sm text-gray-600">Ask {{ name }} to work on a concrete task. Add JSON only when the agent needs structured context.</p>
      </div>
      {% endif %}
      {% if error %}
      <div role="alert" class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700 text-sm">{{ error }}</div>
      {% endif %}
      {% if user_message %}
      <div class="rounded-lg border border-gray-200 p-4 bg-gray-50">
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">You</p>
        <p class="text-sm text-gray-700">{{ user_message }}</p>
      </div>
      {% endif %}
      {% if result %}
      <div class="rounded-lg border border-gray-200 p-4 bg-white">
        <div class="flex items-center justify-between gap-3 mb-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'Team response' if team else 'Agent response' }}</p>
          {% if result_status %}<span class="apg-badge apg-badge-neutral">{{ result_status }}</span>{% endif %}
        </div>
        <div class="apg-agent-output text-sm text-gray-700">{{ result_html|safe }}</div>
      </div>
      {% endif %}
    </div>

    <form method="post" action="{{ action }}" class="space-y-4" data-apg-stream-target="#apg-agent-stream">
      <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide">Message
        <textarea name="message" rows="3" autocomplete="off" class="mt-1 w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-apg-primary focus:border-transparent bg-white">{{ user_message }}</textarea>
      </label>
      <details>
        <summary class="cursor-pointer text-sm font-medium text-gray-700">Structured payload</summary>
        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mt-3">Payload JSON
          <textarea name="payload_json" rows="6" class="mt-1 w-full px-3 py-2 border border-gray-200 rounded-lg text-sm font-mono focus:outline-none focus:ring-2 focus:ring-apg-primary focus:border-transparent bg-white">{{ payload_json }}</textarea>
        </label>
      </details>
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <label class="flex items-center gap-2 text-sm text-gray-600"><input name="stream" type="checkbox" value="true"> Stream when supported</label>
        <div class="flex items-center gap-2">
          <button type="submit" class="apg-btn">Send</button>
          <button type="button" class="apg-btn apg-btn-secondary" onclick="document.getElementById('apg-agent-stream').setAttribute('aria-busy','false')">Stop</button>
        </div>
      </div>
    </form>
  </article>

  <aside class="space-y-4">
    {% if team %}
    <section class="apg-card">
      <h2 class="text-base font-semibold text-gray-900 mb-3">Team lanes</h2>
      {% if team_members %}
      <ol class="space-y-2">
        {% for member in team_members %}
        <li class="flex items-center justify-between gap-3 border border-gray-100 rounded-lg p-3">
          <a href="/ui/agents/{{ member }}" class="text-sm font-medium text-apg-primary hover:underline">{{ member }}</a>
          <span class="apg-badge apg-badge-neutral">member</span>
        </li>
        {% endfor %}
      </ol>
      {% else %}
      <p class="text-sm text-gray-500">No member agents declared for this team.</p>
      {% endif %}
    </section>

    <section class="apg-card">
      <h2 class="text-base font-semibold text-gray-900 mb-3">Handoff flow</h2>
      {% if team_flow %}
      <ol class="space-y-2">
        {% for edge in team_flow %}
        <li class="text-sm text-gray-600"><span class="font-medium text-gray-900">{{ edge.source }}</span> -> <span class="font-medium text-gray-900">{{ edge.target }}</span></li>
        {% endfor %}
      </ol>
      {% else %}
      <p class="text-sm text-gray-500">No explicit handoff flow declared.</p>
      {% endif %}
    </section>
    {% endif %}

    <section class="apg-card">
      <h2 class="text-base font-semibold text-gray-900 mb-3">Configuration</h2>
      {% if description.role %}<p class="text-sm text-gray-600"><span class="font-medium text-gray-900">Role:</span> {{ description.role }}</p>{% endif %}
      {% if description.model %}<p class="text-sm text-gray-600 mt-1"><span class="font-medium text-gray-900">Model:</span> {{ description.model }}</p>{% endif %}
      {% if description.runtime %}<p class="text-sm text-gray-600 mt-1"><span class="font-medium text-gray-900">Runtime:</span> {{ description.runtime }}</p>{% endif %}
      {% if description.tools %}
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mt-4 mb-2">Tools</p>
      <div class="flex items-center gap-2 flex-wrap">
        {% for tool in description.tools %}
        <span class="apg-badge apg-badge-neutral">{{ tool }}</span>
        {% endfor %}
      </div>
      {% endif %}
      {% if description.capabilities %}
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mt-4 mb-2">Capabilities</p>
      <div class="flex items-center gap-2 flex-wrap">
        {% for capability in description.capabilities %}
        <span class="apg-badge apg-badge-neutral">{{ capability }}</span>
        {% endfor %}
      </div>
      {% endif %}
      <details class="mt-4">
        <summary class="cursor-pointer text-sm font-medium text-gray-700">Raw description JSON</summary>
        <pre>{{ description_json }}</pre>
      </details>
      {% if result %}
      <details class="mt-4">
        <summary class="cursor-pointer text-sm font-medium text-gray-700">Raw response JSON</summary>
        <pre>{{ result_json }}</pre>
      </details>
      {% endif %}
    </section>
  </aside>
</section>
