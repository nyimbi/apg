{# field_display.html.j2 — semantic field rendering for record detail
   Included by record_detail.html.j2 for individual field value rendering.
   Variables: field (dict), field_val (any), semantic (str)
#}
{% if semantic == 'email' and field_val %}
  <a href="mailto:{{ field_val }}" class="text-apg-primary hover:underline text-sm">{{ field_val }}</a>
{% elif semantic == 'phone' and field_val %}
  <a href="tel:{{ field_val }}" class="text-apg-primary hover:underline text-sm inline-flex items-center gap-1">
    <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
    {{ field_val }}
  </a>
{% elif semantic == 'url' and field_val %}
  <a href="{{ field_val }}" target="_blank" rel="noopener" class="text-apg-primary hover:underline text-sm inline-flex items-center gap-1 truncate max-w-xs">
    <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor"><path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/><path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/></svg>
    {{ field_val | string | truncate(40) }}
  </a>
{% elif semantic == 'image_url' and field_val %}
  <img src="{{ field_val }}" alt="{{ field.name }}" class="w-12 h-12 rounded-lg object-cover border border-gray-100">
{% elif semantic == 'currency' and field_val %}
  <span class="text-sm font-semibold text-gray-900 tabular-nums">{{ field_val | string | float | round(2) }}</span>
{% elif semantic == 'percent' and field_val %}
  <div class="flex items-center gap-2">
    <div class="flex-1 bg-gray-100 rounded-full h-1.5 max-w-24">
      <div class="bg-apg-primary h-1.5 rounded-full" style="width: {{ [field_val | float, 100] | min }}%"></div>
    </div>
    <span class="text-sm text-gray-700 tabular-nums">{{ field_val }}%</span>
  </div>
{% elif semantic == 'rating' and field_val %}
  <div class="flex items-center gap-0.5">
    {% set stars = field_val | float | round | int %}
    {% for i in range(5) %}
    <svg class="w-4 h-4 {{ 'text-amber-400' if i < stars else 'text-gray-200' }}" viewBox="0 0 20 20" fill="currentColor">
      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
    </svg>
    {% endfor %}
    <span class="text-xs text-gray-400 ml-1">{{ field_val }}/5</span>
  </div>
{% elif semantic == 'color' and field_val %}
  <div class="flex items-center gap-2">
    <div class="w-5 h-5 rounded-full border border-gray-200 flex-shrink-0" style="background-color: {{ field_val }}"></div>
    <span class="text-sm text-gray-700 font-mono">{{ field_val }}</span>
  </div>
{% elif semantic == 'json' and field_val %}
  <details class="max-w-xs">
    <summary class="text-xs text-apg-primary cursor-pointer hover:underline">View JSON</summary>
    <pre class="mt-1 text-xs bg-gray-50 rounded-lg p-2 overflow-auto max-h-40 border border-gray-100">{{ field_val | string }}</pre>
  </details>
{% elif semantic == 'status' and field_val %}
  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold
    {% if field_val | lower in ['active', 'approved', 'paid', 'open', 'enabled', 'complete', 'completed', 'success', 'done'] %}bg-green-100 text-green-800
    {% elif field_val | lower in ['inactive', 'rejected', 'closed', 'disabled', 'cancelled', 'canceled', 'failed', 'expired'] %}bg-red-100 text-red-800
    {% elif field_val | lower in ['pending', 'draft', 'processing', 'review', 'in_progress', 'waiting'] %}bg-yellow-100 text-yellow-800
    {% else %}bg-gray-100 text-gray-600{% endif %}">
    {{ field_val }}
  </span>
{% elif semantic == 'boolean' %}
  {% if field_val | string | lower in ['true', '1', 'yes'] %}
  <span class="inline-flex items-center gap-1 text-green-600 text-sm"><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Yes</span>
  {% else %}
  <span class="inline-flex items-center gap-1 text-gray-400 text-sm"><svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>No</span>
  {% endif %}
{% else %}
  {% if field_val is none or field_val == '' or field_val | string == 'None' %}
  <span class="text-gray-300 italic text-xs">—</span>
  {% else %}
  {{ field_val | string | truncate(200) }}
  {% endif %}
{% endif %}
