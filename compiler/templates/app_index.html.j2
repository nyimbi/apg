<!--- app_index.html.j2 - APG application home page --->
{# Variables: module_name, module_description, entities, capabilities, databases,
              application_routes, ui_routes, agents, agent_teams #}
<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{{ module_name }}</h1>
  <p class="text-gray-500 mt-1">{{ module_description or 'Generated APG application' }}</p>
</div>

{# Quick nav #}
<nav class="flex flex-wrap gap-2 mb-8 text-sm" aria-label="Workspace shortcuts">
  {% if entities %}
  <a href="/ui/entities/{{ entities[0].name | urlencode }}"
     class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-apg-primary text-white hover:opacity-90 transition-opacity font-medium">
    Start with {{ entities[0].name }}
  </a>
  {% endif %}
  {% for link in api_links %}
  <a href="{{ link.url }}"
     class="inline-flex items-center px-3 py-1.5 rounded border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-apg-primary transition-colors">
    {{ link.label }}
  </a>
  {% endfor %}
</nav>

<section class="apg-dashboard-command-center mb-8" aria-label="Dashboard command center">
  <article class="apg-card apg-dashboard-panel">
    <div class="apg-card-header">
      <div>
        <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Composable Tiles</h2>
        <p class="text-xs text-gray-400 mt-1">Persisted workspace order and visibility</p>
      </div>
      <button type="button" class="apg-btn apg-btn-secondary" data-apg-tour="dashboard-tiles">Save view</button>
    </div>
    <ol class="apg-dashboard-sort-list">
      {% for tile in tile_controls %}
      <li>
        <span class="apg-drag-handle" aria-hidden="true">::</span>
        <a href="{{ tile.href }}">{{ tile.label }}</a>
        <span>{{ tile.position }}</span>
      </li>
      {% else %}
      <li><span>No record tiles yet</span></li>
      {% endfor %}
    </ol>
  </article>

  <article class="apg-card apg-dashboard-panel">
    <div class="apg-card-header">
      <div>
        <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Threshold Alerts</h2>
        <p class="text-xs text-gray-400 mt-1">Inline watches before scheduled delivery</p>
      </div>
      <a class="apg-btn apg-btn-secondary" href="/metrics">Metrics</a>
    </div>
    <ul class="apg-dashboard-watch-list">
      {% for alert in dashboard_alerts %}
      <li>
        <a href="{{ alert.href }}">{{ alert.label }}</a>
        <strong>{{ alert.value }}</strong>
        <small>{{ alert.state }} at {{ alert.threshold }}</small>
      </li>
      {% else %}
      <li><span>No thresholds available</span></li>
      {% endfor %}
    </ul>
  </article>

  <article class="apg-card apg-dashboard-panel">
    <div class="apg-card-header">
      <div>
        <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Annotation Pins</h2>
        <p class="text-xs text-gray-400 mt-1">Decision context travels with charts</p>
      </div>
      <span class="apg-badge apg-badge-info">{{ dashboard_annotations | length }} pins</span>
    </div>
    <ul class="apg-dashboard-pin-list">
      {% for pin in dashboard_annotations %}
      <li>
        <a href="{{ pin.href }}">{{ pin.title }}</a>
        <p>{{ pin.body }}</p>
      </li>
      {% else %}
      <li><p>Add status data to unlock annotation pins.</p></li>
      {% endfor %}
    </ul>
  </article>

  <article class="apg-card apg-dashboard-panel">
    <div class="apg-card-header">
      <div>
        <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Scheduled Export</h2>
        <p class="text-xs text-gray-400 mt-1">Offline packets, no external service</p>
      </div>
      <button type="button" class="apg-btn apg-btn-secondary" onclick="window.print()">PNG/PDF</button>
    </div>
    <ul class="apg-dashboard-export-list">
      {% for item in scheduled_exports %}
      <li>
        <strong>{{ item.label }}</strong>
        <span>{{ item.cadence }}</span>
        <small>{{ item.format }}</small>
      </li>
      {% endfor %}
    </ul>
  </article>
</section>

{# Stats row #}
<div class="apg-grid-4 mb-8" data-apg-live="events">
  {% for stat in dashboard_stats[:4] %}
  <article class="apg-card">
    <div class="apg-stat">
      <a class="apg-stat-value hover:text-apg-primary" href="/ui/entities/{{ stat.label | urlencode }}">{{ stat.value }}</a>
      <span class="apg-stat-label">{{ stat.label }} records</span>
      <span class="apg-stat-delta">{{ stat.delta }}</span>
    </div>
    <div class="apg-chart mt-3" data-apg-chart="{{ stat.chart_id }}"></div>
    <script id="{{ stat.chart_id }}" type="application/json">{{ stat.spec_json | safe }}</script>
  </article>
  {% endfor %}
  <article class="apg-card">
    <div class="apg-stat">
      <a class="apg-stat-value hover:text-apg-primary" href="/ui/marketplace">{{ capabilities | length }}</a>
      <span class="apg-stat-label">Capabilities</span>
    </div>
  </article>
  <article class="apg-card">
    <div class="apg-stat">
      <a class="apg-stat-value hover:text-apg-primary" href="/ui/workflows">{{ workflow_summary.workflow_count }}</a>
      <span class="apg-stat-label">Workflows</span>
    </div>
  </article>
</div>

{% if status_charts %}
<section class="apg-grid-2 gap-6 mb-8">
  {% for chart in status_charts %}
  <article class="apg-card">
    <div class="apg-card-header">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">{{ chart.entity }} by {{ chart.field }}</h2>
      <a class="text-xs hover:underline" href="/ui/entities/{{ chart.entity | urlencode }}?view=analytics">Analytics</a>
    </div>
    <div class="apg-chart" data-apg-chart="{{ chart.chart_id }}"></div>
    <script id="{{ chart.chart_id }}" type="application/json">{{ chart.spec_json | safe }}</script>
  </article>
  {% endfor %}
</section>
{% endif %}

<section class="apg-grid-3 gap-6 mb-8">
  <article class="apg-card">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3">Recent Activity</h2>
    {% if recent_activity %}
    <ul class="space-y-2">
      {% for event in recent_activity %}
      <li class="text-xs text-gray-500">{{ event.get('type', 'event') }} · {{ event.get('entity', '') }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <div class="apg-chart-empty">
      <p>No activity yet</p>
      {% if entities %}<a class="apg-btn apg-btn-secondary mt-3" href="/ui/entities/{{ entities[0].name | urlencode }}">Create the first record</a>{% endif %}
    </div>
    {% endif %}
  </article>
  <article class="apg-card">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3">Workflow Summary</h2>
    <p class="text-sm text-gray-500">{{ workflow_summary.workflow_count }} workflow(s), {{ workflow_summary.run_count }} run(s)</p>
    <a class="apg-btn apg-btn-secondary mt-3" href="/ui/workflows">Open workflows</a>
  </article>
  <article class="apg-card">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3">Agent Summary</h2>
    <p class="text-sm text-gray-500">{{ agent_summary.agent_count }} agent(s), {{ agent_summary.team_count }} team(s)</p>
    {% if agents %}<a class="apg-btn apg-btn-secondary mt-3" href="/ui/agents/{{ agents[0].name | urlencode }}">Open agent console</a>{% endif %}
  </article>
</section>

<div class="apg-grid-2 gap-6">
  {% if entities %}
  <div class="apg-card">
    <div class="apg-card-header">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Entities</h2>
    </div>
    <ul class="divide-y divide-gray-100 dark:divide-gray-700">
      {% for entity in entities %}
      <li class="py-2 flex items-center justify-between">
        <a href="/ui/entities/{{ entity.name | urlencode }}"
           class="text-sm text-apg-primary hover:underline font-medium">
          {{ entity.name }}
        </a>
        <span class="apg-badge apg-badge-neutral">{{ entity.type }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if capabilities %}
  <div class="apg-card">
    <div class="apg-card-header">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Capabilities</h2>
    </div>
    <ul class="divide-y divide-gray-100 dark:divide-gray-700">
      {% for cap in capabilities %}
      <li class="py-2">
        <a href="/ui/capabilities/{{ cap.name | urlencode }}"
           class="text-sm text-apg-primary hover:underline font-medium">
          {{ cap.name }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if ui_routes %}
  <div class="apg-card">
    <div class="apg-card-header">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Application Screens</h2>
    </div>
    <ul class="divide-y divide-gray-100 dark:divide-gray-700">
      {% for route, screen in ui_routes.items() %}
      <li class="py-2 flex items-center justify-between">
        <a href="{{ route }}" class="text-sm text-apg-primary hover:underline">{{ route }}</a>
        <span class="text-xs text-gray-400">{{ screen.get('application', '') }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if application_routes %}
  <div class="apg-card">
    <div class="apg-card-header">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Application Routes</h2>
    </div>
    <ul class="divide-y divide-gray-100 dark:divide-gray-700">
      {% for route, screen in application_routes.items() %}
      <li class="py-2 flex items-center justify-between">
        <a href="{{ route }}" class="text-sm text-apg-primary hover:underline">{{ route }}</a>
        <span class="text-xs text-gray-400">{{ screen.get('application', '') }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if agents %}
  <div class="apg-card">
    <div class="apg-card-header">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">AI Agents</h2>
    </div>
    <ul class="divide-y divide-gray-100 dark:divide-gray-700">
      {% for agent in agents %}
      <li class="py-2">
        <a href="/ui/agents/{{ agent.name | urlencode }}"
           class="text-sm text-apg-primary hover:underline font-medium">
          {{ agent.name }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if agent_teams %}
  <div class="apg-card">
    <div class="apg-card-header">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">AI Agent Teams</h2>
    </div>
    <ul class="divide-y divide-gray-100 dark:divide-gray-700">
      {% for team in agent_teams %}
      <li class="py-2">
        <a href="/ui/agent-teams/{{ team.name | urlencode }}"
           class="text-sm text-apg-primary hover:underline font-medium">
          {{ team.name }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</div>
