{# landing.html.j2 — APG application landing page #}
<!doctype html>
<html lang="{{ active_locale }}" dir="{{ text_direction }}" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ module_name | replace('_', ' ') | title }}</title>
  <link rel="stylesheet" href="/static/apg.css">
  <link rel="stylesheet" href="/theme.css">
  <style>
    :root {
      --brand: {{ theme_primary }};
      --accent: {{ theme_accent }};
    }
  </style>
</head>
<body class="min-h-full bg-gray-50 text-gray-900 font-sans antialiased">
  <a class="apg-skip-link" href="#content">Skip to content</a>

  <header class="bg-white border-b border-gray-200">
    <nav class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between gap-4">
      <a href="/" class="text-lg font-bold text-gray-900">{{ module_name | replace('_', ' ') | title }}</a>
      <div class="flex items-center gap-2 flex-wrap justify-end">
        <a href="/ui" class="apg-btn">{{ _('open_app') }}</a>
        <a href="/ui/marketplace" class="apg-btn apg-btn-secondary">{{ _('marketplace') }}</a>
      </div>
    </nav>
  </header>

  <main id="content" class="max-w-6xl mx-auto px-6 py-10">
    <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start mb-8">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">Generated APG workspace</p>
        <h1 class="text-4xl font-extrabold text-gray-900 mb-4">{{ module_name | replace('_', ' ') | title }}</h1>
        <p class="text-lg text-gray-600 mb-6 leading-relaxed">
          {{ module_description or 'A generated operational application with data, workflows, automation, and integration surfaces ready to use.' }}
        </p>
        <div class="flex items-center gap-3 flex-wrap">
          <a href="/ui" class="apg-btn">{{ _('open_app') }}</a>
          {% if primary_entities %}
          <a href="/ui/entities/{{ primary_entities[0].name }}" class="apg-btn apg-btn-secondary">Open {{ primary_entities[0].name }}</a>
          {% endif %}
          <a href="/openapi.json" class="apg-btn apg-btn-secondary">API contract</a>
        </div>
      </div>
      <section class="apg-card" aria-label="Workspace readiness">
        <h2 class="text-base font-semibold text-gray-900 mb-4">Workspace readiness</h2>
        <div class="grid grid-cols-2 gap-3">
          {% for stat in stats %}
          <div class="border border-gray-100 rounded-lg p-3">
            <p class="text-2xl font-bold text-gray-900">{{ stat.value }}</p>
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ stat.label }}</p>
          </div>
          {% endfor %}
        </div>
      </section>
    </section>

    {% if capability_compare %}
    <section class="apg-marketplace-compare mb-8" aria-label="Capability compare">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">Capability compare</p>
        <h2 class="text-base font-semibold text-gray-900">Generated proof beats marketplace promises</h2>
      </div>
      <div class="apg-table-wrap">
        <table class="apg-table">
          <thead><tr><th>Surface</th><th>APG proof</th><th>Leader weakness closed</th><th>Inspect</th></tr></thead>
          <tbody>
            {% for row in capability_compare %}
            <tr>
              <td class="font-semibold">{{ row.surface }}</td>
              <td>{{ row.apg }}</td>
              <td>{{ row.leader_gap }}</td>
              <td><a href="{{ row.proof }}" class="apg-btn apg-btn-secondary apg-mini-btn">Open</a></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if live_demo %}
    <section class="apg-live-demo-boot mb-8" aria-label="Live demo boot">
      <header>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">Live demo boot</p>
        <h2 class="text-base font-semibold text-gray-900">{{ live_demo.headline }}</h2>
      </header>
      <ol>
        {% for step in live_demo.steps %}
        <li>
          <span>{{ loop.index }}</span>
          <div>
            <a href="{{ step.url }}" class="font-semibold text-gray-900">{{ step.label }}</a>
            <small>{{ step.detail }}</small>
          </div>
        </li>
        {% endfor %}
      </ol>
    </section>
    {% endif %}

    <section class="mb-8" aria-label="Primary actions">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-400 mb-4">Start here</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for action in workspace_actions %}
        <a href="{{ action.url }}" class="apg-card hover:border-apg-primary transition-colors">
          <h3 class="text-sm font-semibold text-gray-900">{{ action.label }}</h3>
          <p class="text-xs text-gray-500 mt-2">{{ action.description }}</p>
        </a>
        {% endfor %}
      </div>
    </section>

    {% if primary_entities %}
    <section class="mb-8" aria-label="Data workspaces">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-400 mb-4">{{ _('data_entities') }}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for entity in primary_entities %}
        <a href="/ui/entities/{{ entity.name }}" class="apg-card hover:border-apg-primary transition-colors">
          <div class="flex items-center justify-between gap-3 mb-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center text-white text-sm font-bold" style="background: var(--brand)">
              {{ entity.name[0] | upper }}
            </span>
            <span class="apg-badge">{{ entity.type }}</span>
          </div>
          <h3 class="text-sm font-semibold text-gray-900">{{ entity.name }}</h3>
          <p class="text-xs text-gray-500 mt-1">{{ entity.fields | length if entity.fields else entity.properties | length }} fields</p>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-8">
      <article class="apg-card">
        <h2 class="text-base font-semibold text-gray-900 mb-3">Integration readiness</h2>
        <p class="text-sm text-gray-500 mb-4">Generated APIs and marketplace blueprints make the app connectable without external assets.</p>
        <div class="space-y-2">
          {% for blueprint in marketplace_blueprints[:3] %}
          <a href="{{ blueprint.href }}" class="flex items-center justify-between gap-3 border border-gray-100 rounded-lg p-3 hover:border-apg-primary">
            <span class="text-sm font-semibold text-gray-900">{{ blueprint.title }}</span>
            <span class="text-xs text-gray-400">{{ blueprint.category }}</span>
          </a>
          {% endfor %}
        </div>
      </article>
      <article class="apg-card">
        <h2 class="text-base font-semibold text-gray-900 mb-3">Developer surfaces</h2>
        <div class="flex flex-wrap gap-2">
          {% for link in api_links %}
          <a href="{{ link.url }}" class="apg-btn apg-btn-secondary">{{ link.label }}</a>
          {% endfor %}
        </div>
      </article>
    </section>

    {% if marketplace_intelligence %}
    <section class="apg-install-proof-ledger mb-8" aria-label="Install proof ledger">
      <header>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">Install proof</p>
        <h2 class="text-base font-semibold text-gray-900">Local evidence for {{ marketplace_intelligence.leader }}-class evaluation</h2>
      </header>
      <div>
        {% for item in marketplace_intelligence.install_proof %}
        <a href="{{ item.url }}">
          <span>{{ item.label }}</span>
          <strong>{{ item.value }}</strong>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}
  </main>

  <footer class="border-t border-gray-200 py-6 text-center text-xs text-gray-400">
    Generated by <span class="font-medium text-gray-600">APG</span> · Datacraft
  </footer>
</body>
</html>
