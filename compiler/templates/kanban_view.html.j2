{# kanban_view.html.j2 — Kanban board view for status-field entities
   Variables: entity_name, safe_entity, columns, display_field, status_field, fields
   columns: [{"label": str, "records": [dict]}]
#}

{# Breadcrumb + view toggle #}
<nav class="flex items-center gap-2 text-sm mb-5 text-gray-500 flex-wrap">
  <a href="/ui" class="hover:text-apg-primary transition-colors">Application</a>
  <span>/</span>
  <a href="/ui/entities/{{ safe_entity }}" class="hover:text-apg-primary transition-colors">{{ entity_name }}</a>
  <span>/</span>
  <span class="font-semibold text-gray-900">Kanban</span>
  <div class="ml-auto flex items-center gap-1">
    <a href="/ui/entities/{{ safe_entity }}"
       class="px-3 py-1 text-xs border border-gray-200 rounded-lg text-gray-600 hover:border-apg-primary hover:text-apg-primary transition-colors">
      ≡ List
    </a>
    <span class="px-3 py-1 text-xs bg-apg-primary text-white rounded-lg font-medium">⊞ Kanban</span>
  </div>
</nav>

<div class="flex items-center gap-4 mb-5">
  <h1 class="text-xl font-bold text-gray-900">{{ entity_name }}</h1>
  <span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full font-medium">
    by {{ status_field | replace('_', ' ') }}
  </span>
  <span class="text-xs text-gray-400">
    {{ columns | sum(attribute='records') | length }} total
  </span>
</div>

{# Kanban board — horizontal scroll #}
<div class="flex gap-4 overflow-x-auto pb-6 items-start -mx-1 px-1">
  {% for col in columns %}
  <div class="flex-shrink-0 w-72">
    {# Column header #}
    <div class="flex items-center justify-between mb-3 px-1">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full
          {% if col.label | lower in ['active', 'approved', 'paid', 'open', 'complete', 'completed', 'success', 'done'] %}bg-green-400
          {% elif col.label | lower in ['inactive', 'rejected', 'closed', 'cancelled', 'canceled', 'failed', 'expired'] %}bg-red-400
          {% elif col.label | lower in ['pending', 'draft', 'processing', 'review', 'in_progress', 'waiting'] %}bg-yellow-400
          {% else %}bg-gray-300{% endif %}"></span>
        <h2 class="text-sm font-semibold text-gray-900">{{ col.label }}</h2>
        <span class="text-xs bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded-full font-medium">{{ col.records | length }}</span>
      </div>
    </div>

    {# Card list #}
    <div class="space-y-2.5">
      {% for record in col.records %}
      {% set rec_id = record.get('id', '') | string %}
      <a href="/ui/entities/{{ safe_entity }}/{{ rec_id | urlencode }}"
         class="block bg-white rounded-xl border border-gray-200 p-4 hover:border-apg-primary hover:shadow-md transition-all group/card">
        <div class="flex items-start justify-between gap-2 mb-2.5">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center text-white text-sm font-bold flex-shrink-0"
               style="background: var(--apg-primary, #0ea5e9)">
            {{ (record.get(display_field, '') | string)[:1] | upper or '?' }}
          </div>
          <span class="text-xs text-gray-300 font-mono mt-1">{{ rec_id[:8] }}</span>
        </div>
        <p class="text-sm font-semibold text-gray-900 group-hover/card:text-apg-primary transition-colors leading-tight mb-2">
          {{ record.get(display_field, '—') | string | truncate(50) }}
        </p>
        {% for f in fields %}
        {% if f.name not in ['id', '_revision', display_field, status_field] %}
        {% set fval = record.get(f.name, '') %}
        {% if fval and fval != '' and fval != 'None' %}
        <p class="text-xs text-gray-400 truncate mt-0.5">
          <span class="font-medium text-gray-500">{{ (f.name[:-3] | replace('_', ' ') | title ~ ' ID') if f.name.endswith('_id') else (f.name | replace('_', ' ') | title) }}:</span>
          {{ fval | string | truncate(35) }}
        </p>
        {% if loop.index >= 2 %}{% break %}{% endif %}
        {% endif %}
        {% endif %}
        {% endfor %}
      </a>
      {% endfor %}

      {% if not col.records %}
      <div class="bg-gray-50 rounded-xl border border-dashed border-gray-200 p-6 text-center">
        <p class="text-xs text-gray-300">Empty</p>
      </div>
      {% endif %}
    </div>
  </div>
  {% endfor %}

  {% if not columns %}
  <div class="flex-1 text-center py-16 text-gray-400">
    <div class="text-4xl mb-3 opacity-20">⊞</div>
    <p class="text-sm">No records to display.</p>
  </div>
  {% endif %}
</div>
