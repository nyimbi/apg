{# record_detail.html.j2 — Salesforce-quality record detail page
   Variables: entity_name, entity_type, safe_entity, safe_record_id,
              record, fields, field_semantics, title, status_val, revision,
              related_lists, related_count, prev_record_url, next_record_url,
              record_url, has_kanban (bool)
   related_lists: [{"entity": str, "fk_field": str, "records": [dict], "cols": [str]}]
   field_semantics: {field_name: semantic_type}
#}

{# Breadcrumb #}
<nav class="flex items-center gap-2 text-sm mb-5 text-gray-500 flex-wrap">
  <a href="/ui" class="hover:text-apg-primary transition-colors">Application</a>
  <span>/</span>
  <a href="/ui/entities/{{ safe_entity }}" class="hover:text-apg-primary transition-colors">{{ entity_name }}</a>
  <span>/</span>
  <span class="font-semibold text-gray-900 truncate max-w-xs">{{ title }}</span>
</nav>

{# Record header card #}
<div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-5 overflow-hidden">
  <div class="h-1 bg-apg-primary"></div>
  <div class="px-6 py-5 flex items-start gap-4">
    <div class="w-14 h-14 rounded-xl flex items-center justify-center text-white text-2xl font-bold flex-shrink-0"
         style="background: var(--apg-primary, #0ea5e9)">
      {{ (title[:1] | upper) if title else (entity_name[:1] | upper) }}
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-xl font-bold text-gray-900 break-all">{{ title }}</h1>
        {% if status_val %}
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold
          {% if status_val | lower in ['active', 'approved', 'paid', 'open', 'enabled', 'complete', 'completed', 'success'] %}bg-green-100 text-green-800
          {% elif status_val | lower in ['inactive', 'rejected', 'closed', 'disabled', 'cancelled', 'canceled', 'failed', 'expired'] %}bg-red-100 text-red-800
          {% elif status_val | lower in ['pending', 'draft', 'processing', 'review', 'in_progress', 'waiting'] %}bg-yellow-100 text-yellow-800
          {% else %}bg-gray-100 text-gray-600{% endif %}">
          {{ status_val }}
        </span>
        {% endif %}
        <span class="text-xs font-medium text-gray-400 bg-gray-50 px-2 py-0.5 rounded uppercase tracking-wide">{{ entity_type }}</span>
      </div>
      {% set id_val = record.get('id', '') %}
      {% if id_val %}
      <p class="text-xs text-gray-400 mt-1 font-mono truncate">{{ id_val | string }}</p>
      {% endif %}
    </div>
    <div class="flex items-center gap-2 flex-shrink-0 flex-wrap">
      {% if prev_record_url %}
      <a href="{{ prev_record_url }}" class="apg-btn apg-btn-secondary">Previous</a>
      {% endif %}
      {% if next_record_url %}
      <a href="{{ next_record_url }}" class="apg-btn apg-btn-secondary">Next</a>
      {% endif %}
      <button type="button"
              class="apg-btn apg-btn-secondary"
              onclick="navigator.clipboard && navigator.clipboard.writeText(location.origin + '{{ record_url }}'); APGToast('Record link copied', 'success');">
        Copy link
      </button>
      {% if has_kanban %}
      <a href="/ui/entities/{{ safe_entity }}?view=kanban" class="apg-btn apg-btn-secondary">Kanban</a>
      {% endif %}
      <a href="/ui/workflows/{{ safe_entity }}/create_{{ safe_entity }}"
         class="apg-btn">
        Workflow
      </a>
      <form method="post"
            action="/ui/entities/{{ safe_entity }}/records/{{ safe_record_id }}/delete"
            class="inline"
            onsubmit="return apgConfirmSubmit(this, 'Delete this record? This cannot be undone.')">
        {{ csrf_input() | safe }}
        <input type="hidden" name="expected_revision" value="{{ revision }}">
        <button type="submit"
                class="px-3 py-1.5 text-sm font-medium border border-red-200 text-red-500 rounded-lg hover:bg-red-50 transition-colors">
          Delete
        </button>
      </form>
    </div>
  </div>
{# Highlights panel — top fields at a glance #}
{% set highlight_fields = [] %}
{% for f in fields %}
  {% if f.name not in ['id', '_revision'] and not f.name.endswith('_id') %}
    {% if highlight_fields | length < 4 %}
      {% set _ = highlight_fields.append(f) %}
    {% endif %}
  {% endif %}
{% endfor %}
{% if highlight_fields %}
<div class="border-t border-gray-100 px-6 py-3 grid grid-cols-2 md:grid-cols-4 gap-4 bg-gray-50/50">
  {% for f in highlight_fields %}
  {% set fv = record.get(f.name, '') %}
  {% set sem = field_semantics.get(f.name, 'text') if field_semantics else 'text' %}
  <div class="min-w-0">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-0.5 truncate">
      {{ (f.name[:-3] | replace('_',' ') | title ~ ' ID') if f.name.endswith('_id') else (f.name | replace('_',' ') | title) }}
    </p>
    <p class="text-sm font-medium text-gray-900 truncate">
      {% if fv is none or fv == '' or fv | string == 'None' %}
      <span class="text-gray-300 italic text-xs">—</span>
      {% elif sem == 'currency' %}
      <span class="tabular-nums">{{ format_currency(fv) }}</span>
      {% elif sem == 'status' %}
      <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-semibold
        {% if fv | string | lower in ['active','approved','paid','open','enabled','complete','completed','success','done'] %}bg-green-100 text-green-800
        {% elif fv | string | lower in ['inactive','rejected','closed','disabled','cancelled','canceled','failed','expired'] %}bg-red-100 text-red-800
        {% else %}bg-yellow-100 text-yellow-800{% endif %}">{{ fv }}</span>
      {% else %}
      {{ fv | string | truncate(30) }}
      {% endif %}
    </p>
  </div>
  {% endfor %}
</div>
{% endif %}
</div>

{% if detail_intelligence %}
<section class="apg-detail-command-center" aria-label="Record intelligence">
  <article class="apg-detail-command-card">
    <div class="apg-detail-command-head">
      <span>Change Diff Timeline</span>
      <strong>rev. {{ revision }}</strong>
    </div>
    {% if detail_intelligence.diff_fields %}
    <ol class="apg-detail-diff-list">
      {% for item in detail_intelligence.diff_fields %}
      <li>
        <span>{{ item.name }}</span>
        <strong>{{ item.value }}</strong>
      </li>
      {% endfor %}
    </ol>
    {% else %}
    <p class="apg-detail-empty">No populated fields to compare yet.</p>
    {% endif %}
    <small>{{ detail_intelligence.activity_count }} activity events captured</small>
  </article>

  <article class="apg-detail-command-card">
    <div class="apg-detail-command-head">
      <span>Related Record Graph</span>
      <strong>{{ related_count }} links</strong>
    </div>
    {% if detail_intelligence.related_graph %}
    <div class="apg-detail-graph">
      <div class="apg-detail-node apg-detail-node-root">{{ entity_name }}</div>
      {% for rel in detail_intelligence.related_graph %}
      <a class="apg-detail-node" href="{{ rel.url }}">
        {{ rel.entity }}
        <small>{{ rel.count }} via {{ rel.field }}</small>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <p class="apg-detail-empty">No downstream records reference this item yet.</p>
    {% endif %}
  </article>

  <article class="apg-detail-command-card">
    <div class="apg-detail-command-head">
      <span>Create Sibling Context</span>
      <strong>{{ detail_intelligence.sibling_fields | length }} defaults</strong>
    </div>
    {% if detail_intelligence.sibling_fields %}
    <dl class="apg-detail-sibling-list">
      {% for item in detail_intelligence.sibling_fields %}
      <div>
        <dt>{{ item.name }}</dt>
        <dd>{{ item.value or 'Empty' }}</dd>
      </div>
      {% endfor %}
    </dl>
    {% else %}
    <p class="apg-detail-empty">No safe sibling defaults detected.</p>
    {% endif %}
    <a href="{{ detail_intelligence.create_sibling_url }}" class="apg-detail-action">Start from this shape</a>
  </article>
</section>
{% endif %}

{# Tab bar #}
<div class="flex items-center gap-1 border-b border-gray-200 mb-6">
  <button onclick="apgTab('details')" id="apg-tab-details"
          class="apg-tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-apg-primary text-apg-primary -mb-px transition-colors">
    Details
  </button>
  <button onclick="apgTab('related')" id="apg-tab-related"
          class="apg-tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900 -mb-px transition-colors">
    Related
    {% if related_lists %}
    <span class="ml-1 text-xs bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded-full">
      {{ related_count }}
    </span>
    {% endif %}
  </button>
  <button onclick="apgTab('activity')" id="apg-tab-activity"
          class="apg-tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900 -mb-px transition-colors">
    Activity
  </button>
</div>

{# Details panel #}
<div id="apg-panel-details">
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
    <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-gray-900">Record Details</h2>
      <span class="text-xs text-gray-400 font-mono">rev. {{ revision }}</span>
    </div>
    <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-x-8">
      {% for field in fields %}
      {% if field.name != '_revision' %}
      {% set field_val = record.get(field.name, '') %}
      {% set fld_id = 'fld-' ~ safe_entity ~ '-' ~ safe_record_id ~ '-' ~ field.name %}
      <div id="{{ fld_id }}" class="py-3 border-b border-gray-50 last:border-0 group/field">
        <dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">
          {{ (field.name[:-3] | replace('_', ' ') | title ~ ' ID') if field.name.endswith('_id') else (field.name | replace('_', ' ') | title) }}
        </dt>
        <dd class="flex items-center justify-between gap-2 min-h-6">
          <span class="text-sm text-gray-900 break-words">
            {% set semantic = field_semantics.get(field.name, 'text') if field_semantics else 'text' %}
            {% include 'widgets/field_display.html.j2' %}
          </span>
          <button
            hx-get="/ui/entities/{{ safe_entity }}/{{ safe_record_id }}/fields/{{ field.name }}/edit"
            hx-target="#{{ fld_id }}"
            hx-swap="outerHTML"
            class="opacity-0 group-hover/field:opacity-100 flex-shrink-0 p-1 text-gray-300 hover:text-apg-primary rounded transition-all"
            title="Edit {{ field.name }}">
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zm-2.207 2.207L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
            </svg>
          </button>
        </dd>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{# Related panel #}
<div id="apg-panel-related" class="hidden">
  {% if related_lists %}
    {% for rel in related_lists %}
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm mb-4">
      <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <h2 class="text-sm font-semibold text-gray-900">{{ rel.entity }}</h2>
          <span class="text-xs bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded-full font-medium">{{ rel.records | length }}</span>
        </div>
        <a href="{{ rel.list_url }}"
           class="text-xs text-apg-primary hover:underline">View filtered</a>
      </div>
      {% if rel.records %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="apg-sr-only">{{ rel.entity }} records</caption>
          <thead>
            <tr class="bg-gray-50 border-b border-gray-100">
              {% for col in rel.cols %}
              <th scope="col" class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">
                {{ (col[:-3] | replace('_', ' ') | title ~ ' ID') if col.endswith('_id') else (col | replace('_', ' ') | title) }}
              </th>
              {% endfor %}
              <th scope="col" class="px-4 py-2 w-16">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {% for row in rel.records[:5] %}
            <tr class="hover:bg-gray-50 transition-colors">
              {% for col in rel.cols %}
              <td{% if loop.first %} scope="row"{% endif %} class="px-4 py-2.5 text-gray-700 max-w-xs truncate">
                {{ row.get(col, '') | string | truncate(40) }}
              </td>
              {% endfor %}
              <td class="px-4 py-2.5 text-right">
                <a href="/ui/entities/{{ rel.entity | urlencode }}/{{ row.get('id', '') | string | urlencode }}"
                   class="text-xs text-apg-primary hover:underline font-medium">View →</a>
              </td>
            </tr>
            {% endfor %}
            {% if rel.records | length > 5 %}
            <tr>
              <td colspan="{{ rel.cols | length + 1 }}" class="px-4 py-2.5 text-center text-xs text-gray-400">
                + {{ rel.records | length - 5 }} more —
                <a href="{{ rel.list_url }}" class="text-apg-primary hover:underline">view filtered</a>
              </td>
            </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="px-4 py-8 text-center text-sm text-gray-400">
        <p>No related {{ rel.entity }} records through {{ rel.fk_field }}.</p>
        <div class="mt-3 flex items-center justify-center gap-2 flex-wrap">
          <a href="{{ rel.list_url }}" class="apg-btn apg-btn-secondary">Open filtered list</a>
          <a href="{{ rel.create_url }}" class="apg-btn">Create {{ rel.entity }}</a>
        </div>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  {% else %}
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-12 text-center">
    <div class="text-4xl mb-3 opacity-20">🔗</div>
    <p class="text-sm font-medium text-gray-500">No related records found.</p>
    <p class="text-xs text-gray-400 mt-1">Other entities with FK fields pointing to {{ entity_name }} appear here.</p>
  </div>
  {% endif %}
</div>

{# Activity panel #}
<div id="apg-panel-activity" class="hidden">
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
    <div class="px-4 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-900">Activity</h2>
    </div>
    <div class="p-5">
      <ol class="relative border-l-2 border-gray-100 ml-4 space-y-5">
        {% if activity_events %}
          {% for ev in activity_events %}
          <li class="ml-6">
            <span class="absolute flex items-center justify-center w-8 h-8 rounded-full -left-4 text-sm ring-4 ring-white
              {% if ev.type == 'create' %}bg-blue-50
              {% elif ev.type == 'update' %}bg-purple-50
              {% elif ev.type == 'delete' %}bg-red-50
              {% elif ev.type == 'note' %}bg-yellow-50
              {% else %}bg-gray-50{% endif %}">
              {% if ev.type == 'create' %}📋
              {% elif ev.type == 'update' %}✏️
              {% elif ev.type == 'delete' %}🗑️
              {% elif ev.type == 'note' %}💬
              {% else %}⚡{% endif %}
            </span>
            <div class="pl-2">
              <p class="text-sm font-medium text-gray-900">{{ ev.detail or (ev.type | title) }}</p>
              <p class="text-xs text-gray-400 mt-0.5">
                {{ ev.actor or 'APG' }}
                {% if ev.ts %} · {{ ev.ts }}{% endif %}
              </p>
            </div>
          </li>
          {% endfor %}
        {% else %}
          <li class="ml-6">
            <span class="absolute flex items-center justify-center w-8 h-8 bg-blue-50 rounded-full -left-4 text-sm ring-4 ring-white">📋</span>
            <div class="pl-2">
              <p class="text-sm font-medium text-gray-900">Record created</p>
              <p class="text-xs text-gray-400 mt-0.5">Revision {{ revision }} · via APG</p>
            </div>
          </li>
        {% endif %}
      </ol>
      <form method="post"
            action="/ui/entities/{{ safe_entity }}/records/{{ safe_record_id }}/note"
            class="mt-8 flex gap-3">
        {{ csrf_input() | safe }}
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold flex-shrink-0"
             style="background: var(--apg-primary, #0ea5e9)">A</div>
        <div class="flex-1">
          <textarea name="note" placeholder="Add a note…" rows="2" required
                    class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-apg-primary focus:border-transparent placeholder-gray-300"></textarea>
          <button type="submit"
                  class="mt-1.5 px-3 py-1.5 bg-apg-primary text-white text-xs font-medium rounded-lg hover:opacity-90 transition-opacity">
            Save Note
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script nonce="{{ csp_nonce }}">
function apgTab(name) {
  document.querySelectorAll('.apg-tab-btn').forEach(function(b) {
    b.classList.remove('border-apg-primary', 'text-apg-primary');
    b.classList.add('border-transparent', 'text-gray-500');
  });
  document.querySelectorAll('[id^="apg-panel-"]').forEach(function(p) { p.classList.add('hidden'); });
  var btn = document.getElementById('apg-tab-' + name);
  if (btn) {
    btn.classList.remove('border-transparent', 'text-gray-500');
    btn.classList.add('border-apg-primary', 'text-apg-primary');
  }
  var panel = document.getElementById('apg-panel-' + name);
  if (panel) panel.classList.remove('hidden');
}
</script>
