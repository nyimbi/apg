    "testCommand": "python3 -c \"\nfrom pathlib import Path\nf = Path('capabilities/composition/config/api.py')\ntext = f.read_text()\n\n# Add templates and configurations endpoints to create_app()\nold = '''        @app.get(\\\"/workspaces/{workspace_id}\\\")\n        async def get_workspace(workspace_id: str):\n            ws = _api_runtime_state.get(f\\\"ws:{workspace_id}\\\")\n            if not ws:\n                from fastapi import HTTPException\n                raise HTTPException(status_code=404, detail=\\\"workspace_not_found\\\")\n            return ws'''\n\nnew = '''        @app.get(\\\"/workspaces/{workspace_id}\\\")\n        async def get_workspace(workspace_id: str):\n            ws = _api_runtime_state.get(f\\\"ws:{workspace_id}\\\")\n            if not ws:\n                from fastapi import HTTPException\n                raise HTTPException(status_code=404, detail=\\\"workspace_not_found\\\")\n            return ws\n\n        @app.post(\\\"/templates\\\")\n        async def create_template_ep(req: _FAReq):\n            import uuid\n            ws_id = req.query_params.get(\\\"workspace_id\\\", \\\"\\\")\n            body = {}\n            try: body = await req.json()\n            except Exception: body = {}\n            tmpl = {\\\"id\\\": str(uuid.uuid4()), \\\"workspace_id\\\": ws_id, **body}\n            _api_runtime_state[f\\\"tmpl:{tmpl[\\'id\\']}\\\"] = tmpl\n            return tmpl\n\n        @app.get(\\\"/templates\\\")\n        async def list_templates_ep(req: _FAReq):\n            ws_id = req.query_params.get(\\\"workspace_id\\\", \\\"\\\")\n            return [v for k, v in _api_runtime_state.items() if k.startswith(\\\"tmpl:\\\") and v.get(\\\"workspace_id\\\") == ws_id]\n\n        @app.post(\\\"/configurations\\\")\n        async def create_config_ep(req: _FAReq):\n            import uuid\n            ws_id = req.query_params.get(\\\"workspace_id\\\", \\\"\\\")\n            body = {}\n            try: body = await req.json()\n            except Exception: body = {}\n            cfg = {\\\"id\\\": str(uuid.uuid4()), \\\"workspace_id\\\": ws_id, \\\"status\\\": \\\"active\\\", **body}\n            _api_runtime_state[f\\\"cfg:{cfg[\\'id\\']}\\\"] = cfg\n            return cfg\n\n        @app.get(\\\"/configurations\\\")\n        async def list_configs_ep(req: _FAReq):\n            ws_id = req.query_params.get(\\\"workspace_id\\\", \\\"\\\")\n            return [v for k, v in _api_runtime_state.items() if k.startswith(\\\"cfg:\\\") and v.get(\\\"workspace_id\\\") == ws_id]\n\n        @app.get(\\\"/configurations/{config_id}\\\")\n        async def get_config_ep(config_id: str):\n            return _api_runtime_state.get(f\\\"cfg:{config_id}\\\", {\\\"id\\\": config_id})'''\n\nif old in text:\n    f.write_text(text.replace(old, new))\n    print('Added template and config endpoints')\n\" && \\\n/Users/nyimbiodero/src/pjs/apg/.venv/bin/python -m pytest tests/test_composition_config_api_runtime.py -q --tb=no 2>&1 | tail -3",
