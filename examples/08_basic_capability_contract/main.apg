// Example 08: first-class capability contract.
// Complexity focus: one capability with explicit provides/requires metadata.

module capability_basics version 1.0.0 {
    description: "Small capability contract with a generated runtime manifest";
}

capability AuditLog {
    contract: {
        // `id` is the stable capability identifier.
        id: audit_log,

        // `provides` names services that other capabilities can depend on.
        provides: [audit_events],

        // Configuration values are available to generated config helpers.
        configuration: {retention_days: 365}
    };

    // Master data names make the capability composable into ERP apps.
    master_data: {entities: [audit_event]};
}
