        "ntfy",
        "wflo",
        "comp"
      ],
      "rule_engine": {
        "default_decision": "allow",
        "rules": [
          {
            "action": "deny",
            "name": "lease_requires_signed_contract",
            "when": "operation == activate_lease and contract_signed != true"
          },
          {
            "action": "deny",
            "name": "deposit_required_before_occupation",
            "when": "operation == allow_occupation and deposit_paid != true"
          },
          {
            "action": "require_review",
            "name": "ifrs16_threshold_check",
            "when": "lease_term_months_lt == 12 or monthly_rent_lt == 41667"
          },
          {
            "action": "require_review",
            "name": "arrears_block_renewal",
            "when": "operation == renew_lease and arrears_amount_gt == 0"
          },
          {
            "action": "require_review",
            "name": "cfo_approval_large_lease",
            "when": "annual_rent_gt == 5000000 and cfo_approved != true"
          }
        ],
        "type": "deterministic"
      },
