// ============================================================
// EXAMPLE: Basic APG Applications
// ============================================================
// WHAT IT SHOWS:
//   Foundational APG application patterns covering entities,
//   capabilities, rules, themes, and composition. Demonstrates:
//   - Entity definitions with typed properties
//   - Security rules (authentication, rate limiting, CSRF)
//   - User-facing application shells with screen layouts
//   - File upload, commenting, rating systems
//
// HOW TO COMPILE:
//   apg compile examples/basic_applications.apg --output out/
//
// GENERATED ENDPOINTS:
//   GET  /applications       — application manifest
//   GET  /capabilities       — capability registry
//   GET  /entities           — entity schemas
//   GET  /ui                 — operational console UI
// ============================================================

module basic_applications version 1.0.0 {
    description: "Basic APG application examples: blog, e-commerce, task management, CRM, inventory";
}

// 1. SIMPLE WEB APPLICATION - Blog System

table BlogPost {
    id: str;
    title: str;
    content: str;
    author: str;
    created_at: datetime;
    updated_at: datetime;
    published: bool = false;
    tags: List[str];
    view_count: int = 0;
}

table BlogComment {
    id: str;
    post_id: str;
    author_name: str;
    author_email: str;
    content: str;
    created_at: datetime;
    approved: bool = false;
}

table BlogUser {
    id: str;
    username: str;
    email: str;
    password_hash: str;
    is_admin: bool = false;
    created_at: datetime;
    last_login: datetime?;
}

capability BlogManagement {
    contract: {
        id: blog_management,
        provides: [post_authoring, comment_moderation, user_management],
        requires: [auth, audl],
        configuration: {
            tenant_id: "default",
            posts_per_page: 10,
            spam_filter_enabled: bool,
            rate_limit_comments: 3,
            captcha_threshold: 0.5
        },
        rules: [
            {name: "post_requires_auth",    when: "user_authenticated == false and operation == create", action: deny},
            {name: "comment_rate_limit",    when: "comments_per_minute > 3",                            action: deny},
            {name: "comment_spam_detected", when: "spam_score > 0.8",                                   action: deny},
            {name: "publish_requires_admin",when: "published == true and is_admin == false",            action: deny}
        ],
        ui: {shell: python, routes: [
            {name: "Posts",    path: "/blog",          component: "PostList",    permission: "blog:view"},
            {name: "New Post", path: "/blog/new",      component: "PostForm",    permission: "blog:write"},
            {name: "Comments", path: "/blog/comments", component: "CommentList", permission: "blog:moderate"}
        ]},
        theme: {name: blog_theme, tokens: {accent: "#2196F3"}}
    };
}

workflow PostPublishing {
    steps: str = "draft -> review -> published";
    human_tasks: [review];
    assignments: {review: editor};
    guards: {
        review:     "title_length > 5 and content_length > 10",
        published:  "review_approved == true";
    };
}

app BlogSystem {
    description: "Blog application with post authoring and comment moderation";
    capabilities: [BlogManagement];
    routes: ["/blog", "/blog/new", "/blog/comments"];
}

// 2. E-COMMERCE SYSTEM

table Product {
    id: str;
    name: str;
    description: str?;
    price: decimal;
    stock_quantity: int = 0;
    category_id: str;
    brand: str?;
    sku: str;
    images: List[str];
    weight: float;
    dimensions: Dict[str, float];
    max_images: int = 10;
    is_active: bool = true;
    created_at: datetime;
}

table Category {
    id: str;
    name: str;
    description: str?;
    parent_id: str?;
    is_active: bool = true;
}

table Order {
    id: str;
    user_id: str;
    status: str = "pending";
    total_amount: decimal;
    shipping_address: Dict[str, str];
    billing_address: Dict[str, str];
    payment_method: str;
    created_at: datetime;
    shipped_at: datetime?;
    delivered_at: datetime?;
}

table OrderItem {
    id: str;
    order_id: str;
    product_id: str;
    quantity: int;
    unit_price: decimal;
    total_price: decimal;
}

capability ECommerceCore {
    contract: {
        id: ecommerce_core,
        provides: [product_catalog, order_management, inventory_tracking, payment_processing],
        requires: [auth, audl, ntfy],
        configuration: {
            tenant_id: "default",
            currency: "KES",
            low_stock_threshold: 10,
            max_product_images: 10,
            max_image_size_mb: 5
        },
        rules: [
            {name: "stock_check",           when: "quantity > stock_quantity",            action: deny},
            {name: "price_positive",         when: "price <= 0",                           action: deny},
            {name: "order_requires_address", when: "shipping_address missing",             action: deny},
            {name: "low_stock_alert",        when: "stock_quantity <= low_stock_threshold",action: warn}
        ],
        ui: {shell: python, routes: [
            {name: "Products",  path: "/shop/products", component: "ProductCatalog", permission: "shop:view"},
            {name: "Orders",    path: "/shop/orders",   component: "OrderList",      permission: "shop:orders"},
            {name: "Inventory", path: "/shop/inventory",component: "InventoryView",  permission: "shop:inventory"}
        ]},
        theme: {name: shop_theme, tokens: {accent: "#FF6D00"}}
    };
}

workflow OrderProcessing {
    steps: str = "order_received -> validate_inventory -> process_payment -> update_inventory -> ship_order -> deliver -> complete";
    human_tasks: [ship_order];
    assignments: {ship_order: warehouse_staff};
    guards: {
        validate_inventory: "stock_available == true",
        process_payment:    "inventory_reserved == true",
        ship_order:         "payment_confirmed == true";
    };
    compensation: {process_payment: refund_payment};
}

app ECommerceApp {
    description: "E-commerce platform with product catalog and order management";
    capabilities: [ECommerceCore];
    routes: ["/shop", "/shop/products", "/shop/orders", "/shop/inventory"];
}

// 3. TASK MANAGEMENT SYSTEM

table Project {
    id: str;
    name: str;
    description: str?;
    owner_id: str;
    status: str = "active";
    start_date: date;
    end_date: date?;
    created_at: datetime;
}

table Task {
    id: str;
    title: str;
    description: str?;
    project_id: str;
    assignee_id: str?;
    priority: str = "medium";
    status: str = "todo";
    due_date: datetime?;
    estimated_hours: float?;
    actual_hours: float?;
    created_at: datetime;
    completed_at: datetime?;
}

table TimeEntry {
    id: str;
    task_id: str;
    user_id: str;
    start_time: datetime;
    end_time: datetime?;
    duration: int;
    description: str?;
    billable: bool = true;
}

capability TaskManagement {
    contract: {
        id: task_management,
        provides: [project_tracking, task_assignment, time_logging, progress_reporting],
        requires: [auth, ntfy],
        configuration: {
            tenant_id: "default",
            default_priority: "medium",
            overdue_check_interval_hours: 24
        },
        rules: [
            {name: "task_requires_project",  when: "project_id missing",                  action: deny},
            {name: "overdue_alert",          when: "due_date < now and status != done",    action: warn},
            {name: "time_entry_open",        when: "end_time missing and start_time set",  action: warn},
            {name: "estimate_exceeded",      when: "actual_hours > estimated_hours * 1.5", action: warn}
        ],
        ui: {shell: python, routes: [
            {name: "Projects",  path: "/tasks/projects", component: "ProjectList",  permission: "tasks:view"},
            {name: "My Tasks",  path: "/tasks",          component: "TaskBoard",    permission: "tasks:view"},
            {name: "Timesheet", path: "/tasks/time",     component: "TimesheetView",permission: "tasks:time"}
        ]},
        theme: {name: tasks_theme, tokens: {accent: "#4CAF50"}}
    };
    screens: {
        TaskBoard: {
            route: "/tasks",
            layout: grid,
            contains: [TodoColumn, InProgressColumn, ReviewColumn, DoneColumn],
            binds: [tasks.by_status],
            actions: [create_task, move_task, assign_task]
        }
    };
}

app TaskManagerApp {
    description: "Project and task management application with time tracking";
    capabilities: [TaskManagement];
    routes: ["/tasks", "/tasks/projects", "/tasks/time"];
}

// 4. CUSTOMER RELATIONSHIP MANAGEMENT (CRM)

table Contact {
    id: str;
    first_name: str;
    last_name: str;
    email: str;
    phone: str?;
    company: str?;
    title: str?;
    address: Dict[str, str];
    lead_source: str?;
    status: str = "lead";
    assigned_to: str?;
    created_at: datetime;
    last_contact: datetime?;
}

table Deal {
    id: str;
    name: str;
    contact_id: str;
    value: decimal;
    probability: int = 50;
    stage: str = "prospecting";
    expected_close_date: date;
    actual_close_date: date?;
    notes: str?;
    created_at: datetime;
}

table Activity {
    id: str;
    contact_id: str;
    activity_type: str;
    subject: str;
    description: str?;
    scheduled_at: datetime?;
    completed_at: datetime?;
    created_by: str;
    created_at: datetime;
}

capability CRMCore {
    contract: {
        id: crm_core,
        provides: [contact_management, deal_pipeline, activity_logging, lead_nurturing],
        requires: [auth, ntfy, audl],
        configuration: {
            tenant_id: "default",
            lead_timeout_days: 30,
            high_value_threshold: 10000,
            auto_assignment: bool
        },
        rules: [
            {name: "duplicate_contact",    when: "email_exists == true",            action: require_review},
            {name: "high_value_escalation",when: "value > 10000",                   action: require_review},
            {name: "stale_lead",           when: "days_since_contact > 30",         action: warn},
            {name: "probability_range",    when: "probability < 0 or probability > 100", action: deny}
        ],
        ui: {shell: python, routes: [
            {name: "Contacts", path: "/crm/contacts", component: "ContactList",   permission: "crm:view"},
            {name: "Pipeline", path: "/crm/pipeline", component: "DealPipeline",  permission: "crm:deals"},
            {name: "Activities",path: "/crm/activities",component: "ActivityLog", permission: "crm:activities"}
        ]},
        theme: {name: crm_theme, tokens: {accent: "#9C27B0"}}
    };
}

workflow LeadNurturing {
    steps: str = "new_lead -> score_lead -> assign_salesperson -> send_welcome -> qualify_lead -> create_opportunity";
    human_tasks: [qualify_lead];
    assignments: {qualify_lead: sales_rep};
    guards: {
        assign_salesperson: "lead_score > 0",
        qualify_lead:       "welcome_sent == true",
        create_opportunity: "qualification_complete == true";
    };
}

app CRMApp {
    description: "Customer relationship management with deal pipeline and activity tracking";
    capabilities: [CRMCore];
    routes: ["/crm", "/crm/contacts", "/crm/pipeline", "/crm/activities"];
}

// 5. INVENTORY MANAGEMENT SYSTEM

table Warehouse {
    id: str;
    name: str;
    address: Dict[str, str];
    manager_id: str;
    is_active: bool = true;
}

table InventoryItem {
    id: str;
    warehouse_id: str;
    product_id: str;
    quantity: int;
    reserved_quantity: int = 0;
    reorder_point: int = 10;
    max_stock_level: int;
    last_counted: datetime?;
    cost_per_unit: decimal;
    location: str?;
}

table StockMovement {
    id: str;
    inventory_item_id: str;
    movement_type: str;
    quantity: int;
    reference_type: str;
    reference_id: str;
    notes: str?;
    created_by: str;
    created_at: datetime;
}

capability InventoryManagement {
    contract: {
        id: inventory_management,
        provides: [stock_tracking, movement_recording, reorder_management, audit_trail],
        requires: [auth, audl, ntfy],
        configuration: {
            tenant_id: "default",
            default_reorder_point: 10,
            large_adjustment_threshold: 100,
            large_value_threshold: 1000,
            approval_required: bool
        },
        rules: [
            {name: "negative_stock_denied",   when: "quantity - adjustment_quantity < 0",     action: deny},
            {name: "large_adjustment_review",  when: "abs_adjustment > large_adjustment_threshold", action: require_review},
            {name: "reorder_alert",            when: "available_quantity <= reorder_point",   action: warn},
            {name: "overstock_warning",        when: "quantity > max_stock_level",            action: warn}
        ],
        ui: {shell: python, routes: [
            {name: "Inventory",   path: "/inventory",          component: "InventoryList",   permission: "inv:view"},
            {name: "Movements",   path: "/inventory/movements",component: "MovementLog",     permission: "inv:view"},
            {name: "Adjustments", path: "/inventory/adjust",   component: "AdjustmentForm",  permission: "inv:adjust"},
            {name: "Reports",     path: "/inventory/reports",  component: "InventoryReport", permission: "inv:report"}
        ]},
        theme: {name: inventory_theme, tokens: {accent: "#607D8B"}}
    };
    screens: {
        InventoryDashboard: {
            route: "/inventory",
            layout: dashboard,
            contains: [StockLevelWidget, ReorderAlerts, MovementSummary, ValueWidget],
            binds: [inventory_items.current, stock_movements.recent],
            actions: [adjust_stock, transfer_stock, export_report]
        }
    };
}

workflow StockAdjustment {
    steps: str = "initiated -> validated -> approved -> applied -> logged";
    human_tasks: [approved];
    assignments: {approved: warehouse_manager};
    guards: {
        validated: "reason not missing and quantity not zero",
        approved:  "abs_adjustment > large_adjustment_threshold",
        applied:   "approval_granted == true or abs_adjustment <= large_adjustment_threshold";
    };
    compensation: {applied: reverse_adjustment};
}

app InventoryApp {
    description: "Warehouse inventory management with stock movements and reorder alerts";
    capabilities: [InventoryManagement];
    routes: ["/inventory", "/inventory/movements", "/inventory/adjust", "/inventory/reports"];
}
