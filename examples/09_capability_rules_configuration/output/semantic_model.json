{
  "agents": {},
  "app": {
    "description": null,
    "entity_count": 2,
    "name": "credit_control",
    "version": "1.0.0"
  },
  "capabilities": {
    "CreditControl": {
      "approvals": {
        "approvers": [
          "credit_manager",
          "finance_controller"
        ],
        "levels": 2
      },
      "business_rules": [],
      "components": {},
      "configuration": {
        "currency": "KES",
        "default_limit": 50000,
        "high_risk_threshold": 0.7,
        "max_days_overdue": 30,
        "review_threshold": 0.5
      },
      "erp_modules": [],
      "i18n": {},
      "master_data": {
        "entities": [
          "customer_credit_profile",
          "credit_limit",
          "payment_history"
        ]
      },
      "name": "CreditControl",
      "provides": [
        "credit_limit_checks",
        "hold_release",
        "credit_scoring"
      ],
      "requires": [
        "audit_events",
        "customer_master"
      ],
      "rule_engine": {
        "default_decision": "allow",
        "type": "deterministic"
      },
      "rules": [
        {
          "action": "deny",
          "name": "tenant_required",
          "priority": 100,
          "when": "tenant_id missing",
          "when_ast": {
            "field": "tenant_id",
            "negated": false,
            "type": "missing"
          }
        },
        {
          "action": "allow",
          "name": "customer_present",
          "priority": 99,
          "when": "customer_id not missing",
          "when_ast": {
            "field": "customer_id",
            "negated": true,
            "type": "missing"
          }
        },
        {
          "action": "deny",
          "name": "over_limit",
          "priority": 90,
          "when": "order_total > credit_limit",
          "when_ast": {
            "field": "order_total",
            "op": ">",
            "type": "compare",
            "value": "credit_limit"
          }
        },
        {
          "action": "deny",
          "name": "under_minimum",
          "priority": 89,
          "when": "order_total < 100",
          "when_ast": {
            "field": "order_total",
            "op": "<",
            "type": "compare",
            "value": 100
          }
        },
        {
          "action": "require_review",
          "name": "at_limit",
          "priority": 88,
          "when": "order_total >= credit_limit",
          "when_ast": {
            "field": "order_total",
            "op": ">=",
            "type": "compare",
            "value": "credit_limit"
          }
        },
        {
          "action": "allow",
          "name": "safe_order",
          "priority": 87,
          "when": "order_total <= 1000",
          "when_ast": {
            "field": "order_total",
            "op": "<=",
            "type": "compare",
            "value": 1000
          }
        },
        {
          "action": "allow",
          "name": "premium_customer",
          "priority": 86,
          "when": "customer_tier == premium",
          "when_ast": {
            "field": "customer_tier",
            "op": "==",
            "type": "compare",
            "value": "premium"
          }
        },
        {
          "action": "require_review",
          "name": "non_standard_currency",
          "priority": 85,
          "when": "currency != KES",
          "when_ast": {
            "field": "currency",
            "op": "!=",
            "type": "compare",
            "value": "KES"
          }
        },
        {
          "action": "require_review",
          "name": "high_risk_region",
          "priority": 80,
          "when": "country in [NG, SD, LY]",
          "when_ast": {
            "field": "country",
            "negated": false,
            "type": "in",
            "values": [
              "NG",
              "SD",
              "LY"
            ]
          }
        },
        {
          "action": "allow",
          "name": "approved_currency",
          "priority": 79,
          "when": "currency in [KES, UGX, TZS, USD, EUR]",
          "when_ast": {
            "field": "currency",
            "negated": false,
            "type": "in",
            "values": [
              "KES",
              "UGX",
              "TZS",
              "USD",
              "EUR"
            ]
          }
        },
        {
          "action": "require_review",
          "name": "blocked_category",
          "priority": 78,
          "when": "product_category not in [food, medicine, education]",
          "when_ast": {
            "field": "product_category",
            "negated": true,
            "type": "in",
            "values": [
              "food",
              "medicine",
              "education"
            ]
          }
        },
        {
          "action": "require_review",
          "name": "high_value_new_customer",
          "priority": 70,
          "when": "order_total > 100000 and customer_age_days < 90",
          "when_ast": {
            "left": {
              "field": "order_total",
              "op": ">",
              "type": "compare",
              "value": 100000
            },
            "right": {
              "field": "customer_age_days",
              "op": "<",
              "type": "compare",
              "value": 90
            },
            "type": "and"
          }
        },
        {
          "action": "deny",
          "name": "risk_and_overdue",
          "priority": 69,
          "when": "risk_score > high_risk_threshold and days_overdue > max_days_overdue",
          "when_ast": {
            "left": {
              "field": "risk_score",
              "op": ">",
              "type": "compare",
              "value": "high_risk_threshold"
            },
            "right": {
              "field": "days_overdue",
              "op": ">",
              "type": "compare",
              "value": "max_days_overdue"
            },
            "type": "and"
          }
        },
        {
          "action": "deny",
          "name": "fraud_pattern",
          "priority": 68,
          "when": "velocity_score > 0.8 and geo_anomaly == true",
          "when_ast": {
            "left": {
              "field": "velocity_score",
              "op": ">",
              "type": "compare",
              "value": 0.8
            },
            "right": {
              "field": "geo_anomaly",
              "op": "==",
              "type": "compare",
              "value": true
            },
            "type": "and"
          }
        },
        {
          "action": "require_review",
          "name": "urgent_review",
          "priority": 60,
          "when": "amount > 500000 or customer_tier == vip",
          "when_ast": {
            "left": {
              "field": "amount",
              "op": ">",
              "type": "compare",
              "value": 500000
            },
            "right": {
              "field": "customer_tier",
              "op": "==",
              "type": "compare",
              "value": "vip"
            },
            "type": "or"
          }
        },
        {
          "action": "deny",
          "name": "any_block_reason",
          "priority": 59,
          "when": "is_blacklisted == true or is_frozen == true",
          "when_ast": {
            "left": {
              "field": "is_blacklisted",
              "op": "==",
              "type": "compare",
              "value": true
            },
            "right": {
              "field": "is_frozen",
              "op": "==",
              "type": "compare",
              "value": true
            },
            "type": "or"
          }
        },
        {
          "action": "require_review",
          "name": "complex_approval",
          "priority": 50,
          "when": "(amount > 50000 or is_international == true) and risk_score < review_threshold",
          "when_ast": {
            "left": {
              "left": {
                "field": "amount",
                "op": ">",
                "type": "compare",
                "value": 50000
              },
              "right": {
                "field": "is_international",
                "op": "==",
                "type": "compare",
                "value": true
              },
              "type": "or"
            },
            "right": {
              "field": "risk_score",
              "op": "<",
              "type": "compare",
              "value": "review_threshold"
            },
            "type": "and"
          }
        },
        {
          "action": "deny",
          "name": "multi_factor_deny",
          "priority": 49,
          "when": "(fraud_score > 0.9 or velocity_flag == true) and customer_age_days < 30",
          "when_ast": {
            "left": {
              "left": {
                "field": "fraud_score",
                "op": ">",
                "type": "compare",
                "value": 0.9
              },
              "right": {
                "field": "velocity_flag",
                "op": "==",
                "type": "compare",
                "value": true
              },
              "type": "or"
            },
            "right": {
              "field": "customer_age_days",
              "op": "<",
              "type": "compare",
              "value": 30
            },
            "type": "and"
          }
        },
        {
          "action": "require_review",
          "name": "high_risk_score",
          "priority": 40,
          "when": "risk_score >= high_risk_threshold",
          "when_ast": {
            "field": "risk_score",
            "op": ">=",
            "type": "compare",
            "value": "high_risk_threshold"
          }
        }
      ],
      "runtime": {},
      "screens": {},
      "streaming": {},
