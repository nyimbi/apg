    },
    "CreditControl.fraud_pattern": {
      "action": "deny",
      "name": "fraud_pattern",
      "priority": 68,
      "when": "velocity_score > 0.8 and geo_anomaly == true",
      "when_ast": {
        "left": {
          "field": "velocity_score",
          "op": ">",
          "type": "compare",
          "value": 0.8
        },
        "right": {
          "field": "geo_anomaly",
          "op": "==",
          "type": "compare",
          "value": true
        },
        "type": "and"
      }
    },
    "CreditControl.high_risk_region": {
      "action": "require_review",
      "name": "high_risk_region",
      "priority": 80,
      "when": "country in [NG, SD, LY]",
      "when_ast": {
        "field": "country",
        "negated": false,
        "type": "in",
        "values": [
          "NG",
          "SD",
          "LY"
        ]
      }
    },
    "CreditControl.high_risk_score": {
      "action": "require_review",
      "name": "high_risk_score",
      "priority": 40,
      "when": "risk_score >= high_risk_threshold",
      "when_ast": {
        "field": "risk_score",
        "op": ">=",
        "type": "compare",
        "value": "high_risk_threshold"
      }
    },
    "CreditControl.high_value_new_customer": {
      "action": "require_review",
      "name": "high_value_new_customer",
      "priority": 70,
      "when": "order_total > 100000 and customer_age_days < 90",
      "when_ast": {
        "left": {
          "field": "order_total",
          "op": ">",
          "type": "compare",
          "value": 100000
        },
        "right": {
          "field": "customer_age_days",
          "op": "<",
          "type": "compare",
          "value": 90
        },
        "type": "and"
      }
    },
    "CreditControl.multi_factor_deny": {
      "action": "deny",
      "name": "multi_factor_deny",
      "priority": 49,
      "when": "(fraud_score > 0.9 or velocity_flag == true) and customer_age_days < 30",
      "when_ast": {
        "left": {
          "left": {
            "field": "fraud_score",
            "op": ">",
            "type": "compare",
            "value": 0.9
          },
          "right": {
            "field": "velocity_flag",
            "op": "==",
            "type": "compare",
            "value": true
          },
          "type": "or"
        },
        "right": {
          "field": "customer_age_days",
          "op": "<",
          "type": "compare",
          "value": 30
        },
        "type": "and"
      }
    },
    "CreditControl.non_standard_currency": {
      "action": "require_review",
      "name": "non_standard_currency",
      "priority": 85,
      "when": "currency != KES",
      "when_ast": {
        "field": "currency",
        "op": "!=",
        "type": "compare",
        "value": "KES"
      }
    },
    "CreditControl.over_limit": {
      "action": "deny",
      "name": "over_limit",
      "priority": 90,
      "when": "order_total > credit_limit",
      "when_ast": {
        "field": "order_total",
        "op": ">",
        "type": "compare",
        "value": "credit_limit"
      }
    },
    "CreditControl.premium_customer": {
      "action": "allow",
      "name": "premium_customer",
      "priority": 86,
      "when": "customer_tier == premium",
      "when_ast": {
        "field": "customer_tier",
        "op": "==",
        "type": "compare",
        "value": "premium"
      }
    },
    "CreditControl.risk_and_overdue": {
      "action": "deny",
      "name": "risk_and_overdue",
      "priority": 69,
      "when": "risk_score > high_risk_threshold and days_overdue > max_days_overdue",
      "when_ast": {
        "left": {
          "field": "risk_score",
          "op": ">",
          "type": "compare",
          "value": "high_risk_threshold"
        },
        "right": {
          "field": "days_overdue",
          "op": ">",
          "type": "compare",
          "value": "max_days_overdue"
        },
        "type": "and"
      }
    },
    "CreditControl.safe_order": {
      "action": "allow",
      "name": "safe_order",
      "priority": 87,
      "when": "order_total <= 1000",
      "when_ast": {
        "field": "order_total",
        "op": "<=",
        "type": "compare",
        "value": 1000
      }
    },
    "CreditControl.tenant_required": {
      "action": "deny",
      "name": "tenant_required",
      "priority": 100,
      "when": "tenant_id missing",
      "when_ast": {
        "field": "tenant_id",
        "negated": false,
        "type": "missing"
      }
    },
    "CreditControl.under_minimum": {
      "action": "deny",
      "name": "under_minimum",
      "priority": 89,
      "when": "order_total < 100",
      "when_ast": {
        "field": "order_total",
        "op": "<",
        "type": "compare",
        "value": 100
      }
    },
    "CreditControl.urgent_review": {
      "action": "require_review",
      "name": "urgent_review",
      "priority": 60,
      "when": "amount > 500000 or customer_tier == vip",
      "when_ast": {
        "left": {
          "field": "amount",
          "op": ">",
          "type": "compare",
          "value": 500000
        },
        "right": {
          "field": "customer_tier",
          "op": "==",
          "type": "compare",
          "value": "vip"
        },
        "type": "or"
      }
    }
