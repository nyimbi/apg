        "dispatched",
        "delivered"
      ],
      "steps_raw": "received -> payment_authorised -> picking -> packing -> dispatched -> delivered",
      "timers": {
        "dispatched": "PT24H",
        "packing": "PT2H",
        "picking": "PT4H"
      },
      "transitions": [
        {
          "guard": "payment_status == approved and fraud_score < 0.7",
          "source": "received",
          "target": "payment_authorised"
        },
        {
          "guard": null,
          "source": "payment_authorised",
          "target": "picking"
        },
        {
          "guard": null,
          "source": "picking",
          "target": "packing"
        },
        {
