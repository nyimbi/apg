          "source": "packing",
          "target": "dispatched"
        },
        {
          "guard": null,
          "source": "dispatched",
          "target": "delivered"
        }
      ],
      "type": "workflow",
      "waits": {
        "delivered": "delivery_confirmation_received",
        "payment_authorised": "payment_confirmed"
      }
    },
    "ReturnProcess": {
      "assignments": {
        "approved": "returns_manager",
        "inspected": "quality_inspector"
      },
      "compensation": {
        "refunded": "reverse_refund"
      },
      "guards": {
        "approved": "return_reason in [defective, wrong_item, not_as_described]",
        "refunded": "inspection_passed == true"
      },
      "human_tasks": [
        "approved",
        "inspected"
      ],
