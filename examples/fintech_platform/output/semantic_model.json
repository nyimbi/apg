{
  "agents": {
    "FintechRiskOfficer": {
      "capabilities": [
        "aml_screening_workflow",
        "regulatory_reporting"
      ],
      "configuration": {
        "max_turns": 4,
        "temperature": 0.0
      },
      "handoffs": [],
      "inputs": [],
      "memory": {
        "kind": "vector",
        "name": "compliance_memory"
      },
      "model": "openai:gpt-4.1-mini",
      "name": "FintechRiskOfficer",
      "outputs": [],
      "role": "risk and compliance officer",
      "rules": [
        {
          "action": "deny",
          "name": "no_sar_without_evidence",
          "when": "sar_evidence missing"
        }
      ],
      "runtime": null,
      "system": "You are a fintech compliance officer for Kenya/East Africa. Review AML alerts, assess transaction patterns, and prepare regulatory submissions to CBK, CMA, and FSCA. Apply FATF recommendations and Kenya AML/CFT framework.",
      "theme": {},
      "tools": [
        "transaction_history",
        "customer_risk_profile",
        "watchlist_check",
        "cbk_reporting"
      ],
      "ui": {}
    }
  },
  "app": {
    "description": null,
    "entity_count": 8,
    "name": "fintech_platform",
