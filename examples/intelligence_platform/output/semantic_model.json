            "when": "circumvents_privacy_controls == true"
          },
          {
            "action": "deny",
            "name": "evidence_fabrication_denied",
            "when": "evidence_source == fabricated"
          },
          {
            "action": "require_review",
            "name": "critical_alert_requires_immediate_ack",
            "when": "severity == critical and ack_within_minutes_gt == 15"
          }
