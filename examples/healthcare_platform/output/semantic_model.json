        "ntfy",
        "wflo",
        "schd"
      ],
      "rule_engine": {
        "default_decision": "allow",
        "rules": [
          {
            "action": "deny",
            "name": "consent_required",
            "when": "operation == treat and consent_recorded != true"
          },
          {
            "action": "deny",
            "name": "drug_allergy_check",
            "when": "allergy_detected == true and override_reason missing"
          },
          {
            "action": "deny",
            "name": "controlled_substance_limit",
            "when": "drug_schedule == II and quantity_gt == 30"
          },
          {
            "action": "deny",
            "name": "prescriber_must_be_licensed",
            "when": "prescriber_licensed != true"
          },
          {
            "action": "require_review",
            "name": "critical_lab_requires_immediate_notify",
            "when": "lab_value_critical == true and clinician_notified != true"
          },
          {
            "action": "require_review",
            "name": "minor_patient_requires_guardian_consent",
            "when": "patient_age_lt == 18 and guardian_consent missing"
          },
          {
            "action": "deny",
            "name": "mental_health_enhanced_privacy",
            "when": "diagnosis_category == mental_health and access_level_lt == treating_clinician"
          }
        ],
        "type": "deterministic"
      },
