      "assignments": {
        "approved": "cfo",
        "review": "controller"
      },
      "compensation": {},
      "guards": {
        "review": "all_reconciliations_complete == true\";\n        approved: \"review_sign_off_complete == true\";\n        locked:   \"approved == true\";"
      },
      "human_tasks": [
        "accruals",
        "bank_recon",
        "review",
        "approved"
      ],
      "methods": [],
      "name": "MonthEndClose",
      "properties": {},
      "retry_policy": {
        "bank_recon": "3",
        "sub_ledger_recon": "2"
      },
      "states": [
        "open",
        "accruals",
        "bank_recon",
        "sub_ledger_recon",
        "review",
        "approved",
        "closed",
        "locked"
      ],
      "steps": [
        "open",
        "accruals",
        "bank_recon",
        "sub_ledger_recon",
        "review",
        "approved",
        "closed",
