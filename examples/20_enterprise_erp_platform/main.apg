// Example 20: enterprise ERP platform composition.
// Complexity focus: data records plus multiple ERP capabilities, screens, rules, themes, i18n, streaming, approvals, and dependency contracts.

module enterprise_erp_platform version 1.0.0 {
    description: "Executable APG ERP platform skeleton assembled from composable records and capabilities";
}

app EnterpriseERPPlatform {
    description: "Composable ERP application shell that assembles finance, operations, and audit capabilities";
    capabilities: [PlatformAudit, EnterpriseFinance, EnterpriseOperations];
    routes: ["/erp/finance", "/erp/operations", "/erp/operations/dashboard"];
    components: {
        finance_workbench: {capability: journal_entries, route: "/erp/finance"},
        operations_workbench: {capability: executive_kpis, route: "/erp/operations"},
        audit_console: {capability: audit_events, route: "/erp/audit"}
    };
    screens: {
        ExecutiveHome: {route: "/erp", capability: EnterpriseOperations, component: "ExecutiveHome"}
    };
    theme: {name: enterprise_theme, tokens: {accent: "#174EA6", surface: "#F8FAFC"}};
    runtime: {target: python, deployment: container, streaming: {processor: bytewax}};
    deployments: {default: local, container: docker};
}

table Customer {
    customer_number: str;
    legal_name: str;
    email: str;
    active: bool;
}

table Item {
    sku: str;
    description: str;
    unit_price: float;
    active: bool;
}

table SalesOrder {
    customer_id: int;
    order_number: str;
    total: float;
    status: str;
}

capability PlatformAudit {
    contract: {
        id: platform_audit,
        provides: [audit_events],
        configuration: {retention_days: 730}
    };
    streaming: {processor: bytewax, state: platform_audit_state};
}

capability EnterpriseFinance {
    contract: {
        id: enterprise_finance,
        provides: [journal_entries, invoice_generation, payment_allocation],
        requires: [audit_events],
        configuration: {currency: "KES", fiscal_calendar: "monthly"},
        rules: [
            {name: "balanced_journal", when: "debits != credits", action: "deny"},
            {name: "invoice_requires_order", when: "order_id missing", action: "deny"}
        ],
        ui: {shell: python, routes: [{name: "Finance", path: "/erp/finance", component: "FinanceWorkbench"}]},
        theme: {name: finance_theme, tokens: {accent: "#126E82"}}
    };
    erp_modules: [finance, general_ledger, accounts_payable];
    approvals: {levels: 2, approvers: [controller, cfo]};
    master_data: {entities: [account, cost_center, financial_period]};
    i18n: {supported_languages: [en, sw, ha, yo, zu, am, rw], default_language: en, fallback_language: en};
    streaming: {processor: bytewax, state: finance_event_state};
}

capability EnterpriseOperations {
    contract: {
        id: enterprise_operations,
        provides: [stock_balances, order_fulfillment, executive_kpis],
        requires: [journal_entries, audit_events],
        configuration: {default_warehouse: "NBO-01", refresh_seconds: 30},
        rules: [
            {name: "no_negative_stock", when: "on_hand - reserved < 0", action: "deny"},
            {name: "critical_exception_review", when: "severity == critical", action: "require_review"}
        ],
        ui: {shell: python, routes: [{name: "Operations", path: "/erp/operations", component: "OperationsWorkbench"}]},
        theme: {name: operations_theme, tokens: {accent: "#2F855A", surface: "#F7FAFC"}}
    };
    erp_modules: [inventory, warehouse, manufacturing, sales];
    screens: {
        OperationsDashboard: {
            route: "/erp/operations/dashboard",
            title: "Enterprise Operations",
            layout: dashboard,
            contains: [InventoryKpis, OrderQueue, ExceptionQueue],
            composes: [FulfillmentTable, FinanceKpis],
            binds: [executive_kpis.current],
            actions: [approve, reject, escalate],
            events: [{on: "select", do: "filter", target: FulfillmentTable}],
            relationships: [
                InventoryKpis -> ExceptionQueue,
                OrderQueue -> FulfillmentTable,
                FinanceKpis -> ExceptionQueue
            ]
        }
    };
    streaming: {processor: bytewax, state: operations_event_state};
}
