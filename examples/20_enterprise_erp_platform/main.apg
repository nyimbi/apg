// Example 20: enterprise ERP platform — comprehensive language showcase.
// Features: duration literals, model chain (->), fallback chain (??),
//           env() references, full ERP metadata, multiple workflows,
//           agent team, all entity types, complete app composition

module enterprise_erp version 2.0.0 {
    description: "Full-suite enterprise ERP: Finance, Procurement, Inventory, HR, CRM";
    author: "Datacraft";
    license: "Proprietary";
}

table Vendor {
    vendor_number: str;
    legal_name: str;
    tax_id: str;
    payment_terms: str = "NET30";
    currency: str = "KES";
    bank_account: str?;
    status: str = "active";
    country: str = "KE";
}

table Customer {
    customer_number: str;
    legal_name: str;
    credit_limit: float = 100000.0;
    payment_terms: str = "NET30";
    currency: str = "KES";
    status: str = "active";
    region: str;
}

table Employee {
    employee_number: str;
    full_name: str;
    department: str;
    position: str;
    salary: float;
    hire_date: str;
    is_active: bool = true;
}

db ERPDB {
    engine: postgresql;
    schema: erp_platform;
    url: env("ERP_DATABASE_URL");
}

capability ERPCore {
    contract: {
        id: enterprise_erp_core,
        provides: [erp_entities, erp_config, erp_audit],
        configuration: {
            tenant_id: env("ERP_TENANT_ID"),
            db_url:    env("ERP_DATABASE_URL"),
            api_key:   $ERP_API_KEY,
            base_currency: "KES",
            fiscal_year_start: "01-01"
        },
        configuration_schema: {required: ["tenant_id", "db_url"]},
        rule_engine: {
            type: deterministic,
            default_decision: allow,
            rules: [
                {name: "tenant_required",  when: "tenant_id missing",    action: deny, priority: 100},
                {name: "auth_required",    when: "session_token missing", action: deny, priority: 90}
            ]
        }
    };
    erp_modules: [finance, general_ledger, accounts_payable, accounts_receivable, procurement, inventory, hr, payroll, sales, crm, fixed_assets, project_accounting];
    master_data: {
        entities: [account, cost_centre, department, currency, exchange_rate, financial_period, tax_code],
        ownership: {account: finance, cost_centre: operations}
    };
    i18n: {
        supported_languages: [en, sw, fr, ar, ha, yo, zu, am],
        default_language: en,
        fallback_language: en
    };
}

capability ExecutiveERP {
    contract: {
        id: executive_erp_view,
        provides: [executive_dashboard, board_reporting],
        requires: [erp_entities, erp_audit],
        configuration: {tenant_id: env("ERP_TENANT_ID")},
        rules: [
            {name: "exec_only",       when: "role missing",              action: deny},
            {name: "large_exposure",  when: "total_exposure > 10000000", action: require_review}
        ],
        ui: {
            shell: python,
            requires_theme: true,
            routes: [
                {name: "Executive",  path: "/erp/exec",  component: "ExecutiveDashboard", permission: "erp:executive"},
                {name: "Board Pack", path: "/erp/board", component: "BoardPack",          permission: "erp:board"}
            ]
        },
        theme: {
            name: exec_theme,
            tokens: {
                "color.primary": "#0D47A1",
                "color.accent":  "#006064",
                "border.radius": "4px",
                "font.family":   "Roboto, sans-serif",
                "density":       "spacious"
            }
        }
    };
    approvals: {levels: 1, approvers: [ceo], segregation_of_duties: false};
    screens: {
        ExecutiveHome: {
            route: "/erp/exec",
            title: "Executive Dashboard",
            layout: dashboard,
            contains: [RevenueKpi, CashPosition, OpenOrders, HeadcountSummary],
            composes: [ProcurementSummary, PayrollSummary],
            binds: [financials.current_month, inventory.value, hr.headcount],
            actions: [export_board_pack, drill_down, schedule_report],
            relationships: [
                RevenueKpi -> ProcurementSummary,
                {from: CashPosition, to: OpenOrders, via: liquidity_filter}
            ]
        }
    };
    streaming: {processor: bytewax, input: erp_event_bus, output: exec_alerts, state: exec_state, window: 1hour};
}

agent ERPAnalyst {
    role: "ERP business analyst";
    model: "openai:gpt-4.1";
    runtime: codex;
    system: "Analyse ERP data across Finance, Procurement, HR, and CRM. Produce concise insights with KPI context. Cite data sources.";
    capabilities: [erp_entities, executive_dashboard, board_reporting];
    tools: [gl.query, procurement.analysis, inventory.forecast, hr.analytics];
    memory: vector erp_analyst_memory;
    input: erp_query;
    output: business_insight;
    configuration: {temperature: 0.1, max_turns: 10};
}

agent PrivacyAgent {
    role: "privacy-safe HR advisor";
    model: "ollama:llama3.3";
    runtime: ollama;
    system: "Handle HR queries locally. No data transmitted externally. GDPR-compliant responses.";
    capabilities: [erp_entities];
    tools: [hr.query_local, payroll.summarise_local];
    configuration: {temperature: 0.0, max_turns: 5};
}

agent_team ERPAdvisors {
    agents: [ERPAnalyst, PrivacyAgent];
    flow: ERPAnalyst -> PrivacyAgent [condition: hr_or_payroll_query];
    capabilities: [erp_entities, executive_dashboard];
    configuration: {handoff_mode: conditional};
}

workflow HireToRetire {
    steps: str = "job_offer -> onboarding -> probation -> confirmed -> active -> resignation -> offboarding -> terminated";
    human_tasks: [job_offer, onboarding, probation, offboarding];
    assignments: {job_offer: hr_manager, onboarding: hr_officer};
    guards: {
        probation: "onboarding_complete == true";
        confirmed: "probation_assessment_passed == true";
    };
    timers: {probation: "P90D", offboarding: "P30D"};
    compensation: {confirmed: reinstate_probation_status};
}

workflow MonthEndClose {
    steps: str = "open -> accruals -> bank_recon -> sub_ledger_recon -> review -> approved -> closed -> locked";
    human_tasks: [accruals, bank_recon, review, approved];
    assignments: {review: controller, approved: cfo};
    guards: {
        review:   "all_reconciliations_complete == true";
        approved: "review_sign_off_complete == true";
        locked:   "approved == true";
    };
    timers: {review: "PT48H", approved: "PT24H"};
    retry_policy: {bank_recon: "3", sub_ledger_recon: "2"};
}

app EnterpriseERP {
    description: "Full-suite ERP composed from APG capabilities";
    capabilities: [ERPCore, ExecutiveERP];
    agent_teams: [ERPAdvisors];
    routes: ["/erp", "/erp/exec", "/erp/finance", "/erp/procurement", "/erp/hr"];
    components: {
        finance_workbench:  {capability: erp_entities, route: "/erp/finance"},
        procurement_desk:   {capability: erp_entities, route: "/erp/procurement"},
        hr_portal:          {capability: erp_entities, route: "/erp/hr"}
    };
    screens: {
        ERPHome: {
            route: "/erp",
            title: "ERP Platform",
            layout: dashboard,
            contains: [ModuleNav, RecentActivity, AlertPanel],
            binds: [erp.summary, activity.recent, alerts.active],
            actions: [navigate, refresh]
        }
    };
    theme: {name: erp_platform_theme, tokens: {"accent": "#006064", "border.radius": "4px"}};
    runtime: {target: python, deployment: container, streaming: {processor: bytewax}};
    deployments: {default: local, container: docker, cloud: kubernetes};
}
