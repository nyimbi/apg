// Example 10: complete theme, i18n, and streaming configuration.
// Features: theme with full token set, i18n with African language codes,
//           streaming with all fields (processor, input, output, state, window)

module localised_inventory version 1.0.0 {
    description: "Inventory capability with full i18n and streaming";
}

capability LocalisedInventory {
    contract: {
        id: localised_inventory,
        provides: [stock_balances, inventory_events, reorder_alerts],
        requires: [audit_events],
        configuration: {
            tenant_id: "default",
            default_warehouse: "NBO-01",
            low_stock_threshold: 10,
            auto_reorder: true
        },
        rules: [
            {name: "no_negative_stock", when: "on_hand - reserved < 0",        action: deny},
            {name: "reorder_required",  when: "on_hand <= low_stock_threshold", action: warn}
        ],
        ui: {
            shell: python,
            requires_theme: true,
            routes: [
                {name: "Stock",     path: "/inventory",          component: "StockDashboard", permission: "inventory:view"},
                {name: "Reorders",  path: "/inventory/reorder",  component: "ReorderQueue",   permission: "inventory:reorder"},
                {name: "Movements", path: "/inventory/movements",component: "MovementLog",    permission: "inventory:movements"}
            ]
        },
        theme: {
            name: inventory_theme,
            tokens: {
                "color.primary":      "#1B5E20",
                "color.accent":       "#F57F17",
                "color.surface":      "#FFFFFF",
                "color.background":   "#F5F5F5",
                "color.error":        "#C62828",
                "color.warning":      "#E65100",
                "color.success":      "#2E7D32",
                "color.text.primary": "#212121",
                "color.text.muted":   "#757575",
                "border.radius":      "4px",
                "shadow.card":        "0 2px 4px rgba(0,0,0,0.12)",
                "density":            "comfortable",
                "font.family":        "Inter, sans-serif",
                "font.size.base":     "14px"
            },
            components: {
                stock_level_badge: {variant: "filled",       color_scheme: "status"},
                movement_table:    {stripe: true,            compact: false},
                reorder_alert:     {icon: "alert-circle",    position: "top-right"}
            },
            allow_tenant_overrides: true
        },
        runtime: {
            target: python,
            streaming: {processor: bytewax}
        }
    };

    // Full streaming configuration
    streaming: {
        processor: bytewax,
        input: inventory_event_bus,
        output: reorder_alert_stream,
        state: inventory_state,
        window: 15min
    };

    // Comprehensive i18n — English plus major African languages
    i18n: {
        supported_languages: [
            en, sw, fr, pt, ar,
            rw, rn, yo, ig, ha,
            tw, ak, ee, gaa, fon,
            zu, xh, st, tn, ss, ve, nr, nso, ts,
            am, ti, so, om,
            ln, lu, kg, sg
        ],
        default_language: en,
        fallback_language: en
    };

    master_data: {entities: [warehouse, bin_location, item_category, unit_of_measure]};
}

app LocalisedInventoryApp {
    description: "Localised inventory management with streaming";
    capabilities: [LocalisedInventory];
    routes: ["/inventory"];
}
