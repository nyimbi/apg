          "action": "deny",
          "name": "budget_code_required",
          "when": "budget_code missing",
          "when_ast": {
            "field": "budget_code",
            "negated": false,
            "type": "missing"
          }
        },
        {
          "action": "require_review",
          "name": "high_value_approval",
          "when": "amount > approval_threshold",
          "when_ast": {
            "field": "amount",
            "op": ">",
            "type": "compare",
            "value": "approval_threshold"
          }
        },
        {
          "action": "require_review",
          "name": "three_quote_required",
          "when": "amount > three_quote_minimum and quote_count < 3",
          "when_ast": {
            "left": {
              "field": "amount",
              "op": ">",
              "type": "compare",
              "value": "three_quote_minimum"
            },
            "right": {
              "field": "quote_count",
              "op": "<",
              "type": "compare",
              "value": 3
            },
            "type": "and"
          }
        },
        {
          "action": "deny",
          "name": "approved_supplier",
          "when": "supplier_status not in [approved, preferred]",
          "when_ast": {
            "field": "supplier_status",
            "negated": true,
            "type": "in",
            "values": [
              "approved",
              "preferred"
            ]
          }
        }
      ],
