        "procurement_review": "PT48H"
      },
      "transitions": [
        {
          "guard": null,
          "source": "draft",
          "target": "submitted"
        },
        {
          "guard": "amount <= budget_limit and budget_code not missing",
          "source": "submitted",
          "target": "budget_review"
        },
        {
          "guard": "budget_review_complete == true",
          "source": "budget_review",
          "target": "procurement_review"
        },
        {
          "guard": "amount > finance_threshold or is_strategic == true",
          "source": "procurement_review",
          "target": "finance_approval"
        },
        {
          "guard": null,
          "source": "finance_approval",
          "target": "approved"
        },
        {
          "guard": "all_approvals_complete and preferred_supplier_selected",
