        "budget_review": "release_budget_reservation",
        "ordered": "cancel_purchase_order"
      },
      "guards": {
        "budget_review": "amount <= budget_limit and budget_code not missing",
        "finance_approval": "amount > finance_threshold or is_strategic == true",
        "ordered": "all_approvals_complete and preferred_supplier_selected",
        "procurement_review": "budget_review_complete == true"
      },
      "human_tasks": [
        "budget_review",
        "procurement_review",
        "finance_approval"
      ],
      "methods": [],
      "name": "ProcurementApproval",
      "properties": {},
      "retry_policy": {
