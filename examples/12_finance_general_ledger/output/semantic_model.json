{
  "agents": {},
  "app": {
    "description": null,
    "entity_count": 5,
    "name": "finance_gl",
    "version": "1.0.0"
  },
  "capabilities": {
    "GeneralLedger": {
      "approvals": {
        "approvers": [
          "finance_manager",
          "controller",
          "cfo"
        ],
        "escalation": "finance_director",
        "levels": 3,
        "segregation_of_duties": true,
        "thresholds": {
          "level1": 100000,
          "level2": 500000,
          "level3": 1000000
        }
      },
      "business_rules": [
        {
          "action": "deny",
          "name": "balanced_entry",
          "when": "debits != credits",
          "when_ast": {
            "field": "debits",
            "op": "!=",
            "type": "compare",
            "value": "credits"
          }
        },
        {
          "action": "deny",
          "name": "valid_period",
          "when": "period_status == closed",
          "when_ast": {
            "field": "period_status",
            "op": "==",
            "type": "compare",
            "value": "closed"
          }
        },
        {
          "action": "deny",
          "name": "active_account",
          "when": "account_is_active == false",
          "when_ast": {
            "field": "account_is_active",
            "op": "==",
            "type": "compare",
            "value": false
          }
        },
        {
          "action": "require_review",
          "name": "budget_exceeded",
          "when": "commitment > budget_line",
          "when_ast": {
            "field": "commitment",
            "op": ">",
            "type": "compare",
            "value": "budget_line"
          }
        }
      ],
      "components": {},
      "configuration": {
        "base_currency": "KES",
        "decimal_places": 2,
        "fiscal_year_start": "01-01",
        "supported_currencies": [
          "KES",
          "UGX",
          "TZS",
          "USD",
          "EUR"
        ],
        "tenant_id": "default"
      },
      "erp_modules": [
        "finance",
        "general_ledger",
        "accounts_payable",
        "accounts_receivable",
        "fixed_assets",
        "project_accounting",
        "reporting"
      ],
      "i18n": {
        "default_language": "en",
        "fallback_language": "en",
        "supported_languages": [
          "en",
          "sw",
          "fr"
        ]
      },
      "master_data": {
        "deduplication": "account_code",
        "entities": [
          "account",
          "cost_centre",
          "financial_period",
          "currency",
          "exchange_rate",
          "budget",
          "budget_line",
          "project",
          "department"
        ],
        "governance": {
          "rules": [
            {
              "action": "deny",
              "name": "unique_code",
              "when": "account_code exists"
            }
          ],
          "type": "deterministic"
        },
        "ownership": {
          "account": "finance",
          "cost_centre": "operations",
          "currency": "finance",
          "financial_period": "finance"
        }
      },
      "name": "GeneralLedger",
      "provides": [
        "chart_of_accounts",
        "journal_entries",
        "period_close",
        "trial_balance",
        "financial_statements"
      ],
      "requires": [
        "audit_events",
        "auth"
      ],
      "rule_engine": {},
      "rules": [
        {
          "action": "deny",
          "name": "journal_balanced",
          "when": "total_debit != total_credit",
          "when_ast": {
            "field": "total_debit",
            "op": "!=",
            "type": "compare",
            "value": "total_credit"
          }
        },
        {
          "action": "deny",
          "name": "open_period_required",
          "when": "period_status != open",
          "when_ast": {
            "field": "period_status",
            "op": "!=",
            "type": "compare",
            "value": "open"
          }
        },
        {
          "action": "allow",
          "name": "posting_authorised",
          "when": "user_role in [accountant, controller, cfo]",
          "when_ast": {
            "field": "user_role",
            "negated": false,
            "type": "in",
            "values": [
              "accountant",
              "controller",
              "cfo"
            ]
          }
        },
        {
          "action": "require_review",
          "name": "large_entry_review",
          "when": "total_debit > 1000000",
          "when_ast": {
            "field": "total_debit",
            "op": ">",
            "type": "compare",
            "value": 1000000
          }
        },
        {
          "action": "deny",
          "name": "period_close_check",
          "when": "reconciled == false and period_close_initiated == true",
          "when_ast": {
            "left": {
              "field": "reconciled",
              "op": "==",
              "type": "compare",
              "value": false
            },
            "right": {
              "field": "period_close_initiated",
              "op": "==",
              "type": "compare",
              "value": true
            },
            "type": "and"
          }
        }
      ],
      "runtime": {},
      "screens": {},
      "streaming": {
        "input": "gl_events",
        "processor": "bytewax",
        "state": "gl_state"
      },
      "theme": {
        "name": "finance_theme",
        "tokens": {
          "accent": "#1A237E",
          "color.primary": "#283593"
        }
      },
      "ui": {
        "routes": [
          {
            "component": "AccountList",
            "name": "Chart of Accounts",
            "path": "/gl/accounts",
            "permission": "gl:accounts"
          },
          {
            "component": "JournalList",
            "name": "Journal Entries",
            "path": "/gl/journals",
            "permission": "gl:journals"
          },
          {
            "component": "TrialBalance",
            "name": "Trial Balance",
            "path": "/gl/trial",
            "permission": "gl:reports"
          },
          {
            "component": "PeriodClose",
            "name": "Period Close",
            "path": "/gl/period-close",
            "permission": "gl:close"
          }
        ],
        "shell": "python"
      }
    }
  },
