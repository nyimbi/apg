// Example 01: typed customer record with optional and union fields.
// Features: str, int, float, decimal, bool, datetime, date, str?, str | None,
//           default values, List[str], Dict[str, Any]

module customer_records version 1.0.0 {
    description: "Customer data model with full type coverage";
}

table Customer {
    // Required scalar fields
    customer_number: str;
    legal_name: str;
    email: str;
    phone: str;
    // Optional field — may be absent (null)
    secondary_email: str?;
    // Union type — explicit null alternative
    company_name: str | None;
    // Numeric types
    credit_limit: decimal = 50000.0;
    loyalty_points: int = 0;
    discount_rate: float = 0.0;
    // Boolean with default
    is_active: bool = true;
    is_verified: bool = false;
    // Date/time types
    registered_at: datetime;
    date_of_birth: date?;
    // Collection types
    tags: List[str];
    preferences: Dict[str, str];
    // Status with a default
    status: str = "prospect";
    // Arbitrary metadata
    metadata: Dict[str, Any];
}

app CustomerRecords {
    description: "Customer records application";
    capabilities: [];
    routes: ["/customers"];
}
