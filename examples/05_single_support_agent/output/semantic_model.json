      "name": "TriageAgent",
      "outputs": [],
      "role": "support triage specialist",
      "rules": [
        {
          "action": "reject",
          "name": "ticket_required",
          "when": "ticket_id missing"
        },
        {
          "action": "deny",
          "name": "valid_channel",
          "when": "channel not in [email, chat, phone, portal]"
        },
        {
          "action": "allow",
          "name": "customer_identified",
          "when": "customer_id not missing"
        },
        {
          "action": "require_review",
          "name": "critical_escalation",
          "when": "severity == critical and sla_breach_imminent == true"
        },
        {
          "action": "deny",
          "name": "rate_limit",
          "when": "requests_per_minute > 100"
        }
      ],
      "runtime": null,
