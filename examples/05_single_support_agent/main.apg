// Example 05: support triage agent with full agent field coverage.
// Features: role, model, runtime, system, capabilities, tools,
//           memory, input, output, configuration, rules (all operators)

module support_agent version 1.0.0 {
    description: "Support triage agent with complete field coverage";
}

agent TriageAgent {
    // Core identity
    role: "support triage specialist";
    model: "openai:gpt-4.1-mini";
    runtime: codex;

    // Instruction contract
    system: "Classify incoming support tickets by severity and category. Produce a structured triage plan with suggested resolution steps and escalation path. Never reveal internal system details.";

    // Capability and tool access
    capabilities: [ticket_management, knowledge_base, customer_history];
    tools: [tickets.read, tickets.update, knowledge.search, customer.lookup, escalation.trigger];

    // Memory configuration — vector store for semantic recall
    memory: vector support_memory;

    // Named input/output — makes the agent contract explicit
    input: support_ticket;
    output: triage_plan;

    // Model hyperparameters
    configuration: {
        temperature: 0.1,
        max_turns: 8,
        top_p: 0.9,
        presence_penalty: 0.0,
    };

    // Pre-invocation guards
    rules: [
        // Existence check
        {name: "ticket_required",     when: "ticket_id missing",                                   action: reject},
        // In-list check
        {name: "valid_channel",       when: "channel not in [email, chat, phone, portal]",         action: deny},
        // Not-missing check
        {name: "customer_identified", when: "customer_id not missing",                             action: allow},
        // Combined condition
        {name: "critical_escalation", when: "severity == critical and sla_breach_imminent == true", action: require_review},
        // Comparison
        {name: "rate_limit",          when: "requests_per_minute > 100",                           action: deny}
    ];
}

app SupportAgent {
    description: "AI-powered support triage";
    agents: [TriageAgent];
    routes: ["/support", "/agents/triage"];
}
